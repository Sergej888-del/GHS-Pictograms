{
  "name": "ghspictograms",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "build:local": "node --use-system-ca ./node_modules/astro/bin/astro.mjs build",
    "preview": "astro preview",
    "preview:local": "node --use-system-ca ./node_modules/astro/bin/astro.mjs preview",
    "check:types": "node --use-system-ca ./node_modules/typescript/bin/tsc --noEmit",
    "check:dist": "node --use-system-ca --import tsx scripts/check-dist.ts",
    "check:seo": "node --use-system-ca --import tsx scripts/check-seo.ts",
    "generate:redirects": "node scripts/generate-pictogram-redirects.mjs",
    "astro": "astro",
    "generate-types": "wrangler types",
    "import-pubchem": "tsx scripts/import-pubchem.ts",
    "check:label-layout": "node --use-system-ca --import tsx scripts/check-label-layout.ts",
    "import:substance-names": "node --use-system-ca --import tsx scripts/import-substance-names.ts",
    "check:label-width": "node --use-system-ca --import tsx scripts/check-label-width.ts",
    "check:p-precedence": "node --experimental-strip-types scripts/check-p-precedence.ts",
    "check:label-size": "node --experimental-strip-types scripts/check-label-size.ts",
    "check:label-elements": "node --experimental-strip-types scripts/check-label-elements.ts",
    "check:label-fit": "node --experimental-strip-types scripts/check-label-fit.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.2",
    "@astrojs/sitemap": "^3.7.2",
    "@supabase/supabase-js": "^2.101.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.1.3",
    "fuse.js": "^7.3.0",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "vite": "^7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260401.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
  }
}
