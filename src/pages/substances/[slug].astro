        <a class="hub-mini-card" href={`/label-constructor/?cas=${encodeURIComponent(cas)}`}>
          <strong>Label constructor</strong>
          <span>Build a compliant GHS label with these pictograms and statements.</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
