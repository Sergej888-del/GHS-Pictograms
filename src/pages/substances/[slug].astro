  */}
  {nFaq && (
    <section class="hub-sec-b" id="faq">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nFaq} · Questions</p>
        <h2 class="hub-h2">{nm} — frequently asked questions</h2>
        <div class="sub-faq">
          {faq.map((f) => (
            <div class="sub-faq-item">
              <h3 class="sub-h3">{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/*
    ⚠⚠ Соседи по алфавиту. Считаются в getStaticPaths — см. комментарий там.
    Когда соседа нет (первая и последняя запись справочника), карточка ведёт
