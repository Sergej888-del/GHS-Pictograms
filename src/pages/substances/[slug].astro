    количество и идентификатор продукта, которых у справочника нет и быть не
    может. Поэтому подвал карточки — это подписанные ПРОПУСКИ, а не пустое
    место: пустое место читается как «больше ничего не нужно».
    ⚠ Собирается из тех же данных, что и секции выше. Отдельного источника у
    превью нет — иначе оно начнёт расходиться с таблицами на той же странице.
  */}
  {nLabel && (
    <section class="hub-sec-a" id="label">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nLabel} · Label elements</p>
        <h2 class="hub-h2">{nm} GHS label elements</h2>
        <p class="hub-sub">
          Everything CLP Annex VI fixes for {nmShort}, laid out the way it appears on a label.
          The greyed lines are the parts only the supplier can fill in.
        </p>

        <div class="sub-label">
          <div class="sub-label-head">
            {pictograms.length > 0 && (
              <div class="sub-label-picts">
                {pictograms.map((code) => (
                  <img src={`/pictograms/${code.toLowerCase()}.svg`} width="64" height="64"
                       alt={`${code} ${PICTOGRAM_NAME[code]} pictogram`} loading="lazy" />
                ))}
              </div>
            )}
            {row.signal_word && <p class="sub-label-signal">{row.signal_word}</p>}
          </div>

          <p class="sub-label-name">{nm}</p>

          {hList.length > 0 && (
            <ul class="sub-label-list">
              {hList.map((h) => <li>{h.text}</li>)}
            </ul>
          )}
          {euhList.length > 0 && (
            <ul class="sub-label-list">
              {euhList.map((e) => <li>{e.text}</li>)}
            </ul>
          )}
          {pFlat.length > 0 && (
            <ul class="sub-label-list sub-label-p">
              {pFlat.map((p) => (
                <li>
                  {splitClpNotation(p.text, 'p').map((piece) =>
                    piece.kind === 'blank' ? (
                      <span class="clp-blank">{piece.value}</span>
                    ) : piece.kind === 'opt' ? (
                      <span class="clp-opt">{piece.value}</span>
                    ) : (
                      piece.value
                    )
                  )}
                </li>
              ))}
            </ul>
          )}

          <p class="sub-label-supplier">
            Supplier name, address and telephone number<span class="sep">·</span>
            Product identifier<span class="sep">·</span>Nominal quantity
          </p>
        </div>

        <p class="hub-note">
          Need this as an actual label?{' '}
          <a href={`/label-constructor/?cas=${encodeURIComponent(cas)}`}>
            Open {nmShort} in the GHS label constructor →
          </a>
        </p>
      </div>
    </section>
  )}

  {/*
    ⚠⚠ Здоровье и пределы воздействия. Раздел появился в session 38: данные
    лежали в выгрузке LCSS с самого начала, но до JSON не доехали.
    ⚠⚠⚠ ДВА НЕЗАВИСИМЫХ ОТВЕТА НА ВОПРОС «КАНЦЕРОГЕН ЛИ». CLP Annex VI — это
    право ЕС, IARC — научная оценка ВОЗ, и они РАСХОДЯТСЯ штатно: у вещества
    может не быть гармонизированного H350 и при этом стоять Group 2B. Свести
    их в один вердикт значит выбрать за читателя, какой из двух источников
    неправ. Поэтому показываем оба и подписываем, кто что сказал.
    ⚠ Пределы — американские (OSHA, NIOSH). В ЕС свои значения, которых у нас
    нет; про это сказано прямо в подписи, а не мелким шрифтом внизу.
    ⛔ ACGIH TLV в этот блок попасть не может: вырезан на сборке данных
    построчно, см. BANNED_ROW в scripts/build-lcss-text.mjs.
  */}
  {nHealth && (
    <section class="hub-sec-white" id="health">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nHealth} · Health hazards</p>
        <h2 class="hub-h2">{nm} health hazards and exposure limits</h2>

        {texts?.hazsum && (
          <>
            <h3 class="sub-h3" id="hazard-summary">{nm} hazard summary</h3>
            <div class="sub-quote">
              <p>{texts.hazsum.t}</p>
              <p class="hub-fine">Source: {texts.hazsum.s}</p>
            </div>
          </>
        )}

        {carc && (
          <>
            <h3 class="sub-h3" id="carcinogenicity">{nm} carcinogenicity classification</h3>
            {carc.iarc && (
              <div class="hub-panel">
                <div class="hub-panel-row">
                  <span class="hub-panel-label">IARC classification</span>
                  <span><b>{carc.iarc.group}</b> — {carc.iarc.label}</span>
                </div>
                {carc.iarc.volumes.length > 0 && (
                  <div class="hub-panel-row">
                    <span class="hub-panel-label">IARC monographs</span>
                    <span>{carc.iarc.volumes.join('; ')}</span>
                  </div>
                )}
              </div>
            )}
            {carc.ntp?.verdict && (
              <div class="sub-quote">
                <p>{carc.ntp.verdict}</p>
                <p class="hub-fine">
                  Source: US National Toxicology Program{carc.ntp.report ? ` · ${carc.ntp.report}` : ''}
                </p>
              </div>
            )}
            {!carc.ntp?.verdict && carc.ntp?.report && (
              <p class="hub-fine">
                Studied by the US National Toxicology Program: {carc.ntp.report}
              </p>
            )}
            {carc.notes?.map((n) => (
              <div class="sub-quote">
                <p>{n.t}</p>
                <p class="hub-fine">Source: {n.s}</p>
              </div>
            ))}
            <p class="hub-fine">
              An IARC group and a CLP classification answer different questions. IARC judges
              whether the evidence for cancer in humans is strong enough; CLP Annex VI is the
              legally binding EU classification. A substance can carry one and not the other.
            </p>
          </>
        )}

        {oelRows.length > 0 && (
          <>
            <h3 class="sub-h3" id="exposure-limits">{nm} occupational exposure limits</h3>
            <div class="hub-table-wrap">
              <table class="hub-table sub-oel">
                <caption class="hub-fine">
                  US occupational exposure limits reported for {nmShort}. PEL is enforceable
                  (OSHA), REL is a recommendation (NIOSH), IDLH is the concentration at which
                  escape becomes impossible without injury.
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Limit</th>
                    <th scope="col">Value</th>
                    <th scope="col">Source</th>
                  </tr>
                </thead>
                <tbody>
                  {oelRows.map((r) => (
                    <tr>
                      <th scope="row" class="c-code" title={r.full}>{r.kind}</th>
                      <td class="c-val c-val-text">{r.t}</td>
                      <td class="c-txt">{r.s}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="hub-fine">
              These are United States values. The European Union sets its own indicative and
              binding limits, and the figure that applies at a given workplace is the one in
              the local regulation — not the one shown here.
            </p>
          </>
        )}
      </div>
    </section>
  )}

  {nProperties && (
    <section class="hub-sec-b" id="properties">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nProperties} · Physical and chemical properties</p>
        <h2 class="hub-h2">{nm} properties</h2>
        <p class="hub-sub">
          Every value is shown with the conditions it was measured under and the source
          it came from. Where sources disagree, all values are listed rather than one
          being picked — the difference is usually a different form of the substance,
          not an error.
        </p>

        {/*
          ⚠⚠ ОДНО СВОЙСТВО — ОДИН H3 (session 38, решение Сергея). Раньше все
          значения лежали в одной таблице под общим H2, и заголовка со словами
          «boiling point» на странице не было. Связка «вещество + boiling point»
          ищется отдельно от «вещество + properties», и отвечать на неё должен
          заголовок, а не строка внутри таблицы.

          ⚠ Разметка ячеек НЕ МЕНЯЛАСЬ: `<td class="c-val">` с цифрой — маркер
          проверки subs-static-content, которая только по нему и отличает статику
          от острова client:load. Маркер и разметка правятся одним движением;
          здесь движения не потребовалось, и это осознанно.

          ⚠ Якорь #properties остаётся на секции, у каждого свойства свой
          собственный (#boiling-point и т. д.) — по ключу, а не по подписи:
          подпись меняется, ключ приходит из данных.
        */}
        {propertyRows.map((prop) => (
          <div class="sub-prop-block">
            <h3 class="sub-h3" id={prop.key.replace(/_/g, '-')}>
