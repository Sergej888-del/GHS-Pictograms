---
/**
 * Страница вещества в справочнике: /substances/<имя>-<cas>/
 *
 * ⚠⚠ ПРАВИЛО ОТРИСОВКИ (session 35). Сначала статика, острова только для поиска,
 * фильтра и сравнения. Причина — дефект старых страниц на ghssymbols:
 * `SubstancePage` подключён `client:load`, в статике на странице фенола 25 КБ и
 * ни слова о феноле. Итог в Google: 1 929 показов, 3 клика, CTR 0,16 %.
 * Здесь весь текст, все таблицы и все числа лежат в HTML. Островов нет вообще.
 *
 * ⚠⚠ ПРАВИЛО ЧИСЕЛ. Значение всегда с условиями и источником — см. lcssProperties.ts.
 *
 * ⚠ Справочник и SDS не конкурируют: в заголовке справочника НИКОГДА нет слова
 * SDS, синонимы живут ТОЛЬКО здесь. Разбор: claude/substance-hub-decisions.md §4.3.
 *
 * ⚠⚠ ПРАВИЛО ЗАГОЛОВКОВ (session 38, решение Сергея). Имя вещества стоит в
 * КАЖДОМ заголовке секции и подсекции: «Acetone hazard statements», «Acetone
 * boiling point». Причина — замеры волн 1–4: объём собирают не голые
 * модификаторы, а связки «вещество + модификатор» (`formula` при веществе —
 * 20 730, `molecular weight` — 4 570). H2 «Properties» не отвечает ни на один
 * реальный запрос; «Acetone properties» отвечает.
 * ⚠ Отсюда же запрет на подстраницы вида /acetone/boiling-point/: объёма на
 * отдельный URL нет, а H3 с якорем его собирает (substance-hub-decisions.md §4.2).
 */
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase'
import { must } from '../../lib/mustQuery'
import { truncateMetaDescription } from '../../lib/metaDescription'
import { substanceNameFull, substanceTitleName, truncateName, NAME_COLUMNS } from '../../lib/substanceName'
import { substanceSlug, substanceHref } from '../../lib/substanceSlug'
import { ecForDisplay } from '../../lib/substanceIdentifiers'
// ⚠ Ссылку на страницу H-кода строит ТОЛЬКО hHref: у девяти суффиксных кодов
// (H360Fd, H360FD, H361f…) слаг отличается от кода — см. hStatementSlug.ts.
// Прямая склейка `/h-statements/${code}/` дала 387 страниц со ссылкой в 404.
// ⚠ EUH-коды живут в той же таблице и на тех же адресах: /h-statements/EUH014/.
import { hHref } from '../../lib/hStatementSlug'
import { buildPropertyRows, buildSourceNotes, PROPERTY_HEADING, PROPERTY_LABEL, type LcssRecord } from '../../lib/lcssProperties'
import { buildIntro, type TextRecord } from '../../lib/substanceIntro'
import { groupPStatements, countPStatements } from '../../lib/pStatements'
import { buildHazardClasses, categoryLabel, hasAmbiguity, type HazardClassEntry } from '../../lib/hazardClasses'
import { buildFaq } from '../../lib/substanceFaq'
// ⚠ Нотация CLP рисуется тем же кодом, что и на страницах фраз: «…» — пропуск,
// который заполняет поставщик, «[…]» — необязательная часть. Без этого P-фраза
// в карточке читается как оборванная строка.
import { splitClpNotation } from '../../lib/clpNotation'
// ⚠⚠ Партнёрская карточка ставится ТОЛЬКО компонентом. Разметка (rel="sponsored
// nofollow noopener", target, дисклоуз, fp_sid) зашита в него один раз, и обе
// проверки группы Affiliate в check:dist проверяют именно её. Ссылка, вписанная
// руками мимо компонента, — тот самый сценарий отказа, который они ловят.
import SdsManagerCard from '../../components/SdsManagerCard.astro'
// ⚠⚠ Транспортный знак ставится ТОЛЬКО этим компонентом. Подложка под ромбом —
// не украшение: у знаков с белым полем внешнего контура в файле нет вовсе
// (49 CFR 172.407(b)(2)), и без подложки ромб на белой странице теряет границу.
// Буква группы совместимости класса 1 тоже рисуется внутри него, по измеренной
// координате. Прямой <img src="/pictograms/transport/…"> мимо компонента даст
// знак без границы и без буквы — см. claude/adr-placard-set-session40.md.
import TransportLabel from '../../components/TransportLabel.astro'
import { adrLabels, dotLabels } from '../../lib/transportLabels'
import {
  ADR_SOURCE, DOT_SOURCE, ADR_CLASS_NAME, dotClassName, unLabel, ADR_STATUS_TEXT,
} from '../../lib/dangerousGoods'
import { buildUnEntriesByCas, MULTI_UN_NOTE, type UnEntry } from '../../lib/substanceTransport'
// ⚠⚠ Имя записи Annex VI по языковым редакциям собирается ТЕМ ЖЕ модулем, что
// и имя на этикетке в конструкторе: обязательное примечание, групповые записи и
// ненадёжный разбор разбираются там один раз. Второй разбор здесь молча разошёлся
// бы с первым, и справочник начал бы называть вещество иначе, чем этикетка.
// ⚠ Модуль намеренно без обращений к базе — им же считает check:dist.
import {
  buildOfficialNames, NAME_TRANSLATION_COLUMNS, VERBATIM_REASON_TEXT,
  ANNEX_VI_LANGUAGE_ABSENT, ANNEX_VI_LANGUAGE_ABSENT_REASON,
  type NameTranslationRow, type OfficialName,
} from '../../lib/nameForms'
import {
  erratumFor, erratumCitation, ERRATUM_LEAD, ERRATA_TABLE_NOTE,
} from '../../lib/annex6Errata'
// ⚠⚠ Ошибки регламента ВНУТРИ СТРОКИ (код H-фразы ≠ напечатанному классу) —
// другой вид, чем языковые: одинаковы во всех 23 редакциях, с 2008 года.
// Печатаем фразы по классу, расхождение — пометкой (`annex6RowErrata.ts`).
import {
  rowErratumFor, rowErratumCitation, ROW_ERRATUM_LEAD, ROW_ERRATA_TABLE_NOTE,
} from '../../lib/annex6RowErrata'
// ⚠ `EU_LANGUAGES` нужен здесь только чтобы назвать НЕДОСТАЮЩИЕ редакции и
// подписать строки таблицы. Сам порядок строк задаёт `buildOfficialNames` —
// одним списком на страницу и на проверку.
import { EU_LANGUAGES, LANGUAGE_BY_CODE, EURLEX_ATTRIBUTION } from '../../lib/labelLanguages'
import lcssValues from '../../data/lcss-values.json'
import lcssText from '../../data/lcss-text.json'

const SITE = 'https://ghspictograms.com'

const PICTOGRAM_NAME: Record<string, string> = {
  GHS01: 'Exploding bomb',
  GHS02: 'Flame',
  GHS03: 'Flame over circle',
  GHS04: 'Gas cylinder',
  GHS05: 'Corrosion',
  GHS06: 'Skull and crossbones',
  GHS07: 'Exclamation mark',
  GHS08: 'Health hazard',
  GHS09: 'Environment',
}

export async function getStaticPaths() {
  // ⚠ getStaticPaths — изолированная область видимости: видны только top-level импорты.
  const PAGE = 1000
  type Row = {
    cas_number: string
    ec_number: string | null
    index_number: string | null
    common_name: string | null
    display_name_short: string | null
    iupac_name: string
    synonyms: string[] | null
    molecular_formula: string | null
    molecular_weight: number | null
    signal_word: string | null
    h_statement_codes: string[] | null
    p_statement_codes: string[] | null
    euh_codes: string[] | null
    ghs_pictogram_codes: string[] | null
  }

  const rows: Row[] = []
  for (let from = 0; ; from += PAGE) {
    // PostgREST отдаёт максимум 1000 строк за раз, веществ 4 178.
    const chunk = must(
      `substances (getStaticPaths, from=${from})`,
      await supabase
        .from('substances')
        .select(
          `cas_number, ec_number, index_number, ${NAME_COLUMNS}, synonyms, molecular_formula, molecular_weight, signal_word, h_statement_codes, p_statement_codes, euh_codes, ghs_pictogram_codes`
        )
        .not('cas_number', 'is', null)
        .order('cas_number')
        .range(from, from + PAGE - 1)
    ) as Row[] | null
    if (!chunk?.length) break
    rows.push(...chunk)
    if (chunk.length < PAGE) break
  }

  // ⚠⚠ Отбор по ФОРМЕ CAS, а не по отсутствию скобки. Проверка `!includes('[')`
  // пропускала три записи, которые CAS не являются: `-` (один дефис),
  // `127087-87-09016-45-9` и `3811-73-215922-78-8` — два номера, склеенных
  // обрезкой varchar(20). Слаг из них не разбирается обратно, и редирект
  // /hazards/<cas>/ на такую страницу не наведётся.
  // ⚠ Тот же отбор обязан стоять в sitemap.xml.ts и в
  // ghssymbols/scripts/generate-substance-redirect-map.mjs — иначе счёта разойдутся.
  const CAS_SHAPE = /^\d{2,7}-\d{2}-\d$/
  const clean = rows.filter((r) => r.cas_number && CAS_SHAPE.test(r.cas_number))

  // ═══ Имя записи Annex VI по языковым редакциям (session 56) ═══
  //
  // ⚠⚠ ЧИТАЕТСЯ ПО КЛЮЧУ, А НЕ ЧЕРЕЗ OFFSET, И ЭТО ЗАМЕР, А НЕ ВКУСОВЩИНА.
  // `range()` — это `LIMIT … OFFSET …`, и Postgres на каждой странице проходит
  // все предыдущие записи индекса заново. На 101 654 строках последние страницы
  // упираются в `statement_timeout` роли `anon` (3 с, замер session 47). Замер
  // 2026-08-09, EXPLAIN ANALYZE на живой базе:
  //
  //   ORDER BY … LIMIT 1000 OFFSET 100000   → 4 152 мс, 99 655 буферов
  //   WHERE index_number >= … LIMIT 1000    →     2,6 мс,  1 008 буферов
  //
  // ⚠ Сборка через `range()` проходила — но только потому, что обёртка
  // `supabase.ts` повторяет GET после ответа 500. То есть отказ был, его просто
  // гасили повторы. Проверка `check:dist` повторов не делает и упала честно.
  //
  // ⭐ Курсор — `index_number`, первый столбец первичного ключа
  // `(index_number, lang)`, поэтому чтение идёт по индексу и стоит одинаково на
  // любой странице.
  // ⚠ Курсор двигается через `gte`, а не `gt`: страница в тысячу строк почти
  // всегда обрывается ПОСРЕДИ записи (у записи до 23 языков), и `gt` потерял бы
  // её хвост. Повторы отсеиваются по ключу `(index_number, lang)`.
  //
  // ⚠⚠ Порядок обязателен и сам по себе: без ORDER BY Postgres не обязан
  // отдавать страницы в одном и том же порядке, и соседние страницы начинают
  // перекрываться — часть строк ПРОПАДАЕТ, часть приходит ДВАЖДЫ (session 55).
  //
  // ⚠ Таблица читается ЦЕЛИКОМ, а не фильтром `.in('index_number', …)` на
  // 3 650 значений: фильтр PostgREST уходит в строку запроса URL и упирается в
  // предел её длины. Тот же довод записан у транспортного блока ниже.
  // ⚠ Строки сворачиваются в карту сразу, пачками по тысяче, чтобы 101 654
  // сырых строки не лежали в памяти разом.
  const wantedIndex = new Set(
    clean.map((r) => r.index_number).filter((v): v is string => Boolean(v)),
  )
  const nameRowsByIndex = new Map<string, NameTranslationRow[]>()
  const seenNameRow = new Set<string>()
  let nameCursor: string | null = null
  for (;;) {
    let query = supabase
      .from('substance_name_translations')
      .select(NAME_TRANSLATION_COLUMNS)
      .order('index_number', { ascending: true })
      .order('lang', { ascending: true })
      .limit(PAGE)
    if (nameCursor !== null) query = query.gte('index_number', nameCursor)
    const chunk = must(
      `substance_name_translations (getStaticPaths, от ${nameCursor ?? 'начала'})`,
      await query
    ) as NameTranslationRow[] | null
    if (!chunk?.length) break
    let fresh = 0
    for (const r of chunk) {
      const key = `${r.index_number}|${r.lang}`
      if (seenNameRow.has(key)) continue
      seenNameRow.add(key)
      fresh++
      if (!wantedIndex.has(r.index_number)) continue
      const list = nameRowsByIndex.get(r.index_number)
      if (list) list.push(r)
      else nameRowsByIndex.set(r.index_number, [r])
    }
    if (chunk.length < PAGE) break
    // ⚠ Страховка от вечного цикла: страница целиком из повторов означала бы,
    // что у одного индексного номера больше 1000 языков. Молчаливое
    // зацикливание сборки хуже громкого отказа.
    if (!fresh) {
      throw new Error(
        `substance_name_translations: страница из ${chunk.length} строк не дала ни одной новой ` +
        `на курсоре ${nameCursor} — у одного индексного номера не может быть столько языков`
      )
    }
    nameCursor = chunk[chunk.length - 1].index_number
  }
  // ⚠⚠ Порядок языков страница НЕ задаёт. Он свойство регламента и живёт в
  // `euLanguages.ts` — там же, откуда его берёт проверка. Пока порядок был
  // аргументом, страница и проверка получали разные ответы от одной функции.
  const namesByIndex = new Map<string, OfficialName[]>()
  for (const [index, list] of nameRowsByIndex) {
    namesByIndex.set(index, buildOfficialNames(list))
  }

  const hCodes = [...new Set(clean.flatMap((r) => r.h_statement_codes ?? []))]
  const hRows = must(
    'h_statements (getStaticPaths)',
    await supabase.from('h_statements').select('code, text_en').in('code', hCodes)
  ) as Array<{ code: string; text_en: string }> | null
  const hText = new Map((hRows ?? []).map((h) => [h.code, h.text_en]))

  // ⚠⚠ P-фразы с текстом, а не одними кодами (session 38). До этого страница
  // печатала строку «Precautionary statements: P201, P280, P308, P313» — четыре
  // кода без единого слова о том, что делать. Уникальных кодов у всего
  // справочника 45, поэтому это ОДИН запрос на всю сборку, а не 3 650.
  // ⚠ Комбинированных кодов («P301+P310») среди них нет — проверено по базе;
  // все 45 лежат в `p_statements` и имеют свою страницу.
  const pCodes = [...new Set(clean.flatMap((r) => r.p_statement_codes ?? []))]
  const pRows = must(
    'p_statements (getStaticPaths)',
    await supabase.from('p_statements').select('code, text_en, category').in('code', pCodes)
  ) as Array<{ code: string; text_en: string; category: string }> | null
  const pMeta = new Map((pRows ?? []).map((p) => [p.code, { text: p.text_en, category: p.category }]))

  // ⚠ EUH-фразы лежат в ОТДЕЛЬНОЙ колонке `euh_codes`, а их текст — в таблице
  // `h_statements` с категорией `eu_specific`. Отдельной таблицы под них нет,
  // и искать её не надо: /h-statements/EUH014/ — существующая страница.
  const euhCodes = [...new Set(clean.flatMap((r) => r.euh_codes ?? []))]
  const euhRows = euhCodes.length
    ? (must(
        'h_statements (EUH, getStaticPaths)',
        await supabase.from('h_statements').select('code, text_en').in('code', euhCodes)
      ) as Array<{ code: string; text_en: string }> | null)
    : []
  const euhText = new Map((euhRows ?? []).map((h) => [h.code, h.text_en]))

  // ⚠⚠ Класс и категория опасности выводятся из H-кода, потому что таблица
  // `hazard_classifications` ПУСТА. Ограничения вывода и правило показа
  // неоднозначности — в шапке lib/hazardClasses.ts, читать до правок.
  const mapRows = must(
    'hazard_category_mapping (getStaticPaths)',
    await supabase
      .from('hazard_category_mapping')
      .select('hazard_class_id, category_code, pictogram_code, signal_word, h_statement_code')
  ) as Array<{
    hazard_class_id: string
    category_code: string | null
    pictogram_code: string | null
    signal_word: string | null
    h_statement_code: string | null
  }> | null
  const catalogRows = must(
    'hazard_class_catalog (getStaticPaths)',
    await supabase.from('hazard_class_catalog').select('id, class_code, name_en, ghs_chapter, display_order')
  ) as Array<{
    id: string
    class_code: string
    name_en: string
    ghs_chapter: string | null
    display_order: number | null
  }> | null

  // ⚠⚠⚠ РЕАКТИВНЫЕ ГРУППЫ CAMEO БЕРУТСЯ ИЗ БАЗЫ, А НЕ ИЗ ВЫГРУЗКИ LCSS.
  // Сверка session 38: в выгрузке PubChem группы собраны объединением по ВСЕМ
  // записям CAMEO с тем же CAS, поэтому метанолу достаётся «Amines, Phosphines,
  // and Pyridines» от записи METHANOL, TALLOW ALKYL IMINOBISETHANOL, а едкому
  // натру — «Water and Aqueous Solutions» от его раствора. Это дефект B из
  // claude/cameo-cas-collisions.md §4, уже вычищенный в базе через
  // substance_cameo_choice (session 33).
  // ⚠⚠ Второй довод, важнее первого: на ЭТОЙ ЖЕ таблице считает матрица
  // совместимости, в которую со страницы ведёт ссылка. Возьми мы группу из
  // другого источника — страница и инструмент разошлись бы, и читатель увидел
  // бы два разных ответа на один вопрос по одной ссылке.
  //
  // ⚠⚠⚠ И ЭТОГО МАЛО. Замер session 38: в таблице ДВА источника —
  //   `…curated record via substance_cameo_choice (session 33)` — 130 связей, 98 веществ
  //   `CAMEO Chemicals v3.1.0, NOAA/EPA`                        — 1 800 связей, 987 веществ
  // В session 33 вычистили только те 98, у которых есть своя SDS. Остальные 987
  // лежат тем же объединением по CAS, что и выгрузка: 1,78 группы на вещество
  // против 1,81 в выгрузке, «Water and Aqueous Solutions» 54 против 58 — это
  // одни и те же данные.
  //
  // ⚠⚠ Поэтому берём ТОЛЬКО курируемые. На 987 страницах секции просто не будет.
  // «NaOH несовместим с водой» на странице по безопасности — это не косметический
  // дефект, и пустая секция тут честнее. Проверка subs-reactive-group в
  // check:dist держит счёт: блок обязан стоять ровно на курируемых и нигде ещё.
  // ⚠ Отбор по source_ref, а не по вхождению в substance_cameo_choice: source_ref
  // говорит, ОТКУДА взялась строка, а таблица выбора — лишь что решение принято.
  // При следующем переимпорте разойтись может именно вторая.
  const RG_CURATED = 'CAMEO Chemicals 3.1.0 - curated record via substance_cameo_choice (session 33)'
  const rgLinkRows = must(
    'substance_reactive_group_link (getStaticPaths)',
    await supabase
      .from('substance_reactive_group_link')
      .select('cas_number, rg_id')
      .eq('source_ref', RG_CURATED)
  ) as Array<{ cas_number: string; rg_id: string }> | null
  const rgNameRows = must(
    'chem_reactive_groups (getStaticPaths)',
    await supabase.from('chem_reactive_groups').select('rg_id, name')
  ) as Array<{ rg_id: string; name: string }> | null
  const rgName = new Map((rgNameRows ?? []).map((g) => [g.rg_id, g.name]))
  const rgByCas = new Map<string, string[]>()
  for (const link of rgLinkRows ?? []) {
    const label = rgName.get(link.rg_id)
    if (!label) continue
    if (!rgByCas.has(link.cas_number)) rgByCas.set(link.cas_number, [])
    rgByCas.get(link.cas_number)!.push(label)
  }
  // ⚠ Сортировка здесь, а не в разметке: порядок строк PostgREST не определён,
  // а от него зависит текст абзаца и, через него, уникальность description.
  for (const [cas, list] of rgByCas) rgByCas.set(cas, [...new Set(list)].sort())

  // Страницы SDS: перекрёстная ссылка «как с этим обращаться» → «что это такое».
  const sdsRows = must(
    'sds_pages (getStaticPaths)',
    await supabase.from('sds_pages').select('slug, cas_number, status')
  ) as Array<{ slug: string; cas_number: string | null; status: string }> | null
  const sdsByCas = new Map(
    (sdsRows ?? [])
      .filter((s) => s.cas_number && s.status === 'live')
      .map((s) => [s.cas_number as string, s.slug])
  )

  // ═══ Транспорт: CAS → номер ООН (session 41) ═══
  //
  // ⚠ Постраничная выкачка обязательна: в `dg_substances` 2 939 строк, в
  // `dot_substances` 3 003, а PostgREST отдаёт максимум 1 000 за раз. Без неё
  // страница получила бы первую тысячу номеров, а остальные молча остались бы
  // без транспортного блока — ровно тот сценарий тихого отказа, который
  // разобран в claude/silent-supabase-failures.md.
  //
  // ⚠ Выкачиваем таблицы целиком и раскладываем в JS, а НЕ шлём `.in()` на 389
  // номеров: фильтр PostgREST уходит в строку запроса URL, и такой список
  // упирается в предел её длины. Тот же довод записан в un/[number].astro.
  async function allRows<T>(what: string, build: (from: number, to: number) => any): Promise<T[]> {
    const out: T[] = []
    for (let from = 0; ; from += PAGE) {
      const chunk = must(`${what} (from=${from})`, await build(from, from + PAGE - 1)) as T[] | null
      if (!chunk?.length) break
      out.push(...chunk)
      if (chunk.length < PAGE) break
    }
    return out
  }

  const [unLinks, unPages, adrRowsAll, dotRowsAll] = await Promise.all([
    allRows<{ cas_number: string; un_number: string; match_type: string }>(
      'substance_un_link (getStaticPaths)',
      (a, b) => supabase.from('substance_un_link')
        .select('cas_number, un_number, match_type').order('un_number').range(a, b)
    ),
    allRows<{ un_number: string }>(
      'un_page_index (getStaticPaths)',
      (a, b) => supabase.from('un_page_index').select('un_number').order('un_number').range(a, b)
    ),
    allRows<{
      un_number: string; proper_shipping_name: string; transport_class: string | null
      classification_code: string | null; packing_group: string | null
      label_codes: string[] | null; adr_status: string | null
    }>(
      'dg_substances (getStaticPaths)',
      // ⚠ Порядок строк ОБЯЗАН совпадать с un/[number].astro: там тот же
      // `order('packing_group', { nullsFirst: true })`. Разойдутся — и вариант,
      // показанный первым на странице вещества, окажется вторым на странице
      // номера, а читатель прочтёт это как разные данные.
      (a, b) => supabase.from('dg_substances')
        .select('un_number, proper_shipping_name, transport_class, classification_code, packing_group, label_codes, adr_status')
        .order('un_number').order('packing_group', { nullsFirst: true }).range(a, b)
    ),
    allRows<{
      un_number: string; row_order: number; id_prefix: string | null
      proper_shipping_name: string; hazard_class: string | null
      packing_group: string | null; label_codes: string[] | null
    }>(
      'dot_substances (getStaticPaths)',
      (a, b) => supabase.from('dot_substances')
        .select('un_number, row_order, id_prefix, proper_shipping_name, hazard_class, packing_group, label_codes')
        .order('un_number').order('row_order').range(a, b)
    ),
  ])

  const unByCas = buildUnEntriesByCas({
    links: unLinks,
    adr: adrRowsAll,
    dot: dotRowsAll,
    pages: new Set(unPages.map((p) => p.un_number)),
  })

  // ⚠⚠ Соседи по алфавиту (session 37). До этого вещества не были связаны между
  // собой ВООБЩЕ: раздел вёл только «вверх» — на коды и на букву указателя.
  // Цепь prev → next проходит все 3 650 страниц насквозь, и это единственная
  // связь «вбок» в разделе.
  //
  // ⚠ Порядок ОБЯЗАН совпадать с browse/[letter].astro: там список сортируется
  // тем же `localeCompare(name, 'en')` по имени ПОСЛЕ substanceTitleName.
  // Разойдутся правила — и «следующее» на странице не совпадёт со следующим в
  // указателе, а читатель прочтёт это как ошибку данных, а не вёрстки.
  //
  // ⚠ Второй ключ сортировки — CAS. Имя вещества уникальным НЕ является
  // (у `2,4,4-trimethyl-1-pentene` два CAS, проверка title-unique нашла 77 таких
  // повторов). Без второго ключа порядок двух одноимённых записей зависел бы от
  // устойчивости сортировки движка, то есть был бы неопределён.
  //
  // ⚠⚠ Цепь идёт по ВСЕМУ справочнику, а не внутри буквы, и на стыках это видно:
  // после `Zoxamide` следующим стоит `α-[3-(1-oxoprop-2-enyl)…`. Это не сбой.
  // Буква указателя считается по ПЕРВОМУ ЗНАКУ (всё, что не a–z, уходит в «0-9»),
  // а порядок — по правилам сравнения строк, где греческие буквы стоят после
  // латиницы. Поэтому корзина «0-9» разложена по цепи двумя кусками: символы и
  // цифры в начале, 13 греческих имён в самом конце. Проверено на всех 3 650:
  // внутри каждой буквы порядок цепи совпадает с порядком указателя знак в знак.
  //
  // ⚠ Лишних запросов в базу здесь нет: весь набор уже в `clean`.
  const ordered = clean
    .map((row) => {
      const name = substanceTitleName(substanceNameFull(row))
      return {
        row,
        name,
        // ⚠ Адрес строит ТОЛЬКО substanceHref/substanceSlug. Прямая склейка
        // `/substances/${name}-${cas}/` не переживёт ни имени со скобкой, ни
        // обрезки до SLUG_NAME_MAX — см. hStatementSlug.ts, там уже наступали.
        href: substanceHref(name, row.cas_number),
      }
    })
    // ⚠ Три ключа, и каждый закрывает свой случай:
    //   1) localeCompare — тот же порядок, что печатает указатель;
    //   2) CAS — имена совпали (77 таких повторов);
    //   3) двоичное сравнение имени — localeCompare вернул 0 на РАЗНЫХ строках
    //      (пунктуация может быть неразличима на первых уровнях сравнения).
    // Без третьего ключа порядок зависел бы от того, как Postgres вернул строки
    // с одинаковым cas_number, а этот порядок не определён и может меняться
    // между сборками — то есть prev/next «плавали» бы без единой правки кода.
    .sort(
      (a, b) =>
        a.name.localeCompare(b.name, 'en') ||
        a.row.cas_number.localeCompare(b.row.cas_number) ||
        (a.name < b.name ? -1 : a.name > b.name ? 1 : 0),
    )

  /** Что знает страница о соседе: этого хватает на карточку и ни байта больше. */
  const card = (it: (typeof ordered)[number]) => ({
    name: it.name,
    cas: it.row.cas_number,
    href: it.href,
    formula: it.row.molecular_formula,
  })

  return ordered.map((it, i) => ({
    params: { slug: substanceSlug(substanceNameFull(it.row), it.row.cas_number) },
    props: {
      row: it.row,
      hText: Object.fromEntries((it.row.h_statement_codes ?? []).map((c) => [c, hText.get(c) ?? ''])),
      // ⚠ В props уезжает только то, что нужно ЭТОЙ странице. Полный справочник
      // 45 фраз и 33 классов, размноженный на 3 650 страниц, — это 30 МБ мусора
      // в промежуточных файлах сборки при нулевой пользе.
      pMeta: Object.fromEntries(
        (it.row.p_statement_codes ?? []).map((c) => [c, pMeta.get(c)]).filter(([, v]) => Boolean(v)),
      ),
      euhText: Object.fromEntries((it.row.euh_codes ?? []).map((c) => [c, euhText.get(c) ?? ''])),
      hazardClasses: buildHazardClasses(it.row.h_statement_codes, mapRows ?? [], catalogRows ?? []),
      rgroups: rgByCas.get(it.row.cas_number) ?? [],
      sdsSlug: sdsByCas.get(it.row.cas_number) ?? null,
      // ⚠ Пустой массив у 3 222 страниц из 3 650 — это НЕ ошибка. Мост
      // `substance_un_link` покрывает 428 веществ: остальные под собственным
      // номером ООН не едут (их возят как компонент смеси или они вообще не
      // опасный груз). Секция на такой странице просто не рисуется.
      unEntries: unByCas.get(it.row.cas_number) ?? [],
      // ⚠ Только имена СВОЕЙ записи: карта на 3 650 номеров, размноженная на
      // 3 650 страниц, — это те самые «30 МБ мусора», о которых сказано выше.
      officialNames: (it.row.index_number && namesByIndex.get(it.row.index_number)) || [],
      prev: i > 0 ? card(ordered[i - 1]) : null,
      next: i < ordered.length - 1 ? card(ordered[i + 1]) : null,
    },
  }))
}

type Props = {
  row: {
    cas_number: string
    ec_number: string | null
    index_number: string | null
    common_name: string | null
    display_name_short: string | null
    iupac_name: string
    synonyms: string[] | null
    molecular_formula: string | null
    molecular_weight: number | null
    signal_word: string | null
    h_statement_codes: string[] | null
    p_statement_codes: string[] | null
    euh_codes: string[] | null
    ghs_pictogram_codes: string[] | null
  }
  hText: Record<string, string>
  pMeta: Record<string, { text: string; category: string } | undefined>
  euhText: Record<string, string>
  hazardClasses: HazardClassEntry[]
  /** Реактивные группы CAMEO из базы — см. комментарий в getStaticPaths. */
  rgroups: string[]
  sdsSlug: string | null
  /** Номера ООН этого вещества со строками ADR и 49 CFR — lib/substanceTransport.ts. */
  unEntries: UnEntry[]
  /**
   * Имя записи Annex VI Part 3 по языковым редакциям регламента.
   * ⚠ Пустой массив означает «строк переводов у этой записи нет» — тогда секции
   * нет вовсе. Замер 2026-08-09: пусто у 0 из 3 650 построенных страниц.
   */
  officialNames: OfficialName[]
  prev: Neighbour | null
  next: Neighbour | null
}

/** Сосед по алфавиту. Считается в getStaticPaths — см. комментарий там. */
type Neighbour = { name: string; cas: string; href: string; formula: string | null }

const { row, hText, pMeta, euhText, hazardClasses, rgroups, sdsSlug, unEntries, officialNames, prev, next } =
  Astro.props as Props

// ⚠ Имя для показа: заглавная первая буква там, где это типографика, а не правка
// номенклатуры. Разбор и список исключений — в substanceName.ts. На адрес не влияет:
// substanceSlug опускает регистр, поэтому слаги остаются прежними.
const name = substanceTitleName(substanceNameFull(row))
const cas = row.cas_number
// ⚠⚠ EC ЧЕРЕЗ ПРОВЕРКУ ФОРМЫ. У 37 собранных страниц в колонке вместо номера
// стоит прочерк («-»), и панель печатала «EC number: -», а schema.org отдавала
// этот прочерк Google как PropertyValue. Склеек тут не бывает: записи со
// склеенным EC имеют и склеенный CAS, а такие страницы не строятся вовсе.
const ecShown = ecForDisplay(row.ec_number)
const formula = row.molecular_formula
// ⚠⚠ Имя в заголовке обрезается, потому что у 707 некурированных записей оно
// длиной с абзац («lithium sodium 4-[4-[4-(nitrilotris…»). H2 на всю ширину
// экрана — не заголовок. Длины подобраны так, чтобы ключевой хвост
// («hazard statements») оставался виден на телефоне.
const nm = truncateName(name, 30)
const nmShort = truncateName(name, 26)
const lcss = (lcssValues as Record<string, LcssRecord>)[cas]
const texts = (lcssText as Record<string, TextRecord>)[cas]
const propertyRows = buildPropertyRows(lcss)
// ⚠ Абзацы, не поместившиеся в таблицу значений, не выбрасываются, а показываются
// ниже под темой. Подпись «Lower explosive limit» над рассказом о взрыве — неправда,
// но и молчание про взрыв человек прочтёт как «не взрывается». Разбор: lcssProperties.ts.
const sourceNotes = buildSourceNotes(lcss)
// ⚠ Буква указателя. Правило обязано совпадать с
// src/pages/substances/browse/[letter].astro, иначе крошка поведёт в 404.
const firstChar = name.trim().charAt(0).toLowerCase()
const letterBucket = firstChar >= 'a' && firstChar <= 'z' ? firstChar : '0-9'
const letterLabel = letterBucket === '0-9' ? '0–9' : letterBucket.toUpperCase()
const noteTopics = [...new Set(sourceNotes.map((n) => n.topic))]
// ⚠ Раздел «Fire Potential» из LCSS — это тоже про пожар, поэтому его наличие
// переключает заголовок секции так же, как тема заметок. Без этой строки
// вещество, у которого есть только firepot, получало бы заголовок «Further
// notes on …» над абзацем о том, при какой температуре оно горит.
const notesAreFire = noteTopics.includes('Fire and explosion') || Boolean(texts?.firepot)
const intro = buildIntro({ name, formula, weight: row.molecular_weight, signal: row.signal_word, texts, lcss })

// ⚠ 231 строка iupac_name содержит CRLF, а сама колонка Annex VI — перечень
// синонимов через точку с запятой. Разбираем на список, не показываем строкой.
const clean = (s: string) => s.replace(/\r?\n+/g, '; ').replace(/\s+/g, ' ').trim()
const synonymList = [
  ...new Set(
    [...(row.synonyms ?? []), ...clean(row.iupac_name).split(';')]
      .map((s) => s.trim())
      .filter((s) => s && s.toLowerCase() !== name.toLowerCase())
  ),
].slice(0, 40)

// ═══ Блок «имя записи в языковых редакциях Annex VI» (session 56) ═══
//
// ⚠⚠ ЭТО НЕ ПЕРЕВОД, И ТАК И НАПИСАНО НА ЭКРАНЕ. Annex VI Part 3 издан на всех
// официальных языках, и колонка идентификации написана в каждом издании своими
// словами; мы её оттуда достаём. Замер 2026-08-09 по 3 650 построенным
// страницам: одинаковое имя во всех редакциях лишь у 9 (0,2 %), в среднем
// различных написаний 19,7 из 23 — блок по построению не шаблонный.
//
// ⚠ Ирландского в таблице нет ни одной строки, и это не наш пропуск: сводного
// текста CLP на ирландском не издавалось вовсе, цитировать нечего. Сказано под
// таблицей словами — список из 23 там, где официальных языков 24, иначе
// читается как недоделка.
// ⚠ Список недостающих редакций строится ВЫЧИТАНИЕМ из официальных языков, а не
// переписыванием: новый язык ЕС попадёт сюда сам, и забыть его будет негде.
const namesLangs = new Set(officialNames.map((n) => n.code))
const namesMissing = EU_LANGUAGES.filter(
  (l) => l.code !== ANNEX_VI_LANGUAGE_ABSENT && !namesLangs.has(l.code),
)
// ⚠ Обязательное примечание в квадратных скобках — часть имени (Annex VI Part 1
// п. 1.1.1.4), а не наш комментарий. Оговорка печатается только когда оно есть.
const namesHavePrintedSuffix = officialNames.some((n) => n.printedSuffix)
const namesHaveVerbatim = officialNames.some((n) => n.verbatim)
// ⚠⚠ Ошибки САМОГО регламента в отдельных языковых редакциях: ячейка несёт имя
// другой записи либо примечание парной записи. Сверено с первоисточником —
// правится НЕ данными, а пометкой рядом со строкой (`annex6Errata.ts`).
const namesErrata = new Map(
  officialNames
    .map((n) => [n.code, erratumFor(row.index_number ?? '', n.code)] as const)
    .filter(([, e]) => e),
)
const namesHaveErrata = namesErrata.size > 0
/**
 * Языковая метка разметки для кода редакции.
 * ⚠ Все 24 кода регламента — двухбуквенные ISO 639-1, они же законные подтеги
 * BCP 47, поэтому перевод в нижний регистр здесь и есть всё преобразование.
 */
const htmlLang = (code: string) => code.toLowerCase()

const pictograms = (row.ghs_pictogram_codes ?? []).filter((c) => PICTOGRAM_NAME[c])
const hList = (row.h_statement_codes ?? []).map((code) => ({ code, text: hText[code] ?? '' }))
// ⚠⚠ Ошибка регламента в строке этой записи: напечатанный код H-фразы не
// соответствует напечатанному классу (6 записей, все — базовый текст 2008 г.).
// Пометка стоит ПОД таблицей H-фраз, потому что именно её содержимое расходится
// с напечатанным. Данные не правятся: `annex6RowErrata.ts`, шапка.
const rowErratum = rowErratumFor(row.index_number)
const euhList = (row.euh_codes ?? []).map((code) => ({ code, text: euhText[code] ?? '' }))
// ⚠ Группы P-фраз — см. lib/pStatements.ts: раздел берётся ИЗ БАЗЫ, а не из
// первой цифры кода.
const pGroups = groupPStatements(row.p_statement_codes, pMeta)
const pCount = countPStatements(pGroups)
const pFlat = pGroups.flatMap((g) => g.items)
const storageCodes = pGroups.find((g) => g.key === 'storage')?.items.map((i) => i.code) ?? []

// ⚠⚠ Разделы LCSS, доехавшие до страницы только в session 38. До этого из
// 25 разделов выгрузки в JSON лежали 14 — не потому, что остальные запрещены,
// а потому, что сборка данных нигде не была записана и никем не проверялась.
// Правило отбора и чёрный список строк — scripts/build-lcss-text.mjs.
const carc = texts?.carc
const oel = texts?.oel
const oelRows = [
  ...(oel?.pel ?? []).map((r) => ({ kind: 'PEL', full: 'Permissible exposure limit', ...r })),
  ...(oel?.rel ?? []).map((r) => ({ kind: 'REL', full: 'Recommended exposure limit', ...r })),
  ...(oel?.idlh ?? []).map((r) => ({ kind: 'IDLH', full: 'Immediately dangerous to life or health', ...r })),
]
const hasHealth = Boolean(texts?.hazsum || carc || oelRows.length)

// ⚠ FAQ собирается ИЗ СВОИХ данных и ничего не выдумывает; правило «отсутствие
// кода — не доказательство безопасности» разобрано в шапке substanceFaq.ts.
const faq = buildFaq({
  name: nm,
  cas,
  ec: ecShown || null,
  formula,
  weight: row.molecular_weight,
  signalWord: row.signal_word,
  hCodes: row.h_statement_codes ?? [],
  hText,
  pictogramNames: pictograms.map((c) => PICTOGRAM_NAME[c]),
  propertyRows,
  storageText: texts?.storage,
  storageCodes,
  iarc: carc?.iarc,
  pel: oel?.pel?.[0],
})

/**
 * ⚠⚠ Title собирается под бюджет в 62 знака ЦЕЛИКОМ, поэтому у страницы вещества
 * нет хвоста «| GHS Pictograms» (titleIsComplete={true}). Бренд съедал 18 знаков
 * из 65, и все 3 650 заголовков вылезали за обрезку Google.
 *
 * ⚠ CAS в заголовке — не украшение, а решение двух задач сразу:
 *   1) уникальность. Имя вещества уникальным НЕ является: у `2,4,4-trimethyl-1-pentene`
 *      два CAS (107-39-1 и 25167-70-8), у `Distillates (coal tar), naphthalene oils…`
 *      шесть. Проверка title-unique нашла 77 таких повторов. CAS уникален (проверено).
 *   2) запрос. Семейство `cas number` — 26 940 объёма.
 *
 * Формулу оставляем: «acetone formula» + «acetone chemical formula» = 14 700.
 */
const TITLE_BUDGET = 62
const titleTail = ` — Properties, CAS ${cas}`
const titleRoom = TITLE_BUDGET - titleTail.length - (formula ? formula.length + 3 : 0)
const shortName = truncateName(name, Math.max(titleRoom, 18))
const titleCore = formula ? `${shortName} (${formula})` : shortName
const title = `${titleCore}${titleTail}`
/**
 * ⚠⚠ CAS в конце description — по той же причине, что и в title: имя вещества
 * уникальным не является. У фосфора два CAS (7723-14-0 и 12185-10-3), и описание
 * выходило слово в слово одинаковым. Проверка description-unique их и поймала.
 *
 * ⚠ Второй случай, который это лечит: имя без пробелов длиной под сотню знаков
 * («lithium sodium 4-[4-[4-(nitrilotris…»). Обрезка по последнему пробелу давала
 * description «Lithium sodium...» — три слова на всю страницу. Хвост с CAS и
 * сигнальным словом возвращает туда хоть какой-то смысл.
 */
const descTail = row.signal_word
  ? ` CAS ${cas}. Signal word ${row.signal_word}.`
  : ` CAS ${cas}.`
const description = truncateMetaDescription(intro.metaSentence, 155 - descTail.length) + descTail
const canonical = `${SITE}${substanceHref(name, cas)}`

/**
 * ⚠⚠ Сериализация JSON-LD с экранированием «<».
 * В данных встречается угловая скобка: формулировка H350 хранится как
 * «May cause cancer <state route of exposure…>», и она попадает в ответы FAQ.
 * Голый `<` внутри <script> закрывает блок раньше времени на строке `</script>`
 * и роняет разметку молча — проверка jsonld-valid увидит обрывок, но только
 * если ей повезёт с местом разрыва. `<` — законное JSON-экранирование,
 * разбирается обратно в «<» без потерь.
 */
const ld = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c')

/**
 * Официальные имена с языковой меткой — для `alternateName`.
 * ⚠ Берётся ОДНО, основное обозначение каждой редакции: прочие обозначения той
 * же ячейки — синонимы внутри языка, и вываливать все 23 × N в разметку значит
 * подменить идентификацию перечислением.
 * ⚠ Совпавшее с заголовком страницы не дублируется: `name` уже стоит выше.
 */
const officialAlternateNames = officialNames
  .filter((n) => !n.verbatim && n.designations.length)
  .map((n) => ({ '@value': n.designations[0], '@language': htmlLang(n.code) }))
  .filter((v) => v['@value'].toLowerCase() !== name.toLowerCase())

const chemicalJson = ld({
  '@context': 'https://schema.org',
  '@type': 'ChemicalSubstance',
  name,
  ...(formula ? { molecularFormula: formula } : {}),
  ...(row.molecular_weight ? { molecularWeight: `${row.molecular_weight} g/mol` } : {}),
  /**
   * ⚠⚠ ДВА РАЗНЫХ СОРТА ИМЁН В ОДНОМ ПОЛЕ, И РАЗЛИЧАЕТ ИХ ЯЗЫКОВАЯ МЕТКА.
   * Синонимы PubChem — торговые и бытовые имена без установленной редакции, у
   * них языка нет и приписывать его нельзя. Имена Annex VI, наоборот, изданы на
   * конкретном языке, и подать их голой строкой значило бы утверждать, что
   * «Aceton» — английское написание. JSON-LD различает это ровно одним
   * способом — объектом `{ @value, @language }`.
   * ⚠ Дословные ячейки (групповые и ненадёжные записи) сюда не идут: имя записи
   * это не одно имя вещества, а разметка обязана обещать только то, что видно.
   */
  ...(synonymList.length || officialAlternateNames.length
    ? { alternateName: [...synonymList.slice(0, 10), ...officialAlternateNames] }
    : {}),
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'CAS', value: cas },
    ...(ecShown ? [{ '@type': 'PropertyValue', propertyID: 'EC', value: ecShown }] : []),
  ],
  description: intro.metaSentence,
  url: canonical,
})

const breadcrumbJson = ld({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Substances', item: `${SITE}/substances/` },
    { '@type': 'ListItem', position: 3, name, item: canonical },
  ],
})

/**
 * ⚠ Разметка FAQPage строится ИЗ ТОГО ЖЕ массива, что и видимый блок. Разметка,
 * обещающая поиску ответ, которого на странице нет, — это ровно то, за что
 * Google снимает расширенный сниппет. Один источник на два места.
 */
const faqJson = faq.length
  ? ld({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })
  : null

// Нумерация секций считается заранее, а не побочным эффектом разметки.
let sn = 0
const pad = () => String(++sn).padStart(2, '0')
const nIdentification = pad()
const nIdentifiers = pad()
const nClassification = hList.length || pictograms.length || hazardClasses.length ? pad() : null
const nPrecautions = pCount ? pad() : null
// ⚠ Условие ровно одно и то же в трёх местах: здесь, в массиве `toc` и у самой
// <section id="names">. Разойдутся — либо дырка в нумерации, либо пункт
// оглавления в никуда; и то и другое ловит проверка subs-toc.
const nNames = officialNames.length ? pad() : null
const nLabel = pictograms.length || row.signal_word || hList.length ? pad() : null
const nHealth = hasHealth ? pad() : null
const nProperties = propertyRows.length ? pad() : null
const nNotes = sourceNotes.length || texts?.firepot ? pad() : null
const nHandling =
  texts?.storage || texts?.incompat || texts?.reactivity || texts?.safestore ||
  texts?.peroxide || rgroups.length
    ? pad()
    : null
// ⚠ Номер выдаётся ровно тогда, когда секция рисуется. Условие здесь и условие
// у <section id="transport"> — одно и то же выражение `unEntries.length`;
// разойдутся они — и в нумерации появится дырка (02 · … 04 · …).
const nTransport = unEntries.length ? pad() : null
const nFaq = faq.length ? pad() : null

/**
 * ⚠⚠ ОГЛАВЛЕНИЕ СТРАНИЦЫ (session 41, просьба Сергея). Страница вещества — до
 * тринадцати секций, и на телефоне докрутить до «storage and handling» это
 * восемь-девять экранов.
 *
 * ⚠ Список собирается ИЗ ТЕХ ЖЕ выражений, что и сами секции, а не из отдельного
 * массива «как надо». Пункт оглавления, ведущий на якорь, которого на странице
 * нет, — это ссылка в никуда: браузер молча остаётся на месте, и читатель
 * решает, что сломана страница. Проверка subs-toc-anchors в check:dist держит
 * равенство «пункт ↔ секция» в обе стороны.
 *
 * ⚠ Подписи короткие и БЕЗ имени вещества. Правило «имя в каждом заголовке»
 * (session 38) касается H2/H3 — это текст, который читает поиск. Здесь же
 * горизонтальная полоска на ширину экрана: «Acetone hazard classification»
 * в ней не поместится, а тринадцать таких подписей превратят навигацию в
 * простыню. У поиска эти ссылки и так не отдельные заголовки.
 */
const toc: Array<{ id: string; label: string }> = [
  { id: 'overview', label: 'Overview' },
  { id: 'identifiers', label: 'Identifiers' },
  ...(nClassification ? [{ id: 'hazards', label: 'Hazards' }] : []),
  { id: 'sds', label: 'SDS' },
  ...(nPrecautions ? [{ id: 'precautions', label: 'Precautions' }] : []),
  ...(nNames ? [{ id: 'names', label: 'Names' }] : []),
  ...(nLabel ? [{ id: 'label', label: 'Label' }] : []),
  ...(nHealth ? [{ id: 'health', label: 'Health' }] : []),
  ...(nProperties ? [{ id: 'properties', label: 'Properties' }] : []),
  ...(nNotes ? [{ id: 'fire-notes', label: notesAreFire ? 'Fire' : 'Notes' }] : []),
  ...(nHandling ? [{ id: 'handling', label: 'Storage' }] : []),
  ...(nTransport ? [{ id: 'transport', label: 'Transport' }] : []),
  ...(nFaq ? [{ id: 'faq', label: 'FAQ' }] : []),
  { id: 'nearby', label: 'Nearby' },
]

/**
 * Коды знаков строкой — печатаются рядом с картинками и остаются на странице,
 * даже когда картинки для кода у нас нет.
 * ⚠ Это не подпись к картинке, а само значение колонки: у 49 CFR встречается
 * «Empty» (ярлык §172.450, файла у нас пока нет) и «None» (ярлык не требуется).
 * Молчание вместо кода читалось бы как «знак не нужен» в обоих случаях.
 */
const codeList = (codes: string[] | null): string => (codes ?? []).join(', ') || '—'

/** Больше одного номера — читателю надо объяснить, почему. См. MULTI_UN_NOTE. */
const multiUn = unEntries.length > 1
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete={true}>
  <script type="application/ld+json" slot="head" set:html={chemicalJson} />
  <script type="application/ld+json" slot="head" set:html={breadcrumbJson} />
  {faqJson && <script type="application/ld+json" slot="head" set:html={faqJson} />}

  <section class="hub-hero">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/substances/">Substances</a><span class="sep">/</span>
        <a href={`/substances/browse/${letterBucket}/`}>{letterLabel}</a><span class="sep">/</span>
        <span>{truncateName(name, 40)}</span>
      </nav>
      <p class="hub-hero-eyebrow">Substance profile</p>
      <h1>{name}</h1>
      <p class="hub-hero-sub">{intro.lead}</p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">CAS {cas}</span>
        {formula && <span class="hub-hero-chip">{formula}</span>}
        {row.molecular_weight && <span class="hub-hero-chip">{row.molecular_weight} g/mol</span>}
        {row.signal_word && <span class="hub-hero-chip">{row.signal_word}</span>}
      </div>
      {sdsSlug && (
        <p class="sub-hero-cta-row">
          <a class="hub-hero-cta" href={`/sds/${sdsSlug}/`}>{truncateName(name, 30)} Safety Data Sheet →</a>
        </p>
      )}
    </div>
  </section>

  {/*
    ⚠⚠ ОГЛАВЛЕНИЕ. Массив `toc` собран в шапке из тех же условий, что и секции.
    ⚠ Это <nav> со списком, а не строка ссылок: скринридер обязан уметь выйти
    из него одной командой, иначе на странице с тринадцатью пунктами он читает
    их перед КАЖДЫМ переходом.
    ⚠ Полоска липкая и стоит под шапкой сайта (она сама sticky, высота 64 px,
    z-index 50). Наши значения — top: 64px и z-index: 40, они в hub.css рядом
    с правилом .sub-toc; менять одно без другого нельзя.
    ⚠ JavaScript тут не нужен вообще: переход по якорю делает браузер, плавность
    даёт scroll-behavior, а отступ под шапку — scroll-margin-top у секций.
  */}
  <nav class="sub-toc" aria-label="Sections of this page">
    <div class="hub-wrap sub-toc-wrap">
      <span class="sub-toc-label" aria-hidden="true">On this page</span>
      <ul class="sub-toc-list">
        {toc.map((t) => (
          <li><a href={`#${t.id}`}>{t.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="hub-sec-a" id="overview">
    <div class="hub-wrap">
      <p class="hub-eyebrow">{nIdentification} · Identification</p>
      <h2 class="hub-h2">What {nm} is</h2>
      <div class="hub-prose" set:html={intro.paragraphs} />
    </div>
  </section>

  {/*
    ⚠⚠ Идентификаторы вынесены в СВОЮ секцию (session 38). Раньше CAS, EC,
    формула и масса лежали одной панелью внутри вводной секции, под общим H2
    «What acetone is». Заголовка со словами «molecular weight» на странице не
    было ни одного — при том что связка «вещество + molecular weight» это
    4 570 объёма, а «вещество + formula» — 20 730.
    ⚠ Якорь #formula сохранён: на него уже ссылаются со страниц SDS.
  */}
  <section class="hub-sec-white" id="identifiers">
    <div class="hub-wrap">
      <p class="hub-eyebrow">{nIdentifiers} · Identifiers</p>
      <h2 class="hub-h2">{nm} identifiers and molecular data</h2>

      <h3 class="sub-h3" id="cas-number">{nm} CAS number and EC number</h3>
      <div class="hub-panel">
        <div class="hub-panel-row">
          <span class="hub-panel-label">CAS number</span><span>{cas}</span>
        </div>
        {ecShown && (
          <div class="hub-panel-row">
            <span class="hub-panel-label">EC number</span><span>{ecShown}</span>
          </div>
        )}
        {row.index_number && (
          <div class="hub-panel-row">
            <span class="hub-panel-label">Index number (CLP Annex VI)</span><span>{row.index_number}</span>
          </div>
        )}
      </div>

      {(formula || row.molecular_weight || texts?.classes) && (
        <>
          <h3 class="sub-h3" id="formula">{nm} molecular formula and molecular weight</h3>
          <div class="hub-panel">
            {formula && (
              <div class="hub-panel-row">
                <span class="hub-panel-label">Molecular formula</span><span>{formula}</span>
              </div>
            )}
            {row.molecular_weight && (
              <div class="hub-panel-row">
                <span class="hub-panel-label">Molecular weight</span><span>{row.molecular_weight} g/mol</span>
              </div>
            )}
            {texts?.classes && (
              <div class="hub-panel-row">
                <span class="hub-panel-label">Chemical class</span>
                <span>{texts.classes.t}</span>
              </div>
            )}
          </div>
        </>
      )}

      {synonymList.length > 0 && (
        <div class="sub-synonyms" id="synonyms">
          <h3 class="sub-h3">Other names for {nm}</h3>
          <ul class="sub-syn-list">
            {synonymList.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  {nClassification && (
    <section class="hub-sec-a" id="hazards">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nClassification} · GHS classification</p>
        <h2 class="hub-h2">{nm} hazard classification</h2>
        <p class="hub-sub">
          Harmonised classification under CLP Annex VI. This is the legally binding
          classification in the EU; other jurisdictions may differ.
        </p>

        {(pictograms.length > 0 || row.signal_word) && (
          <>
            <h3 class="sub-h3" id="pictograms">{nm} pictograms and signal word</h3>
            {pictograms.length > 0 && (
              <div class="sub-picts">
                {pictograms.map((code) => (
                  <a class="sub-pict" href={`/ghs/${code.toLowerCase()}/`}>
                    <img src={`/pictograms/${code.toLowerCase()}.svg`} width="88" height="88"
                         alt={`${code} ${PICTOGRAM_NAME[code]} pictogram`} loading="lazy" />
                    <span>{PICTOGRAM_NAME[code]}</span>
                  </a>
                ))}
              </div>
            )}
            {row.signal_word && (
              <div class="hub-panel">
                <div class="hub-panel-row">
                  <span class="hub-panel-label">Signal word</span><span>{row.signal_word}</span>
                </div>
              </div>
            )}
          </>
        )}

        {/*
          ⚠⚠ Класс и категория ВЫВЕДЕНЫ из H-кода, а не выписаны из Annex VI:
          таблица hazard_classifications в базе пуста. Ограничения вывода и
          правило показа неоднозначности — в шапке lib/hazardClasses.ts.
          ⚠ Сигнальное слово в этой таблице НЕ печатается: у H221 категория 1B
          даёт Danger, категория 2 — Warning. Настоящее слово вещества стоит
          выше, в панели, и приходит из своей колонки.
        */}
        {hazardClasses.length > 0 && (
          <>
            <h3 class="sub-h3" id="hazard-class">{nm} hazard class and category</h3>
            <div class="hub-table-wrap">
              <table class="hub-table sub-class">
                <caption class="hub-fine">GHS hazard classes {nmShort} falls into</caption>
                <thead>
                  <tr>
                    <th scope="col">Hazard class</th>
                    <th scope="col">Category</th>
                    <th scope="col">From code</th>
                    <th scope="col">Pictogram</th>
                  </tr>
                </thead>
                <tbody>
                  {hazardClasses.map((hc) => (
                    <tr>
                      <th scope="row" class="c-prop">
                        {hc.className}
                        {hc.ghsChapter && <span class="sub-class-ch">GHS chapter {hc.ghsChapter}</span>}
                      </th>
                      <td class="c-txt">{categoryLabel(hc)}</td>
                      <td class="c-code"><a href={hHref(hc.hCode)}>{hc.hCode}</a></td>
                      <td class="c-code">
                        {hc.pictogram ? (
                          <a href={`/ghs/${hc.pictogram.toLowerCase()}/`}>{hc.pictogram}</a>
                        ) : (
                          '—'
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {hasAmbiguity(hazardClasses) && (
              <p class="hub-fine">
                Where two values are shown with “or”, the hazard statement is shared by more
                than one category or by more than one class, and the code alone does not say
                which. H272, for example, belongs to oxidising liquids and to oxidising solids —
                the physical state decides. The binding answer for a specific entry is in the
                CLP Annex VI table itself.
              </p>
            )}
          </>
        )}

        {hList.length > 0 && (
          <>
            <h3 class="sub-h3" id="hazard-statements">{nm} hazard statements (H-codes)</h3>
            <div class="hub-table-wrap">
              <table class="hub-table">
                <caption class="hub-fine">Hazard statements assigned to {nmShort}</caption>
                <thead><tr><th scope="col">Code</th><th scope="col">Hazard statement</th></tr></thead>
                <tbody>
                  {hList.map((h) => (
                    <tr>
                      <td class="c-code"><a href={hHref(h.code)}>{h.code}</a></td>
                      <td class="c-txt">{h.text}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {rowErratum && (
              <>
                {/* ⚠ Порядок: что напечатано → почему показано иное → где проверить.
                    Ссылка на полосу ОЖ обязательна: мы утверждаем, что официальный
                    текст противоречит сам себе, и обязаны показать место. */}
                <p class="hub-note warn row-erratum" lang="en">
                  <strong>{ROW_ERRATUM_LEAD[rowErratum.kind]}</strong>{' '}
                  {rowErratum.note}
                  <span class="src">{rowErratumCitation(rowErratum)}</span>
                </p>
                <p class="hub-fine">{ROW_ERRATA_TABLE_NOTE}</p>
              </>
            )}
          </>
        )}

        {/*
          ⚠⚠ EUH-фразы с ТЕКСТОМ (session 38). До этого печаталась строка
          «Supplemental EU statements: EUH014, EUH066» — коды без слов и без
          ссылок, хотя страницы у них есть и лежат там же, где H-фразы.
          ⚠ Их девять на весь справочник, встречаются у 130 веществ.
        */}
        {euhList.length > 0 && (
          <>
            <h3 class="sub-h3" id="euh-statements">{nm} supplemental EU statements (EUH)</h3>
            <div class="hub-table-wrap">
              <table class="hub-table">
                <caption class="hub-fine">
                  EU-specific statements assigned to {nmShort}. They exist only in CLP and have
                  no counterpart in UN GHS.
                </caption>
                <thead><tr><th scope="col">Code</th><th scope="col">Statement</th></tr></thead>
                <tbody>
                  {euhList.map((e) => (
                    <tr>
                      <td class="c-code"><a href={hHref(e.code)}>{e.code}</a></td>
                      <td class="c-txt">{e.text}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}

        {/*
          ⚠ Ссылки на хабы, а не только на отдельные коды (session 37). До этого
          в хаб H-фраз, P-фраз и пиктограмм со страницы вещества можно было попасть
          ТОЛЬКО через подвал: в теле были ссылки на конкретные коды и ни одной —
          на их справочник.
          ⚠ Числа кодов здесь намеренно не печатаются: захардкоженное «108 фраз»
          устаревает молча при первой же правке данных.
        */}
        <p class="hub-note">
          This page lists only the codes assigned to {nmShort}. The full
          reference lives on the <a href="/h-statements/">hazard statements hub</a>, the{' '}
          <a href="/p-statements/">precautionary statements hub</a> and the{' '}
          <a href="/pictograms/">GHS pictograms hub</a>.
        </p>
      </div>
    </section>
  )}

  {/*
    ⚠⚠⚠ ПАРТНЁРСКАЯ КАРТОЧКА — НА КАЖДОЙ СТРАНИЦЕ И ВЫСОКО (решение Сергея,
    session 38). Это ОТМЕНА правила session 37, а не его дополнение: тогда
    карточка стояла только там, где своей SDS у нас нет, и низом страницы.
    Прежний довод — «карточка спорит с собственной страницей SDS за тот же
    клик» — снят: на 73 страницах со своей SDS кнопка в герое ведёт на наш
    разбор опубликованных данных, а карточка отвечает на другой вопрос —
    где взять лист на КОНКРЕТНЫЙ продукт конкретного поставщика. Поэтому у
    неё и текст другой, а не тот же самый (см. ниже).

    ⚠⚠ Место выбрано Сергеем: сразу после классификации, до P-фраз и этикетки.
    Читатель к этому моменту уже увидел, чем вещество опасно, — и это ровно та
    точка, где возникает вопрос «а лист безопасности где».

    ⚠ Абзац перед карточкой — не подводка к рекламе, а ответ на вопрос, с которым
    человек сюда пришёл. SDS выпускается на ПРОДУКТ, а не на вещество, поэтому
    «SDS ацетона» как единого документа не существует в принципе.

    ⚠ Секция намеренно НЕ пронумерована: 01–10 несут данные, здесь данных нет.
