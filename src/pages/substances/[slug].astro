  */}
  {nPrecautions && (
    <section class="hub-sec-white" id="precautions">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nPrecautions} · Precautionary statements</p>
        <h2 class="hub-h2">{nm} precautionary statements</h2>
        <p class="hub-sub">
          CLP Annex VI assigns {pCount} precautionary {pCount === 1 ? 'statement' : 'statements'} to{' '}
          {nmShort}. They are grouped the way a label groups them: what to do before handling,
          what to do when something has already happened, how to store it and how to dispose of it.
        </p>

        {pGroups.map((group) => (
          <div class="sub-pgroup">
            <h3 class="sub-h3">{group.label}</h3>
            {group.blurb && <p class="hub-fine">{group.blurb}</p>}
            <div class="sub-pcards">
              {group.items.map((item) => (
                <a class="sub-pcard" href={`/p-statements/${item.code}/`}>
                  <span class="sub-pcard-code">{item.code}</span>
                  <span class="sub-pcard-text">
                    {splitClpNotation(item.text, 'p').map((piece) =>
                      piece.kind === 'blank' ? (
                        <span class="clp-blank" title="Blank filled in by the supplier">{piece.value}</span>
                      ) : piece.kind === 'opt' ? (
                        <span class="clp-opt" title="Optional part">{piece.value}</span>
