            </h3>
            <div class="hub-table-wrap">
              <table class="hub-table sub-props">
                <thead>
                  <tr>
                    <th scope="col">Property</th>
                    <th scope="col">Value</th>
                    <th scope="col">Conditions</th>
                    <th scope="col">Source</th>
