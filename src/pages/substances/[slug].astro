                </thead>
                <tbody>
                  {prop.values.map((val, i) => (
                    <tr class={i === 0 ? 'sub-prop-first' : 'sub-prop-more'}>
                      <th scope="row" class="c-prop">{i === 0 ? prop.label : ''}</th>
                      <td class={val.isText ? 'c-val c-val-text' : 'c-val'}>{val.display}</td>
                      <td class="c-txt">{val.condition ?? ''}</td>
                      <td class="c-code">{val.source}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}

        <p class="hub-fine">
          Values compiled from PubChem Laboratory Chemical Safety Summary. Temperatures
          converted to Fahrenheit for reference.
        </p>
      </div>
    </section>
  )}

  {nNotes && (
    <section class="hub-sec-a" id="fire-notes">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nNotes} · {notesAreFire ? 'Fire and explosion' : 'Source notes'}</p>
        <h2 class="hub-h2">
          {notesAreFire
            ? `${nmShort} fire and explosion behaviour`
            : `Further notes on ${nm}`}
        </h2>
        <p class="hub-sub">
          These are descriptions rather than measured values, so they are kept out of
          the table above and quoted here with the source that reported them.
        </p>
        {texts?.firepot && (
          <div class="sub-notes">
            <h3 class="sub-h3">{nm} fire potential</h3>
            <div class="sub-quote">
              <p>{texts.firepot.t}</p>
              <p class="hub-fine">Source: {texts.firepot.s}</p>
            </div>
          </div>
        )}
        {noteTopics.map((topic) => (
          <div class="sub-notes">
            <h3 class="sub-h3">{topic}</h3>
            {sourceNotes.filter((n) => n.topic === topic).map((n) => (
              <div class="sub-quote">
                <p>{n.text}</p>
                <p class="hub-fine">Source: {n.source}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  {nHandling && (
    <section class="hub-sec-white" id="handling">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nHandling} · Handling and storage</p>
        <h2 class="hub-h2">{nm} storage and handling</h2>

        {/*
          ⚠⚠ Реактивная группа — ключ к матрице совместимости: именно по ней
          считается, с чем вещество нельзя ставить рядом. Данные из базы, не из
          выгрузки LCSS — почему именно так, разобрано в getStaticPaths.
          ⚠ Подпись обязана сказать, что это НЕ класс опасности GHS: у ярлыка
          CAMEO нет ни кода, ни категории, ни юрисдикции, и рядом с таблицей
          Annex VI он иначе читается как ещё одна строка классификации.
          ⛔ Пометок реактивности CAMEO («Polymerizable», «Water-Reactive») тут
          нет: в выгрузке они собраны объединением по CAS и несут свойства
          растворов и смесей, а курируемого источника под них в базе нет.
        */}
        {rgroups.length > 0 && (
          <>
            <h3 class="sub-h3" id="reactive-group">{nm} reactive group</h3>
            <p>
              CAMEO Chemicals places {nmShort} in{' '}
              {rgroups.length === 1 ? 'the reactive group' : 'the reactive groups'}{' '}
              <b>{rgroups.join(', ')}</b>. Compatibility with other chemicals is worked out
              from the group, not from the individual substance — which is why two substances
              you have never seen react can still be flagged as a pair that must be separated.
            </p>
            <p class="hub-fine">
              A reactive group is a CAMEO Chemicals (US NOAA) grouping, not a GHS hazard class:
              it has no code, no category and no legal force. It is what the storage
              compatibility matrix on this site computes from.
            </p>
          </>
        )}

        {texts?.peroxide && (
          <div class="sub-quote sub-quote-warn">
            <h3 class="sub-h3">{nm} peroxide formation</h3>
            <p>{texts.peroxide.t}</p>
            <p class="hub-fine">Source: {texts.peroxide.s}</p>
          </div>
        )}

        {texts?.safestore && (
          <div class="sub-quote">
            <h3 class="sub-h3">{nm} safe storage</h3>
            <p>{texts.safestore.t}</p>
            <p class="hub-fine">Source: {texts.safestore.s}</p>
          </div>
        )}

        {texts?.storage && (
          <div class="sub-quote">
            <h3 class="sub-h3">{nm} storage conditions</h3>
            <p>{texts.storage.t}</p>
            <p class="hub-fine">Source: {texts.storage.s}</p>
          </div>
        )}
        {texts?.incompat && (
          <div class="sub-quote">
            <h3 class="sub-h3">{nm} incompatible materials</h3>
            <p>{texts.incompat.t}</p>
            <p class="hub-fine">Source: {texts.incompat.s}</p>
          </div>
        )}
        {texts?.reactivity && (
          <div class="sub-quote">
            <h3 class="sub-h3">{nm} reactivity</h3>
            <p>{texts.reactivity.t}</p>
            <p class="hub-fine">Source: {texts.reactivity.s}</p>
          </div>
        )}

        <p class="hub-note">
          Planning storage for a mix of chemicals?{' '}
          <a href={`/tools/chemical-storage-compatibility/?substance=${encodeURIComponent(cas)}`}>
            Check {truncateName(name, 25)} in the storage compatibility matrix →
          </a>
        </p>
      </div>
    </section>
  )}

  {/*
    ⚠⚠ FAQ. Каждый ответ собран из СВОИХ данных, разметка FAQPage строится из
    того же массива — разбор в шапке lib/substanceFaq.ts.
    ⚠ Вопрос — это H3, а не <summary>: содержимое обязано лежать в HTML
    развёрнутым. Свёрнутый по умолчанию ответ Google индексирует хуже, а
