  */}
  <section class="hub-sec-a" id="nearby">
    <div class="hub-wrap">
      <p class="hub-eyebrow">Nearby</p>
      <h2 class="hub-h2">Substances next to {nmShort}</h2>
      <nav class="hub-prevnext" aria-label="Neighbouring substances">
        {prev ? (
          <a href={prev.href}>
            <span class="dir">← Previous</span>
