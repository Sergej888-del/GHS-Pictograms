---
/**
 * Хаб справочника веществ — /substances/
 *
 * ⚠⚠ SESSION 36, ПЕРЕПИСАНО ПОД НОВУЮ РОЛЬ. До этого страница называлась
 * «Find a substance — open in Label Constructor» и была выбором вещества для
 * конструктора этикеток (session 23). С переездом раздела она стала хабом
 * справочника на 3 650 страниц, а текст остался прежним — и обещал конструктор.
 *
 * Дефект нашёл Сергей, глядя на живую страницу: «два разных фильтра на одной
 * странице ведут в разные места». Пути на самом деле сошлись — строка результата
 * острова с session 36 ведёт на страницу вещества, — врал только текст.
 * Лечение: назвать вещи своими именами. Секция 01 — обход алфавитом,
 * секция 02 — точечный поиск. Каждая говорит, куда ведёт.
 *
 * ⚠ ПРАВИЛО ОТРИСОВКИ (substance-hub-decisions.md §4.1): сначала статика, остров
 * только для поиска. Указатель A–Z лежит в HTML и работает без JavaScript.
 *
 * ⚠ Цена острова, замерена по коду: при каждом визите он выкачивает всю базу —
 * пять обращений к Supabase по 1 000 строк — и только потом начинает искать.
 * Отсюда надпись «Loading substances…» на живой странице. Поэтому он ВТОРОЙ
 * секцией, а не первой: обход алфавитом доступен сразу, ждать не нужно.
 */
export const prerender = true
import Layout from '../../layouts/Layout.astro'
import SubstanceFilterBrowse from '../../components/SubstanceFilterBrowse'
import { supabase } from '../../lib/supabase'
import { must } from '../../lib/mustQuery'
import { substanceNameFull, substanceTitleName, NAME_COLUMNS } from '../../lib/substanceName'

const SITE = 'https://ghspictograms.com'

type Row = { cas_number: string; common_name: string | null; display_name_short: string | null; iupac_name: string }

const PAGE = 1000
const rows: Row[] = []
for (let from = 0; ; from += PAGE) {
  const chunk = must(
    `substances (browse index, from=${from})`,
    await supabase
      .from('substances')
      .select(`cas_number, ${NAME_COLUMNS}`)
      .not('cas_number', 'is', null)
      .order('cas_number')
      .range(from, from + PAGE - 1)
  ) as Row[] | null
  if (!chunk?.length) break
  rows.push(...chunk)
  if (chunk.length < PAGE) break
}

// ⚠ Отбор и правило первой буквы обязаны совпадать с
// src/pages/substances/browse/[letter].astro и с sitemap.xml.ts.
const CAS_SHAPE = /^\d{2,7}-\d{2}-\d$/
const counts = new Map<string, number>()
let total = 0
for (const r of rows) {
  if (!r.cas_number || !CAS_SHAPE.test(r.cas_number)) continue
  total++
  const c = substanceTitleName(substanceNameFull(r)).trim().charAt(0).toLowerCase()
  const key = c >= 'a' && c <= 'z' ? c : '0-9'
  counts.set(key, (counts.get(key) ?? 0) + 1)
}
const LETTERS = ['0-9', ...'abcdefghijklmnopqrstuvwxyz'.split('')]
// ⚠ Разделитель тысяч: «3650» в заголовке выдачи читается как код, «3,650» — как число.
const totalLabel = total.toLocaleString('en-US')
const letterCount = LETTERS.filter((l) => counts.get(l)).length

/**
 * ⚠ Заголовок собран под бюджет 62 знака целиком (titleIsComplete={true}), без
 * хвоста «| GHS Pictograms». Прежний «Find a substance — open in Label
 * Constructor» не целился ни в один запрос: он описывал инструмент, а страница —
 * справочник на 3 650 записей.
 */
const title = `GHS Substance Database — ${totalLabel} CLP Annex VI Chemicals`
// ⚠ Держим короче 165 знаков: за этим порогом check:seo ругается, а Google обрезает.
const description =
  'Every substance with a harmonised EU CLP Annex VI classification has its own page: ' +
  'properties, GHS pictograms, hazard statements. Browse A–Z or search by CAS.'
const canonical = `${SITE}/substances/`

const breadcrumbJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Substances', item: canonical },
  ],
})
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete={true}>
  <script type="application/ld+json" slot="head" set:html={breadcrumbJson} />

  <section class="hub-hero">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <span>Substances</span>
      </nav>
      <p class="hub-hero-eyebrow">Reference</p>
      <h1>GHS substance database</h1>
      <p class="hub-hero-sub">
        Every substance carrying a harmonised classification under EU CLP Annex VI has its own
        page: physical and chemical properties with the conditions each value was measured under,
        GHS pictograms, hazard and precautionary statements, and label elements.
      </p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{totalLabel} substances</span>
        <span class="hub-hero-chip">{letterCount} index pages</span>
        <span class="hub-hero-chip">CLP Annex VI</span>
      </div>
    </div>
  </section>

  <section class="hub-sec-a" id="browse">
    <div class="hub-wrap">
      <p class="hub-eyebrow">01 · Browse</p>
      <h2 class="hub-h2">All {totalLabel} substances, A to Z</h2>
      <p class="hub-sub">
        Pick a letter to see every substance whose name starts with it. Each entry opens its own
        reference page. This index is plain HTML and needs no JavaScript.
      </p>
      <nav class="sub-alpha" style="margin-top:22px" aria-label="Browse substances by letter">
        {LETTERS.map((l) =>
          counts.get(l) ? (
            <a class="sub-alpha-item" href={`/substances/browse/${l}/`} title={`${counts.get(l)} substances`}>
              {l === '0-9' ? '0–9' : l.toUpperCase()}
            </a>
          ) : (
            <span class="sub-alpha-item is-empty" title="No substances start with this letter">
              {l === '0-9' ? '0–9' : l.toUpperCase()}
            </span>
          )
        )}
      </nav>
    </div>
  </section>

  <section class="hub-sec-white" id="search">
    <div class="hub-wrap">
      <p class="hub-eyebrow">02 · Search</p>
      <h2 class="hub-h2">Look up a specific substance</h2>
      <p class="hub-sub">
        Search by CAS number or name with fuzzy matching, then narrow the result by GHS pictogram
        or signal word. Every row opens the substance page; the button beside it opens the same
        substance in the GHS Label Constructor. Up to 100 matches are shown at once — for the
        complete list, use the alphabetical index above.
      </p>
    </div>
    <SubstanceFilterBrowse client:load />
  </section>

  <section class="hub-sec-deep">
    <div class="hub-wrap">
      <p class="hub-eyebrow on-dark">Next</p>
      <h2 class="hub-h2 on-dark">Work with these substances</h2>
      <div class="hub-mini-cards">
        <a class="hub-mini-card" href="/label-constructor/">
          <strong>GHS label constructor</strong>
          <span>Build a compliant label: pictograms, signal word, H- and P-statements.</span>
        </a>
        <a class="hub-mini-card" href="/tools/ate-mixture-calculator/">
          <strong>ATE mixture calculator</strong>
          <span>Acute toxicity estimate for a mixture, by the CLP calculation method.</span>
        </a>
        <a class="hub-mini-card" href="/tools/chemical-storage-compatibility/">
          <strong>Storage compatibility</strong>
          <span>What must not be stored next to what, by hazard class.</span>
        </a>
        <a class="hub-mini-card" href="/sds/">
          <strong>Safety data sheets</strong>
          <span>Full 16-section sheets for the substances handled most often.</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
