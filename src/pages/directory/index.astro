---
// /directory/ — хаб GHS Tools & Services Directory (№148, s92, CLAUDE.md §18).
//
// Что на странице: правила каталога словами читателя (§18.2), семь разделов с числом записей,
// «Who is responsible for an SDS» (дословные цитаты REACH / CLP / OSHA / HPA), раздел «Checked and
// not listed» (имена из «best of»-списков, которых нет или которые не про GHS — решение Сергея s92:
// люди будут искать эти имена и найдут у нас честный ответ), форма «Suggest a listing».
//
// ⚠ «Checked and not listed» формулируется ТОЛЬКО фактами («не нашли продукт с таким именем»,
//   «вендор не описывает его как GHS-инструмент») — без «фальшивка», без имён сайтов-списков.
import Layout from '../../layouts/Layout.astro'
import DirectoryClaimForm from '../../components/DirectoryClaimForm'
import '../../styles/directory.css'
import {
  CATEGORIES, SITE, SUBCATEGORIES, accentClassOfCategory, buildCard, categoryBySlug, categoryHref, entriesInCategory, formatDate, groupOfCategory,
  hqTokensOf, opsTokensOf, subcategoryHref, visibleGroups,
} from '../../lib/directoryModel'
import { geoFilterOptions, geoProblems } from '../../lib/directoryGeo'
import { loadDirectory } from '../../lib/directoryData'
import { LEGAL_QUOTES, LEGAL_SUMMARY, LEGAL_DISCLAIMER, LEGAL_CHECKED } from '../../lib/directoryLegal'
import { directoryAccentClass } from '../../lib/sectionAccent'
import { loadEmergency } from '../../lib/emergencyData'

export const prerender = true

const { entries, facts } = await loadDirectory()
// s111: the official emergency-lines page is a reference, not a vendor group (no tiles, no listing counts). The block
// appears only while that page is built, i.e. while at least one emergency row is live.
const emergency = await loadEmergency()
const emergencyBuilt = emergency.blocks.length > 0
const listed = entries.filter((e) => e.state === 'live')
const closed = entries.filter((e) => e.state === 'closed')
const notListed = entries
  .filter((e) => e.state === 'not-listed')
  .sort((a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base' }))
// s96: число раздела = что стоит на его странице (основная категория + подтверждённые also_in);
// итоги «listed» выше — уникальные записи.
const count = (slug: string) => entriesInCategory(entries, slug, facts).length
const lastVerified = entries.map((e) => e.last_verified).sort().at(-1) ?? null

// s108 (A1): четыре группы навигации — СЛОЙ над категориями (адреса не меняются, directoryModel.GROUPS). Группа без живых
// категорий не печатается; `closed` — не группа, а архив под группами. Запись в нескольких категориях одной группы
// считается один раз (число группы = уникальные записи основных категорий).
const NUM_WORD = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve']
const shownGroups = visibleGroups()
const groupCount = (slugs: readonly string[]) => new Set(slugs.flatMap((s) => entriesInCategory(entries, s, facts).map((e) => e.id))).size
const tile = (slug: string, also: boolean) => {
  const c = categoryBySlug(slug)!
  return { c, also, other: also ? groupOfCategory(slug)?.name ?? null : null, n: count(slug) }
}
const groupTiles = shownGroups.map((g) => ({
  g,
  n: groupCount(g.categories),
  tiles: [...g.categories.map((s) => tile(s, false)), ...(g.alsoCategories ?? []).map((s) => tile(s, true))],
}))
const archiveTile = tile('closed', false)
const sectionsTitle = `${NUM_WORD[CATEGORIES.length][0].toUpperCase()}${NUM_WORD[CATEGORIES.length].slice(1)} sections in ${NUM_WORD[shownGroups.length]} groups, one set of rules`

// s108 (A1b): форма «Find by country or region» ведёт на общий вид /directory/all/ (?geo=…&ops=…). Опции — по ВСЕМ живым
// записям; число в скобках — сколько вендоров покажет общий вид. Неизвестный код страны роняет сборку (как в DirectoryListing).
const liveCards = listed.map((e) => buildCard(e, facts))
const geoBad = geoProblems(liveCards.map((c) => c.entry.hq_country), liveCards.flatMap((c) => c.facts.market ?? []).map((f) => f.detail))
if (geoBad.length) throw new Error(`directory: ${geoBad.join('; ')}`)
const findHq = geoFilterOptions(liveCards.map((c) => hqTokensOf(c.entry)), false)
const findOps = geoFilterOptions(liveCards.map((c) => opsTokensOf(c)), true)

const title = 'GHS Tools & Services Directory — Listed, Not Ranked'
const description =
  'A neutral directory of SDS authoring and management software, GHS label tools, databases and SDS services: verifiable facts and published prices, never ranked.'
const canonical = `${SITE}/directory/`

const principles = [
  ['Facts, not ratings', 'We have not used these products, so we do not score them. Each card lists what the vendor publishes, with a link to the page we read it on.'],
  ['Order is never sold', 'Listings verified by their owners come first, most recently confirmed at the top; the rest follow alphabetically. A paid placement, if one ever appears, sits in a separate block marked Sponsored and moves nothing.'],
  ['Prices only as published', 'A price appears only if the vendor publishes it and a second reading of its page found the same figure. Otherwise: “price on request”.'],
  ['Responsibility, quoted from legal documents', 'Writing an SDS for someone does not take over their legal duty. Each card quotes what the vendor itself says it is, and is not, responsible for — taken only from its terms, licence, legal notice or published policy, never from its blog, help pages or marketing.'],
  ['Partnerships disclosed', 'Where this site earns from a vendor, the card says so next to the name. It changes nothing in the order.'],
  ['Nothing is deleted', 'A tool that closes stays listed as closed, with the date and where its content went — that is what old links are looking for. A vendor can still ask to have its own listing removed at any time.'],
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'GHS Tools & Services Directory',
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'GHS Pictograms', url: `${SITE}/` },
  hasPart: CATEGORIES.map((c) => ({ '@type': 'CollectionPage', name: c.h1, url: `${SITE}${categoryHref(c.slug)}` })),
}
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hub-hero tint-teal">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner">
      <p class="hub-hero-eyebrow">Directory · Tools &amp; services</p>
      <h1>GHS Tools &amp; Services Directory</h1>
      <p class="hub-hero-sub">
        SDS authoring and management software, GHS label tools, chemical safety databases, SDS writing and translation
        services — what each one is, where it is based, which rules it covers, what it costs when the price is public,
        and what its vendor says it is responsible for.
      </p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{listed.length} listings</span>
        <span class="hub-hero-chip">{closed.length} closed or moved</span>
        <span class="hub-hero-chip" data-dir-principle>Listed, not ranked</span>
        {lastVerified && <span class="hub-hero-chip">Last verified {formatDate(lastVerified)}</span>}
      </div>
    </div>
  </section>

  <section class="hub-sec-a">
    <div class="hub-wrap">
      <p class="hub-eyebrow">01 · Sections</p>
      <h2 class="hub-h2">{sectionsTitle}</h2>
      <form class="dir-find" method="get" action="/directory/all/" data-dir-find>
        <div class="dir-find-head">
          <h3>Looking for a vendor in a particular country?</h3>
          <p>
            Pick a country or region and see every vendor across all sections — software, services, databases and training —
            in one list. <strong>Based in</strong> is where the vendor’s head office is; <strong>Operates in</strong> is the
            markets the vendor names on its own pages.
          </p>
        </div>
        <label>Based in
          <select name="geo" data-dir-find-geo>
            <option value="">Anywhere</option>
            {findHq.continents.length > 1 && (
              <optgroup label="Continents">{findHq.continents.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}</optgroup>
            )}
            {findHq.regions.length > 1 && (
              <optgroup label="Regions">{findHq.regions.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}</optgroup>
            )}
            <optgroup label="Countries">{findHq.countries.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}</optgroup>
          </select>
        </label>
        <label>Operates in
          <select name="ops" data-dir-find-ops>
            <option value="">Anywhere</option>
            {findOps.extra.length > 0 && (
              <optgroup label="Stated by the vendor">{findOps.extra.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}</optgroup>
            )}
            {findOps.continents.length > 1 && (
              <optgroup label="Continents">{findOps.continents.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}</optgroup>
            )}
            {findOps.regions.length > 1 && (
              <optgroup label="Regions">{findOps.regions.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}</optgroup>
            )}
            <optgroup label="Countries">{findOps.countries.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}</optgroup>
          </select>
        </label>
        <button type="submit" class="dir-find-go">Show vendors</button>
        <a class="dir-find-all" href="/directory/all/" data-dir-find-all>Browse all {listed.length} listings →</a>
      </form>
      {groupTiles.map(({ g, n, tiles }) => (
        <div data-dir-hub-group={g.slug} class={`dir-group ${directoryAccentClass(g.slug)}`}>
          <div class="dir-group-head">
            <h3 class="hub-h2" id={`g-${g.slug}`}>{g.name} <span class="dir-cat-n">{n}</span></h3>
            <p class="dir-group-rule">{g.blurb}</p>
          </div>
          <div class="hub-cards four">
            {tiles.map(({ c, also, other, n: tn }) => (
              <a class={`hub-card ${accentClassOfCategory(c.slug)}`.trim()} href={categoryHref(c.slug)}>
                <p class="tag">{c.eyebrow.replace('Directory · ', '')}{also && other ? ` · mainly under ${other}` : ''}</p>
                <h3>{c.h1.charAt(0).toUpperCase() + c.h1.slice(1)}</h3>
                <p class="copy">{c.description}</p>
                <p class="dir-cat-n">{tn} listings</p>
              </a>
            ))}
          </div>
        </div>
      ))}
      {emergencyBuilt && (
        <div class="dir-reference" data-dir-hub-reference="emergency-numbers">
          <p class="dir-reference-tag">Official reference</p>
          <h3 class="hub-h2" id="g-reference">Emergency numbers for SDS section 1.4</h3>
          <p class="dir-group-rule">
            Official poison centres and national helplines, with what each country’s sources say about the emergency number in
            section 1.4 of a safety data sheet. Not a vendor listing: nothing here is ranked, claimed or paid.
          </p>
          <a class="dir-reference-link" href="/directory/emergency-numbers/">See the numbers for {emergency.blocks.length} {emergency.blocks.length === 1 ? 'country' : 'countries'} →</a>
        </div>
      )}
      <div data-dir-hub-group="archive" class="dir-group">
        <div class="dir-group-head">
          <h3 class="hub-h2" id="g-archive">Archive</h3>
          <p class="dir-group-rule">Resources that closed or moved, kept on purpose: library guides still link to them.</p>
        </div>
        <div class="hub-cards four">
          <a class="hub-card" href={categoryHref(archiveTile.c.slug)}>
            <p class="tag">{archiveTile.c.eyebrow.replace('Directory · ', '')}</p>
            <h3>{archiveTile.c.h1.charAt(0).toUpperCase() + archiveTile.c.h1.slice(1)}</h3>
            <p class="copy">{archiveTile.c.description}</p>
            <p class="dir-cat-n">{archiveTile.n} entries</p>
          </a>
        </div>
      </div>
      <p class="hub-fine dir-hub-subs" data-dir-hub-subs>
        Services are split into {NUM_WORD[SUBCATEGORIES.length]} sections:
        {SUBCATEGORIES.map((x, i) => <>{i > 0 ? ' · ' : ' '}<a href={subcategoryHref(x.slug)}>{x.short}</a></>)}.
      </p>
    </div>
  </section>

  <section class="hub-sec-b">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">02 · How the directory works</p>
      <h2 class="hub-h2">Listed, not ranked</h2>
      <div class="dir-principles">
        {principles.map(([h, t]) => (
          <div class="dir-principle"><strong>{h}</strong>{t}</div>
        ))}
      </div>
      <p class="hub-sub">
        Every listing starts as <strong>listed</strong>: facts from public pages, not verified by the owner. An owner can
        <strong>claim</strong> it for free — confirm or correct the facts — and the card then shows “Verified by owner” with
        the date, a logo and a short description in the vendor’s words, and moves ahead of the alphabetical list in its
        section. Links to vendors carry <code>nofollow</code>, claimed or not. The conditions for every listing — free,
        no contract, removal on request — are written out in the <a href="/directory/terms/">listing terms</a>.
      </p>
    </div>
  </section>

  <section class="hub-sec-white" id="who-is-responsible">
    <div class="hub-wrap">
      <p class="hub-eyebrow">03 · The law</p>
      <h2 class="hub-h2">Who is responsible for an SDS?</h2>
      <p class="hub-sub">Read in the official consolidated texts on {formatDate(LEGAL_CHECKED)}.</p>
      <div class="dir-legal">
        {LEGAL_QUOTES.map((q) => (
          <figure>
            <figcaption>{q.instrument} · {q.provision} · <a href={q.url} rel="noopener" target="_blank">{q.version}</a></figcaption>
            <blockquote>“{q.quote}”</blockquote>
          </figure>
        ))}
      </div>
      <p class="hub-sub">{LEGAL_SUMMARY}</p>
      <p class="hub-fine">{LEGAL_DISCLAIMER}</p>
    </div>
  </section>

  <section class="hub-sec-a" id="checked-not-listed">
    <div class="hub-wrap">
      <p class="hub-eyebrow">04 · Checked and not listed</p>
      <h2 class="hub-h2">Names you may have seen elsewhere</h2>
      <p class="hub-sub">
        Some names appear in “best software” lists but do not hold up when you go to the source. We checked each one;
        this is what we found, and why it is not in the directory.
      </p>
      <ul class="dir-notlisted" data-dir-notlisted>
        {notListed.map((e) => (
          <li id={`n-${e.slug}`}>
            <strong>{e.title}</strong>
            <span class="seen">{e.description} · checked {formatDate(e.last_verified)}</span>
            {e.reason}
            {e.reason_source && <a class="dir-src" href={e.reason_source} rel="nofollow noopener" target="_blank">source</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hub-sec-white" id="suggest">
    <div class="hub-wrap">
      <p class="hub-eyebrow">05 · Suggest a listing</p>
      <h2 class="hub-h2">Missing a tool or a service?</h2>
      <p class="hub-sub">
        Tell us its name and website. We check it against the same rules before it appears — there is no fee for
        being listed, and no way to pay for a better position.
      </p>
      <DirectoryClaimForm client:visible mode="suggest" />
    </div>
  </section>
</Layout>
