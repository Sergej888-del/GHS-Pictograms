---
// /directory/<category>/ — страница категории каталога (№148, s92, CLAUDE.md §18).
//
// Устройство (решение Сергея s92 «карточки + таблица»): сравнительная таблица по всем записям
// (страна, юрисдикции, языки, модель цены, «от», поставка, проба, API) → карточки с ценами,
// возможностями и тем, за что вендор отвечает → блок «Who is responsible for an SDS» (там, где
// документ имеет юридическую силу) → «предложить / заявить». Таблица, фильтры и карточки — DirectoryListing (s96).
//
// ⚠ Индексируется с первого дня (правило 6 касается страниц записей, не категорий).
// ⚠ Порядок — `orderEntries` (s95: заявленные первыми по дате подтверждения, свежие выше; listed — алфавит).
//   Таблица и карточки идут в ОДНОМ порядке; сторож dir-order проверяет его по data-dir-title и ищет ORDER_NOTE.
// ⚠ s96: записи с подтверждённой дополнительной категорией (`also_in`, alsoInCategories) стоят и здесь — той же
//   карточкой с пометкой «Also listed under …»; страница записи у них одна, под основной категорией.
// ⚠ s96: раздел услуг — хаб четырёх подразделов (SUBCATEGORIES): карточки по группам со ссылкой на страницу
//   подраздела /directory/authoring-services-consultants/<sub>/; таблица — общая по всем 39.
import Layout from '../../../layouts/Layout.astro'
import DirectoryListing from '../../../components/DirectoryListing.astro'
import type { ListingGroup } from '../../../components/DirectoryListing.astro'
import '../../../styles/directory.css'
import {
  CATEGORIES, SITE, SPONSORED_MAX, SUBCATEGORIES, SUBCATEGORY_PARENT, buildCard, categoryHref, effectiveTier,
  entriesInCategory, formatDate, orderEntries, subcategoryHref, type Category,
} from '../../../lib/directoryModel'
import { loadDirectory } from '../../../lib/directoryData'
import { LEGAL_QUOTES, LEGAL_SUMMARY, LEGAL_DISCLAIMER, LEGAL_CHECKED } from '../../../lib/directoryLegal'

export const prerender = true

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: category.slug }, props: { category } }))
}

const { category } = Astro.props as { category: Category }
const { entries, facts } = await loadDirectory()

const inCat = entriesInCategory(entries, category.slug, facts)
// ⚠ Featured-запись остаётся и в редакционном списке на своём месте: оплата ДОБАВЛЯЕТ место в
// блоке Sponsored, но не двигает и не убирает её из списка ниже (§18.3). Sponsored — только по основной категории.
const editorial = orderEntries(inCat)
const sponsored = orderEntries(
  inCat.filter((e) => e.category === category.slug && e.state === 'live' && effectiveTier(e) === 'featured'),
).slice(0, SPONSORED_MAX)
const cards = editorial.map((e) => buildCard(e, facts))
const sponsoredCards = sponsored.map((e) => buildCard(e, facts))
const n = inCat.length
const isClosed = category.slug === 'closed'
const isServices = category.slug === SUBCATEGORY_PARENT
const groups: ListingGroup[] = isServices
  ? SUBCATEGORIES.map((s) => ({
      id: s.slug,
      title: s.h1,
      rule: s.rule,
      href: subcategoryHref(s.slug),
      cards: cards.filter((c) => c.entry.subcategory === s.slug),
    }))
  : [{ id: 'entries', title: '', cards }]
// ⚠ Запись услуг без подраздела или с чужим — в группы не попала бы и молча исчезла со страницы.
if (isServices) {
  const grouped = groups.reduce((a, g) => a + g.cards.length, 0)
  if (grouped !== cards.length) throw new Error(`directory: ${cards.length - grouped} services entries have no subcategory`)
}

const lastVerified = inCat.map((e) => e.last_verified).sort().at(-1) ?? null
const others = CATEGORIES.filter((c) => c.slug !== category.slug)

const title = category.title
const description = category.description
const canonical = `${SITE}${categoryHref(category.slug)}`
const lead = category.lead.replace('{n}', String(n))

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.h1,
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'GHS Pictograms', url: `${SITE}/` },
  ...(isServices
    ? { hasPart: SUBCATEGORIES.map((s) => ({ '@type': 'CollectionPage', name: s.h1, url: `${SITE}${subcategoryHref(s.slug)}` })) }
    : {}),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: n,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: cards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.entry.title,
      url: `${canonical}#e-${c.entry.slug}`,
    })),
  },
}
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hub-hero tint-teal">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner">
      <p class="hub-crumb"><a href="/directory/">GHS Tools &amp; Services Directory</a><span class="sep">/</span>{category.short}</p>
      <p class="hub-hero-eyebrow">{category.eyebrow}</p>
      <h1>{category.h1}</h1>
      <p class="hub-hero-sub">{lead}</p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{n} {isClosed ? 'entries' : 'listed'}</span>
        <span class="hub-hero-chip" data-dir-principle>Listed, not ranked</span>
        {lastVerified && <span class="hub-hero-chip">Last verified {formatDate(lastVerified)}</span>}
      </div>
      {isServices && (
        <nav class="dir-subnav" aria-label="Sections" data-dir-subnav>
          {SUBCATEGORIES.map((s) => (
            <a href={subcategoryHref(s.slug)}>{s.short} <span class="dir-cat-n">{cards.filter((c) => c.entry.subcategory === s.slug).length}</span></a>
          ))}
        </nav>
      )}
    </div>
  </section>

  <DirectoryListing cards={cards} sponsoredCards={sponsoredCards} groups={groups} isClosed={isClosed} inCategory={category.slug} />

  {category.responsibility && (
    <section class="hub-sec-white" id="who-is-responsible">
      <div class="hub-wrap">
        <p class="hub-eyebrow">03 · The law</p>
        <h2 class="hub-h2">Who is responsible for an SDS?</h2>
        <p class="hub-sub">
          The texts below were read in the official consolidated versions on {formatDate(LEGAL_CHECKED)}.
        </p>
        <div class="dir-legal">
          {LEGAL_QUOTES.map((q) => (
            <figure>
              <figcaption>{q.instrument} · {q.provision} · <a href={q.url} rel="noopener" target="_blank">{q.version}</a></figcaption>
              <blockquote>“{q.quote}”</blockquote>
            </figure>
          ))}
        </div>
        <p class="hub-sub">{LEGAL_SUMMARY}</p>
        <p class="hub-fine">{LEGAL_DISCLAIMER}</p>
      </div>
    </section>
  )}

  <section class="hub-sec-white">
    <div class="hub-wrap">
      <div class="hub-close-panel">
        <div class="dots" aria-hidden="true"></div>
        <h2>Is a listing wrong, or missing?</h2>
        <p>
          Owners can claim a listing for free and confirm or correct its facts — open the listing and use the form at the
          bottom. To suggest a tool or service we have not listed, use the form on the
          <a href="/directory/#suggest">directory home page</a>. Other sections:
          {others.map((o, i) => <>{i > 0 ? ' · ' : ' '}<a href={categoryHref(o.slug)}>{o.short}</a></>)}.
        </p>
      </div>
    </div>
  </section>
</Layout>
