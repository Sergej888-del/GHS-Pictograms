---
// SDS library hub — /sds/
// Lists every live page from the `sds_pages` registry. Grows automatically as
// registry rows are flipped to status='live' — no code change per substance.
// rev3 (session 13, Фаза 3): rebuilt on the v2 hub vocabulary (src/styles/hub.css) —
// animated navy hero, A–Z letter groups, explanatory card row, navy closing panel.
// Client-side search over name / CAS / formula / synonyms_search (brands included,
// search-only — never displayed) is preserved and now also hides empty letter groups.
// JetBrains Mono link dropped (Sergej's call): mono is --font-mono site-wide.
import Layout from '../../layouts/Layout.astro'
import SdsManagerCard from '../../components/SdsManagerCard.astro'
import { supabase } from '../../lib/supabase'

const SITE = 'https://ghspictograms.com'

const { data: pagesRaw } = await supabase
  .from('sds_pages')
  .select('slug, cas_number, display_name, formula_display, template_variant, synonyms_search')
  .eq('status', 'live')
  .order('display_name')
const pages = pagesRaw ?? []

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)

// One lowercase haystack per card for the client-side filter.
const searchBlob = (p: any) =>
  [p.display_name, p.cas_number, p.formula_display, ...(p.synonyms_search ?? [])]
    .filter(Boolean)
    .join(' | ')
    .toLowerCase()

// Payload for the hero autocomplete (session 16). Array-of-arrays on purpose:
// 109 rows of repeated object keys would be dead weight in the HTML.
//   [ slug, display_name, cas, formula, synonyms_search[] ]
// synonyms_search carries brand and trade names that are deliberately never
// displayed on a card — the dropdown is the one place they surface, and only
// as "matched synonym · X" on the row they explain.
const acData = pages.map((p: any) => [
  p.slug,
  p.display_name,
  p.cas_number ?? '',
  p.formula_display ?? '',
  p.synonyms_search ?? [],
])

// A–Z grouping: anything not starting with a latin letter lands in "0–9".
const groups: [string, any[]][] = (() => {
  const map = new Map<string, any[]>()
  for (const p of pages) {
    const first = (p.display_name ?? '').trim().charAt(0).toUpperCase()
    const letter = /[A-Z]/.test(first) ? first : '0–9'
    const bucket = map.get(letter)
    if (bucket) bucket.push(p)
    else map.set(letter, [p])
  }
  return Array.from(map.entries()).sort((a, b) => {
    if (a[0] === b[0]) return 0
    if (a[0] === '0–9') return -1
    if (b[0] === '0–9') return 1
    return a[0].localeCompare(b[0])
  })
})()

// Explanatory row — what every substance page actually contains.
const sections = [
  {
    tag: 'Classification',
    name: 'Harmonised GHS classification',
    acc: '#1d4ed8',
    line: '#bfdbfe',
    soft: '#eff6ff',
    ink: '#1d4ed8',
    desc: "Hazard classes, categories, H- and P-statements and label pictograms taken straight from CLP Annex VI — the legally harmonised EU entry, not a supplier's interpretation of it.",
  },
  {
    tag: 'Segregation',
    name: 'Computed storage verdict',
    acc: '#0d9488',
    line: '#99f6e4',
    soft: '#f0fdfa',
    ink: '#0f766e',
    desc: "Which chemicals must never share a store with this one, which need separation, and which are safe together — computed from GHS segregation rules across 3,600+ substances. You won't find this section in any supplier PDF.",
  },
  {
    tag: 'Transport',
    name: 'ADR transport data & the real SDS',
    acc: '#0ea5e9',
    line: '#bae6fd',
    soft: '#f0f9ff',
    ink: '#0284c7',
    desc: "UN number, ADR class and packing group where the substance is regulated for transport — plus honest links to the official supplier safety data sheets. We reference them, we don't pretend to replace them.",
  },
]

const title = 'SDS library: safety data sheets by substance'
const description =
  'Safety data sheet reference pages for common industrial chemicals: GHS classification from CLP Annex VI, computed storage compatibility verdicts, ADR transport data, and links to official supplier SDS PDFs.'
const canonical = `${SITE}/sds/`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  numberOfItems: pages.length,
}
---

<Layout title={title} description={description} canonical={canonical}>
  <!-- Animated navy hero (v2), gradient leaning teal — the /sds/ hub colour -->
  <section class="hub-hero tint-teal">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>

    <div class="hub-wrap hub-hero-inner">
      <p class="hub-hero-eyebrow">Reference · SDS library</p>
      <h1>SDS library</h1>
      <p class="hub-hero-sub">
        Safety data sheet reference by substance: harmonised GHS classification, a computed storage
        verdict you won't find in a PDF, transport data, and honest links to official supplier SDS documents.
      </p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{pages.length} substances</span>
        <span class="hub-hero-chip">CLP Annex VI · computed storage verdicts</span>
      </div>

      <div class="hub-hero-search">
        <svg class="hub-search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <label for="sds-search" class="sr-only">Search substances by name, CAS number, formula, or synonym</label>
        <input
          id="sds-search"
          type="search"
          placeholder="Search name, CAS, formula, or synonym…"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="sds-ac"
          aria-autocomplete="list"
        />
        <div id="sds-ac" class="hub-ac" role="listbox" aria-label="Matching substances" hidden></div>
      </div>
    </div>
  </section>

  <!-- What every substance page contains -->
  <section class="hub-sec-a">
    <div class="hub-wrap">
      <p class="hub-eyebrow">01 · What's on every page</p>
      <h2 class="hub-h2">Three things a supplier PDF won't give you together</h2>
      <div class="hub-cards">
        {sections.map((s) => (
          <div class="hub-card static" style={`--acc:${s.acc};--acc-line:${s.line};--acc-soft:${s.soft};--acc-ink:${s.ink}`}>
            <p class="tag">{s.tag}</p>
            <h3>{s.name}</h3>
            <p class="copy">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- A–Z library -->
  <section class="hub-sec-b">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">02 · Library</p>
      <h2 class="hub-h2">All substances, A–Z</h2>
      <p class="hub-meta"><span id="sds-count">{pages.length}</span> substances · A–Z</p>

      {pages.length > 0 ? (
        <div id="sds-grid">
          {groups.map(([letter, items]) => (
            <section class="hub-letter-group" data-letter={letter}>
              <h3 class="hub-letter">{letter}</h3>
              <ul class="hub-index">
                {items.map((p) => (
                  <li data-search={searchBlob(p)}>
                    <a href={`/sds/${p.slug}/`} class="hub-index-card">
                      <span class="txt">
                        <span class="name">{cap(p.display_name)} SDS</span>
                        {p.cas_number && <span class="cas">CAS {p.cas_number}</span>}
                      </span>
                      {p.formula_display && <span class="formula">{p.formula_display}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <p class="hub-note">Pages are being prepared — check back shortly.</p>
      )}

      <p id="sds-empty" class="hub-note hub-hide">
        Nothing matches that search here yet. The
        <a href="/tools/chemical-storage-compatibility/">storage compatibility tool</a>
        covers 3,600+ substances by CAS number — try it there.
      </p>
    </div>
  </section>

  <!-- Closing / storage-tool bridge -->
  <section class="hub-sec-white">
    <div class="hub-wrap">
      <div class="hub-close-panel">
        <div class="dots" aria-hidden="true"></div>
        <h2>Missing one you need?</h2>
        <p>
          More substances are added in waves. The
          <a href="/tools/chemical-storage-compatibility/">storage compatibility tool</a>
          already covers 3,600+ substances by CAS number.
        </p>
      </div>

      <SdsManagerCard
        service="management"
        body="These reference pages cover the substance. The document your inspector asks for is the supplier's own safety data sheet for the product you actually bought — and it has to be the current revision, on file, and reachable from the floor. For keeping that library central, version-controlled and QR-accessible, the solution we recommend is SDS Manager. It also offers SDS authoring and a broader EHS suite."
        href="https://sdsmanager.com/us/sds-management?fpr=ghs3&fp_sid=sdshub"
      />
    </div>
  </section>

  <!-- Autocomplete payload. Read by the script below; never rendered. -->
  <script id="sds-ac-data" type="application/json" is:inline set:html={JSON.stringify(acData)} />

  <script>
    // Client-side filter: every query token must match the card's search blob
    // (name + CAS + formula + synonyms_search, brands included search-only).
    // Letter groups collapse when none of their cards survive the filter.
    const input = document.getElementById('sds-search') as HTMLInputElement | null
    const grid = document.getElementById('sds-grid')
    const countEl = document.getElementById('sds-count')
    const emptyEl = document.getElementById('sds-empty')
    if (input && grid) {
      const cards = Array.from(grid.querySelectorAll<HTMLLIElement>('li[data-search]'))
      const letterGroups = Array.from(grid.querySelectorAll<HTMLElement>('.hub-letter-group'))
      const norm = (s: string) => s.toLowerCase().replace(/sulph/g, 'sulf').replace(/\s+/g, ' ').trim()
      const blobs = cards.map((c) => norm(c.dataset.search ?? ''))
      input.addEventListener('input', () => {
        const tokens = norm(input.value).split(' ').filter(Boolean)
        let visible = 0
        cards.forEach((card, i) => {
          const show = tokens.every((t) => blobs[i].includes(t))
          card.classList.toggle('hub-hide', !show)
          if (show) visible++
        })
        letterGroups.forEach((g) => {
          const anyVisible = g.querySelector('li[data-search]:not(.hub-hide)')
          g.classList.toggle('hub-hide', !anyVisible)
        })
        if (countEl) countEl.textContent = String(visible)
        if (emptyEl) emptyEl.classList.toggle('hub-hide', visible > 0)
      })
    }

    // ── Hero autocomplete (session 16) ───────────────────────────────────────
    // The A–Z filter above still runs; it is the browse path. This is the find
    // path: the list it filters sits a screen and a half below the fold, so
    // typing in the hero used to look like nothing happened.
    //
    // Ranked, not alphabetical, and never auto-navigating: "acetone" matches
    // three substances, and two of them (methyl ethyl ketone, methyl isobutyl
    // ketone) match only through a search-only synonym. Jumping straight to a
    // page would land the reader on the wrong ketone; a plain list would leave
    // them unable to see why those two are there. So each synonym hit prints
    // the synonym that matched.
    type AcRow = [string, string, string, string, string[]]
    const acEl = document.getElementById('sds-ac')
    const acRaw = document.getElementById('sds-ac-data')
    if (input && acEl && acRaw?.textContent) {
      const data: AcRow[] = JSON.parse(acRaw.textContent)
      const MAX = 8
      const norm = (s: string) => (s || '').toLowerCase().replace(/sulph/g, 'sulf').replace(/\s+/g, ' ').trim()
      const esc = (s: string) =>
        String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      const rxEsc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
      const mark = (text: string, q: string) => {
        const i = norm(text).indexOf(q)
        if (i < 0) return esc(text)
        return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + q.length)) + '</mark>' + esc(text.slice(i + q.length))
      }
      const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)

      // Lower score wins. Name beats identifier beats synonym; within each,
      // a prefix beats a mid-string hit.
      const rank = (r: AcRow, q: string): { s: number; syn?: string } | null => {
        const name = norm(r[1])
        if (name === q) return { s: 0 }
        if (name.indexOf(q) === 0) return { s: 1 }
        if (new RegExp('\\b' + rxEsc(q)).test(name)) return { s: 2 }
        if (name.indexOf(q) > -1) return { s: 3 }
        if (r[2] && r[2].indexOf(q) === 0) return { s: 4 }
        if (r[3] && norm(r[3]).indexOf(q) === 0) return { s: 5 }
        let mid: string | undefined
        for (const raw of r[4]) {
          const sn = norm(raw)
          if (sn.indexOf(q) === 0) return { s: 6, syn: raw }
          if (!mid && sn.indexOf(q) > -1) mid = raw
        }
        return mid ? { s: 7, syn: mid } : null
      }

      // The dropdown must be position:fixed — .hub-hero is overflow:hidden
      // site-wide (it clips the drifting dots and the sheen), so an absolutely
      // positioned panel would be cut off at the hero's bottom edge.
      const place = () => {
        const r = input.getBoundingClientRect()
        acEl.style.left = r.left + 'px'
        acEl.style.top = r.bottom + 8 + 'px'
        acEl.style.width = r.width + 'px'
        return r.bottom > 0 && r.top < window.innerHeight
      }
      let active = -1
      const rows = () => Array.from(acEl.querySelectorAll<HTMLAnchorElement>('.hub-ac-row'))
      const close = () => {
        acEl.hidden = true
        input.setAttribute('aria-expanded', 'false')
        active = -1
      }
      const render = () => {
        const q = norm(input.value)
        if (q.length < 2) return close()
        const hits: { r: AcRow; s: number; syn?: string }[] = []
        for (const r of data) {
          const m = rank(r, q)
          if (m) hits.push({ r, s: m.s, syn: m.syn })
        }
        hits.sort((a, b) => a.s - b.s || a.r[1].localeCompare(b.r[1]))
        if (!hits.length) {
          acEl.innerHTML =
            '<p class="hub-ac-none">No substance matches <b>' + esc(input.value) +
            '</b> yet. The <a href="/tools/chemical-storage-compatibility/">storage compatibility tool</a> covers 3,600+ substances by CAS number.</p>'
        } else {
          let html = hits.slice(0, MAX).map((h) => {
            const sub = h.syn
              ? '<span class="hub-ac-sub">matched synonym · <em>' + mark(h.syn, q) + '</em></span>'
              : h.r[3] ? '<span class="hub-ac-sub">' + esc(h.r[3]) + '</span>' : ''
            return '<a class="hub-ac-row" role="option" href="/sds/' + h.r[0] + '/">' +
              '<span><span class="hub-ac-name">' + mark(cap(h.r[1]), q) + ' SDS</span>' + sub + '</span>' +
              (h.r[2] ? '<span class="hub-ac-cas">CAS ' + esc(h.r[2]) + '</span>' : '') + '</a>'
          }).join('')
          if (hits.length > MAX)
            html += '<span class="hub-ac-foot">' + (hits.length - MAX) + ' more below in the A–Z list</span>'
          acEl.innerHTML = html
        }
        place()
        acEl.hidden = false
        input.setAttribute('aria-expanded', 'true')
        active = -1
      }
      const move = (d: number) => {
        const rs = rows()
        if (!rs.length) return
        active = (active + d + rs.length) % rs.length
        rs.forEach((r, i) => r.classList.toggle('is-active', i === active))
        rs[active].scrollIntoView({ block: 'nearest' })
      }
      input.addEventListener('input', render)
      input.addEventListener('focus', () => { if (input.value) render() })
      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); move(1) }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1) }
        else if (e.key === 'Escape') close()
        else if (e.key === 'Enter') {
          const rs = rows()
          if (!rs.length) return
          e.preventDefault()
          rs[active < 0 ? 0 : active].click()
        }
      })
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement
        if (!t.closest('.hub-hero-search')) close()
      })
      window.addEventListener('resize', () => { if (!acEl.hidden) place() })
      window.addEventListener('scroll', () => { if (!acEl.hidden && !place()) close() }, { passive: true })
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
