// --- §4 / §5 / §6 response text (substance_response, session 16) -------------
// The CAMEO strings are stored verbatim. Two shapes exist and both are handled:
//   (a) route-structured first aid ("EYES: …\n\nSKIN: …") — 61 of 99 substances
//   (b) flat prose with no route headings — the remaining 38
// Paragraphs whose first token is an ALL-CAPS label ("SMALL FIRE:", "LARGE
// SPILL:") get that label lifted into a chip; the sentence itself is untouched.
const ROUTE_ORDER = ['EYES', 'SKIN', 'SKIN AND EYES', 'INHALATION', 'INGESTION', 'ASPIRATION', 'OTHER']
const LABEL_RE = /^([A-Z][A-Z0-9 ,()/'\-.]{2,70}):\s*/

function rParas(t?: string | null): string[] {
  return (t ?? '').split('\n\n').map((p) => p.trim()).filter(Boolean)
}
function rSplit(p: string): { label: string | null; body: string } {
  const m = p.match(LABEL_RE)
  if (!m) return { label: null, body: p }
  const body = p.slice(m[0].length).trim()
  if (!body) return { label: null, body: p }
  return { label: m[1].trim(), body }
}
function rEsc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
}
// CAMEO leaves two cross-references dangling because it assumes you are on its
// own site. Both are re-pointed at the primary source rather than reworded —
// "General First Aid" is the ERG preamble (11 substances), and the UN/NA
// datasheet holds the ERG Table 1 isolation distances (4 TIH substances).
function rLink(s: string): string {
  const cls = 'font-semibold text-teal-700 hover:underline'
  return rEsc(s)
    .replace(
      /Refer to the &quot;General First Aid&quot; section/g,
      `<a href="https://www.phmsa.dot.gov/hazmat/erg/emergency-response-guidebook-erg" target="_blank" rel="noopener" class="${cls}">Refer to the ERG &quot;General First Aid&quot; instructions</a>`,
    )
    .replace(
      /UN\/NA (\d{4}) datasheet/g,
      `<a href="https://cameochemicals.noaa.gov/unna/$1" target="_blank" rel="noopener" class="${cls}">UN/NA $1 datasheet</a>`,
    )
}
/** Paragraph HTML for the light (page) theme. */
function rBlock(t?: string | null): string {
  const P = 'mt-2.5 text-[13.5px] text-gray-700 leading-relaxed'
  const CHIP =
    'mr-1.5 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.06em] text-slate-600'
  return rParas(t)
    .map((p) => {
      const { label, body } = rSplit(p)
      return label
        ? `<p class="${P}"><span class="${CHIP}" style="${mono}">${rEsc(label)}</span>${rLink(body)}</p>`
        : `<p class="${P}">${rLink(p)}</p>`
    })
    .join('')
}
/** Same paragraphs, inverted for the blacked-out emergency overlay. */
function rBlockDark(t?: string | null): string {
  const P = 'mt-2.5 text-[13.5px] leading-relaxed text-slate-200'
  const CHIP =
    'mr-1.5 rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.06em] text-white'
  return rParas(t)
    .map((p) => {
      const { label, body } = rSplit(p)
      return label
        ? `<p class="${P}"><span class="${CHIP}" style="${mono}">${rEsc(label)}</span>${rEsc(body)}</p>`
        : `<p class="${P}">${rEsc(p)}</p>`
    })
    .join('')
}
function rRoutes(t?: string | null): { route: string; text: string }[] {
  const out: { route: string; text: string }[] = []
  for (const p of rParas(t)) {
    const { label, body } = rSplit(p)
    if (label && ROUTE_ORDER.includes(label)) out.push({ route: label, text: body })
    else if (out.length) out[out.length - 1].text += '\n\n' + p
    else return []
  }
  return out
}
function rSrc(src?: string | null): string {
  return `Source: ${src ?? 'CAMEO Chemicals'} — via CAMEO Chemicals (NOAA), public domain.`
}
const faRoutes = rRoutes(response?.first_aid)
const hasFirstAid = Boolean(response?.first_aid)
const hasFireSec = Boolean(response?.fire_haz || response?.fire_fight)
const hasSpillSec = Boolean(response?.non_fire_resp || response?.isolation)
// The hero emergency button only lights up when the overlay would have all
// three answers a responder needs. Two out of three is not an emergency mode.
const emergencyOn = EMERGENCY_ENABLED && hasFirstAid && hasFireSec && hasSpillSec

// --- §8 exposure limits (session 27) ---------------------------------------
// Data: substance_response.idlh_* + niosh_pgd_file, imported session 16 from
// cameo.sqlite and sitting unrendered ever since. IDLH is a NIOSH figure and
// U.S. public domain.
// ⚠ IDLH is NOT an occupational exposure limit. A PEL/REL is an 8-hour shift
// average; IDLH is the acute concentration a worker could escape from within
// 30 minutes without irreversible harm. OSHA PEL / NIOSH REL / EU IOELV are
// still missing and will be added to this same section from PubChem LCSS.
// ⚠ Eight of the ten units are "as the metal" (mg Cr(VI)/m3, mg Ni/m3 …):
// the limit counts the metal, not the compound. Never reformat the unit.
const idlhValue: number | null = response?.idlh_value != null ? Number(response.idlh_value) : null
const idlhUnit: string | null = response?.idlh_unit ?? null
const nioshFile: string | null = response?.niosh_pgd_file ?? null
const nioshHref = nioshFile ? `https://www.cdc.gov/niosh/npg/${nioshFile}` : null
// The note column carries up to three different statements at once, so each is
// detected separately rather than printed raw:
//   "A potential occupational carcinogen."          -> NIOSH carcinogen flag
//   "Based on 10% of the lower explosive limit."    -> flammability-derived, not toxicity
//   "[From NPG: o-Xylene]"                          -> value published for another entry
const idlhNote: string = response?.idlh_note ?? ''
const idlhCarcinogen = /carcinogen/i.test(idlhNote)
const idlhFromLel = /lower explosive limit/i.test(idlhNote)
const idlhFromOther = (idlhNote.match(/\[From NPG:\s*([^\]]+)\]/i)?.[1] ?? '').trim() || null
// Unit written "mg Cr(VI)/m3" means the limit is expressed as that element.
const idlhAsElement = (idlhUnit?.match(/^mg\s+(.+?)\/m3$/i)?.[1] ?? '').trim() || null
// The section renders wherever NIOSH has an entry — 76 pages. On the 13 without
// a value it is a single honest line plus the link to the source, which is worth
// more than hiding the fact that NIOSH looked and set no IDLH.
const showOel = Boolean(nioshHref)

// §15 regulatory — Step-4 import (substance_regulatory_status: SVHC, Seveso
// derived from H-codes, TSCA/DSL, precursor flags EU 2019/1148 + EC 273/2004).
// Auto-appears once the query returns rows; until then hidden — no skeletons.
const regRows: any[] = []

// SEO (D11)
const title = `${cap} SDS (MSDS): GHS hazards, classification & storage`
const description = substance
  ? `Safety data sheet overview for ${name}${cas ? ` (CAS ${cas})` : ''}: GHS classification from CLP Annex VI, precautionary statements, acute toxicity estimates, a computed storage compatibility verdict, ADR transport data, and links to official supplier SDS / MSDS PDFs.`
  : `Safety data sheet overview for ${name}${cas ? ` (CAS ${cas})` : ''}: classification status, storage guidance, and links to official supplier SDS / MSDS PDFs.`
const canonical = `${SITE}/sds/${page.slug}/`
const buildDate = new Date().toISOString().split('T')[0]

const suppliers = cas
  ? [
      { label: 'Sigma-Aldrich', href: `https://www.sigmaaldrich.com/US/en/search/${cas}` },
      { label: 'Fisher Scientific', href: `https://www.fishersci.com/us/en/catalog/search/products?keyword=${cas}` },
      { label: 'Carl Roth', href: `https://www.carlroth.com/en/en/search?query=${cas}` },
    ]
  : []

// Identity strip (S1 + S3). REACH reg. no. is live-wired: renders as soon as the
// reach_reg_number import fills the column (empty today).
const identity: { label: string; value: string }[] = []
if (cas) identity.push({ label: 'CAS number', value: cas })
if (substance?.ec_number) identity.push({ label: 'EC number', value: substance.ec_number })
if (substance?.index_number) identity.push({ label: 'CLP Annex VI index', value: substance.index_number })
// Formula rows (session 25). Two columns hold two DIFFERENT notations, both legitimate:
//   substances.molecular_formula — Hill/alphabetical form as printed in Annex VI
//                                  ("C3H6O", "H2O4S", "ClNaO"). Correct, but nobody
//                                  writes sulfuric acid as H2O4S and nobody searches it.
//   sds_pages.formula_display    — readable structural form ("CH3COCH3", "H2SO4",
//                                  "NaOCl"), filled session 25 on 100 of 109 pages.
// Where Annex VI has no entry (42 pages — gases, inorganics, minerals) formula_display
// IS the molecular formula, so it takes the primary label instead of a second row.
// Identical values never produce two rows.
if (substance?.molecular_formula) {
  identity.push({ label: 'Molecular formula', value: substance.molecular_formula })
  if (formula && formula !== substance.molecular_formula) {
    identity.push({ label: 'Structural formula', value: formula })
  }
} else if (formula) {
  identity.push({ label: 'Molecular formula', value: formula })
}
if (substance?.molecular_weight != null) identity.push({ label: 'Molar mass', value: `${substance.molecular_weight} g/mol` })
if (substance?.reach_reg_number) identity.push({ label: 'REACH reg. no.', value: substance.reach_reg_number })

// --- §3 structure block (session 26) --------------------------------------
// Data: substance_structure, filled in sessions 24-25 from a local PubChem dump.
// Drawings: public/structures/<slug>.svg, generated by RDKit from the SMILES
// string — our own asset, no third-party image licence involved.
// ⚠ Hybridisation, VSEPR, valence electrons and lone pairs are computed from the
// connection table. For an ionic row that table is a single ion, so those four
// values describe the ion and NOT the compound — they render for molecular only.
const struct = structure ?? null
const structKind: string = struct?.structure_kind ?? ''
const structSvg: string | null = struct?.svg_file ? `/structures/${struct.svg_file}` : null
const isMolStruct = structKind === 'molecular'
const structFormula: string | null = formula ?? substance?.molecular_formula ?? null

// hybridization is keyed by atom ("C0", "O2"). Atom indices mean nothing to a
// reader, so collapse to one phrase per element: "C sp³ ×2, sp² · O sp²".
function hybSummary(h: Record<string, string> | null | undefined): string | null {
  if (!h || typeof h !== 'object') return null
  const byEl: Record<string, Record<string, number>> = {}
  for (const [atom, raw] of Object.entries(h)) {
    const el = (String(atom).match(/^[A-Za-z]+/) ?? [''])[0]
    const label = String(raw).toLowerCase().replace('sp3', 'sp³').replace('sp2', 'sp²').replace('sp1', 'sp')
    if (!el || !label) continue
    byEl[el] = byEl[el] ?? {}
    byEl[el][label] = (byEl[el][label] ?? 0) + 1
  }
  const parts = Object.entries(byEl).map(([el, counts]) => {
    const inner = Object.entries(counts)
      .sort((a, b) => b[1] - a[1])
      .map(([l, n]) => (n > 1 ? `${l} ×${n}` : l))
      .join(', ')
    return `${el} ${inner}`
  })
  return parts.length ? parts.join(' · ') : null
}

const structFg: string[] = isMolStruct ? (struct?.functional_groups ?? []) : []
const structChips: { k: string; v: string }[] = []
if (structFg.length) structChips.push({ k: `Functional group${structFg.length > 1 ? 's' : ''}`, v: structFg.join(', ') })
if (isMolStruct) {
  const hs = hybSummary(struct?.hybridization)
  if (hs) structChips.push({ k: 'Hybridisation', v: hs })
  if (struct?.vsepr_geometry) {
    // ⚠ В базе лежит "trigonal planar (around C1)" — C1 это ИНДЕКС АТОМА RDKit.
    // Читателю он не значит ничего, ровно как индексы в hybridization выше.
    // Режем любой хвостовой парентезис, а не только литерал " around".
    const shape = String(struct.vsepr_geometry).replace(/\s*\([^)]*\)\s*$/, '').trim()
    structChips.push({
      k: 'Molecular geometry',
      v: struct.vsepr_bond_angle ? `${shape} · ${struct.vsepr_bond_angle}° ideal` : shape,
    })
  }
  if (struct?.valence_electrons) {
    const lp = struct.lone_pairs ?? 0
    structChips.push({ k: 'Electron count', v: `${struct.valence_electrons} valence e⁻ · ${lp} lone pair${lp === 1 ? '' : 's'}` })
  }
}

const structRows: { label: string; value: string }[] = []
if (struct?.smiles) structRows.push({ label: 'SMILES', value: struct.smiles })
if (struct?.inchi) structRows.push({ label: 'InChI', value: struct.inchi })
if (struct?.inchikey) structRows.push({ label: 'InChIKey', value: struct.inchikey })

const structHeading = isMolStruct ? `${cap} molecular structure` : `${cap} structure`
// One sentence per kind, worded so it is true of every member of that kind.
const STRUCT_LEAD: Record<string, string> = {
  molecular: `${cap} is a molecular compound. The skeletal formula below is drawn from its PubChem SMILES string, and every value in this section is computed from that structure.`,
  ionic: `${cap} is an ionic compound — there is no discrete ${structFormula ?? name} molecule. The diagram shows the ions the crystal lattice is built from.`,
  element: `${cap} is a chemical element, not a compound. The identifiers below describe the atom itself; there is no bond framework between different atoms for us to draw.`,
  lattice: `${cap} is not a molecular compound. In the solid its atoms form an extended lattice, so ${structFormula ?? 'its formula'} is a formula unit — the ratio of atoms — and not a molecule. There is no skeletal formula to draw.`,
}
const structIntro = STRUCT_LEAD[structKind] ?? ''
const showStructure = Boolean(struct && structIntro)

// §-numbered sticky nav — only sections that actually render (hybrid nav, D3)
const navItems = [
  ...(substance ? [{ id: 's2', label: '§2 Hazards' }] : []),
  ...(showStructure ? [{ id: 'structure', label: '§3 Structure' }] : []),
  ...(hasFirstAid ? [{ id: 's4', label: '§4 First aid' }] : []),
  ...(hasFireSec ? [{ id: 's5', label: '§5 Fire' }] : []),
  ...(hasSpillSec ? [{ id: 's6', label: '§6 Spill' }] : []),
  ...(substance ? [{ id: 's7', label: '§7 Storage' }] : []),
  ...(showOel ? [{ id: 's8', label: '§8 Exposure' }] : []),
  ...(substance ? [{ id: 's9', label: '§9 Properties' }] : []),
  ...(substance && (reactiveGroups.length || nIncompat + nCaution > 0) ? [{ id: 's10', label: '§10 Reactivity' }] : []),
  ...(ateReal.length ? [{ id: 's11', label: '§11 Toxicology' }] : []),
  ...(ecoCards.length ? [{ id: 's12', label: '§12 Ecology' }] : []),
  ...(transportRows.length ? [{ id: 's14', label: '§14 Transport' }] : []),
  ...(regRows.length ? [{ id: 's15', label: '§15 Regulatory' }] : []),
  { id: 's16', label: '§16 Sources' },
  { id: 'msds', label: 'MSDS' },
  { id: 'faq', label: 'FAQ' },
]

// FAQ
const faq: { q: string; a: string }[] = []
faq.push({
  q: 'Is an MSDS the same as an SDS?',
  a: `In practice, yes. MSDS (Material Safety Data Sheet) is the older name for the same document. In the US, OSHA's Hazard Communication Standard (2012) adopted the GHS-standardised 16-section Safety Data Sheet; in the EU the SDS format is set by REACH Annex II. A document you find labelled "${name} MSDS" is today issued as an SDS.`,
})
if (substance && pictos.length) {
  faq.push({
    q: `What GHS pictograms does ${name} require?`,
    a: `Under the harmonised EU classification (CLP Annex VI), ${name} carries ${pictos.map((p: any) => p.code).join(' and ')} with the signal word "${substance.signal_word ?? '—'}". Hazard statements: ${(substance.h_statement_codes ?? []).join(', ')}. A supplier's SDS may add self-classified hazards on top of this harmonised minimum.`,
  })
}
if (substance && neverWith.length) {
  faq.push({
    q: `What should ${name} never be stored with?`,
    a: `Based on its storage class${storageClasses.length > 1 ? 'es' : ''} (${storageClasses.map((c: string) => shortForCode(c)).join(', ')}), ${name} must not share storage with: ${neverWith.map((s: any) => shortForCode(s.class)).join('; ')}. Verify against the supplier's SDS sections 7 and 10 before finalising storage.`,
  })
}
faq.push({
  q: `Where can I download an official ${name} SDS PDF?`,
  a: `From your own supplier — an SDS is issued per product and supplier, so the correct PDF for an inspection is the one matching the product you actually purchased. The supplier links on this page lead to the official SDS libraries of major distributors.`,
})

// Structured data
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'ChemicalSubstance',
    name: cap,
    url: canonical,
    ...(cas ? { identifier: cas } : {}),
    alternateName: [...synsDisplay, ...(formula ? [formula] : []), `${name} MSDS`],
    ...(substance?.molecular_formula ? { chemicalComposition: substance.molecular_formula } : {}),
    // The structure drawing is our own asset (RDKit from a public-domain SMILES
    // string), so it is safe to declare it as the image of the substance.
    // `image` is plain schema.org/Thing — no pending-vocabulary guesswork.
    ...(structSvg ? { image: `${SITE}${structSvg}` } : {}),
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: canonical,
    name: title,
    dateModified: buildDate,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'SDS library', item: `${SITE}/sds/` },
      { '@type': 'ListItem', position: 3, name: `${cap} SDS`, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]

// --- style tokens (mockup design language) ---
const mono = "font-family:'JetBrains Mono',ui-monospace,monospace;"
const grotesk = "font-family:'Space Grotesk',sans-serif;"
const sectionCls = 'scroll-mt-28'
// §-label above every section heading
const secLabelCls = 'text-[11px] font-semibold uppercase tracking-[0.11em] text-teal-600'
const h2Cls = 'mt-1.5 text-2xl sm:text-[29px] font-bold tracking-tight text-gray-900'
const cardLabelCls = 'text-[10px] uppercase tracking-[0.08em] text-gray-400'
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete={true}>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- HERO (S1) — mockup: navy gradient, teal dots, pills, side column -->
  <section class="relative overflow-hidden text-white hero-dots" style="background:linear-gradient(135deg,#0f172a 0%,#062A78 48%,#134e4a 100%);">
    <div class="absolute inset-0" style="background:linear-gradient(90deg,rgba(15,23,42,0.75) 0%,rgba(15,23,42,0) 65%);" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-11 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] items-start">
      <div>
        <nav class="text-sm text-slate-300 mb-5" aria-label="Breadcrumb">
          <a href="/sds/" class="hover:text-white transition-colors">SDS library</a>
          <span class="mx-1 text-slate-500">/</span>
          <span class="text-slate-200">{cap}</span>
        </nav>
        <p class="text-[11px] font-medium uppercase tracking-[0.11em] text-teal-300" style={mono}>
          Safety data sheet reference{cas && ` · CAS ${cas}`}
        </p>
        <h1 class="mt-2 text-4xl sm:text-[56px] font-bold tracking-tight leading-[1.02]" style={grotesk}>
          {cap} SDS
        </h1>
        <p class="mt-3 text-sm text-slate-300 max-w-2xl leading-relaxed">
          also: {alsoParts.join(' · ')}
        </p>

        {heroPills.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2.5">
            {heroPills.map((p) => (
              <span
                class={`inline-flex items-center gap-2 rounded-full border border-white/30 bg-slate-200/20 backdrop-blur-sm px-3.5 py-1.5 ${
                  p.mono ? 'text-[11.5px] tracking-[0.05em] text-slate-200' : 'text-[12.5px] font-semibold text-white'
                }`}
                style={p.mono ? mono : undefined}
              >
                {p.dot && <span class={`h-[7px] w-[7px] rounded-full ${p.dot}`} aria-hidden="true"></span>}
                {p.text}
              </span>
            ))}
          </div>
        )}

        {substance && pictos.length > 0 && (
          <div class="mt-6 flex flex-wrap items-end gap-4">
            {pictos.map((p: any) =>
              p.svg_content ? (
                <span class="flex flex-col items-center gap-1.5">
                  <span
                    class="inline-flex h-[66px] w-[66px] items-center justify-center rounded-[10px] bg-white p-1 shadow-[0_8px_24px_rgba(0,0,0,0.35)] [&>svg]:h-full [&>svg]:w-full"
                    set:html={p.svg_content}
                  />
                  <span class="text-[11px] text-slate-300">{p.name_en}</span>
                  <span class="text-[10px] text-slate-400" style={mono}>{p.code}</span>
                </span>
              ) : (
                <span class="inline-flex items-center rounded-lg bg-white/10 px-3 py-2 text-sm font-semibold">{p.code}</span>
              ),
            )}
          </div>
        )}
        {/* Variant selector (concentration / gas-vs-solution) renders here for
            template variants D/E once the variant data model exists — no live
            D/E page yet, so no selector markup ships today. */}
      </div>

      <!-- Hero side column: Emergency (gated, v1.5) + supplier PDF hand-off -->
      <div class="flex flex-col gap-3.5">
        {emergencyOn && (
          <label
            for="emg-toggle"
            role="button"
            tabindex="0"
            class="block w-full cursor-pointer rounded-xl border border-rose-400 p-5 text-left shadow-[0_0_0_1px_rgba(220,38,38,0.4),0_12px_34px_rgba(220,38,38,0.35)] transition hover:brightness-110"
            style="background:linear-gradient(135deg,#dc2626 0%,#991b1b 100%);"
          >
            <span class="block text-[10.5px] uppercase tracking-[0.12em] text-rose-200" style={mono}>Incident in progress</span>
            <span class="mt-1.5 block text-[22px] font-bold tracking-tight" style={grotesk}>Emergency mode →</span>
            <span class="mt-1 block text-[12.5px] text-white/80">First aid · fire · spill, full screen</span>
          </label>
        )}

        {suppliers.length > 0 && (
          <div class="rounded-xl border border-white/15 bg-white/[0.06] px-4 py-3.5">
            <p class="text-[10px] uppercase tracking-[0.1em] text-slate-400" style={mono}>Official PDF from supplier</p>
            <div class="mt-2.5 flex flex-wrap gap-2">
              {suppliers.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="nofollow noopener"
                  class="inline-flex items-center gap-1 rounded-[7px] border border-white/25 px-2.5 py-1 text-xs font-semibold text-slate-200 hover:border-teal-300 hover:text-white transition-colors"
                >
                  {s.label} ↗
                </a>
              ))}
            </div>
            <p class="mt-2.5 text-[11.5px] leading-relaxed text-slate-400">
              This page is a reference, not the legal document.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- STICKY §-NAV (hybrid nav, D3 — behaves like tabs on mobile) -->
  <nav class="sticky top-16 z-40 border-b border-gray-200 bg-white/95 backdrop-blur" aria-label="On this page">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-1 overflow-x-auto">
      {navItems.map((p) => (
        <a
          href={`#${p.id}`}
          class="shrink-0 whitespace-nowrap px-2.5 py-3 text-[11px] uppercase tracking-[0.06em] text-slate-500 hover:text-teal-700 transition-colors"
          style={mono}
        >
          {p.label}
        </a>
      ))}
    </div>
  </nav>

  <div class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-9 space-y-11">
      <SharePage url={canonical} title={`${cap} SDS — GHS hazards, classification & storage`} />

      <!-- IDENTITY STRIP (S1 + S3) -->
      {identity.length > 0 && (
        <section aria-label="Substance identifiers">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
            {identity.map((i) => (
              <div class="rounded-[10px] border border-gray-200 bg-white px-3 py-2.5">
                <p class={cardLabelCls} style={mono}>{i.label}</p>
                <p class="mt-1 text-sm font-semibold text-gray-900" style={mono}>{i.value}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {substance && (
        <>
          <!-- §2 HAZARDS -->
          <section id="s2" class={sectionCls}>
            <p class={secLabelCls} style={mono}>§ 02 · Hazards identification</p>
            <h2 class={h2Cls} style={grotesk}>{cap} harmonised EU classification</h2>
            <p class="mt-2 text-sm text-gray-500 max-w-2xl leading-relaxed">
              CLP Annex VI{substance.index_number && ` · Index ${substance.index_number}`}. A supplier SDS may add
              self-classified hazards — this is the legal minimum.
            </p>

            {(page.template_variant === 'D' || page.template_variant === 'E') && (
              <div class="mt-4 max-w-3xl rounded-[10px] border border-amber-200 bg-amber-50 px-4 py-3">
                <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-amber-800" style={mono}>
                  Concentration / form dependent — CLP Note B
                </p>
                <p class="mt-1 text-[13px] leading-relaxed text-amber-900">
                  {cap} is placed on the market in different concentrations or forms whose classification can
                  differ. This page shows the harmonised Annex VI entry for the substance as such — always match
                  the supplier's SDS to the concentration and form you actually use.
                </p>
              </div>
            )}

            {isPetroleumUvcb && (
              <div class="mt-4 max-w-3xl rounded-[10px] border border-amber-200 bg-amber-50 px-4 py-3">
                <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-amber-800" style={mono}>
                  Petroleum UVCB — entry covers the listed classes only
                </p>
                <p class="mt-1 text-[13px] leading-relaxed text-amber-900">
                  {cap} is a petroleum UVCB (substance of unknown or variable composition). Its harmonised
                  Annex VI entry covers only the hazard classes listed on this page — for every other hazard
                  class, suppliers self-classify under CLP Art. 4{uvcbLacksFlam &&
                    ', which is why market fuels typically add flammability (e.g. Flam. Liq. 3, H226) that this entry does not carry'}.
                  Always match the supplier&rsquo;s SDS for the actual product you use.
                </p>
                {substance.index_number === '649-378-00-4' && (
                  <p class="mt-1.5 text-[13px] leading-relaxed text-amber-900">
                    <span class="font-semibold">CLP Note P:</span> the harmonised carcinogen and mutagen
                    classification need not apply if the substance contains less than 0.1&nbsp;% w/w benzene
                    (EC 200-753-7) — the supplier&rsquo;s SDS states the classification that applies.
                  </p>
                )}
              </div>
            )}

            <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] items-start">
              <div class="flex flex-col gap-2">
                {hRows.map((h: any) => (
                  <div class="flex items-baseline gap-3.5 rounded-[10px] border border-rose-200 bg-rose-50 px-3.5 py-3">
                    <a
                      href={hHref(h.code)}
                      class="min-w-[52px] shrink-0 text-sm font-bold text-rose-800 underline decoration-rose-300 underline-offset-2 hover:text-rose-900"
                      style={mono}
                    >{h.code}</a>
                    <span class="flex-1">
                      <span class="block text-[14.5px] text-slate-800">{h.text_en}</span>
                      {CLP_CLASS[h.code] && (
                        <span class="mt-0.5 block text-xs text-gray-500">{CLP_CLASS[h.code]}</span>
                      )}
                    </span>
                  </div>
                ))}
                {euhRows.map((h: any) => (
                  <div class="flex items-baseline gap-3.5 rounded-[10px] border border-amber-200 bg-amber-50 px-3.5 py-3">
                    <a
                      href={hHref(h.code)}
                      class="min-w-[52px] shrink-0 text-sm font-bold text-amber-800 underline decoration-amber-300 underline-offset-2 hover:text-amber-900"
                      style={mono}
                    >{h.code}</a>
                    <span class="flex-1">
                      <span class="block text-[14.5px] text-slate-800">{h.text_en}</span>
                      <span class="mt-0.5 block text-xs text-gray-500">EU supplementary hazard statement (CLP Annex VI)</span>
                    </span>
                  </div>
                ))}
              </div>

              {pRows.length > 0 && (
                <div>
                  <h3 class="text-[15px] font-semibold text-gray-900" style={grotesk}>Precautionary statements</h3>
                  <div class="mt-2.5 grid gap-1.5">
                    {pRows.map((p: any) => (
                      <div class="flex gap-3 rounded-lg border border-teal-100 bg-teal-50/60 px-3 py-2">
                        <a
                          href={`/p-statements/${p.code}/`}
                          class="min-w-[44px] shrink-0 text-[11.5px] font-bold text-teal-800 underline decoration-teal-300 underline-offset-2 hover:text-teal-900"
                          style={mono}
                          title={`What ${p.code} means, and where it is still current`}
                        >{p.code}</a>
                        <span class="text-[12.5px] leading-relaxed text-slate-700">{p.text_en}</span>
                      </div>
                    ))}
                  </div>
                  {/* Коды-заголовки (P301 «IF SWALLOWED:», P305 «IF IN EYES:» …) официально
                      кончаются двоеточием: на этикетке они печатаются только внутри комбинаций.
                      Без этой строки они читаются как обрубок — вопрос возник на живой странице. */}
                  {pRows.some((p: any) => (p.text_en ?? '').trim().endsWith(':')) && (
                    <p class="mt-2.5 text-[11.5px] leading-relaxed text-slate-500">
                      Codes ending in a colon introduce the action that follows — on a label they are
                      printed as combined statements, such as{' '}
                      <a href="/p-statements/P305/" class="underline decoration-slate-300 underline-offset-2 hover:text-slate-700">P305+P351+P338</a>.
                    </p>
                  )}
                </div>
              )}
            </div>
          </section>
        </>
      )}

      <!-- VARIANT B / C — honest fallback. Moved out of the §2…§15 branch in
           session 16: §4/§5/§6 render for these pages too, so the "no harmonised
           classification" note has to sit ABOVE them, not instead of them. -->
      {!substance && (
        <section class="rounded-xl border border-gray-200 bg-white p-6">
          {page.template_variant === 'C' ? (
            <>
              <h2 class="text-xl font-bold text-gray-900" style={grotesk}>This is a product, not a single substance</h2>
              <p class="mt-2 text-sm text-gray-700 leading-relaxed">
                {cap} is a formulated product / mixture. Its hazard profile depends on the exact formulation,
                so there is no single harmonised classification we could honestly show here — the authoritative
                document is the SDS issued by the manufacturer of the specific product you purchased. Use the
                supplier links above to obtain it.
              </p>
            </>
          ) : (
            <>
              <h2 class="text-xl font-bold text-gray-900" style={grotesk}>No harmonised EU classification</h2>
              <p class="mt-2 text-sm text-gray-700 leading-relaxed">
                {cap} has no entry in CLP Annex VI — there is no harmonised EU-wide classification for it.
                <strong> That is not evidence of safety.</strong> Suppliers remain obliged to self-classify it
                under CLP, and workplace hazards (dust, asphyxiation, thermal) can exist without a harmonised
                entry. Always obtain the supplier's SDS for the product you actually use.
              </p>
            </>
          )}
          {hasFirstAid && (
            <p class="mt-3 border-t border-gray-100 pt-3 text-[13px] text-gray-600 leading-relaxed">
              Published emergency-response data does exist for {name} and is reproduced below — first aid,
              fire fighting and spill response come from US federal sources, not from a harmonised
              classification.
            </p>
          )}
        </section>
      )}

      <!-- §3 COMPOSITION / STRUCTURE — session 26. Renders on the 96 pages whose
           substance_structure row carries a PubChem CID. 81 of those get an RDKit
           drawing from public/structures/; the remaining 15 are elements and
           lattice solids, where a picture of a discrete molecule would be a
           chemical lie — they get the identifiers and one honest sentence.
           ⚠ The anchor is #structure, not #s3: the section answers the
           "<substance> structure" query, and that is the id worth linking to.
           ⚠ Formula and molar mass are deliberately NOT repeated here — they are
           already in the identity strip at the top of the page. -->
      {showStructure && (
        <section id="structure" class={sectionCls}>
          <p class={secLabelCls} style={mono}>§ 03 · Composition and identifiers</p>
          <h2 class={h2Cls} style={grotesk}>{structHeading}</h2>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-gray-600">{structIntro}</p>

          <div class={`mt-4 grid overflow-hidden rounded-xl border border-gray-200 bg-white${structSvg ? ' sm:grid-cols-[minmax(0,300px)_minmax(0,1fr)]' : ''}`}>
            {structSvg && (
              <div
                class="flex flex-col items-center justify-center border-b border-gray-200 px-4 py-4 sm:border-b-0 sm:border-r"
                style="background:linear-gradient(135deg,#f0fdfa 0%,#fff 70%);"
              >
                <img
                  src={structSvg}
                  width="400"
                  height="280"
                  loading="lazy"
                  decoding="async"
                  alt={isMolStruct
                    ? `Skeletal formula of ${name}${structFormula ? ` (${structFormula})` : ''}`
                    : `Ions of ${name}${structFormula ? ` (${structFormula})` : ''}`}
                  class="h-auto w-full max-w-[260px]"
                />
                <p class="mt-1.5 text-center text-[10.5px] text-gray-500" style={mono}>
                  {isMolStruct ? '2D skeletal formula' : `Ions of ${name}`}
                  {structFormula ? ` · ${structFormula}` : ''}
                </p>
              </div>
            )}
            <div class="flex flex-col justify-center">
              {structRows.map((r) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-slate-100 px-4 py-3">
                  <span class="shrink-0 text-[13.5px] text-gray-500">{r.label}</span>
                  <span class="break-all text-right text-[12.5px] font-semibold text-gray-900" style={mono}>{r.value}</span>
                </div>
              ))}
              <div class="flex items-baseline justify-between gap-4 px-4 py-3">
                <span class="shrink-0 text-[13.5px] text-gray-500">PubChem CID</span>
                <a
                  href={`https://pubchem.ncbi.nlm.nih.gov/compound/${struct.pubchem_cid}`}
                  rel="noopener nofollow"
                  target="_blank"
                  class="text-[13px] font-semibold text-teal-700 hover:underline"
                  style={mono}
                >{struct.pubchem_cid} →</a>
              </div>
            </div>
          </div>

          {structChips.length > 0 && (
            <div class="mt-2.5 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
              {structChips.map((c) => (
                <div class="rounded-xl border border-gray-200 bg-white px-4 py-3.5">
                  <p class="text-[10px] uppercase tracking-[0.09em] text-teal-700 font-semibold" style={mono}>{c.k}</p>
                  <p class="mt-1.5 text-[15px] font-semibold leading-snug text-gray-900">{c.v}</p>
                </div>
              ))}
            </div>
          )}

          <p class="mt-2 text-[10.5px] leading-relaxed text-gray-400" style={mono}>
            Identifiers from PubChem (NIH, public domain).
            {structSvg ? ' Structure diagram drawn with RDKit from the SMILES string.' : ''}
            {isMolStruct ? ' Geometry and hybridisation are computed from the connection table, not measured.' : ''}
          </p>
        </section>
      )}

      <!-- §4 FIRST AID — substance_response (session 16). Renders for every
           template variant: response data does not depend on Annex VI. -->
      {hasFirstAid && (
        <section id="s4" class={sectionCls}>
          <p class={secLabelCls} style={mono}>§ 04 · First-aid measures</p>
          <h2 class={h2Cls} style={grotesk}>{cap} first aid measures</h2>
          <div class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3">
            <p class="text-[13px] leading-relaxed text-rose-900">
              <strong>Call your national emergency number first.</strong> These are published first-aid
              measures, not medical advice, and they do not replace emergency services, a poison control
              centre or the supplier's safety data sheet.
            </p>
          </div>
          {faRoutes.length > 0 ? (
            <div class="mt-5 grid gap-2.5 sm:grid-cols-2">
              {faRoutes.map((r: any) => (
                <div class="rounded-xl border border-gray-200 bg-white px-4 py-4">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-rose-700" style={mono}>{r.route}</p>
                  <div set:html={rBlock(r.text)} />
                </div>
              ))}
            </div>
          ) : (
            <div class="mt-5 rounded-xl border border-gray-200 bg-white px-5 py-4" set:html={rBlock(response.first_aid)} />
          )}
          <p class="mt-2 text-[10.5px] text-gray-400" style={mono}>{rSrc(response.first_aid_src)}</p>
        </section>
      )}

      <!-- §5 FIRE-FIGHTING -->
      {hasFireSec && (
        <section id="s5" class={sectionCls}>
          <p class={secLabelCls} style={mono}>§ 05 · Fire-fighting measures</p>
          <h2 class={h2Cls} style={grotesk}>{cap} fire fighting measures</h2>
          {response.erg_guide_no && (
            <>
              <a
                href="https://www.phmsa.dot.gov/hazmat/erg/emergency-response-guidebook-erg"
                target="_blank"
                rel="noopener"
                class="mt-3 inline-flex items-center gap-2 rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-[11.5px] font-semibold text-amber-900 transition-colors hover:bg-amber-100"
                style={mono}
              >
                ERG 2024 · GUIDE {response.erg_guide_no}
                <span class="font-normal text-amber-800">{response.erg_guide_title}</span>
              </a>
              <p class="mt-2 max-w-2xl text-[11.5px] leading-relaxed text-gray-500">
                ERG guidance is written per response guide, not per substance — Guide {response.erg_guide_no}
                covers every material assigned to it, so a few sentences reference other UN numbers in the
                same group.
              </p>
            </>
          )}
          {response.fire_haz && (
            <div class="mt-5 rounded-xl border border-rose-200 px-5 py-4" style="background:linear-gradient(135deg,#fef2f2 0%,#fff 70%);">
              <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-rose-700" style={mono}>Fire and explosion hazard</p>
              <div set:html={rBlock(response.fire_haz)} />
            </div>
          )}
          {response.fire_fight && (
            <div class="mt-2.5 rounded-xl border border-gray-200 bg-white px-5 py-4">
              <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-gray-500" style={mono}>Extinguishing media and tactics</p>
              <div set:html={rBlock(response.fire_fight)} />
            </div>
          )}
          <p class="mt-2 text-[10.5px] text-gray-400" style={mono}>{rSrc(response.fire_fight_src ?? response.fire_haz_src)}</p>
        </section>
      )}

      <!-- §6 ACCIDENTAL RELEASE -->
      {hasSpillSec && (
        <section id="s6" class={sectionCls}>
          <p class={secLabelCls} style={mono}>§ 06 · Accidental release measures</p>
          <h2 class={h2Cls} style={grotesk}>{cap} spill and leak response</h2>
          {response.non_fire_resp && (
            <div class="mt-5 rounded-xl border border-gray-200 bg-white px-5 py-4">
              <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-gray-500" style={mono}>Containment and clean-up</p>
              <div set:html={rBlock(response.non_fire_resp)} />
            </div>
          )}
          {response.isolation && (
            <div class="mt-2.5 rounded-xl border border-amber-300 px-5 py-4" style="background:linear-gradient(135deg,#fffbeb 0%,#fff 70%);">
              <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-amber-800" style={mono}>Initial isolation and evacuation</p>
              <div set:html={rBlock(response.isolation)} />
            </div>
          )}
          <p class="mt-2 text-[10.5px] text-gray-400" style={mono}>{rSrc(response.non_fire_resp_src ?? response.isolation_src)}</p>
        </section>
      )}

      {substance && (
        <>
          <!-- §7 HANDLING & STORAGE (the computed differentiator) -->
          <section id="s7" class={sectionCls}>
            <p class={secLabelCls} style={mono}>§ 07 · Handling and storage</p>
            <h2 class={h2Cls} style={grotesk}>{cap} computed storage compatibility</h2>

            <div class="mt-5 overflow-hidden rounded-[14px] border border-teal-200 bg-white">
              <!-- dark verdict header -->
              <div class="flex flex-wrap items-center gap-3 px-5 py-4 text-white sm:px-6" style="background:linear-gradient(135deg,#0f766e 0%,#134e4a 100%);">
                <span class="text-lg sm:text-xl font-bold tracking-tight" style={grotesk}>{verdictHeadline}</span>
                {storageClasses.map((c: string) => (
                  <a
                    href={urlForCode(c)}
                    class="inline-flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 px-3 py-1 text-[11px] tracking-[0.06em] hover:bg-white/20 transition-colors"
                    style={mono}
                  >
                    {shortForCode(c)}
                  </a>
                ))}
              </div>
              <div class="px-5 py-5 sm:px-6">
                <p class="text-sm leading-relaxed text-slate-700">
                  Derived from CLP Annex VI classification and CAMEO reactive-group data — not copied from a PDF.
                </p>

                {specialFlags.length > 0 && (
                  <p class="mt-3">
                    {specialFlags.map((f: string) => (
                      <span class="mr-1.5 inline-flex items-center rounded-md bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900">⚠ {f}</span>
                    ))}
                  </p>
                )}

                {neverWith.length > 0 && (
                  <div class="mt-4">
                    <p class="text-[10px] uppercase tracking-[0.09em] text-rose-600 font-semibold" style={mono}>⛔ Never store with</p>
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      {neverWith.map((c: any) => (
                        <a href={urlForCode(c.class)} class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-3 py-1 text-[12.5px] font-medium text-rose-700 hover:bg-rose-100 transition-colors">
                          {shortForCode(c.class)}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {keepSeparate.length > 0 && (
                  <div class="mt-4">
                    <p class="text-[10px] uppercase tracking-[0.09em] text-amber-700 font-semibold" style={mono}>↔ Keep separate</p>
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      {keepSeparate.map((c: any) => (
                        <a href={urlForCode(c.class)} class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-[12.5px] font-medium text-amber-800 hover:bg-amber-100 transition-colors">
                          {shortForCode(c.class)}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <p class="mt-5 text-sm">
                  <a href={`${TOOL}?substance=${encodeURIComponent(substance.cas_number)}`} class="font-semibold text-teal-700 hover:underline">
                    Full interactive verdict — reactions, gas release on contact, ADR forms →
                  </a>
                </p>
              </div>
            </div>
          </section>
        </>
      )}

      <!-- §8 EXPOSURE CONTROLS — IDLH from NIOSH (session 27).
           ⚠⚠ Deliberately OUTSIDE the {substance && …} branch. IDLH is a NIOSH
           figure and has nothing to do with CLP Annex VI: 16 of the 76 pages
           that have a Pocket Guide entry (urea, gasoline, kerosene, glycerin,
           ethylene glycol …) hold no row in `substances` at all. Inside the
           branch this section silently rendered on 60 pages instead of 76 —
           the same reasoning that moved §4/§5/§6 out of it in session 16.
           OSHA PEL / NIOSH REL / EU IOELV still to come from PubChem LCSS.
           NEVER ACGIH TLV (© private body) — see D11 drop list. -->
      {showOel && (
        <section id="s8" class={sectionCls}>
          <p class={secLabelCls} style={mono}>§ 08 · Exposure controls</p>
          <h2 class={h2Cls} style={grotesk}>{cap} exposure limits (IDLH)</h2>
          {idlhValue != null ? (
            <div
              class="mt-5 flex flex-col gap-2 rounded-xl border border-rose-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
              style="background:linear-gradient(135deg,#fef2f2 0%,#fff 70%);"
            >
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-rose-700" style={mono}>IDLH</p>
                <p class="mt-1 text-[12.5px] text-gray-600">Immediately Dangerous to Life or Health</p>
              </div>
              <p class="whitespace-nowrap text-[27px] font-bold text-gray-900 sm:text-[29px]" style={mono}>
                {idlhValue.toLocaleString('en-US')}
                <span class="ml-1.5 text-[14px] font-semibold text-gray-500">{idlhUnit}</span>
              </p>
            </div>
          ) : (
            <div class="mt-5 rounded-xl border border-gray-200 bg-gray-50 px-5 py-4">
              <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-gray-500" style={mono}>IDLH</p>
              <p class="mt-1.5 text-[13.5px] text-gray-700">
                NIOSH lists {name} in the Pocket Guide but has not established an IDLH value for it.
              </p>
            </div>
          )}
          {idlhAsElement && (
            <p class="mt-2.5 max-w-2xl text-[12.5px] leading-relaxed text-gray-600">
              The limit is expressed as {idlhAsElement}, not as the mass of {name} itself.
            </p>
          )}
          {idlhFromOther && (
            <div class="mt-2.5 rounded-xl border border-amber-300 px-5 py-3.5" style="background:linear-gradient(135deg,#fffbeb 0%,#fff 70%);">
              <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-amber-800" style={mono}>Published for another entry</p>
              <p class="mt-1.5 text-[13px] leading-relaxed text-gray-700">
                NIOSH published this value for <strong>{idlhFromOther}</strong>, not for {name} under its own name.
              </p>
            </div>
          )}
          {idlhFromLel && (
            <div class="mt-2.5 rounded-xl border border-gray-200 bg-white px-5 py-3.5">
              <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-gray-500" style={mono}>Flammability-based</p>
              <p class="mt-1.5 text-[13px] leading-relaxed text-gray-700">
                Set at 10% of the lower explosive limit. It marks where the atmosphere becomes a fire
                hazard, not where {name} becomes acutely toxic.
              </p>
            </div>
          )}
          {idlhCarcinogen && (
            <div class="mt-2.5 rounded-xl border border-orange-300 px-5 py-3.5" style="background:linear-gradient(135deg,#fff7ed 0%,#fff 70%);">
              <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-orange-800" style={mono}>Carcinogen</p>
              <p class="mt-1.5 text-[13px] leading-relaxed text-gray-700">
                NIOSH lists {name} as a potential occupational carcinogen — exposure should be kept as low
                as achievable regardless of the IDLH figure.
              </p>
            </div>
          )}
          <p class="mt-3.5">
            <a
              href={nioshHref}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg border border-teal-300 bg-teal-50 px-3 py-1.5 text-[11.5px] font-semibold text-teal-900 transition-colors hover:bg-teal-100"
              style={mono}
            >
              NIOSH Pocket Guide — {cap} →
            </a>
          </p>
          <p class="mt-2.5 max-w-3xl text-[10.5px] leading-relaxed text-gray-400" style={mono}>
            IDLH from the NIOSH Pocket Guide to Chemical Hazards (CDC, U.S. public domain), via CAMEO Chemicals.
            Occupational exposure limits — OSHA PEL, NIOSH REL and EU IOELV — are not published on this page yet.
          </p>
        </section>
      )}

      {substance && (
        <>
          <!-- §9 PHYSICAL & CHEMICAL PROPERTIES — fire values first -->
          {(hasFire || physRows.length > 0) ? (
            <section id="s9" class={sectionCls}>
              <p class={secLabelCls} style={mono}>§ 09 · Physical and chemical properties</p>
              <h2 class={h2Cls} style={grotesk}>{cap} physical properties</h2>
              {hasFire && (
                <p class="mt-2 text-sm text-gray-500 max-w-2xl leading-relaxed">
                  Fire-relevant values first — flash point and explosion limits decide the storage and
                  ventilation regime.
                </p>
              )}

              {hasFire && (
                <div class="mt-5 grid gap-2.5 sm:grid-cols-3">
                  {flashPoint != null && (
                    <div class="rounded-xl border border-rose-200 px-4 py-4" style="background:linear-gradient(135deg,#fef2f2 0%,#fff 70%);">
                      <p class="text-[10px] uppercase tracking-[0.09em] text-rose-700 font-semibold" style={mono}>Flash point</p>
                      <p class="mt-1.5 text-3xl font-bold tracking-tight text-rose-900" style={grotesk}>{flashPoint} °C</p>
                    </div>
                  )}
                  {lel != null && uel != null && (
                    <div class="rounded-xl border border-rose-200 px-4 py-4" style="background:linear-gradient(135deg,#fef2f2 0%,#fff 70%);">
                      <p class="text-[10px] uppercase tracking-[0.09em] text-rose-700 font-semibold" style={mono}>Explosion limits</p>
                      <p class="mt-1.5 text-3xl font-bold tracking-tight text-rose-900" style={grotesk}>{lel} – {uel} %</p>
                      <p class="mt-1 text-xs text-gray-400">LEL / UEL in air, vol.</p>
                    </div>
                  )}
                  {autoignition != null && (
                    <div class="rounded-xl border border-rose-200 px-4 py-4" style="background:linear-gradient(135deg,#fef2f2 0%,#fff 70%);">
                      <p class="text-[10px] uppercase tracking-[0.09em] text-rose-700 font-semibold" style={mono}>Autoignition</p>
                      <p class="mt-1.5 text-3xl font-bold tracking-tight text-rose-900" style={grotesk}>{autoignition} °C</p>
                    </div>
                  )}
                </div>
              )}

              {physRows.length > 0 && (
                <div class="mt-2.5 overflow-hidden rounded-xl border border-gray-200 bg-white">
                  <div class="grid sm:grid-cols-2">
                    {physRows.map((r) => (
                      <div class="flex items-baseline justify-between gap-4 border-b border-slate-100 px-4 py-3 sm:odd:border-r">
                        <span class="text-[13.5px] text-gray-500">{r.label}</span>
                        <span class="text-[13px] font-semibold text-gray-900 text-right" style={mono}>{r.value}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              <p class="mt-2 text-[10.5px] text-gray-400" style={mono}>Source: CAMEO Chemicals (NOAA, public domain); per-value source references stored in the database.</p>
            </section>
          ) : (
            <section id="s9" class={sectionCls}>
              <p class={secLabelCls} style={mono}>§ 09 · Physical and chemical properties</p>
              <h2 class={h2Cls} style={grotesk}>{cap} physical properties</h2>
              <p class="mt-2 text-sm text-gray-500 max-w-2xl">
                The full physical-property table (melting/boiling point, flash point, explosion limits, vapour
                pressure, density) is being populated for this substance from ECHA registration data and will
                appear here as it lands.
              </p>
            </section>
          )}

          <!-- §10 STABILITY & REACTIVITY -->
          {(reactiveGroups.length > 0 || nIncompat + nCaution > 0) && (
            <section id="s10" class={sectionCls}>
              <p class={secLabelCls} style={mono}>§ 10 · Stability and reactivity</p>
              <div class="mt-3.5 grid gap-6 rounded-xl border border-gray-200 bg-white px-5 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:px-6">
                <p class="text-[14.5px] leading-relaxed text-slate-700">
                  {reactiveGroups.length > 0 && (
                    <>Reactive group (CAMEO/NOAA): <strong>{reactiveGroups.join(', ')}</strong>. </>
                  )}
                  {nIncompat + nCaution > 0 && (
                    <>
                      Our database documents <strong>{nIncompat} incompatible</strong> and{' '}
                      <strong>{nCaution} caution</strong> reaction-partner groups for {name} — including which
                      combinations release gas on contact.
                    </>
                  )}
                  <a href={`${TOOL}?substance=${encodeURIComponent(substance.cas_number)}`} class="mt-2 inline-block font-semibold text-teal-700 hover:underline">
                    See the per-partner breakdown with gas release →
                  </a>
                </p>
                {nIncompat + nCaution > 0 && (
                  <div class="flex gap-2.5">
                    <div class="rounded-[10px] border border-rose-200 bg-rose-50 px-4 py-3 text-center">
                      <p class="text-[28px] font-bold leading-none text-rose-700" style={grotesk}>{nIncompat}</p>
                      <p class="mt-1.5 text-[10px] uppercase tracking-[0.08em] text-rose-700" style={mono}>Incompatible</p>
                    </div>
                    <div class="rounded-[10px] border border-orange-200 bg-orange-50 px-4 py-3 text-center">
                      <p class="text-[28px] font-bold leading-none text-orange-700" style={grotesk}>{nCaution}</p>
                      <p class="mt-1.5 text-[10px] uppercase tracking-[0.08em] text-orange-700" style={mono}>Caution</p>
                    </div>
                  </div>
                )}
              </div>
            </section>
          )}

          <!-- §11 TOXICOLOGY — hidden until a real (> 0) ATE exists -->
          {ateReal.length > 0 && (
            <section id="s11" class={sectionCls}>
              <p class={secLabelCls} style={mono}>§ 11 · Toxicological information</p>
              <h2 class={h2Cls} style={grotesk}>{cap} acute toxicity estimates</h2>

              <div class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-white">
                <div class="flex flex-wrap items-center gap-3 border-b border-teal-100 bg-teal-50/60 px-4 py-3">
                  <span class="text-[10px] uppercase tracking-[0.09em] text-teal-700" style={mono}>Acute tox. classification</span>
                  <span class="text-[13.5px] font-semibold text-teal-900">
                    {acuteToxCodes.length > 0
                      ? `Classified under CLP: ${acuteToxCodes.join(', ')}`
                      : 'Not classified under CLP — no acute-toxicity H-code'}
                  </span>
                </div>
                <table class="w-full border-collapse text-[13.5px]">
                  <thead>
                    <tr class="bg-slate-50 text-left">
                      <th class="px-4 py-2.5 text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500" style={mono}>Route</th>
                      <th class="px-4 py-2.5 text-right text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500" style={mono}>ATE value</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ateRoutes.map((r) => (
                      <tr class="border-t border-slate-100 even:bg-slate-50/50">
                        <td class="px-4 py-2.5 text-slate-700">{r.label}</td>
                        <td class={`px-4 py-2.5 text-right ${r.value != null ? 'font-semibold text-gray-900' : 'text-gray-400'}`} style={mono}>
                          {r.value != null ? r.value : 'No data'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="border-t border-slate-100 bg-slate-50 px-4 py-2.5 text-xs leading-relaxed text-gray-500">
                  Acute Toxicity Estimates (ATE) are regulatory values used for classification under CLP and OSHA
                  HCS Appendix A — not a measure of "safe dose". Empty routes render as "No data", never as a
                  numeric zero.
                </p>
              </div>
            </section>
          )}

          <!-- §12 ECOLOGY — live-wired, hidden until the eco import fills lc50/ec50 -->
          {ecoCards.length > 0 && (
            <section id="s12" class={sectionCls}>
              <p class={secLabelCls} style={mono}>§ 12 · Ecological information</p>
              <h2 class={h2Cls} style={grotesk}>{cap} aquatic toxicity</h2>
              <div class="mt-5 grid gap-2.5 sm:grid-cols-3">
                {ecoCards.map((c) => (
                  <div class="rounded-xl border border-gray-200 bg-white px-4 py-4">
                    <p class={cardLabelCls} style={mono}>{c.label}</p>
                    <p class="mt-1.5 text-2xl font-bold tracking-tight text-gray-900" style={grotesk}>{c.value}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- §13 DISPOSAL -->
          <section id="s13" class={sectionCls}>
            <p class={secLabelCls} style={mono}>§ 13 · Disposal considerations</p>
            <p class="mt-3 max-w-3xl text-[14.5px] leading-relaxed text-slate-700">
              Dispose of waste and residues in accordance with local and national regulations — in the EU under
              the Waste Framework Directive 2008/98/EC. Never discharge to drains or municipal waste; hand
              contaminated packaging and unused product to an authorised waste-disposal company. The supplier's
              SDS section 13 lists the applicable waste codes for the specific product.
            </p>
          </section>

          <!-- §14 TRANSPORT -->
          {transportRows.length > 0 && (
            <section id="s14" class={sectionCls}>
              <p class={secLabelCls} style={mono}>§ 14 · Transport information</p>
              <h2 class={h2Cls} style={grotesk}>{cap} road transport — ADR {adrVersion}</h2>

              <div class="mt-5 space-y-5">
                {transportRows.map((t: any) => (
                  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_260px] items-start">
                    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3">
                      <div class="rounded-[10px] border border-gray-200 bg-white px-3.5 py-3">
                        <p class={cardLabelCls} style={mono}>UN number</p>
                        <p class="mt-1 text-[15px] font-semibold text-gray-900" style={mono}>UN {t.un}</p>
                      </div>
                      {t.name && (
                        <div class="rounded-[10px] border border-gray-200 bg-white px-3.5 py-3">
                          <p class={cardLabelCls} style={mono}>Proper shipping name</p>
                          <p class="mt-1 text-sm font-semibold text-gray-900">{t.name}</p>
                        </div>
                      )}
                      <div class="rounded-[10px] border border-gray-200 bg-white px-3.5 py-3">
                        <p class={cardLabelCls} style={mono}>Class · PG</p>
                        <p class="mt-1 text-[15px] font-semibold text-gray-900" style={mono}>{t.class}{t.pg ? ` · ${t.pg}` : ''}</p>
                      </div>
                      {t.code && (
                        <div class="rounded-[10px] border border-gray-200 bg-white px-3.5 py-3">
                          <p class={cardLabelCls} style={mono}>Classification code</p>
                          <p class="mt-1 text-[15px] font-semibold text-gray-900" style={mono}>{t.code}</p>
                        </div>
                      )}
                      {t.cat != null && (
                        <div class="rounded-[10px] border border-gray-200 bg-white px-3.5 py-3">
                          <p class={cardLabelCls} style={mono}>Transport category</p>
                          <p class="mt-1 text-[15px] font-semibold text-gray-900" style={mono}>{t.cat}</p>
                        </div>
                      )}
                      {t.labels.length > 0 && (
                        <div class="rounded-[10px] border border-gray-200 bg-white px-3.5 py-3">
                          <p class={cardLabelCls} style={mono}>ADR labels</p>
                          <p class="mt-1 text-[15px] font-semibold text-gray-900" style={mono}>{t.labels.join(', ')}</p>
                        </div>
                      )}
                      {/* Tunnel-restriction letter + Limited Quantity cards join
                          this grid at their import — tunnel_code in the DB is the
                          KEMLER number (rendered on the plate), not the letter. */}
                    </div>

                    {t.kemler && (
                      <div class="rounded-xl border border-gray-200 bg-white px-4 py-4 text-center">
                        <p class={cardLabelCls} style={mono}>Hazard ID (Kemler) / UN plate</p>
                        <div class="mx-auto mt-3 w-[176px] rounded-[5px] border-[3px] border-zinc-900" style="background:#f97316;">
                          <div class="border-b-[3px] border-zinc-900 py-1.5 text-[38px] font-bold leading-[1.05] tracking-[0.06em] text-zinc-900" style={mono}>{t.kemler}</div>
                          <div class="py-1.5 text-[38px] font-bold leading-[1.05] tracking-[0.06em] text-zinc-900" style={mono}>{t.un}</div>
                        </div>
                        <p class="mt-2.5 text-xs leading-relaxed text-gray-500">
                          Top: hazard identification number (Kemler). Bottom: UN number — as carried on the
                          orange plate of the transport unit.
                        </p>
                      </div>
                    )}
                  </div>
                ))}
              </div>
              <p class="mt-2 text-[10.5px] text-gray-400" style={mono}>
                Source: UN ADR {adrVersion} (ECE/TRANS/352), Table A. Road (ADR) only — for sea (IMDG) and air (IATA), consult the supplier's SDS §14.
              </p>
            </section>
          )}

          <!-- §15 REGULATORY — hidden until Step-4 import (substance_regulatory_status) -->
          {regRows.length > 0 && (
            <section id="s15" class={sectionCls}>
              <p class={secLabelCls} style={mono}>§ 15 · Regulatory information</p>
              <h2 class={h2Cls} style={grotesk}>{cap} regulatory status</h2>
            </section>
          )}
        </>
      )}

      <!-- MSDS vs SDS -->
      <section id="msds" class={sectionCls}>
        <p class={secLabelCls} style={mono}>MSDS vs SDS</p>
        <h2 class={h2Cls} style={grotesk}>{cap} MSDS vs SDS: is there a difference?</h2>
        <p class="mt-2 text-sm text-gray-700 leading-relaxed max-w-3xl">
          MSDS (Material Safety Data Sheet) is the older name for the same document. In the US, OSHA's Hazard
          Communication Standard (2012) adopted the GHS-standardised 16-section Safety Data Sheet; in the EU the
          format is set by REACH Annex II. So a "{name} MSDS" and a "{name} SDS" refer to the same document —
          today it is issued as an SDS.
          <a href="/compliance/sds/sds-vs-msds-differences/" class="font-semibold text-teal-700 hover:underline">
            Full breakdown of the differences →
          </a>
        </p>
      </section>

      <!-- SDS MANAGER (affiliate) -->
      <SdsManagerCard service="management" href="https://sdsmanager.com/us/sds-management?fpr=ghs3&fp_sid=sdspage" />

      <!-- SIMILAR SUBSTANCES -->
      {similar.length > 0 && storageClasses.length > 0 && (
        <section>
          <h2 class="text-xl font-bold text-gray-900" style={grotesk}>
            Other {shortForCode(storageClasses[0]).toLowerCase()} in our database
          </h2>
          <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
            {similar.map((s: any) => (
              <li>
                <a
                  href={liveMap[s.cas] ? `/sds/${liveMap[s.cas]}/` : `${TOOL}?substance=${encodeURIComponent(s.cas)}`}
                  class="flex flex-col rounded-lg border border-gray-200 bg-white px-3 py-2.5 hover:border-teal-300 hover:bg-teal-50/50 transition-all"
                >
                  <span class="text-sm font-medium text-gray-900 truncate">{s.name}</span>
                  <span class="text-xs text-gray-500" style={mono}>{s.cas}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- CROSS-LINKS: compliance hub + tools -->
      <section class="grid gap-3 sm:grid-cols-2">
        <a href="/compliance/sds/" class="rounded-xl border border-blue-200 bg-blue-50/50 p-5 hover:border-blue-300 transition-colors">
          <p class="text-[11px] font-bold uppercase tracking-wide text-blue-700" style={mono}>Compliance hub</p>
          <p class="mt-1 text-sm font-semibold text-gray-900">From classification to SDS</p>
          <p class="mt-1 text-xs text-gray-600">
            The classification above corresponds to Section 2 of a Safety Data Sheet. Learn how a compliant
            16-section SDS is structured and authored →
          </p>
        </a>
        <a href="/label-constructor/" class="rounded-xl border border-orange-200 bg-orange-50/50 p-5 hover:border-orange-300 transition-colors">
          <p class="text-[11px] font-bold uppercase tracking-wide text-orange-700" style={mono}>GHS label maker</p>
          <p class="mt-1 text-sm font-semibold text-gray-900">Build the label for {name}</p>
          <p class="mt-1 text-xs text-gray-600">
            Pictograms, signal word and H-statements combined into a compliant label layout →
          </p>
        </a>
      </section>

      <!-- §16 SOURCES + DISCLAIMER -->
      <section id="s16" class={`${sectionCls} rounded-xl border border-gray-200 bg-slate-100 px-5 py-5 sm:px-6`}>
        <p class="text-[11px] font-semibold uppercase tracking-[0.11em] text-slate-500" style={mono}>§ 16 · Sources</p>
        <ul class="mt-3 space-y-1 text-[12.5px] leading-relaxed text-slate-600 list-disc pl-4">
          <li>
            Classification: <a href="https://eur-lex.europa.eu/eli/reg/2008/1272/oj" target="_blank" rel="noopener" class="text-teal-700 hover:underline">Regulation (EC) No 1272/2008 (CLP), Annex VI</a>
          </li>
          <li>
            Transport: <a href="https://unece.org/transport/dangerous-goods" target="_blank" rel="noopener" class="text-teal-700 hover:underline">UN ADR {adrVersion} (UNECE)</a>, Table A
          </li>
          <li>
            Reactivity: NOAA CAMEO Chemicals reactive-group matrix (public domain)
          </li>
          <li>
            Physical properties: CAMEO Chemicals (NOAA, public domain) — per-value source references stored in the database
          </li>
          {(hasFirstAid || hasFireSec || hasSpillSec) && (
            <li>
              Emergency response (§4–§6): <a href="https://www.phmsa.dot.gov/hazmat/erg/emergency-response-guidebook-erg" target="_blank" rel="noopener" class="text-teal-700 hover:underline">ERG 2024 (PHMSA)</a> ·{' '}
              <a href="https://www.cdc.gov/niosh/npg/" target="_blank" rel="noopener" class="text-teal-700 hover:underline">NIOSH Pocket Guide (CDC)</a> · CHRIS (USCG) · NTP · EPA — via{' '}
              <a href="https://cameochemicals.noaa.gov/" target="_blank" rel="noopener" class="text-teal-700 hover:underline">CAMEO Chemicals</a> (NOAA), all US federal public domain, reproduced verbatim
            </li>
          )}
          {cas && (
            <li>
              Substance data: <a href={`https://pubchem.ncbi.nlm.nih.gov/#query=${cas}`} target="_blank" rel="noopener" class="text-teal-700 hover:underline">PubChem</a> ·{' '}
              <a href={`https://echa.europa.eu/search-for-chemicals?p_p_id=disssimplesearch_WAR_disssearchportlet&_disssimplesearch_WAR_disssearchportlet_searchOccurred=true&_disssimplesearch_WAR_disssearchportlet_ssKeyword=${cas}`} target="_blank" rel="noopener" class="text-teal-700 hover:underline">ECHA</a>
            </li>
          )}
          {/* OEL source lines (Directive 2000/39/EC · 29 CFR 1910.1000 · NIOSH REL)
              join this list with the Step-3 import. QR "print & stick" card is a
              separate decision (qrcode package) — not part of this restyle. */}
        </ul>
        <p class="mt-4 text-xs text-gray-500 leading-relaxed">
          <strong class="text-gray-700">Reference aid only.</strong> This page summarises the harmonised EU
          classification and computed storage guidance — it is not a Safety Data Sheet and does not replace one.
          Always verify hazards, handling and storage against the supplier's SDS (sections 7 and 10) and local
          regulations before use. Page updated {buildDate}.
        </p>
      </section>

      <!-- FAQ -->
      <section id="faq" class={sectionCls}>
        <h2 class={h2Cls} style={grotesk}>Frequently asked questions about {name}</h2>
        <div class="mt-4 space-y-4">
          {faq.map((f) => (
            <div class="rounded-lg border border-gray-200 bg-white p-4">
              <p class="text-sm font-semibold text-gray-900">{f.q}</p>
              <p class="mt-1 text-sm text-gray-600">{f.a}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <!-- ══ EMERGENCY MODE ══════════════════════════════════════════════════════
       "The lights go out and only the safety data stays lit" (Sergej, s16).
       Opened by a visually-hidden checkbox, NOT by a #hash: the hash version
       navigated instead of opening inside a preview frame, and it would also
       push a history entry on the live page. The checkbox leaves the URL alone.
       CSS does the whole thing — a page someone opens during an incident must
       not depend on a hydrated island. Same three answers as §4/§5/§6, inverted.
       The input sits directly before the overlay so the sibling combinator is
       enough on its own; the :has() rule is the belt to that braces.
       ═══════════════════════════════════════════════════════════════════════ -->
  {emergencyOn && (
    <input type="checkbox" id="emg-toggle" class="emg-toggle" aria-label={`Open emergency mode for ${name}`} />
  )}
  {emergencyOn && (
    <div id="emergency" class="emg">
      <div class="emg-lamp" aria-hidden="true"></div>
      <div class="emg-vignette" aria-hidden="true"></div>
      <div class="emg-scroll">
        <div class="mx-auto w-full max-w-4xl px-4 pb-16 sm:px-6">
          <header class="emg-bar">
            <div class="flex min-w-0 items-center gap-2.5">
              <span class="emg-dot" aria-hidden="true"></span>
              <span class="truncate text-[11px] font-semibold uppercase tracking-[0.14em] text-rose-300" style={mono}>Emergency mode</span>
              <span class="truncate text-[13.5px] font-semibold text-white" style={grotesk}>{cap}</span>
              {response.erg_guide_no && (
                <span class="hidden rounded border border-amber-400/40 bg-amber-400/10 px-2 py-0.5 text-[10.5px] font-semibold text-amber-200 sm:inline" style={mono}>
                  ERG 2024 · GUIDE {response.erg_guide_no}
                </span>
              )}
            </div>
            <label for="emg-toggle" role="button" tabindex="0" class="emg-close" style={mono}>Close ✕</label>
          </header>

          <div class="emg-call">
            <p class="text-[15px] font-bold tracking-tight text-white" style={grotesk}>Call emergency services first</p>
            <p class="mt-1 text-[13px] leading-relaxed text-rose-100/90">
              112 in the EU · 911 in the US. This screen is published response information, not medical
              advice, and it does not replace emergency services, a poison centre or the supplier's safety
              data sheet.
            </p>
          </div>

          <section class="emg-sec">
            <p class="text-[10.5px] font-semibold uppercase tracking-[0.14em] text-rose-300" style={mono}>01 · First aid</p>
            <h2 class="mt-1 text-[26px] font-bold tracking-tight text-white" style={grotesk}>What to do for the person</h2>
            {faRoutes.length > 0 ? (
              <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
                {faRoutes.map((r: any) => (
                  <div class="rounded-xl border border-white/10 bg-white/[0.045] px-5 py-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)]">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-rose-300" style={mono}>{r.route}</p>
                    <div set:html={rBlockDark(r.text)} />
                  </div>
                ))}
              </div>
            ) : (
              <div class="mt-3 rounded-xl border border-white/10 bg-white/[0.045] px-5 py-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)]" set:html={rBlockDark(response.first_aid)} />
            )}
          </section>

          <section class="emg-sec">
            <p class="text-[10.5px] font-semibold uppercase tracking-[0.14em] text-amber-300" style={mono}>02 · Fire</p>
            <h2 class="mt-1 text-[26px] font-bold tracking-tight text-white" style={grotesk}>Extinguishing and tactics</h2>
            {response.fire_haz && (
              <div class="mt-3 rounded-xl border border-white/10 bg-white/[0.045] px-5 py-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)]">
                <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-amber-300" style={mono}>Fire and explosion hazard</p>
                <div set:html={rBlockDark(response.fire_haz)} />
              </div>
            )}
            {response.fire_fight && (
              <div class="mt-3 rounded-xl border border-white/10 bg-white/[0.045] px-5 py-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)]">
                <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-amber-300" style={mono}>Extinguishing media and tactics</p>
                <div set:html={rBlockDark(response.fire_fight)} />
              </div>
            )}
          </section>

          <section class="emg-sec">
            <p class="text-[10.5px] font-semibold uppercase tracking-[0.14em] text-teal-300" style={mono}>03 · Spill</p>
            <h2 class="mt-1 text-[26px] font-bold tracking-tight text-white" style={grotesk}>Containment, isolation, evacuation</h2>
            {response.non_fire_resp && (
              <div class="mt-3 rounded-xl border border-white/10 bg-white/[0.045] px-5 py-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)]">
                <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-teal-300" style={mono}>Containment and clean-up</p>
                <div set:html={rBlockDark(response.non_fire_resp)} />
              </div>
            )}
            {response.isolation && (
              <div class="mt-3 rounded-xl border border-white/10 bg-white/[0.045] px-5 py-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)]">
                <p class="text-[10px] font-semibold uppercase tracking-[0.09em] text-teal-300" style={mono}>Initial isolation and evacuation</p>
                <div set:html={rBlockDark(response.isolation)} />
              </div>
            )}
          </section>

          <p class="mt-8 text-[10.5px] leading-relaxed text-slate-500" style={mono}>
            Sources: ERG 2024 (PHMSA) · NIOSH Pocket Guide (CDC) · CHRIS (USCG) · NTP · EPA — via CAMEO
            Chemicals (NOAA), public domain. Text reproduced verbatim.
          </p>
        </div>
      </div>
    </div>
  )}

  <!-- Keyboard only. The overlay opens and closes with CSS alone; this adds
       Enter/Space on the two labels and Esc to close. If it never runs, the
       emergency screen still works with mouse and touch. -->
  <script is:inline>
    (function () {
      var t = document.getElementById('emg-toggle')
      if (!t) return
      document.querySelectorAll('label[for="emg-toggle"]').forEach(function (l) {
        l.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault()
            t.checked = !t.checked
          }
        })
      })
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && t.checked) t.checked = false
      })
    })()
  </script>

  {jsonLd.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
</Layout>

<style is:global>
  /* Emergency overlay. is:global because the open state is expressed on <body>
     (scroll lock + :has fallback), which Astro's scoping cannot reach. Every
     selector below is namespaced to #emergency / .emg-* and exists on no other
     page, so nothing leaks. */
  .emg-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  #emergency { display: none; }
  .emg-toggle:checked ~ #emergency,
  body:has(.emg-toggle:checked) #emergency { display: block; }
  body:has(.emg-toggle:checked) { overflow: hidden; }
  .emg-close, label[for='emg-toggle'] { cursor: pointer; }
  .emg-close:focus-visible,
  label[for='emg-toggle']:focus-visible { outline: 2px solid #fda4af; outline-offset: 3px; }
  .emg {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #04060c;
    animation: emg-in 0.26s ease-out both;
  }
  @keyframes emg-in { from { opacity: 0; } to { opacity: 1; } }
  /* the lamp: one red source above the fold, warming up as the screen opens */
  .emg-lamp {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(900px 420px at 50% -8%, rgba(220, 38, 38, 0.3), transparent 62%),
      radial-gradient(1400px 900px at 50% 12%, rgba(30, 58, 138, 0.22), transparent 70%);
    animation: emg-lamp 0.5s ease-out both;
  }
  @keyframes emg-lamp { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }
  /* everything outside the lit column falls away */
  .emg-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(closest-side at 50% 38%, transparent 55%, rgba(0, 0, 0, 0.72) 100%);
  }
  .emg-scroll { position: relative; height: 100%; overflow-y: auto; overscroll-behavior: contain; }
  .emg-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 -1rem;
    padding: 0.85rem 1rem;
    background: rgba(4, 6, 12, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .emg-dot {
    height: 9px;
    width: 9px;
    border-radius: 999px;
    background: #f43f5e;
    box-shadow: 0 0 0 4px rgba(244, 63, 94, 0.18), 0 0 14px rgba(244, 63, 94, 0.9);
    animation: emg-pulse 2.4s ease-in-out infinite;
  }
  @keyframes emg-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .emg-close {
    flex: none;
    border-radius: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 0.35rem 0.8rem;
    font-size: 11.5px;
    font-weight: 600;
    color: #e2e8f0;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .emg-close:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.45); }
  .emg-call {
    margin-top: 1.4rem;
    border-radius: 0.85rem;
    border: 1px solid rgba(244, 63, 94, 0.45);
    background: rgba(136, 19, 55, 0.32);
    padding: 1rem 1.15rem;
    box-shadow: 0 0 42px rgba(244, 63, 94, 0.2);
  }
  .emg-sec { margin-top: 2.1rem; }
  @media (prefers-reduced-motion: reduce) {
    .emg, .emg-lamp, .emg-dot { animation: none; }
  }
</style>
