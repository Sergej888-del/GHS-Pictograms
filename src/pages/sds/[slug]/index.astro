// Short class label for hero pills: the parenthetical when present ("Flam. Liq. 2"),
// otherwise the part after the em-dash ("STOT SE 3"), otherwise the full label.
function clpShort(code: string): string | null {
  const full = CLP_CLASS[code]
  if (!full) return null
  const paren = full.match(/\(([^)]+)\)\s*$/)
  if (paren) return paren[1]
  const parts = full.split(' — ')
  return parts.length > 1 ? parts[parts.length - 1] : full
}

