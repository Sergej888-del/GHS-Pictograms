---
// Chemical Storage Compatibility Matrix — flagship storage tool (v4)
// Static page (astro.config output: 'static'). The interactive island
// (StorageTool) renders the two-column search + verdict UI; hero and
// methodology are static. Verdict data comes from the get_storage_verdict RPC.
// v4 (session 14): hero + methodology rebuilt on the v2 hub vocabulary so the
// tool matches /storage-compatibility/ and its 13 category pages. Hero colour
// unchanged (HERO_BG, §0.2). The island itself is untouched in this pass.
export const prerender = true
import Layout from '../../layouts/Layout.astro'
import SdsManagerCard from '../../components/SdsManagerCard.astro'
import StorageTool from '../../components/StorageTool'
import { HERO_BG } from '../../lib/storageClasses'

const method = [
  {
    tag: 'GHS / CLP',
    name: 'GHS hazard class',
    acc: '#0d9488',
    line: '#99f6e4',
    soft: '#f0fdfa',
    ink: '#0f766e',
    desc: 'Each substance is sorted into a storage class from its GHS hazard codes, so incompatible classes can be flagged.',
  },
  {
    tag: 'CAMEO',
    name: 'Chemical reactivity',
    acc: '#0ea5e9',
    line: '#bae6fd',
    soft: '#f0f9ff',
    ink: '#0284c7',
    desc: 'Reactivity data identifies pairs that can react dangerously when a spill or leak brings them into contact.',
  },
  {
    tag: 'ADR 2025',
    name: 'ADR transport',
    acc: '#1d4ed8',
    line: '#bfdbfe',
    soft: '#eff6ff',
    ink: '#1d4ed8',
    desc: 'Transport data adds the UN number, ADR class, and packing group for moving the substance by road.',
  },
]
---
<Layout
  title="Chemical Storage Compatibility Matrix — what can be stored together"
  description="Check chemical storage compatibility by GHS hazard class, chemical reactivity, and ADR transport. See what to never store together, what to keep separate, and each substance's transport class."
  canonical="https://ghspictograms.com/tools/chemical-storage-compatibility/"
>
  <!-- HERO — v2 frame, original storage colour (HERO_BG) kept via inline style -->
  <section class="hub-hero" style={`background:${HERO_BG};`}>
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>

    <div class="hub-wrap hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/tools/">Tools</a><span class="sep">/</span>Storage compatibility
      </nav>
      <p class="hub-hero-eyebrow">Tool · Storage compatibility</p>
      <h1>Chemical storage compatibility matrix</h1>
      <p class="hub-hero-sub">
        See what can — and can't — be stored together, by GHS hazard class, chemical reactivity, and ADR transport class.
      </p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">3,652 substances</span>
        <span class="hub-hero-chip">13 hazard classes</span>
        <span class="hub-hero-chip">GHS · CAMEO · ADR</span>
      </div>
      <a href="/storage-compatibility/" class="hub-hero-cta ghost">Browse by hazard class →</a>
    </div>
  </section>

  <!-- TOOL (interactive island) -->
  <section class="hub-sec-tool">
    <div class="hub-wrap">
      <StorageTool client:load />
    </div>
  </section>

  <!-- METHOD -->
  <section class="hub-sec-deep">
    <div class="hub-wrap">
      <p class="hub-eyebrow">01 · Method</p>
      <h2 class="hub-h2">How this tool works</h2>
      <p class="hub-sub">
        Three independent data sources decide a verdict. Class-level guidance for a whole hazard family lives on the
        <a href="/storage-compatibility/">storage class pages</a>.
      </p>

      <div class="hub-cards">
        {method.map((m) => (
          <div class="hub-card static" style={`--acc:${m.acc};--acc-line:${m.line};--acc-soft:${m.soft};--acc-ink:${m.ink}`}>
            <p class="tag">{m.tag}</p>
            <h3>{m.name}</h3>
            <p class="copy">{m.desc}</p>
          </div>
        ))}
      </div>

      <p class="hub-fine">
        This tool is a reference aid, not a substitute for a substance's Safety Data Sheet or professional judgment.
        Always verify storage and handling against SDS sections 7 and 10, and follow local regulations.
        <br />
        Data sources: GHS/CLP hazard classifications, CAMEO Chemicals (NOAA), ADR 2025 (UNECE).
      </p>

      <SdsManagerCard
        service="management"
        body="This tool gives you the verdict; the sheet gives you the authority for it. Every verdict above still has to be checked against SDS sections 7 and 10 for the exact product on your shelf — which means having the current revision of each supplier's sheet, not the one filed three years ago. For keeping that library central, version-controlled and QR-accessible at the store, the solution we recommend is SDS Manager. It also offers SDS authoring and a broader EHS suite."
        href="https://sdsmanager.com/us/sds-management?fpr=ghs3&fp_sid=sttool"
      />
    </div>
  </section>
</Layout>
