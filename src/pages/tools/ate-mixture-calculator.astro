---
// ATE Mixture Calculator — flagship acute-toxicity tool (/tools/ate-mixture-calculator/).
// Static page; the interactive island (AteMixtureCalculator) renders the
// component builder + classification. v2.1 identity (navy→teal hero, teal dots,
// JetBrains Mono labels) shared with the /sds/ pages and storage tool.
export const prerender = true
import Layout from '../../layouts/Layout.astro'
import AteMixtureCalculator from '../../components/AteMixtureCalculator'
import SdsManagerCard from '../../components/SdsManagerCard.astro'

const SITE = 'https://ghspictograms.com'
const canonical = `${SITE}/tools/ate-mixture-calculator/`
const title = 'ATE Mixture Calculator — GHS/CLP Acute Toxicity Estimate'
const description =
  'Free ATE mixture calculator for GHS/CLP acute toxicity classification. Computes ATEmix across oral, dermal and inhalation routes using the additivity formula, auto-fills ingredient ATE from harmonised Annex VI classifications (Table 3.1.2), applies the 10% unknown-toxicity rule, and returns category, H-statements, pictogram and a printable report.'

const mono = "font-family:'JetBrains Mono',ui-monospace,monospace;"
const grotesk = "font-family:'Space Grotesk',sans-serif;"

const faqs = [
  {
    q: 'What is the ATE mixture formula?',
    a: 'The acute toxicity estimate of a mixture is calculated with the GHS additivity formula: 100 / ATEmix = Σ (Ci / ATEi), summed over every ingredient present at ≥ 1% that has a known ATE. Ci is the ingredient concentration in weight-% and ATEi is that ingredient\'s acute toxicity estimate (a measured LD50/LC50 point estimate, or the converted value from its classification category). The result is compared against the Table 3.1.1 cut-offs to assign a hazard category per route.',
  },
  {
    q: 'How does the calculator handle ingredients without a measured LD50?',
    a: 'When an ingredient has no numeric ATE but carries a harmonised acute-toxicity hazard statement (H300–H332), the tool converts its classification category to a point estimate using GHS Table 3.1.2 — for example oral Category 3 → 100 mg/kg, inhalation vapour Category 1 → 0.05 mg/L. This is the method GHS prescribes for mixture classification and it lets the calculator work across the whole substance database, not only the chemicals with a published numeric ATE.',
  },
  {
    q: 'What is the 10% unknown-toxicity rule?',
    a: 'If ingredients whose acute toxicity is unknown add up to more than 10% of the mixture, the numerator of the additivity formula is reduced to (100 − ΣCunknown) so the estimate is based only on the classified fraction. At or below 10%, the unknown ingredients are disregarded and the full 100 is used. The calculator applies this correction automatically and flags any route where it fired.',
  },
  {
    q: 'Which routes and inhalation forms are covered?',
    a: 'Oral and dermal (mg/kg body weight) plus inhalation. Because a hazard statement like H330 does not encode the physical form, you choose whether the mixture is inhaled as a gas (ppmV), a vapour (mg/L) or a dust/mist (mg/L); the inhalation route then uses that column\'s cut-offs and converted point estimates from Tables 3.1.1 and 3.1.2.',
  },
  {
    q: 'Is this the same as an LD50 calculator?',
    a: 'No. An LD50 calculator fits a dose–response curve to experimental mortality data to estimate the median lethal dose of a single substance. This tool takes the LD50/LC50-derived ATE of each ingredient and combines them into the acute toxicity estimate of the whole mixture for GHS/CLP labelling. Use an LD50 tool to get a single substance\'s value, then bring that value here to classify a formulation.',
  },
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'ATE Mixture Calculator',
      url: canonical,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any (web)',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
}
---

<Layout title={title} description={description} canonical={canonical}>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&display=swap"
    rel="stylesheet"
  />

  {/* HERO — v2.1 navy→teal + teal dots */}
  <section class="relative overflow-hidden text-white hero-dots" style="background:linear-gradient(135deg,#0f172a 0%,#062A78 48%,#134e4a 100%);">
    <div class="absolute inset-0" style="background:linear-gradient(90deg,rgba(15,23,42,0.75) 0%,rgba(15,23,42,0) 65%);" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <nav class="text-sm text-slate-300 mb-6" aria-label="Breadcrumb">
        <a href="/tools/" class="hover:text-white transition-colors">Tools</a>
        <span class="mx-1.5 text-slate-500">/</span>
        <span class="text-slate-200">ATE mixture calculator</span>
      </nav>
      <p class="text-[11px] font-medium uppercase tracking-[0.11em] text-teal-300" style={mono}>
        Calculator · Acute toxicity estimate
      </p>
      <h1 class="mt-2 text-4xl sm:text-[52px] font-bold tracking-tight leading-[1.05]" style={grotesk}>
        ATE Mixture Calculator
      </h1>
      <p class="mt-4 text-[15px] text-slate-300 max-w-3xl leading-relaxed">
        Classify a chemical mixture for acute toxicity under GHS / CLP. Add ingredients from a
        4,000-substance database — the calculator auto-fills each ATE from its harmonised Annex VI
        classification, runs the additivity formula across oral, dermal and inhalation routes, and
        returns the category, H-statements, pictogram and a printable report.
      </p>
      <div class="mt-5 flex flex-wrap gap-2.5">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-slate-200/20 backdrop-blur-sm px-3.5 py-1.5 text-[11.5px] tracking-[0.05em] text-slate-200" style={mono}>
          <span class="h-[7px] w-[7px] rounded-full bg-teal-400" aria-hidden="true"></span>
          100 / ATEmix = Σ(Ci / ATEi)
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-slate-200/20 backdrop-blur-sm px-3.5 py-1.5 text-[11.5px] tracking-[0.05em] text-slate-200" style={mono}>
          GHS Ch. 3.1 · Tables 3.1.1 & 3.1.2
        </span>
      </div>
    </div>
  </section>

  {/* TOOL */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <AteMixtureCalculator client:load />
  </section>

  {/* METHOD */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
    <div class="rounded-xl border border-gray-200 bg-gray-50 p-6 sm:p-8">
      <h2 class="text-xl font-bold text-gray-900" style={grotesk}>How the classification works</h2>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
        <div class="rounded-lg border border-gray-200 border-t-2 border-t-teal-400 bg-white p-4">
          <p class="font-semibold text-gray-900">1 · Resolve each ATE</p>
          <p class="mt-1 text-gray-600">Every ingredient gets an acute toxicity estimate: a measured LD50/LC50 value where one exists, otherwise the converted point estimate from its harmonised category (GHS Table 3.1.2). You can override any value.</p>
        </div>
        <div class="rounded-lg border border-gray-200 border-t-2 border-t-teal-400 bg-white p-4">
          <p class="font-semibold text-gray-900">2 · Apply the additivity formula</p>
          <p class="mt-1 text-gray-600">For each route, <span style={mono} class="text-[13px]">100 / ATEmix = Σ(Ci / ATEi)</span> over ingredients ≥ 1%. If unknown-toxicity ingredients exceed 10%, the numerator is corrected to <span style={mono} class="text-[13px]">(100 − ΣCunknown)</span>.</p>
        </div>
        <div class="rounded-lg border border-gray-200 border-t-2 border-t-teal-400 bg-white p-4">
          <p class="font-semibold text-gray-900">3 · Assign the category</p>
          <p class="mt-1 text-gray-600">ATEmix is placed on the Table 3.1.1 cut-offs to give a hazard category per route, then the worst category sets the signal word, pictogram (GHS06 / GHS07) and H-statements.</p>
        </div>
      </div>
      <p class="mt-6 text-xs text-gray-500 leading-relaxed">
        Reference: UN GHS Chapter 3.1 (acute toxicity) and CLP Annex I 3.1.3 (classification of mixtures). Converted
        point estimates follow Table 3.1.2; cut-off ranges follow Table 3.1.1. This tool is a computed aid for SDS
        authoring — always review the outcome against each ingredient's safety data sheet and Annex VI entry.
      </p>
    </div>
  </section>

  {/* SDS Manager (affiliate) */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SdsManagerCard
      service="management"
      href="https://sdsmanager.com/us/sds-management?fpr=ghs3&fp_sid=gpmgmt"
    />
  </section>

  {/* FAQ */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
    <h2 class="text-xl font-bold text-gray-900" style={grotesk}>Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-lg border border-gray-200 bg-white p-4">
          <summary class="cursor-pointer list-none font-semibold text-gray-900 flex items-center justify-between gap-3">
            {f.q}
            <span class="text-teal-500 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  {/* BRIDGES */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="rounded-2xl p-8 text-white shadow-lg" style="background:linear-gradient(135deg,#0f172a 0%,#062A78 55%,#134e4a 100%);">
      <h2 class="text-xl font-bold mb-3" style={grotesk}>Working from a single substance?</h2>
      <p class="text-sm text-slate-200 leading-relaxed max-w-3xl">
        Look up harmonised classification, storage compatibility and transport data for one chemical in the
        <a href="/sds/" class="text-teal-300 font-semibold underline underline-offset-2 hover:text-teal-200">SDS library</a>,
        check what a formulation can be stored next to with the
        <a href="/tools/chemical-storage-compatibility/" class="text-teal-300 font-semibold underline underline-offset-2 hover:text-teal-200">storage compatibility matrix</a>,
        or browse every free
        <a href="/tools/" class="text-teal-300 font-semibold underline underline-offset-2 hover:text-teal-200">GHS tool</a>.
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
