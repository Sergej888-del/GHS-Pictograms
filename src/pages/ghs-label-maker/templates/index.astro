---
/**
 * Хаб шаблонов размеров — /ghs-label-maker/templates/
 *
 * ⚠⚠ ЗДЕСЬ ПЕРЕЧИСЛЕНЫ ВСЕ ГЕОМЕТРИИ, А СТРАНИЦ ТОЛЬКО ШЕСТЬ. Это то же решение,
 * что на `/un/`, где из 2 347 номеров собственный адрес получили 389: отдельный
 * URL заводится там, где странице есть чем быть непустой. Двадцать пять тонких
 * страниц про прямоугольники утянули бы вниз уже ранжирующиеся адреса домена.
 *
 * ⚠ Хранится ГЕОМЕТРИЯ, а не код вендора: один формат 4 × 2 in — это Avery
 * 60505, 60525 и 5163, Presta 94207 и OnlineLabels OL3540 и OL125 одновременно.
 * Коды печатаются в колонке «Also sold as» — по ним ищут, но устаревают они, а
 * не размер.
 */
export const prerender = true

import Layout from '../../../layouts/Layout.astro'
import { SITE, TEMPLATES, TEMPLATE_BY_STOCK, breadcrumbJsonLd } from '../../../lib/labelMakerHub'
import { stockFor, stockSizeLabel, stockMm, SHEET_NAME, type LabelStockItem } from '../../../lib/labelStock'
import { CLP_SIZE_TIERS, labelSizeVerdict } from '../../../lib/jurisdictions'
// ⚠ Цвет карточки перелинковки берётся ИЗ АДРЕСА — одна карта
// «раздел → цвет» на весь сайт, см. src/lib/sectionAccent.ts.
import { withAccent, accentBadge } from '../../../lib/sectionAccent'

const canonical = `${SITE}/ghs-label-maker/templates/`
const title = 'GHS Label Templates — Avery, OnlineLabels & A4 Sizes'
const description =
  'Free GHS label templates in the sizes labels are actually sold in: 4 × 2, 4 × 6, 4 × 4 and 2 × 2 inch, full Letter sheet, A4 and A5. Avery and OnlineLabels codes.'

const us = stockFor('us')
const eu = stockFor('eu')

/**
 * Самый крупный ярус CLP, которому формат удовлетворяет.
 *
 * ⛔⛔ ПЕРЕПИСАНО В SESSION 65: ПРЕЖНИЙ РАСЧЁТ ОБЪЯВЛЯЛ ГОДНЫМ ТО, ЧТО ЗАКОН
 * ЗАПРЕЩАЕТ. Он мерил ТОЛЬКО площадь («area >= labelMinW * labelMinH») и
 * пропускал длинные узкие ленты через ярусы, где стороны обязательны: лента
 * 210 × 40 мм давала площадь 8 400 против 7 770 у яруса «> 3–50 л» и
 * помечалась годной для двадцатилитровой канистры — хотя короткая сторона 40 мм
 * вдвое меньше предписанных 74. Это утверждение печаталось на 3 650 страницах.
 *
 * ⚠⚠ Table 1.3 говорит о ярусах РАЗНЫМИ словами, и расчёт обязан их различать:
 *   ≤ 3 л  → «If possible, at least 52 × 74» — цель. Здесь прикидка по площади
 *            уместна и честна: привычная 4 × 2 in (101,6 × 50,8) не добирает
 *            1,2 мм по короткой стороне, но незаконной не является, а площади в
 *            ней в полтора раза больше предписанных 52 × 74. Помечается «~».
 *   > 3 л  → «At least 74 × 105» — норма. Только стороны, в любой ориентации.
 *
 * ⚠ Про площадь ЭТИКЕТКИ в Table 1.3 нет ни слова — площадь есть только у
 * пиктограммы в §1.2.1.3. Поэтому «~» подписан как наша оценка, а не как
 * соответствие.
 */
function clpTierFor(s: LabelStockItem): string {
  const { w, h } = stockMm(s)
  const area = w * h
  const short = Math.min(w, h)
  const fits = CLP_SIZE_TIERS.filter((t) => {
    if (t.labelSidesBinding) return labelSizeVerdict(t, w, h).meetsSides
    return area >= t.labelMinW * t.labelMinH && short >= Math.min(t.labelMinW, t.labelMinH) / 2
  })
  if (!fits.length) return '—'
  const top = fits[fits.length - 1]
  // «~» отличает нашу оценку по площади от выдержанных сторон.
  return top.labelSidesBinding || labelSizeVerdict(top, w, h).meetsSides
    ? top.capacityLabel
    : `~ ${top.capacityLabel}`
}

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'GHS label maker', path: '/ghs-label-maker/' },
    { name: 'Templates', path: '/ghs-label-maker/templates/' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: TEMPLATES.length,
      itemListElement: TEMPLATES.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.h1,
        url: `${SITE}/ghs-label-maker/templates/${t.slug}/`,
      })),
    },
  },
]
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete={true}>
  {jsonLd.map((block) => (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(block)} />
  ))}

  <section class="hub-hero">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/ghs-label-maker/">GHS label maker</a><span class="sep">/</span>
        <span>Templates</span>
      </nav>
      <p class="hub-hero-eyebrow">Label stock · sizes and part numbers</p>
      <h1>GHS label templates</h1>
      <p class="hub-hero-sub">
        The sizes chemical labels are actually sold in, not abstract paper formats. Pick the one that
        matches the pack of blank labels on your shelf and the tool lays the label out at exactly that
        geometry — then prints the whole sheet at the right pitch.
      </p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{us.length + eu.length} geometries</span>
        <span class="hub-hero-chip">Avery · OnlineLabels · HERMA</span>
        <span class="hub-hero-chip">Letter · Legal · A4 · A3 · roll</span>
      </div>
    </div>
  </section>

  <section class="hub-sec-a">
    <div class="hub-wrap">
      <p class="hub-eyebrow">01 · Popular sizes</p>
      <h2 class="hub-h2">Templates with their own page</h2>
      <p class="hub-sub">
        Six sizes cover most of what people actually print. Each page opens the tool preset to that
        geometry and explains what the size suits — and where it runs out of room.
      </p>
      <div class="hub-index wide" style="margin-top:24px">
        {TEMPLATES.map((t) => (
          <a class="hub-index-card" href={`/ghs-label-maker/templates/${t.slug}/`}>
            <span class="txt">
              <span class="name">{t.h1.replace(' GHS label template', '').replace(' template', '')}</span>
              <span class="cas">{t.description.slice(0, 74)}…</span>
            </span>
            <span class="formula">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="hub-sec-white">
    <div class="hub-wrap">
      <p class="hub-eyebrow">02 · United States</p>
      <h2 class="hub-h2">Letter and Legal sheet stock</h2>
      <p class="hub-sub">
        Chemical-resistant film first — that is what a shipped container needs. The plain paper ranges
        below the divider are listed because people search for them by number and use them on secondary
        containers, where paper is defensible.
      </p>
      <div class="hub-table-wrap">
        <table class="hub-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">mm</th>
              <th scope="col">Sheet</th>
              <th scope="col">Material</th>
              <th scope="col">Also sold as</th>
              <th scope="col">CLP tier</th>
            </tr>
          </thead>
          <tbody>
            {us.map((s) => {
              const t = TEMPLATE_BY_STOCK.get(s.id)
              const mm = stockMm(s)
              return (
                <tr>
                  <td class="c-code">
                    {t ? <a href={`/ghs-label-maker/templates/${t.slug}/`}>{stockSizeLabel(s)}</a> : stockSizeLabel(s)}
                  </td>
                  <td class="c-code">{Math.round(mm.w * 10) / 10} × {Math.round(mm.h * 10) / 10}</td>
                  <td class="c-code">{s.perSheet === null ? 'roll' : `${s.perSheet} · ${SHEET_NAME[s.sheet]}`}</td>
                  <td class="c-code">{s.chemical ? 'chemical-resistant' : 'paper'}</td>
                  <td class="c-txt">{s.aliases.join(', ')}</td>
                  <td class="c-code">{clpTierFor(s)}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="hub-sec-b">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">03 · Europe</p>
      <h2 class="hub-h2">A4, A3 and metric roll stock</h2>
      <div class="hub-table-wrap">
        <table class="hub-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Sheet</th>
              <th scope="col">Material</th>
              <th scope="col">Also sold as</th>
              <th scope="col">CLP tier</th>
            </tr>
          </thead>
          <tbody>
            {eu.map((s) => {
              const t = TEMPLATE_BY_STOCK.get(s.id)
              return (
                <tr>
                  <td class="c-code">
                    {t ? <a href={`/ghs-label-maker/templates/${t.slug}/`}>{stockSizeLabel(s)}</a> : stockSizeLabel(s)}
                  </td>
                  <td class="c-code">{s.perSheet === null ? 'roll' : `${s.perSheet} · ${SHEET_NAME[s.sheet]}`}</td>
                  <td class="c-code">{s.chemical ? 'chemical-resistant' : 'paper'}</td>
                  <td class="c-txt">{s.aliases.join(', ')}</td>
                  <td class="c-code">{clpTierFor(s)}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
      <p class="hub-fine">
        The “CLP tier” column is the largest container capacity the format satisfies under CLP Annex I
        Table 1.3, judged by label <em>area</em> rather than by both sides — otherwise a 4 × 2 in label
        fails the ≤ 3 L tier on one side while carrying half again the prescribed area. It applies in the
        EU and Great Britain; OSHA and WHMIS set no numeric minimum, so the column is guidance there.
        Sizes are as published by the manufacturers; part numbers are for identification only.
      </p>
    </div>
  </section>

  <!-- ── ВХОД В ИНСТРУМЕНТ ─────────────────────────────────────────────────
       ⚠⚠ Конструктор ОДИН, на `/ghs-label-maker/`. Здесь он стоял копией —
       четвёртой из четырнадцати на весь раздел. Разбор — в шапке
       `src/components/LabelConstructorLoader.tsx`. -->
  <section class="hub-sec-tool">
    <div class="hub-wrap">
      <div class="lm-open">
        <div>
          <p class="hub-eyebrow">04 · Build it</p>
          <h2 class="hub-h2" style="margin-bottom:6px">Label builder</h2>
          <p class="hub-sub">
            Pick any size above to open the tool already set to it, or start from a blank label and
            choose the size inside.
          </p>
        </div>
        <a class="tool-cta" href="/ghs-label-maker/#build">Open the label maker →</a>
      </div>
    </div>
  </section>

  <section class="hub-sec-deep">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">Next</p>
      <h2 class="hub-h2">Label rules by jurisdiction</h2>
      <div class="hub-mini-cards">
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/osha/')} href="/ghs-label-maker/osha/">
          <span class="sect">{accentBadge('/ghs-label-maker/osha/')}</span>
          <strong>OSHA HazCom</strong>
          <span>Six required elements, a US address and phone, and the 20 November 2026 deadline.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/clp-eu/')} href="/ghs-label-maker/clp-eu/">
          <span class="sect">{accentBadge('/ghs-label-maker/clp-eu/')}</span>
          <strong>EU CLP</strong>
          <span>The Annex I Table 1.3 size tiers, the UFI and EUH statements.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/whmis-canada/')} href="/ghs-label-maker/whmis-canada/">
          <span class="sect">{accentBadge('/ghs-label-maker/whmis-canada/')}</span>
          <strong>WHMIS Canada</strong>
          <span>English and French both mandatory on a supplier label.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/secondary-container/')} href="/ghs-label-maker/secondary-container/">
          <span class="sect">{accentBadge('/ghs-label-maker/secondary-container/')}</span>
          <strong>Secondary containers</strong>
          <span>Fewer elements — and one case that needs no label at all.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/')} href="/ghs-label-maker/">
          <span class="sect">{accentBadge('/ghs-label-maker/')}</span>
          <strong>Label maker hub</strong>
          <span>All four jurisdictions, the six label elements, printing and the full FAQ.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/tools/')} href="/tools/">
          <strong>All free GHS tools</strong>
          <span>Fourteen tools: calculators, selector, storage matrix and this label maker.</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
