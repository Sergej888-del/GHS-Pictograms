---
/**
 * Страница одного формата — /ghs-label-maker/templates/<slug>/
 *
 * ⚠⚠ ИНСТРУМЕНТА ЗДЕСЬ НЕТ — ТОЛЬКО ССЫЛКА В НЕГО, УЖЕ НА ЭТОМ РАЗМЕРЕ.
 * До session 47 `LabelConstructorLoader` стоял на каждой странице раздела —
 * четырнадцать копий одного конструктора. Сергей, посмотрев собранный сайт:
 * «ты не видишь инструмент, из-за этого мало кто доходит до глубоко зарытого
 * инструмента». Конструктор теперь ОДИН, на `/ghs-label-maker/`, а размер
 * приезжает к нему параметром `?stock=` — ради этого проп `initialStockId` в
 * `LabelConstructorLoader` и `GHSLabelConstructor` и остаётся нужен: адрес
 * читается на хабе и подставляется в тот же проп.
 *
 * ⚠ Слаг — от размера (`4x2-inch`), а не от `id` формата (`us-4x2`) и не от кода
 * вендора: `us-4x2` человеку ничего не говорит, а «avery-5163» умрёт вместе с
 * артикулом. Коды вендоров живут в тексте и в <title>, где их и ищут.
 */
export const prerender = true

import Layout from '../../../layouts/Layout.astro'
import { SITE, TEMPLATES, faqJsonLd, breadcrumbJsonLd } from '../../../lib/labelMakerHub'
import { LABEL_STOCK_ALL, stockSizeLabel, stockMm, SHEET_NAME, MM_PER_INCH } from '../../../lib/labelStock'
import { CLP_SIZE_TIERS, requiredPictogramSideMm, labelSizeVerdict } from '../../../lib/jurisdictions'
import { labelMakerHref } from '../../../lib/labelMakerLink'
// ⚠ Цвет карточки перелинковки берётся ИЗ АДРЕСА — одна карта
// «раздел → цвет» на весь сайт, см. src/lib/sectionAccent.ts.
import { withAccent, accentBadge } from '../../../lib/sectionAccent'

export function getStaticPaths() {
  return TEMPLATES.map((t) => {
    const stock = LABEL_STOCK_ALL.find((s) => s.id === t.stockId)
    if (!stock) {
      // ⚠ Молча пропускать нельзя: страница исчезнет, а ссылки на неё с хаба и
      // из таблицы шаблонов останутся и станут 404.
      throw new Error(`labelMakerHub: у шаблона «${t.slug}» нет формата ${t.stockId} в labelStock.ts`)
    }
    return { params: { template: t.slug }, props: { tpl: t, stock } }
  })
}

const { tpl, stock } = Astro.props
const mm = stockMm(stock)
const canonical = `${SITE}/ghs-label-maker/templates/${tpl.slug}/`

// ⚠⚠ Адрес инструмента строится ТЕМ ЖЕ сборщиком, что и все остальные ссылки в
// конструктор. Литерал `?stock=`, набранный здесь руками, был бы второй
// редакцией контракта — тем самым дефектом, из-за которого в session 38
// калькулятор открывался пустым с 3 650 страниц.
const toolHref = labelMakerHref({ stock: stock.id }) + '#build'

// Ярусы CLP: у обязательных (> 3 л) — по сторонам, у «if possible» (≤ 3 л) —
// наша прикидка по площади. Полный разбор в templates/index.astro.
const area = mm.w * mm.h
const short = Math.min(mm.w, mm.h)
const tiers = CLP_SIZE_TIERS.map((t) => {
  const v = labelSizeVerdict(t, mm.w, mm.h)
  const byArea = area >= t.labelMinW * t.labelMinH && short >= Math.min(t.labelMinW, t.labelMinH) / 2
  return {
    tier: t,
    /** Стороны яруса выдержаны — единственное, что можно назвать соответствием. */
    meetsSides: v.meetsSides,
    /** ⚠ Только у необязательного яруса: наша оценка по площади, не норма. */
    byArea: !t.labelSidesBinding && !v.meetsSides && byArea,
    verdict: v,
    pictogramMm: Math.round(requiredPictogramSideMm(t) * 10) / 10,
  }
})

const idx = TEMPLATES.findIndex((t) => t.slug === tpl.slug)
const prev = TEMPLATES[(idx - 1 + TEMPLATES.length) % TEMPLATES.length]
const next = TEMPLATES[(idx + 1) % TEMPLATES.length]

const r1 = (v: number) => Math.round(v * 10) / 10

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'GHS label maker', path: '/ghs-label-maker/' },
    { name: 'Templates', path: '/ghs-label-maker/templates/' },
    { name: stockSizeLabel(stock), path: `/ghs-label-maker/templates/${tpl.slug}/` },
  ]),
  faqJsonLd(tpl.faq),
]
---

<Layout title={tpl.title} description={tpl.description} canonical={canonical} titleIsComplete={true}>
  {jsonLd.map((block) => (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(block)} />
  ))}

  <section class="hub-hero">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/ghs-label-maker/">GHS label maker</a><span class="sep">/</span>
        <a href="/ghs-label-maker/templates/">Templates</a><span class="sep">/</span>
        <span>{stockSizeLabel(stock)}</span>
      </nav>
      <p class="hub-hero-eyebrow">
        {stock.chemical ? 'Chemical-resistant stock' : 'Paper stock'} ·
        {stock.perSheet === null ? ' roll' : ` ${stock.perSheet} per ${SHEET_NAME[stock.sheet]}`}
      </p>
      <h1>{tpl.h1}</h1>
      <p class="hub-hero-sub">{tpl.intro[0]}</p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{stockSizeLabel(stock)}</span>
        <span class="hub-hero-chip">{r1(mm.w)} × {r1(mm.h)} mm</span>
        {stock.perSheet !== null && <span class="hub-hero-chip">{stock.perSheet} per sheet</span>}
        {stock.use && <span class="hub-hero-chip">{stock.use.split('—')[0].trim()}</span>}
      </div>
    </div>
  </section>

  <!-- ── ВХОД В ИНСТРУМЕНТ, УЖЕ НА ЭТОМ РАЗМЕРЕ ──────────────────────────────
       ⚠ Ссылка несёт `?stock=` и якорь `#build`: обещание заголовка выполняет
       она, а не страница. Адрес строится `labelMakerHref` — тем же сборщиком,
       что и все остальные ссылки в конструктор. -->
  <section class="hub-sec-tool">
    <div class="hub-wrap">
      <div class="lm-open">
        <div>
          <p class="hub-eyebrow">Build it</p>
          <h2 class="hub-h2" style="margin-bottom:6px">Label builder, preset to {stockSizeLabel(stock)}</h2>
          <p class="hub-sub">
            Size and sheet layout arrive already set. Change the jurisdiction or the size inside the
            tool at any point — the label is rebuilt against whatever is selected.
          </p>
        </div>
        <a class="tool-cta" href={toolHref}>Open the label maker at {stockSizeLabel(stock)} →</a>
      </div>
    </div>
  </section>

  <section class="hub-sec-a">
    <div class="hub-wrap">
      <p class="hub-eyebrow">01 · The format</p>
      <h2 class="hub-h2">What this size is for</h2>
      <div class="hub-prose">
        {tpl.intro.map((p) => <p>{p}</p>)}
      </div>

      <div class="hub-panel" style="margin-top:26px">
        <div class="hub-panel-label">Geometry</div>
        <div class="hub-panel-row">
          <span><strong>{stockSizeLabel(stock)}</strong> · {r1(mm.w)} × {r1(mm.h)} mm · {r1(mm.w / MM_PER_INCH)} × {r1(mm.h / MM_PER_INCH)} in</span>
        </div>
        <div class="hub-panel-row">
          <span>{stock.perSheet === null ? 'Roll stock' : `${stock.perSheet} per ${SHEET_NAME[stock.sheet]}`}</span>
          <span>{stock.chemical ? 'Chemical-resistant film' : 'Plain paper — not for shipped chemical containers'}</span>
        </div>
        <div class="hub-panel-row">
          <span>Also sold as: {stock.aliases.join(', ')}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="hub-sec-white">
    <div class="hub-wrap">
      <p class="hub-eyebrow">02 · Where it qualifies</p>
      <h2 class="hub-h2">Against the CLP size tiers</h2>
      <p class="hub-sub">
        CLP Annex I Table 1.3 is the only legally binding table tying label size to container capacity.
        It applies in the European Union and, word for word, in Great Britain. OSHA and WHMIS set no
        numeric minimum at all, so this table is guidance rather than a requirement in those two.
      </p>
      <div class="hub-table-wrap">
        <table class="hub-table">
          <thead>
            <tr>
              <th scope="col">Container</th>
              <th scope="col">Table 1.3 label size</th>
              <th scope="col">Pictogram side</th>
              <th scope="col">This format</th>
            </tr>
          </thead>
          <tbody>
            {tiers.map((t) => (
              <tr>
                <td class="c-code">{t.tier.capacityLabel}</td>
                <td class="c-code">
                  {t.tier.labelMinW} × {t.tier.labelMinH} mm
                  {t.tier.labelSidesBinding ? '' : ' — if possible'}
                </td>
                <td class="c-code">{t.pictogramMm} mm</td>
                <td class="c-code">
                  {t.meetsSides
                    ? (t.verdict.onlyRotated ? 'qualifies (landscape)' : 'qualifies')
                    : t.byArea
                      ? '~ enough area'
                      : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="hub-fine">
        Read the two wordings apart: for packages over 3 litres Table 1.3 says “<em>at least</em>”, and
        the format qualifies only when both dimensions are met — in either orientation, since the table
        gives a pair of dimensions and never says which one is the width. For packages not exceeding
        3 litres it says “<em>if possible</em>, at least 52 × 74”, which is a target rather than a
        minimum; a 4 × 2 in label is 1.2 mm under on the short side while carrying half again the area,
        so it is marked “~ enough area” — our assessment, not a compliance statement. Table 1.3 says
        nothing about label <em>area</em> at all. The pictogram column does combine two real rules: the
        side from Table 1.3 and the “at least one fifteenth of the minimum label area, never below 1 cm²”
        requirement of Annex I §1.2.1, whichever is larger.
      </p>
    </div>
  </section>

  <section class="hub-sec-b" id="faq">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">Questions</p>
      <h2 class="hub-h2">Frequently asked</h2>
      <div class="hub-faq">
        {tpl.faq.map((f) => (
          <div class="hub-faq-item">
            <p class="q">{f.q}</p>
            <p class="a">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hub-sec-deep">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">More templates</p>
      <h2 class="hub-h2">Other sizes</h2>
      <div class="hub-prevnext">
        <a href={`/ghs-label-maker/templates/${prev.slug}/`}>
          <span class="dir">Previous</span>
          <span class="code">{prev.h1.replace(' GHS label template', '')}</span>
          <span class="txt">{prev.intro[0].slice(0, 96)}…</span>
        </a>
        <a href={`/ghs-label-maker/templates/${next.slug}/`} class="next">
          <span class="dir">Next</span>
          <span class="code">{next.h1.replace(' GHS label template', '')}</span>
          <span class="txt">{next.intro[0].slice(0, 96)}…</span>
        </a>
      </div>

      <h2 class="hub-h2" style="margin-top:44px">Label rules</h2>
      <div class="hub-mini-cards">
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/templates/')} href="/ghs-label-maker/templates/">
          <span class="sect">{accentBadge('/ghs-label-maker/templates/')}</span>
          <strong>All label sizes</strong>
          <span>Every geometry with its Avery, OnlineLabels and HERMA part numbers.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/osha/')} href="/ghs-label-maker/osha/">
          <span class="sect">{accentBadge('/ghs-label-maker/osha/')}</span>
          <strong>OSHA HazCom labels</strong>
          <span>What 29 CFR 1910.1200 requires — and why it sets no minimum size.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/clp-eu/')} href="/ghs-label-maker/clp-eu/">
          <span class="sect">{accentBadge('/ghs-label-maker/clp-eu/')}</span>
          <strong>EU CLP labels</strong>
          <span>The size tiers, the pictogram area rule, the UFI and EUH statements.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/secondary-container/')} href="/ghs-label-maker/secondary-container/">
          <span class="sect">{accentBadge('/ghs-label-maker/secondary-container/')}</span>
          <strong>Secondary containers</strong>
          <span>Where paper stock is defensible and pictograms are not mandatory.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/ghs-label-maker/')} href="/ghs-label-maker/">
          <span class="sect">{accentBadge('/ghs-label-maker/')}</span>
          <strong>Label maker hub</strong>
          <span>Four jurisdictions, the six elements, printing and the full FAQ.</span>
        </a>
        <a class={withAccent('hub-mini-card', '/substances/')} href="/substances/">
          <span class="sect">{accentBadge('/substances/')}</span>
          <strong>Substance database</strong>
          <span>4,178 substances with harmonised CLP Annex VI classification.</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
