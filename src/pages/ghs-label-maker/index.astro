---
/**
 * Хаб конструктора этикеток — /ghs-label-maker/
 *
 * ⚠⚠ СЮДА ПЕРЕЕХАЛ `/label-constructor/` (301). Поэтому инструмент стоит НА ЭТОЙ
 * СТРАНИЦЕ и сразу под шапкой, а не ссылкой из текста: человек, который два года
 * ходил по старому адресу строить этикетку, обязан попасть на работающий
 * конструктор, а не на статью о нём.
 *
 * ⚠⚠ Старая страница `src/pages/label-constructor/index.astro` УДАЛЕНА, а не
 * оставлена рядом. На Cloudflare Pages статический файл сильнее строки в
 * `_redirects`: пока файл собирается, правило 301 не срабатывает вообще. Тот же
 * урок был на `/inspector/` в session 39.
 *
 * ⚠ Диагноз session 42, ради которого всё это затеяно: у старой страницы для
 * поиска не было ничего — заголовок, абзац и React-остров. У конкурента на той
 * же странице разбор шести элементов, пять шагов, раздел про печать и FAQ.
 * Отсюда порядок разделов: сначала продукт, потом всё, что его объясняет.
 *
 * ⚠ Тексты и факты — из `src/lib/labelMakerHub.ts`, факты там сверены по
 * `claude/label-maker-regulatory-facts.md`. В разметке норм НЕ ПИШЕМ: иначе на
 * восьми страницах раздела заведётся восемь разных редакций одного правила.
 */
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import LabelConstructorLoader from '../../components/LabelConstructorLoader'
import {
  SITE, STEPS, ANATOMY, HUB_FAQ, CROSS_LINKS, TEMPLATES,
  JURISDICTION_BRANCHES, PURPOSE_BRANCHES,
  faqJsonLd, breadcrumbJsonLd,
} from '../../lib/labelMakerHub'
import { LABEL_STOCK_ALL, stockSizeLabel, SHEET_NAME } from '../../lib/labelStock'
// ⚠ Цвет карточки перелинковки берётся ИЗ АДРЕСА, а не пишется в разметке —
// одна карта «раздел → цвет» на весь сайт, см. src/lib/sectionAccent.ts.
import { withAccent, accentBadge } from '../../lib/sectionAccent'

const canonical = `${SITE}/ghs-label-maker/`
const title = 'GHS Label Maker — Free Online Chemical Label Generator'
const description =
  'Free GHS label maker for OSHA HazCom, EU CLP, WHMIS and GB CLP. Auto-fills pictograms, signal word and H/P statements for 4,178 substances. Vector PDF, no signup.'

// Шаблоны с собственной страницей. ⚠ Список ведёт `TEMPLATES`, а не разметка:
// иначе таблица здесь и набор страниц разъедутся, и половина ссылок уведёт в 404.
const featured = TEMPLATES
  .map((t) => ({ t, s: LABEL_STOCK_ALL.find((x) => x.id === t.stockId)! }))
  .filter((r) => r.s)

const tools = CROSS_LINKS.filter((l) => l.kind === 'tool')
const hubs = CROSS_LINKS.filter((l) => l.kind === 'hub')

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'GHS label maker', path: '/ghs-label-maker/' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GHS Label Maker',
    alternateName: ['GHS Label Generator', 'Chemical Label Maker', 'HazCom Label Maker'],
    url: canonical,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'OSHA HazCom, EU CLP, WHMIS and GB CLP label rules',
      'Auto-filled classification for 4,178 substances with harmonised CLP Annex VI entries',
      'Manual mode for your own mixture',
      'Container-volume sizing per CLP Annex I Table 1.3',
      'Avery, OnlineLabels and HERMA label stock presets',
      'Vector PDF, SVG and multi-up print sheet export',
    ],
    description,
  },
  faqJsonLd(HUB_FAQ),
]
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete={true}>
  {jsonLd.map((block) => (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(block)} />
  ))}

  {/* ── HERO ─────────────────────────────────────────────────────────────── */}
  <section class="hub-hero">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span><span>GHS label maker</span>
      </nav>
      <p class="hub-hero-eyebrow">Free · No signup · Runs in your browser</p>
      <h1>GHS label maker</h1>
      <p class="hub-hero-sub">
        Build a print-ready chemical label for the United States, the European Union, Canada or Great
        Britain. Pick a substance and the pictograms, signal word and hazard statements come from the
        harmonised CLP Annex VI list; enter the container volume and the label is sized to the rule that
        actually applies in that jurisdiction — or to the pack of blank labels you already own.
      </p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">4 jurisdictions</span>
        <span class="hub-hero-chip">4,178 substances</span>
        <span class="hub-hero-chip">Vector PDF &amp; SVG</span>
        <span class="hub-hero-chip">Avery &amp; A4 stock</span>
      </div>
    </div>
  </section>

  {/* ── ИНСТРУМЕНТ ────────────────────────────────────────────────────────
       ⚠⚠ Стоит ВЫШЕ всего текста. Это адрес, на который ведёт 301 со старого
       `/label-constructor/`, и первый экран обязан показывать продукт. */}
  <section class="hub-sec-tool" id="build">
    <div class="hub-wrap">
      <LabelConstructorLoader client:load />
    </div>
  </section>

  {/* ── НАВИГАЦИЯ ПО СТРАНИЦЕ ─────────────────────────────────────────────
       Страница длинная по замыслу. Чистые якоря, без JavaScript. */}
  <nav class="hub-sec-white" style="padding-top:26px;padding-bottom:0" aria-label="On this page">
    <div class="hub-wrap">
      <p class="hub-eyebrow">On this page</p>
      <div class="sub-alpha" style="margin-top:12px">
        <a class="sub-alpha-item" href="#how" style="min-width:auto">How to use it</a>
        <a class="sub-alpha-item" href="#anatomy" style="min-width:auto">What a label carries</a>
        <a class="sub-alpha-item" href="#jurisdictions" style="min-width:auto">By jurisdiction</a>
        <a class="sub-alpha-item" href="#types" style="min-width:auto">By label type</a>
        <a class="sub-alpha-item" href="#printing" style="min-width:auto">Printing &amp; stock</a>
        <a class="sub-alpha-item" href="#faq" style="min-width:auto">FAQ</a>
        <a class="sub-alpha-item" href="#more" style="min-width:auto">Other tools</a>
      </div>
    </div>
  </nav>

  {/* ── 01 · КАК ПОЛЬЗОВАТЬСЯ ─────────────────────────────────────────────── */}
  <section class="hub-sec-a" id="how">
    <div class="hub-wrap">
      <p class="hub-eyebrow">01 · How to use it</p>
      <h2 class="hub-h2">Five steps to a printable label</h2>
      <p class="hub-sub">
        The tool is above; this is what each control is for and why the order matters. Nothing is saved
        on a server — supplier details and your logo are remembered in your own browser so the next
        label starts where the last one finished.
      </p>
      <ol class="lm-steps">
        {STEPS.map((s) => (
          <li class="lm-step">
            <span class="n">{s.n}</span>
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="hub-note">
        Labelling a mixture rather than a pure substance? There is no harmonised classification for
        mixtures and there never will be — yours comes from your own safety data sheet. Use manual mode
        and set the pictograms, signal word and statements yourself. If you have the ingredients but not
        the classification yet, start with the <a href="/tools/ate-mixture-calculator/">ATE mixture calculator</a>.
      </p>
    </div>
  </section>

  {/* ── 02 · АНАТОМИЯ ─────────────────────────────────────────────────────── */}
  <section class="hub-sec-white" id="anatomy">
    <div class="hub-wrap">
      <p class="hub-eyebrow">02 · Anatomy</p>
      <h2 class="hub-h2">What has to be on the label</h2>
      <p class="hub-sub">
        Six elements, in every one of the four systems this tool covers. What differs between them is
        not the list but the detail: whose address, in which language, and what may be dropped when the
        container is too small to hold it all.
      </p>
      <div class="lm-anatomy">
        {ANATOMY.map((a) => (
          <div class="lm-el">
            <span class="num">{a.n}</span>
            <h3>{a.h}</h3>
            <p>{a.p}</p>
            <p class="cite">{a.cite}</p>
          </div>
        ))}
      </div>
      <p class="hub-note">
        The hazard statement texts are not interchangeable between systems. H320 exists in OSHA Appendix C
        and not in CLP; H316 exists in CLP and not in OSHA; OSHA writes “vapors” where CLP writes “vapours”;
        and EUH statements are a European construct with no place on a US label at all. Browse the full sets:
        <a href="/h-statements/">108 hazard statements</a> · <a href="/p-statements/">117 precautionary statements</a>.
      </p>
    </div>
  </section>

  {/* ── 03 · ЮРИСДИКЦИИ ───────────────────────────────────────────────────── */}
  <section class="hub-sec-deep" id="jurisdictions">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">03 · By jurisdiction</p>
      <h2 class="hub-h2">Pick the rulebook you are labelling under</h2>
      <p class="hub-sub">
        Each page opens the tool already set to that jurisdiction, and explains what that jurisdiction
        actually requires — including, in two of the four cases, the fact that no minimum label size
        exists at all.
      </p>
      <div class="hub-cards four">
        {JURISDICTION_BRANCHES.map((b) => (
          <a
            href={`/ghs-label-maker/${b.slug}/`}
            class="hub-card"
            style={`--acc:${b.acc};--acc-line:${b.line};--acc-soft:${b.soft};--acc-ink:${b.ink}`}
          >
            <p class="tag">{b.badge}</p>
            <h3>{b.cardTitle}</h3>
            <p class="copy">{b.cardDesc}</p>
            <span class="cta">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── 04 · ВИДЫ ЭТИКЕТОК ────────────────────────────────────────────────── */}
  <section class="hub-sec-a" id="types">
    <div class="hub-wrap">
      <p class="hub-eyebrow">04 · By label type</p>
      <h2 class="hub-h2">Not every container needs the full label</h2>
      <p class="hub-sub">
        A drum leaving your site, a spray bottle at a bench and a box on a pallet are governed by three
        different rules. Getting this wrong in the cautious direction costs printing; getting it wrong in
        the other direction costs a citation.
      </p>
      <div class="hub-cards">
        {PURPOSE_BRANCHES.map((b) => (
          <a
            href={`/ghs-label-maker/${b.slug}/`}
            class="hub-card"
            style={`--acc:${b.acc};--acc-line:${b.line};--acc-soft:${b.soft};--acc-ink:${b.ink}`}
          >
            <p class="tag">{b.badge}</p>
            <h3>{b.cardTitle}</h3>
            <p class="copy">{b.cardDesc}</p>
            <span class="cta">Open →</span>
          </a>
        ))}
        <a
          href="/ghs-label-maker/templates/"
          class="hub-card"
          {/* ⚠ Нейтральный акцент карточки — ТОКЕНАМИ. У остальных карточек ряда
              акцент приходит из данных ветки (`labelMakerHub.ts`), и это законно:
              цвет там — свойство ветки. А здесь он был просто вписан четырьмя
              литералами, мимо палитры. */}
          style="--acc:var(--ink-3);--acc-line:var(--line);--acc-soft:#f8fafc;--acc-ink:var(--ink-2)"
        >
          <p class="tag">Templates</p>
          <h3>Label size templates</h3>
          <p class="copy">
            Avery, OnlineLabels and HERMA geometries with the tool preset to each one — 4 × 2 in, 4 × 6 in,
            full sheet, A4 and the rest.
          </p>
          <span class="cta">Open →</span>
        </a>
      </div>
    </div>
  </section>

  {/* ── 05 · ПЕЧАТЬ ───────────────────────────────────────────────────────── */}
  <section class="hub-sec-white" id="printing">
    <div class="hub-wrap">
      <p class="hub-eyebrow">05 · Printing</p>
      <h2 class="hub-h2">Getting it onto the container</h2>

      <div class="hub-prose">
        <h3 class="lm-h3">The PDF is vector, and that matters</h3>
        <p>
          Text in the exported PDF is native vector rather than a rasterised picture of text: it stays
          sharp at any size, prints at the resolution of the printer rather than of the screen, and stays
          selectable and searchable. Only the pictograms are rasterised, and those at 600 dpi. The SVG
          export carries its width and height in millimetres, so it opens at the correct physical size in
          a design application instead of at some arbitrary pixel dimension.
        </p>

        <h3 class="lm-h3">Sheets, not single labels</h3>
        <p>
          Choose a sheet — Letter, Legal, A4 or A3 — and the same label is laid out N-up at the pitch of
          the stock, so a pack of blank labels goes through the printer in one pass. This is where
          secondary container labels get cheap: ten to a Letter sheet on 4 × 2 in stock, twelve on 2 × 2 in.
        </p>

        <h3 class="lm-h3">Material</h3>
        <p>
          For a container being shipped, paper is not enough — the label has to survive the chemical it is
          stuck to. Avery UltraDuty and the OnlineLabels chemical-resistant range are the usual
          laser-printable films; for packages that travel by sea, look for BS 5609 certification, which
          tests survival in salt water. For a secondary container that stays indoors and is relabelled at
          every refill, ordinary paper labels are reasonable.
        </p>

        <h3 class="lm-h3">Presets store geometry, not part numbers</h3>
        <p>
          A single 4 × 2 in preset covers Avery 60505, Avery 60525, Avery 5163, Presta 94207 and
          OnlineLabels OL3540 and OL125 at once, because they are the same rectangle. Storing vendor codes
          instead would turn the list into a catalogue that goes stale every time a manufacturer renumbers
          a product line.
        </p>
      </div>

      <div class="hub-table-wrap" style="margin-top:26px">
        <table class="hub-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Per sheet</th>
              <th scope="col">Also sold as</th>
              <th scope="col">Template</th>
            </tr>
          </thead>
          <tbody>
            {featured.map(({ t, s }) => (
              <tr>
                <td class="c-code">{stockSizeLabel(s)}</td>
                <td class="c-code">{s.perSheet === null ? 'roll' : `${s.perSheet} · ${SHEET_NAME[s.sheet]}`}</td>
                <td class="c-txt">{s.aliases.join(', ')}</td>
                <td class="c-code"><a href={`/ghs-label-maker/templates/${t.slug}/`}>Open →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="hub-fine">
        Sizes are as published by the manufacturers; see <a href="/ghs-label-maker/templates/">all templates</a>
        for the full list including the European A4 geometries and thermal-transfer rolls. Vendor part
        numbers are given for identification only.
      </p>
    </div>
  </section>

  {/* ── 06 · FAQ ──────────────────────────────────────────────────────────── */}
  <section class="hub-sec-b" id="faq">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">06 · Questions</p>
      <h2 class="hub-h2">Frequently asked</h2>
      <div class="hub-faq">
        {HUB_FAQ.map((f) => (
          <div class="hub-faq-item">
            <p class="q">{f.q}</p>
            <p class="a" set:html={f.a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── 07 · ОСТАЛЬНОЙ САЙТ ───────────────────────────────────────────────── */}
  <section class="hub-sec-white" id="more">
    <div class="hub-wrap">
      <p class="hub-eyebrow">07 · Elsewhere on the site</p>
      <h2 class="hub-h2">Other tools</h2>
      <p class="hub-sub">
        A label is the last step. These are the steps before it — and the reference sections behind the
        data this tool fills itself from.
      </p>
      <div class="hub-mini-cards">
        {tools.map((l) => (
          <a class={withAccent('hub-mini-card', l.href)} href={l.href}>
            {accentBadge(l.href) && <span class="sect">{accentBadge(l.href)}</span>}
            <strong>{l.title}</strong>
            <span>{l.desc}</span>
          </a>
        ))}
      </div>

      {/* ⚠ У этого заголовка надзаголовка не было, а у «Other tools» есть —
          ритм секции по дизайн-системе (надзаголовок → h2 → подзаголовок) на
          втором блоке обрывался, и заголовок висел без опоры. */}
      <p class="hub-eyebrow" style="margin-top:44px">Reference</p>
      <h2 class="hub-h2">Reference hubs</h2>
      <p class="hub-sub">
        The sections this tool reads from. Each card carries the colour of the section it opens —
        the same colour that section uses everywhere else on the site.
      </p>
      <div class="hub-mini-cards">
        {hubs.map((l) => (
          <a class={withAccent('hub-mini-card', l.href)} href={l.href}>
            {accentBadge(l.href) && <span class="sect">{accentBadge(l.href)}</span>}
            <strong>{l.title}</strong>
            <span>{l.desc}</span>
          </a>
        ))}
      </div>

      <p class="hub-fine">
        Reference layouts only. The supplier remains responsible for the classification and for the label.
        Classification data is from CLP Annex VI; only the official text of each regulation is
        authoritative — for CLP, only the electronic Official Journal is legally authentic.
      </p>
    </div>
  </section>

  {/* ⚠⚠ СТИЛЕЙ ЗДЕСЬ БОЛЬШЕ НЕТ. Классы `.lm-*` переехали в
      `src/styles/hub.css` — правило дизайн-системы: компонентные классы живут
      в системе, а не в разметке страницы. В блоке, который тут стоял, цвета
      были литералами (`#475569`, `#0f172a`, `#e2e8f0`), а `.lm-h3` объявлялся
      ещё и на второй странице раздела — с другими отступами.
      Разбор — `claude/design-system.md`. */}
</Layout>
