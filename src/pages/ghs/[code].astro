---
export const prerender = true
import Layout from '../../layouts/Layout.astro'
import SvgDownloadButton from '../../components/SvgDownloadButton'
import GhsCalculator from '../../components/GhsCalculator'
import SharePage from '../../components/SharePage.astro'
import { supabase } from '../../lib/supabase'
import { hHref } from '../../lib/hStatementSlug'
import { substanceName, substanceNameFull } from '../../lib/substanceName'
import { substanceHref } from '../../lib/substanceSlug'
import { casForDisplay, casShapeOk } from '../../lib/substanceIdentifiers'

export async function getStaticPaths() {
  return [
    'GHS01','GHS02','GHS03','GHS04','GHS05',
    'GHS06','GHS07','GHS08','GHS09'
  ].map(code => ({ params: { code: code.toLowerCase() } }))
}

const { code } = Astro.params
const upperCode = (code ?? '').toUpperCase()

const GHS_META: Record<string, {
  name: string
  hazardClass: string
  color: string
  bgLight: string
  borderColor: string
  textColor: string
  description: string
  storageNote: string
  regulatoryNote: string
  adnNote: string
}> = {
  GHS01: {
    name: 'Exploding Bomb',
    hazardClass: 'Explosives',
    color: '#7C3AED',
    bgLight: '#F5F3FF',
    borderColor: '#DDD6FE',
    textColor: '#4C1D95',
    description: 'The exploding bomb pictogram indicates explosive substances, mixtures, and articles, including self-reactive substances and organic peroxides. These materials release energy rapidly when subjected to shock, heat, or friction.',
    storageNote: 'Store only in approved explosive magazines. Segregate from all ignition sources, heat, open flame, and friction. Access restricted to authorised personnel. Quantities must be minimised. Earthing and bonding required during transfer.',
    regulatoryNote: 'Under CLP Regulation (EC) No 1272/2008, GHS01 applies to explosive substances in Division 1.1–1.6. EU Directive 2014/28/EU governs commercial explosives. OSHA 29 CFR 1910.109 covers storage and handling in the USA.',
    adnNote: 'ADR/RID Class 1 — Explosive substances. UN placards use an orange rectangle with black flame/explosion symbol. Transport requires specialised vehicles and trained drivers under ADR regulations.',
  },
  GHS02: {
    name: 'Flame',
    hazardClass: 'Flammable substances',
    color: '#DC2626',
    bgLight: '#FFF7ED',
    borderColor: '#FED7AA',
    textColor: '#7C2D12',
    description: 'The flame pictogram indicates flammable gases, aerosols, liquids, and solids, as well as pyrophoric, self-heating, and water-reactive substances. Flash point below 60 °C for liquids is a key trigger.',
    storageNote: 'Store in dedicated flammable storage cabinet away from oxidisers and ignition sources. Use explosion-proof electrical equipment. Ground and bond containers during transfer to prevent static discharge. Keep containers tightly closed.',
    regulatoryNote: 'CLP categories: Flammable Liquids Cat. 1–3 (H224/H225/H226), Flammable Gases Cat. 1–2 (H220/H221). OSHA 29 CFR 1910.106 governs flammable liquid storage. NFPA 30 provides fire protection standards.',
    adnNote: 'ADR Class 3 (flammable liquids) or Class 2.1 (flammable gases). Transport placards show red diamond with black flame. Flashpoint determines packing group: PG I (<23°C), PG II (23–60°C).',
  },
  GHS03: {
    name: 'Flame Over Circle',
    hazardClass: 'Oxidising substances',
    color: '#D97706',
    bgLight: '#FFFBEB',
    borderColor: '#FDE68A',
    textColor: '#78350F',
    description: 'The flame over circle pictogram indicates oxidising gases, liquids, and solids. These substances can intensify fire or cause combustion in materials that normally would not burn, significantly increasing fire risk.',
    storageNote: 'Store separately from all flammable, combustible, and organic materials. Keep cool and dry. Use dedicated non-combustible storage. Never store near reducing agents or acids. Ensure adequate ventilation.',
    regulatoryNote: 'CLP categories: Oxidising Gases Cat. 1 (H270), Oxidising Liquids Cat. 1–3 (H271/H272), Oxidising Solids Cat. 1–3. OSHA 29 CFR 1910.104 covers oxygen storage. Special permits may apply for Category 1 oxidisers.',
    adnNote: 'ADR Class 5.1 (oxidising substances) or Class 2.2 with oxidising sub-risk. Yellow diamond with black flame over circle. Must be segregated from Class 3 and Class 4 goods during transport.',
  },
  GHS04: {
    name: 'Gas Cylinder',
    hazardClass: 'Gases under pressure',
    color: '#0284C7',
    bgLight: '#F0F9FF',
    borderColor: '#BAE6FD',
    textColor: '#0C4A6E',
    description: 'The gas cylinder pictogram indicates compressed, liquefied, refrigerated liquefied, or dissolved gases stored under pressure. These present risks of explosion if heated and asphyxiation if released in confined spaces.',
    storageNote: 'Secure cylinders upright with chains or straps at all times. Store away from heat sources, corrosives, and ignition sources. Use correct regulators and valves. Ensure adequate ventilation in storage and use areas. Cap cylinders when not in use.',
    regulatoryNote: 'EU Pressure Equipment Directive (PED) 2014/68/EU applies to gas cylinders. EN ISO 11114-1 covers material compatibility. OSHA 29 CFR 1910.101 governs compressed gas handling in the USA. Regular inspection required.',
    adnNote: 'ADR Class 2 — Gases. Placard colour depends on gas type: non-flammable/non-toxic (green), flammable (red), toxic (white). UN number identifies specific gas. Specialised transport vehicles may be required.',
  },
  GHS05: {
    name: 'Corrosion',
    hazardClass: 'Corrosive substances',
    color: '#7C3AED',
    bgLight: '#FAF5FF',
    borderColor: '#E9D5FF',
    textColor: '#4C1D95',
    description: 'The corrosion pictogram indicates substances that cause severe skin burns and eye damage (H314/H318) or are corrosive to metals (H290). Contact can cause permanent tissue destruction within minutes.',
    storageNote: 'Store in acid-resistant or alkali-resistant cabinets as appropriate. Do not store in metal containers for corrosive-to-metals substances. Use secondary containment (drip trays). Segregate acids from bases. Ensure eyewash stations are accessible within 10 seconds.',
    regulatoryNote: 'CLP Skin Corrosion Cat. 1A/1B/1C (H314) and Eye Damage Cat. 1 (H318). EU Directive 98/24/EC covers chemical agents at work. OSHA 29 CFR 1910.1000 sets PELs. Emergency eyewash required per ANSI Z358.1.',
    adnNote: 'ADR Class 8 — Corrosive substances. Black and white diamond with test tubes showing corrosion. Packing groups I–III based on severity. Segregation from food, metals, and certain organic materials required.',
  },
  GHS06: {
    name: 'Skull and Crossbones',
    hazardClass: 'Acute toxicity (severe)',
    color: '#1F2937',
    bgLight: '#F9FAFB',
    borderColor: '#D1D5DB',
    textColor: '#111827',
    description: 'The skull and crossbones pictogram indicates severe acute toxicity via oral (H300/H301), dermal (H310/H311), or inhalation (H330/H331) routes. Categories 1–3 represent the highest acute toxicity levels under GHS/CLP.',
    storageNote: 'Store in locked, well-ventilated area. Access restricted to trained and authorised personnel only. Secondary containment mandatory. Biological and air monitoring may be required. Emergency procedures and antidotes must be available and documented.',
    regulatoryNote: 'CLP Acute Toxicity Cat. 1–3. Suppresses GHS07 on labels per CLP Article 26. OSHA 29 CFR 1910.1200 requires full hazcom programme. EU occupational exposure limits (OELs) under Directive 2017/164/EU may apply.',
    adnNote: 'ADR Class 6.1 — Toxic substances. White diamond with skull and crossbones. Packing group I (very toxic), II (toxic), or III (harmful). Closed cargo transport vehicles required for PG I liquids.',
  },
  GHS07: {
    name: 'Exclamation Mark',
    hazardClass: 'Harmful substances',
    color: '#D97706',
    bgLight: '#FFFBEB',
    borderColor: '#FDE68A',
    textColor: '#78350F',
    description: 'The exclamation mark pictogram indicates acute toxicity of lower severity (H302/H312/H332), skin and eye irritation (H315/H319), skin sensitisation (H317), and respiratory/narcotic effects (H335/H336). Suppressed when GHS06, GHS05, or GHS08 applies.',
    storageNote: 'Provide adequate ventilation in work areas. Wear appropriate PPE: gloves, eye protection, and respiratory protection if vapour concentrations may exceed OELs. Keep containers closed when not in use. Wash hands thoroughly after handling.',
    regulatoryNote: 'CLP Acute Toxicity Cat. 4 and various irritation/sensitisation categories. Suppressed on label by GHS06 (acute tox. Cat. 1–3) and GHS05 per CLP Article 26. OSHA HCS 2012 aligns with these classifications.',
    adnNote: 'Harmful substances (Class 6.1 PG III) may display GHS07 for transport. However, many GHS07-classified substances fall below ADR transport thresholds and do not require hazmat placards for road transport.',
  },
  GHS08: {
    name: 'Health Hazard',
    hazardClass: 'Serious long-term health hazards',
    color: '#BE185D',
    bgLight: '#FDF2F8',
    borderColor: '#FBCFE8',
    textColor: '#831843',
    description: 'The health hazard pictogram indicates serious chronic or irreversible health effects: carcinogenicity (H350/H351), mutagenicity (H340/H341), reproductive toxicity (H360/H361/H362), respiratory sensitisation (H334), and specific target organ toxicity (H370–H373).',
    storageNote: 'Minimise exposure using engineering controls: local exhaust ventilation, closed systems, gloveboxes. Biological monitoring and medical surveillance may be legally required. Substitution should be considered for Cat. 1A/1B substances. Restrict access and maintain exposure records.',
    regulatoryNote: 'CMR substances (Cat. 1A/1B) face restrictions under REACH Annex XVII and may be SVHC candidates. EU Directive 2004/37/EC covers carcinogens at work. OSHA 29 CFR 1910.1003–.1016 lists specific carcinogens with individual standards.',
    adnNote: 'GHS08 substances transported as Class 6.1 or Class 9 depending on classification. Carcinogens and mutagens may be subject to IATA DGR and IMDG Code special provisions for transport documentation and packaging.',
  },
  GHS09: {
    name: 'Environmental Hazard',
    hazardClass: 'Aquatic environmental hazards',
    color: '#0D9488',
    bgLight: '#F0FDFA',
    borderColor: '#99F6E4',
    textColor: '#134E4A',
    description: 'The environmental hazard pictogram indicates substances that are acutely or chronically toxic to aquatic life (H400–H413) or harm the ozone layer (H420). Even small releases can cause lasting ecological damage to water systems.',
    storageNote: 'Do not allow entry to drains, waterways, or soil. Use bunded storage areas. Spill containment equipment must be available. Disposal must comply with local water authority regulations. Contact emergency services immediately for significant spills near water.',
    regulatoryNote: 'CLP Aquatic Acute Cat. 1 (H400) and Chronic Cat. 1–4 (H410–H413). EU Water Framework Directive (2000/60/EC) sets environmental quality standards. Priority substances under Annex II may face market restrictions. REACH registration requires aquatic toxicity data.',
    adnNote: 'Environmentally hazardous substances (aquatic) transported under ADR as Class 9 or with marine pollutant mark (MP). IMDG Code requires marine pollutant label for sea transport. PP1 packaging provision applies for small quantities.',
  },
}

const meta = GHS_META[upperCode]
if (!meta) return Astro.redirect('/pictograms/')

// Загружаем SVG пиктограммы
const { data: picData } = await supabase
  .from('pictograms_signals')
  .select('code, name_en, svg_content, svg_url, signal_word_en')
  .eq('code', upperCode)
  .single()

// Загружаем вещества с этой пиктограммой (первые 24)
const { data: substancesRaw } = await supabase
  .from('substances')
  .select('cas_number, iupac_name, common_name, display_name_short, signal_word, ghs_pictogram_codes')
  .contains('ghs_pictogram_codes', [upperCode])
  .not('cas_number', 'is', null)
  .limit(24)

const substances = substancesRaw ?? []

/**
 * ⚠ Список H-кодов пиктограммы берётся ТОЛЬКО из базы (session 22).
 * Раньше он лежал массивом `hCodes` прямо в этом файле и разъехался с первоисточником
 * в одиннадцати местах: H315 стоял на GHS05 (это GHS07), H304 отсутствовал на GHS08,
 * GHS09 нёс H401/H412/H413, у которых пиктограммы нет вообще.
 * Разбор — `claude/pictograms-page-audit.md`. Первоисточник — UN GHS Rev.11, Annex 3.
 * Не возвращать хардкод: `hazard_category_mapping` — единственное место правки.
 */
const { data: mappingRaw } = await supabase
  .from('hazard_category_mapping')
  .select(
    'category_code, signal_word, h_statement_code, hazard_class_catalog(name_en, ghs_chapter, display_order), h_statements(text_plain)'
  )
  .eq('pictogram_code', upperCode)
  .not('h_statement_code', 'is', null)

type MappingRow = {
  category_code: string | null
  signal_word: string | null
  h_statement_code: string
  hazard_class_catalog: {
    name_en: string
    ghs_chapter: string | null
    display_order: number | null
  } | null
  h_statements: { text_plain: string } | null
}

const mapping = ((mappingRaw ?? []) as unknown as MappingRow[]).sort((a, b) => {
  const oa = a.hazard_class_catalog?.display_order ?? 999
  const ob = b.hazard_class_catalog?.display_order ?? 999
  if (oa !== ob) return oa - ob
  return (a.category_code ?? '').localeCompare(b.category_code ?? '')
})

// Уникальные H-коды пиктограммы, в порядке возрастания кода
const hStatements = Array.from(
  new Map(
    mapping.map((r) => [
      r.h_statement_code,
      { code: r.h_statement_code, text_en: r.h_statements?.text_plain ?? '' },
    ])
  ).values()
).sort((a, b) => a.code.localeCompare(b.code))

// Сигнальные слова: у GHS06 все категории Danger, у GHS07 все Warning, у GHS02 — обе
const signalWords = Array.from(
  new Set(mapping.map((r) => r.signal_word).filter((w): w is string => Boolean(w)))
).sort()

const hazardClassCount = new Set(
  mapping.map((r) => r.hazard_class_catalog?.name_en).filter(Boolean)
).size

/**
 * ⚠ session 23: строка вещества ниже вела на `/pictograms/<cas>/`. Маршрута с таким
 * именем нет — она работала лишь потому, что правило `/pictograms/*` уводило запрос
 * 301 на ghssymbols.com/hazards/<cas>/. Правило снято (там теперь хаб).
 *
 * Решение Сергея: ссылка остаётся живой. Локальная `/sds/<slug>/` там, где страница
 * есть, и АБСОЛЮТНАЯ на ghssymbols у остальных — напрямую, без хопа через редирект.
 * ⚠⚠ Session 36: раздел переехал, пометка выше закрыта. Ссылка ведёт на СВОЮ
 * страницу вещества `/substances/<имя>-<cas>/`. Прежняя абсолютная на
 * ghssymbols.com/hazards/ теперь отдаёт 301 и уводит вес на домен, который мы сливаем.
 * ⚠ Живая SDS остаётся в приоритете: таких веществ 106, страница богаче.
 */
const { data: sdsRaw } = await supabase
  .from('sds_pages')
  .select('slug, cas_number')
  .eq('status', 'live')
  .in('cas_number', substances.map((s) => s.cas_number).filter(Boolean))
const sdsSlug = new Map<string, string>(
  ((sdsRaw ?? []) as { slug: string; cas_number: string | null }[])
    .filter((r) => r.cas_number)
    .map((r) => [r.cas_number as string, r.slug])
)

// Считаем сколько веществ с этой пиктограммой всего
const { count: totalCount } = await supabase
  .from('substances')
  .select('cas_number', { count: 'exact', head: true })
  .contains('ghs_pictogram_codes', [upperCode])
  .not('cas_number', 'is', null)

/**
 * ⚠ Совместная встречаемость пиктограмм — session 23.
 * Считается из наших же веществ: сколько записей, несущих эту пиктограмму, несут заодно
 * каждую из восьми остальных. Такого блока нет ни у одного конкурента, и он показывает
 * правила вытеснения Article 26 живыми числами, а не пересказом.
 * ⚠ Тот же фильтр `cas_number is not null` и та же сортировка по index_number, что на
 * хабе /pictograms/ — иначе числа на двух страницах разойдутся и обе будут «правильные».
 */
const PAGE_SIZE = 1000
const coSets: string[][] = []
for (let from = 0; ; from += PAGE_SIZE) {
  const { data, error } = await supabase
    .from('substances')
    .select('index_number, ghs_pictogram_codes')
    .contains('ghs_pictogram_codes', [upperCode])
    .not('cas_number', 'is', null)
    .order('index_number')
    .range(from, from + PAGE_SIZE - 1)
  if (error) throw new Error(`substances (co-occurrence ${upperCode}): ${error.message}`)
  const rowsCo = (data ?? []) as { index_number: string; ghs_pictogram_codes: string[] | null }[]
  for (const r of rowsCo) coSets.push(Array.from(new Set(r.ghs_pictogram_codes ?? [])))
  if (rowsCo.length < PAGE_SIZE) break
}
if (coSets.length === 0) throw new Error(`${upperCode}: ноль веществ с пиктограммой — сборка была бы пустой`)

const CO_TOTAL = coSets.length
const ALL_CODES = ['GHS01','GHS02','GHS03','GHS04','GHS05','GHS06','GHS07','GHS08','GHS09']
const coCount = new Map<string, number>()
for (const set of coSets) for (const c of set) if (c !== upperCode && ALL_CODES.includes(c)) {
  coCount.set(c, (coCount.get(c) ?? 0) + 1)
}
const coRows = ALL_CODES
  .filter((c) => c !== upperCode && (coCount.get(c) ?? 0) > 0)
  .map((c) => ({
    code: c,
    name: GHS_META[c]?.name ?? c,
    n: coCount.get(c) ?? 0,
    pct: Math.round(((coCount.get(c) ?? 0) / CO_TOTAL) * 1000) / 10,
  }))
  .sort((a, b) => b.n - a.n)
const coOf = (c: string) => coCount.get(c) ?? 0
const nf = (n: number) => n.toLocaleString('en-US')

/**
 * ⚠ Приоритет пиктограмм — CLP Article 26, сверено дословно по
 * `_source-docs/CELEX_02008R1272-20260501_EN_TXT.pdf`, строки 1456–1490.
 * На каждой странице показываются ТОЛЬКО правила, которые её касаются: правило,
 * не относящееся к этой пиктограмме, — это чужой текст на странице.
 * Пункт (e) внесён поправкой M2 и в большинстве справочников отсутствует.
 */
type Rule = { ref: string; text: string; ours: string }
const RULES_BY_CODE: Record<string, Rule[]> = {
  GHS01: [{
    ref: 'Article 26(1)(a)',
    text: 'If <b>GHS01</b> applies, the use of GHS02 and GHS03 becomes <b>optional</b> — unless more than one of them is compulsory.',
    ours: `The bomb almost always travels alone: only <b>${coOf('GHS02')}</b> of the <b>${nf(CO_TOTAL)}</b> harmonised entries carrying GHS01 also carry GHS02, and <b>${coOf('GHS03') || 'none'}</b> carries GHS03.`,
  }],
  GHS02: [{
    ref: 'Article 26(1)(a)',
    text: 'If GHS01 applies, the use of <b>GHS02</b> and GHS03 becomes <b>optional</b> — unless more than one of them is compulsory.',
    ours: `Rarely in play here: <b>${coOf('GHS01')}</b> of the <b>${nf(CO_TOTAL)}</b> entries carrying the flame also carry the exploding bomb.`,
  }, {
    ref: 'Article 26(1)(e)',
    text: 'If <b>GHS02</b> or GHS06 applies, the use of <b>GHS04</b> becomes <b>optional</b>.',
    ours: `Added to CLP by amendment and routinely missed. <b>${coOf('GHS04')}</b> entries carry the flame together with the gas cylinder — on those labels the cylinder is a choice, not an obligation.`,
  }],
  GHS03: [{
    ref: 'Article 26(1)(a)',
    text: 'If GHS01 applies, the use of GHS02 and <b>GHS03</b> becomes <b>optional</b> — unless more than one of them is compulsory.',
    ours: `Never in play in the harmonised list: <b>${coOf('GHS01') || 'not one'}</b> of the <b>${nf(CO_TOTAL)}</b> entries carrying flame over circle also carries the exploding bomb.`,
  }],
  GHS04: [{
    ref: 'Article 26(1)(e)',
    text: 'If GHS02 or GHS06 applies, the use of <b>GHS04</b> becomes <b>optional</b>.',
    ours: `This is the rule that fires constantly, and almost nobody quotes it: <b>${coOf('GHS02')}</b> of the <b>${nf(CO_TOTAL)}</b> gas-cylinder entries also carry GHS02 and another <b>${coOf('GHS06')}</b> carry GHS06. On almost every real cylinder label the gas-cylinder diamond is optional.`,
  }],
  GHS05: [{
    ref: 'Article 26(1)(c)',
    text: 'If <b>GHS05</b> applies, GHS07 shall not appear <b>for skin or eye irritation</b> — and only for that.',
    ours: `Read as a blanket ban this rule does damage: <b>${coOf('GHS07')}</b> of the <b>${nf(CO_TOTAL)}</b> entries carrying corrosion legitimately carry GHS07 as well, because their exclamation mark comes from acute toxicity category 4, sensitisation or narcotic effects — none of which the rule touches.`,
  }],
  GHS06: [{
    ref: 'Article 26(1)(b)',
    text: 'If <b>GHS06</b> applies, <b>GHS07 shall not appear</b>. No exception, no discretion.',
    ours: `Exactly <b>${coOf('GHS07')}</b> of the <b>${nf(CO_TOTAL)}</b> harmonised entries carrying the skull lists GHS07 as well — DNOC, index 609-020-00-X. Annex VI prints the classification; Article 26 takes the exclamation mark off the label.`,
  }, {
    ref: 'Article 26(1)(e)',
    text: 'If GHS02 or <b>GHS06</b> applies, the use of <b>GHS04</b> becomes <b>optional</b>.',
    ours: `<b>${coOf('GHS04')}</b> entries carry the skull together with the gas cylinder — on those labels the cylinder may be dropped.`,
  }],
  GHS07: [{
    ref: 'Article 26(1)(b)',
    text: 'If GHS06 applies, <b>GHS07 shall not appear</b>.',
    ours: `The hardest of the three: no exception at all. Only <b>${coOf('GHS06')}</b> harmonised entry carries both, and on its label the exclamation mark is removed.`,
  }, {
    ref: 'Article 26(1)(c)',
    text: 'If GHS05 applies, <b>GHS07</b> shall not appear <b>for skin or eye irritation</b> — and only for that.',
    ours: `Narrow, and widely over-applied. <b>${coOf('GHS05')}</b> entries carry both, and most keep the exclamation mark because it comes from something the rule does not cover — acute toxicity category 4, sensitisation, narcotic effects.`,
  }, {
    ref: 'Article 26(1)(d)',
    text: 'If GHS08 applies <b>for respiratory sensitisation</b>, <b>GHS07</b> shall not appear for skin sensitisation or for skin and eye irritation.',
    ours: `Narrower still: it fires only when the health-hazard diamond is there because of asthma. <b>${coOf('GHS08')}</b> entries carry both pictograms; the rule reaches only the respiratory-sensitiser slice of them.`,
  }],
  GHS08: [{
    ref: 'Article 26(1)(d)',
    text: 'If <b>GHS08</b> applies <b>for respiratory sensitisation</b>, GHS07 shall not appear for skin sensitisation or for skin and eye irritation.',
    ours: `It fires only when the health-hazard diamond is there because the substance causes asthma — not because it causes cancer or organ damage. <b>${coOf('GHS07')}</b> harmonised entries carry GHS08 and GHS07 together; the rule reaches only the respiratory-sensitiser slice of them, and leaves the rest with both diamonds.`,
  }],
  GHS09: [],
}
const rulesHere = RULES_BY_CODE[upperCode] ?? []

/**
 * Один вывод из матрицы встречаемости на страницу. Пишется руками, но опирается на
 * посчитанные числа — не наоборот.
 */
const CO_NOTE: Record<string, string> = {
  GHS01: 'The surprise here is what is missing: the exploding bomb pairs with the health hazard and the environment far more often than with the flame. An explosive is more likely to be a carcinogen than to be classified as flammable.',
  GHS02: 'Half of everything flammable is also a long-term health hazard. Fire safety and occupational health are the same shelf, not two.',
  GHS03: 'An oxidiser is as likely to be corrosive as to be an environmental hazard, and it reaches the flame pictogram almost never — it does not burn, it makes other things burn.',
  GHS04: 'The strongest pairing on the whole site: nine cylinders in ten also carry the flame, and more than eight in ten carry the health hazard. A gas under pressure is almost never only a pressure problem.',
  GHS05: 'Corrosion travels with the exclamation mark on half of these entries — and that is exactly the pair CLP Article 26(1)(c) is most often wrongly used to break.',
  GHS06: 'What kills a person usually kills a fish: nearly two thirds of acutely toxic entries also carry the environment pictogram. Disposal is part of the hazard, not an afterthought.',
  GHS07: 'The exclamation mark is the most common companion pictogram on the site, and its own most frequent partner is the environment — the mild-to-a-person, harsh-to-the-water combination.',
  GHS08: 'The pairing with GHS09 is the one to remember: a third of everything that damages a person over time also damages the aquatic environment, which is why disposal, not just handling, belongs in the risk assessment.',
  GHS09: 'The environment pictogram rarely travels alone — it sits next to the exclamation mark on half of these entries and next to the health hazard on four in ten.',
}

/**
 * ⚠ Блок «прямой ответ» под экзаменационный интент — session 23.
 * Формулировки взяты дословно из запросов: ≈2 300/мес при SD 6–36, и мы уже показываемся
 * по ним на позициях 5–9 с НУЛЁМ кликов (claude/pictograms-seo-baseline.md §3.6,
 * claude/pictograms-keyword-list.md §5). Ответ обязан стоять первой строкой.
 * Все числа подставляются из базы. Все регуляторные утверждения сверены по первоисточнику:
 * CLP Table 2.1.2 (взрывчатка), 2.6.1 и 2.6.2 (горючие жидкости), 2.16 (коррозия металлов),
 * Annex I 1.2.1 (размеры), OSHA 1910.1200 App. C Figure C.1 (восемь символов, без GHS09).
 */
const FAQ_BY_CODE: Record<string, [string, string][]> = {
  GHS01: [
    ['What does the exploding bomb pictogram indicate?',
     `Explosives, plus the two families that behave like them: self-reactive substances of types A and B, and organic peroxides of types A and B. ${hazardClassCount} CLP hazard classes lead to this pictogram and it carries ${hStatements.length} hazard statements.`],
    ['Do all explosives carry GHS01?',
     'No, and this is the detail most charts get wrong. CLP Table 2.1.2 gives the pictogram to unstable explosives and to divisions 1.1, 1.2, 1.3 and 1.4. Division 1.5 — may mass explode in fire — carries the signal word Danger and H205 but no pictogram at all, and division 1.6 carries no pictogram, no signal word and no hazard statement.'],
    ['Which signal word goes with the exploding bomb?',
     'Danger for unstable explosives and for divisions 1.1, 1.2 and 1.3. Division 1.4, a fire or projection hazard, takes Warning. That single exception is the only reason this pictogram appears with both words.'],
    ['Does GHS01 replace the flame pictogram?',
     `Under Article 26(1)(a) it makes GHS02 and GHS03 optional, unless more than one of them is compulsory. In the harmonised list only ${coOf('GHS02')} of the ${nf(CO_TOTAL)} entries carrying GHS01 also carry GHS02.`],
    ['How many chemicals carry GHS01?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI — the rarest of the nine, alongside GHS03.`],
  ],
  GHS02: [
    ['What does the flame pictogram on a chemical label indicate?',
     `That the substance can catch fire — on its own, in air, or on contact with water. ${hazardClassCount} CLP hazard classes lead to this pictogram, more than any other, and it carries ${hStatements.length} hazard statements.`],
    ['Which hazards make up the flame pictogram?',
     'Flammable gases, aerosols, flammable liquids, flammable solids, self-reactive substances of types B to F, pyrophoric liquids, pyrophoric solids, self-heating substances, substances that emit flammable gases in contact with water, organic peroxides of types B to F, and desensitised explosives.'],
    ['Does the flash point decide whether a liquid gets the flame?',
     'For liquids, yes. A flammable liquid under CLP has a flash point of 60 °C or below. Category 1 is a flash point under 23 °C with an initial boiling point of 35 °C or less; category 2 is under 23 °C with a boiling point above 35 °C; category 3 runs from 23 °C to 60 °C. Gas oils, diesel and light heating oils with a flash point between 55 °C and 75 °C may be treated as category 3.'],
    ['Which signal word goes with the flame?',
     'Both, by category. For flammable liquids, categories 1 and 2 take Danger and category 3 takes Warning — which is why a can of white spirit and a can of petrol carry the same picture and different words.'],
    ['How many chemicals carry GHS02?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI.`],
  ],
  GHS03: [
    ['What does the flame over circle pictogram mean?',
     `That the substance supplies oxygen and makes other materials burn — an oxidising gas, liquid or solid. ${hazardClassCount} CLP hazard classes lead to it and it carries ${hStatements.length} hazard statements: H270, H271 and H272.`],
    ['What is the difference between the flame and the flame over circle?',
     'The flame burns. The flame over circle does not have to burn at all — it feeds a fire that already exists, or starts one in a material that would not otherwise ignite. That is why oxidisers and flammables must be stored apart: each makes the other worse.'],
    ['Which signal word goes with the flame over circle?',
     'Both. Oxidising gases category 1 and the most severe oxidising liquids and solids take Danger; the milder categories take Warning.'],
    ['Is bleach an oxidiser under GHS?',
     'Sodium hypochlorite carries no oxidising hazard statement in CLP Annex VI, yet it is a real oxidiser in practice. Classification follows the test criteria, not intuition — and OSHA App. B explicitly allows known experience to override a test result. Absence of GHS03 is not evidence that a substance will not feed a fire.'],
    ['How many chemicals carry GHS03?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI — the rarest of the nine.`],
  ],
  GHS04: [
    ['The gas cylinder pictogram applies to chemicals that are…',
     `…held under pressure: compressed gases, liquefied gases, refrigerated liquefied gases and dissolved gases. One CLP hazard class leads to it — gases under pressure, chapter 2.5 — and it carries ${hStatements.length} hazard statements, H280 and H281.`],
    ['Does the gas cylinder mean the gas is toxic or flammable?',
     `No. It says nothing about what the gas does — only that it is stored under pressure and the container can burst or, if refrigerated, cause cryogenic burns. The other hazards arrive with other pictograms: ${coOf('GHS02')} of these ${nf(CO_TOTAL)} entries also carry the flame.`],
    ['Which signal word goes with the gas cylinder?',
     'Always Warning. Every category of gases under pressure takes the same word — this is one of only three pictograms that never appears with Danger.'],
    ['Why is GHS04 so often missing from a cylinder label?',
     `Because Article 26(1)(e) allows it. When GHS02 or GHS06 also applies, the gas cylinder becomes optional — and that covers ${coOf('GHS02') + coOf('GHS06')} of these ${nf(CO_TOTAL)} entries. A propane cylinder showing only the flame is correctly labelled.`],
    ['How many chemicals carry GHS04?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI.`],
  ],
  GHS05: [
    ['The corrosion pictogram depicts chemicals that…',
     `…destroy what they touch. Two different things, in fact: irreversible damage to skin and eyes, and corrosion of metals. ${hazardClassCount} CLP hazard classes lead to it, carrying ${hStatements.length} hazard statements — H290, H314 and H318.`],
    ['What characteristic does the corrosion pictogram depict?',
     'Destruction of tissue or material on contact, not toxicity. A corrosive substance need not be poisonous at all: the harm is chemical burning at the point of contact, which is why the picture shows a hand and a surface being eaten away rather than a person.'],
    ['What is the difference between GHS05 and GHS07 for skin?',
     `Severity. GHS05 is skin corrosion categories 1A to 1C — irreversible damage. GHS07 is skin irritation category 2, which heals. Article 26(1)(c) removes the exclamation mark when corrosion applies, but only for irritation: ${coOf('GHS07')} of these ${nf(CO_TOTAL)} entries legitimately keep both.`],
    ['Which signal word goes with the corrosion pictogram?',
     'Both, and the split is unusually clean. Skin corrosion and serious eye damage take Danger. A substance that is only corrosive to metals — H290, category 1 — takes Warning, because it threatens the drum rather than the person holding it.'],
    ['How many chemicals carry GHS05?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI.`],
  ],
  GHS06: [
    ['What does the skull and crossbones pictogram indicate?',
     `Acute toxicity in the fatal band — categories 1, 2 and 3, by swallowing, skin contact or breathing. ${hazardClassCount} CLP hazard classes lead to it, one per route, carrying ${hStatements.length} hazard statements: H300, H301, H310, H311, H330 and H331.`],
    ['What does the skull and crossbones pictogram identify — and what does it not?',
     'It identifies a substance where a small single dose can kill. It does not identify long-term harm: cancer, organ damage and effects on fertility carry the health hazard pictogram instead, and a chemical can be a proven carcinogen with no skull anywhere on the label.'],
    ['What is the difference between the skull and the exclamation mark?',
     `One category. Acute toxicity 1 to 3 gets the skull; category 4 — harmful rather than fatal — gets the exclamation mark. The boundary for the oral route sits at an ATE of 300 mg/kg. Article 26(1)(b) then forbids showing both: exactly ${coOf('GHS07')} harmonised entry lists them together.`],
    ['Which signal word goes with the skull and crossbones?',
     'Always Danger. Every category behind this pictogram carries the same word — there is no Warning-level skull.'],
    ['How many chemicals carry GHS06?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI.`],
  ],
  GHS07: [
    ['What does the exclamation mark pictogram indicate?',
     `The serious-but-not-severe band: acute toxicity category 4, skin and eye irritation, skin sensitisation, and single-exposure organ effects category 3 including narcotic effects. ${hazardClassCount} CLP hazard classes lead to it, more than any pictogram except the flame, carrying ${hStatements.length} hazard statements.`],
    ['Which pictogram is also known as the irritant pictogram?',
     'This one. GHS07 covers skin irritation category 2 and eye irritation category 2A, so it is routinely called the irritant symbol — but irritation is only two of its eight hazard classes. The same picture also means harmful if swallowed, may cause an allergic skin reaction, and may cause drowsiness or dizziness.'],
    ['What is the black exclamation mark pictogram?',
     'A misunderstanding worth clearing up. The symbol itself is always black — every GHS pictogram is a black symbol on a white background inside a red diamond. There is no separate black-bordered version for CLP labelling; a black-bordered diamond is a transport label, not a hazard pictogram.'],
    ['When is the exclamation mark removed from a label?',
     `Three of the five precedence rules in Article 26 point at it, and they are the reason a substance can be an irritant with no exclamation mark on the label. GHS06 removes it outright; GHS05 removes it for irritation only; GHS08 removes it for sensitisation when the health hazard is there because of asthma.`],
    ['How many chemicals carry GHS07?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI, and it is the most common companion pictogram of all — it appears next to another diamond more often than it appears alone.`],
  ],
  GHS08: [
    ['What does the health hazard pictogram indicate?',
     `Serious health effects that are not immediate poisoning: cancer, genetic damage, harm to fertility or the unborn child, damage to a specific organ, asthma caused by breathing the substance in, and lung damage from swallowing it. ${hazardClassCount} CLP hazard classes lead to this pictogram and it carries ${hStatements.length} hazard statements.`],
    ['Is GHS08 the cancer symbol?',
     'Carcinogenicity is one of the seven hazard classes behind it, not the only one. The same image also appears for mutagenicity, reproductive toxicity, organ toxicity, respiratory sensitisation and aspiration hazard. A drum carrying GHS08 is not necessarily carrying a carcinogen.'],
    ['What is the difference between GHS08 and GHS06?',
     `Timing. GHS06, the skull and crossbones, means a single dose can kill quickly — acute toxicity categories 1 to 3. GHS08 means harm that shows up later, or harm that is severe without being acutely lethal. Both appear together on ${coOf('GHS06')} substances.`],
    ['Which signal word goes with the health hazard pictogram?',
     'Both. Category 1 hazards — proven or presumed carcinogens, mutagens and reproductive toxicants, organ damage category 1, aspiration — take Danger. Category 2 hazards, where the evidence is suspected rather than established, take Warning. Five of the nine pictograms appear with either word; GHS06 is always Danger, and GHS04, GHS07 and GHS09 are always Warning.'],
    ['How many chemicals carry GHS08?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI — the most common of the nine.`],
  ],
  GHS09: [
    ['What does the environmental hazard pictogram indicate?',
     `Harm to the aquatic environment: acute category 1, and long-term categories 1 and 2. ${hazardClassCount} CLP hazard classes lead to it, carrying ${hStatements.length} hazard statements — H400, H410 and H411.`],
    ['Why do H412 and H413 have no pictogram?',
     'Because CLP stops the picture at long-term category 2. Categories 3 and 4 — harmful to aquatic life with long lasting effects, and may cause long lasting harmful effects — carry the hazard statement and no pictogram, no signal word. A label with no dead fish on it can still describe a substance that should never reach a drain.'],
    ['Is the environment pictogram required in the United States?',
     'No. OSHA lists eight standard hazard symbols in Appendix C to 1910.1200, Figure C.1, and the environment is not among them — aquatic hazards fall to the EPA, not to the Hazard Communication Standard. The same substance can legally carry this diamond on an EU label and not on a US one, which is a common source of confusion when a supplier ships to both.'],
    ['Which signal word goes with the environmental hazard pictogram?',
     'Always Warning. Aquatic acute 1 and aquatic chronic 1 and 2 all take the same word — this pictogram never appears with Danger.'],
    ['How many chemicals carry GHS09?',
     `${nf(CO_TOTAL)} substances with a harmonised classification in CLP Annex VI.`],
  ],
}
const faqHere = FAQ_BY_CODE[upperCode] ?? []

/**
 * ⚠ Формула title выведена из данных, а не из вкуса (session 22).
 * Разбор — `claude/pictograms-keyword-list.md` §9 и `claude/pictograms-seo-baseline.md` §3.
 *  1. Код первым словом: он даёт нам основную массу показов (GSC: `ghs07` — 913 за 28 дней).
 *  2. Имя вплотную к слову Pictogram: фраза «<имя> pictogram» несёт от 110 до 1 900 объёма
 *     в США и ищется отдельно от кода (`exclamation mark pictogram` — 1 900 при SD 15).
 *  3. Слово Meaning: подтверждено и Semrush, и нашими показами (`ghs07 meaning` — 77).
 *  4. Убрано «Download SVG» и «Substance List»: весь download-интент — около 350/мес,
 *     причём ищут PDF и printable, а не SVG (`ghs pictograms svg` — 10/мес).
 * Синоним «symbol» в title не влезает — держим его в описании и в подзаголовке.
 */
const seoTitle = `${upperCode} — ${meta.name} Pictogram: Meaning & Hazard Classes`
const seoDesc = `${upperCode} is the GHS/CLP ${meta.name.toLowerCase()} pictogram (hazard symbol). What it means, the ${hazardClassCount} hazard classes and categories that require it, its signal word${signalWords.length > 1 ? 's' : ''} ${signalWords.join(' and ')}, the ${hStatements.length} H-codes it carries and ${totalCount ?? substances.length} substances classified with it.`

const ghsJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `https://ghspictograms.com/ghs/${code}/`,
      url: `https://ghspictograms.com/ghs/${code}/`,
      name: seoTitle,
      description: seoDesc,
      inLanguage: 'en',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://ghspictograms.com/',
        name: 'GHS Pictograms',
        url: 'https://ghspictograms.com/',
      },
      about: {
        '@type': 'DefinedTerm',
        name: `${upperCode} — ${meta.name}`,
        description: meta.description,
        inDefinedTermSet: {
          '@type': 'DefinedTermSet',
          name: 'GHS Hazard Pictograms',
          url: 'https://ghspictograms.com/pictograms/',
        },
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://ghspictograms.com/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'GHS Pictograms',
            item: 'https://ghspictograms.com/pictograms/',
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: `${upperCode} — ${meta.name}`,
            item: `https://ghspictograms.com/ghs/${code}/`,
          },
        ],
      },
    },
    /**
     * ⚠ session 23: здесь стоял ВТОРОЙ, синтетический FAQPage — вопросы вида
     * «What does the GHS08 GHS pictogram mean?» собирались из meta.description,
     * storageNote и adnNote. Ответы на странице были, но не в виде вопросов, а
     * Google требует, чтобы разметка FAQPage соответствовала видимому тексту.
     * Теперь узел строится из того же массива, который рисует блок «Straight answers»,
     * то есть каждый вопрос из разметки физически есть на странице.
     * Проверка pict-page-answers в scripts/check-dist.ts сверяет два числа и падает,
     * если они разойдутся, — именно она это и поймала.
     */
    ...(faqHere.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faqHere.map(([q, a]) => ({
              '@type': 'Question',
              name: q,
              acceptedAnswer: { '@type': 'Answer', text: a },
            })),
          },
        ]
      : []),
  ],
}
---

<Layout
  title={seoTitle}
  description={seoDesc}
  titleIsComplete={true}
  canonical={`https://ghspictograms.com/ghs/${code}/`}
>

  <!-- Hero section -->
  <section class="bg-[#062A78] text-white py-16 px-4 hero-dots">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center gap-10">

      <!-- Большая пиктограмма -->
      {picData?.svg_content ? (
        <div
          class="shrink-0 w-48 h-48 [&>svg]:w-full [&>svg]:h-full"
          set:html={picData.svg_content}
        />
      ) : (
        <div class="shrink-0 w-48 h-48 bg-white/10 rounded-2xl flex items-center justify-center">
          <span class="text-white/60 text-sm font-mono">{upperCode}</span>
        </div>
      )}

      <!-- Заголовок -->
      <div>
        <p class="text-blue-200 text-sm font-semibold uppercase tracking-widest mb-2">GHS Hazard Pictogram</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">
          {upperCode} — {meta.name} Pictogram
        </h1>
        <p class="text-lg text-blue-100 mt-2">
          Also called the {meta.name.toLowerCase()} symbol.
          {signalWords.length > 0 && (
            <> Signal word: <strong class="text-white">{signalWords.join(' or ')}</strong>.</>
          )}
        </p>
        <p class="mt-3 text-blue-200 text-lg">{meta.hazardClass}</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/ghs-label-maker/"
            class="px-5 py-2.5 bg-white text-[#062A78] font-bold rounded-lg hover:bg-blue-50 transition-colors text-sm"
          >
            Use in Label Maker →
          </a>
          <a
            href="/pictograms/"
            class="px-5 py-2.5 border border-white/40 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-sm"
          >
            All 9 pictograms →
          </a>
          <a
            href="/substances/"
            class="px-5 py-2.5 border border-white/40 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-sm"
          >
            Browse all substances
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <SharePage url={`https://ghspictograms.com/ghs/${code}/`} title={`${upperCode} — ${meta.name} (GHS pictogram)`} />

    <!-- Что означает -->
    <div class="rounded-2xl p-6 border-2" style={`background:${meta.bgLight};border-color:${meta.borderColor}`}>
      <h2 class="text-xl font-bold mb-3" style={`color:${meta.textColor}`}>
        What does {upperCode} mean?
      </h2>
      <p class="text-gray-700 leading-relaxed">{meta.description}</p>
    </div>

    <!--
      Блок «прямой ответ» под экзаменационный интент (session 23).
      ⚠ Ответ обязан стоять первой строкой абзаца: по этим фразам мы уже показываемся
      на позициях 5–9 с нулём кликов, и выигрывает здесь сниппет, а не длина текста.
      Разбор — claude/pictograms-seo-baseline.md §3.6.
    -->
    {faqHere.length > 0 && (
      <div id="answers">
        <h2 class="text-xl font-bold text-gray-900 mb-3">Straight answers</h2>
        <div class="border border-gray-200 rounded-2xl overflow-hidden bg-white">
          {faqHere.map(([q, a], i) => (
            <div data-pict-faq={upperCode} class={`px-5 py-4 ${i > 0 ? 'border-t border-slate-100' : ''}`}>
              <h3 class="text-base font-semibold text-gray-900 mb-1.5">{q}</h3>
              <p class="text-[0.9375rem] leading-relaxed text-gray-700">{a}</p>
            </div>
          ))}
        </div>
        <p class="mt-3 text-sm text-gray-600">
          Every number here is computed from CLP Annex VI at build time. See
          <a href="/pictograms/" class="font-semibold text-teal-700 underline underline-offset-2 ml-1">all nine pictograms compared</a>.
        </p>
      </div>
    )}

    <!--
      Классы и категории опасности. Данные — hazard_category_mapping × hazard_class_catalog,
      той же выборкой, из которой берётся список H-кодов. Хардкода здесь нет и быть не должно.
    -->
    {mapping.length > 0 && (
      <div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">
          Which hazard classes require {upperCode}?
        </h2>
        <p class="text-gray-600 text-sm mb-4">
          {upperCode} is assigned by {hazardClassCount} hazard {hazardClassCount === 1 ? 'class' : 'classes'}
          across {mapping.length} {mapping.length === 1 ? 'category' : 'categories'} under CLP and UN GHS.
          The signal word is set by the category, not by the pictogram — which is why the same
          pictogram can carry both Danger and Warning. The full wording of every code is listed
          under <a href="#h-statements" class="text-[#062A78] font-semibold hover:underline">Associated H-statements</a> below.
        </p>
        <div class="overflow-x-auto border border-gray-200 rounded-2xl bg-white shadow-sm">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-700">
              <tr>
                <th class="text-left font-semibold px-4 py-3">Hazard class</th>
                <th class="text-left font-semibold px-4 py-3">Ch.</th>
                <th class="text-left font-semibold px-4 py-3">Category</th>
                <th class="text-left font-semibold px-4 py-3">Signal word</th>
                <th class="text-left font-semibold px-4 py-3">H-code</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {mapping.map((row) => (
                <tr class="align-top hover:bg-gray-50" data-hclass-row={row.h_statement_code}>
                  <td class="px-4 py-3 text-gray-900">{row.hazard_class_catalog?.name_en ?? '—'}</td>
                  <td class="px-4 py-3 text-gray-500 whitespace-nowrap">
                    {row.hazard_class_catalog?.ghs_chapter ?? '—'}
                  </td>
                  <td class="px-4 py-3 text-gray-700 whitespace-nowrap">{row.category_code ?? '—'}</td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    {row.signal_word === 'Danger' ? (
                      <span class="font-bold text-rose-700">Danger</span>
                    ) : row.signal_word === 'Warning' ? (
                      <span class="font-semibold text-amber-700">Warning</span>
                    ) : (
                      <span class="text-gray-400">—</span>
                    )}
                  </td>
                  {/*
                    ⚠ Текст фразы здесь НЕ печатаем. Он живёт один раз — в карточках
                    «Associated H-statements» ниже. Таблица отвечает на вопрос «почему
                    пиктограмма назначена» (класс, категория, сигнальное слово), карточки —
                    «какие коды она несёт». Дублировать формулировку в обоих блоках
                    незачем: на GHS02 это 29 повторов на одной странице.
                  */}
                  <td class="px-4 py-3 whitespace-nowrap">
                    <a
                      href={hHref(row.h_statement_code)}
                      class="font-mono font-semibold text-[#062A78] hover:underline"
                    >
                      {row.h_statement_code}
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- GHS calculator: per-pictogram interactive tool (self-hides when no config) -->
    <GhsCalculator client:load code={upperCode} />

    <!-- H-statements карточки -->
    {hStatements.length > 0 && (
      <div id="h-statements">
        <h2 class="text-xl font-bold text-gray-900 mb-4">
          Associated H-statements ({hStatements.length})
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {hStatements.map(h => (
            <a
              href={hHref(h.code)}
              data-hcode={h.code}
              class="bg-rose-50 border border-rose-200 rounded-xl px-4 py-3 flex gap-3 items-start transition hover:border-rose-400 hover:bg-rose-100"
            >
              <span class="font-mono font-bold text-rose-700 shrink-0 text-sm mt-0.5">{h.code}</span>
              <span class="text-rose-900 text-sm leading-snug">{h.text_en}</span>
            </a>
          ))}
        </div>
        <p class="mt-3 text-sm text-gray-600">
          Each code opens its own page: the verbatim CLP wording, its status under EU CLP, OSHA
          HazCom and UN GHS, and every harmonised substance that carries it. See also the
          <a href="/h-statements/" class="font-semibold text-teal-700 underline underline-offset-2">full list of hazard statements</a>
          and the <a href="/p-statements/" class="font-semibold text-teal-700 underline underline-offset-2">precautionary statements</a>.
        </p>
      </div>
    )}

    <!--
      Совместная встречаемость — считается из веществ этой страницы (session 23).
      Такого блока нет ни у одного конкурента: он показывает правила вытеснения
      живыми числами. Маркер data-pict-co проверяется в scripts/check-dist.ts.
    -->
    {coRows.length > 0 && (
      <div id="alongside">
        <h2 class="text-xl font-bold text-gray-900 mb-2">Which pictograms appear next to {upperCode}</h2>
        <p class="text-gray-600 text-sm mb-4">
          A label rarely carries one diamond. Counted across the {nf(CO_TOTAL)} harmonised
          substances that carry {upperCode} — before the Article 26 precedence rules remove anything.
        </p>
        <div class="flex flex-col gap-2">
          {coRows.map(r => (
            <a
              href={`/ghs/${r.code.toLowerCase()}/`}
              data-pict-co={`${r.code}|${r.n}`}
              class="flex flex-wrap items-center gap-x-3 gap-y-2 px-3.5 py-2.5 border border-gray-200 rounded-xl bg-white hover:border-slate-300 hover:bg-slate-50 transition-colors"
            >
              <img src={`/pictograms/${r.code.toLowerCase()}.svg`} width="30" height="30" loading="lazy" decoding="async" alt="" class="shrink-0 w-[30px] h-[30px]" />
              <span class="text-sm text-gray-900 sm:basis-52 sm:shrink-0 grow sm:grow-0 min-w-0">
                <span class="font-mono text-xs font-semibold text-blue-900 bg-blue-50 border border-blue-100 rounded px-1.5 py-0.5 mr-2">{r.code}</span>
                {r.name}
              </span>
              <span class="order-last sm:order-none basis-full sm:basis-auto grow h-2 rounded-full bg-slate-100 overflow-hidden min-w-[60px]">
                <span class="block h-full rounded-full bg-teal-600" style={`width:${r.pct}%`}></span>
              </span>
              <span class="shrink-0 font-mono text-xs text-slate-600 sm:w-32 sm:text-right">
                <b class="text-gray-900">{nf(r.n)}</b> · {r.pct}%
              </span>
            </a>
          ))}
        </div>
        <p class="mt-3 text-sm text-gray-600">{CO_NOTE[upperCode]}</p>
      </div>
    )}

    <!--
      Приоритет — только те правила Article 26, которые касаются ЭТОЙ пиктограммы.
      Чужое правило на странице — это чужой текст. Числа считаются, не пишутся.
    -->
    {rulesHere.length > 0 && (
      <div id="precedence">
        <h2 class="text-xl font-bold text-gray-900 mb-2">
          {upperCode === 'GHS07' ? `When ${upperCode} is removed from a label` : `When ${upperCode} changes what else is shown`}
        </h2>
        <p class="text-gray-600 text-sm mb-4">
          Article 26 of CLP cuts the number of diamonds on a label. {rulesHere.length === 1 ? 'One of its five rules' : `${rulesHere.length} of its five rules`} {rulesHere.length === 1 ? 'touches' : 'touch'} {upperCode}.
        </p>
        <div class="flex flex-col gap-3">
          {rulesHere.map(r => (
            <div data-pict-rule={r.ref} class="border border-gray-200 border-l-[3px] border-l-[#062A78] rounded-xl bg-white px-4 py-3.5">
              <span class="block font-mono text-[0.625rem] font-semibold uppercase tracking-[0.09em] text-slate-500 mb-1.5">{r.ref}</span>
              <p class="text-[0.9375rem] leading-snug text-gray-900" set:html={r.text} />
              <p class="mt-2 pt-2 border-t border-dashed border-slate-300 text-sm leading-snug text-slate-600" set:html={r.ours} />
            </div>
          ))}
        </div>
        <p class="mt-3 text-sm text-gray-600">
          {upperCode === 'GHS09'
            ? 'No rule in Article 26 touches this pictogram at all.'
            : 'Nothing in Article 26 makes ' + upperCode + ' optional in the other direction unless a rule above says so.'}
          <a href="/pictograms/" class="font-semibold text-teal-700 underline underline-offset-2 ml-1">All five precedence rules, with the number of substances each one affects</a>.
        </p>
      </div>
    )}

    <!-- Storage note -->
    <div class="bg-amber-50 border-l-4 border-amber-400 rounded-r-2xl p-6">
      <h2 class="text-xl font-bold text-amber-900 mb-2">Storage & handling requirements</h2>
      <p class="text-amber-800 leading-relaxed">{meta.storageNote}</p>
    </div>

    <!-- Regulatory note -->
    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-slate-900 mb-2">Regulatory context (CLP / OSHA / REACH)</h2>
      <p class="text-slate-700 leading-relaxed">{meta.regulatoryNote}</p>
    </div>

    <!-- ADR/DOT note -->
    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-blue-900 mb-2">Transport marking: GHS vs ADR/DOT</h2>
      <p class="text-blue-800 leading-relaxed">{meta.adnNote}</p>
    </div>

    <!--
      Размеры — CLP Annex I 1.2.1.1–1.2.1.4 и Table 1.3. Полная таблица на четыре размера
      упаковки живёт на хабе; здесь только два правила, которые её перебивают, — иначе
      одна и та же таблица размножится на девять страниц.
    -->
    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-slate-900 mb-2">Printing {upperCode} on a label</h2>
      <p class="text-slate-700 leading-relaxed">
        A square set at a point — a diamond — with the black symbol on a white background and a red
        frame wide enough to be clearly visible. An all-black frame is a transport label, not a CLP
        pictogram. Size is set twice over: each pictogram must cover at least <b>one fifteenth</b> of
        the minimum label area required by Article 17, and must never be smaller than <b>1 cm²</b>.
        On a package of 3 litres or less that works out to <b>10 × 10 mm</b> as the floor, and
        16 × 16 mm where it fits.
      </p>
      <p class="mt-3 text-sm text-slate-700">
        Source: Regulation (EC) No 1272/2008, Annex I, 1.2.1.1–1.2.1.4 and Table 1.3 —
        <a href="/pictograms/" class="font-semibold text-teal-700 underline underline-offset-2">the full table for all four package sizes</a>.
        Building an actual label? The
        <a href="/ghs-label-maker/" class="font-semibold text-teal-700 underline underline-offset-2">label constructor</a>
        lays it out at the right proportions.
      </p>
    </div>

    <!-- Download SVG -->
    {picData?.svg_content && (
      <div class="border-2 border-dashed border-[#062A78]/30 rounded-2xl p-6 flex flex-col sm:flex-row items-center gap-6">
        <div class="w-24 h-24 shrink-0 [&>svg]:w-full [&>svg]:h-full" set:html={picData.svg_content}/>
        <div class="flex-1">
          <p class="font-bold text-gray-900 text-lg">{upperCode} — {meta.name}</p>
          <p class="text-gray-600 text-sm mt-1">High-resolution SVG vector file. Free for use in safety documents, SDS, and label design.</p>
          {picData?.svg_url ? (
            <div class="mt-3">
              <SvgDownloadButton
                client:load
                svgUrl={picData.svg_url}
                fileName={`${upperCode}.svg`}
                ghsCode={upperCode}
                ghsName={meta.name}
              />
            </div>
          ) : (
            <p class="mt-3 text-sm text-amber-700">
              SVG download is temporarily unavailable for this pictogram.
            </p>
          )}
        </div>
      </div>
    )}

    <!-- Substances list -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-2">
        Substances classified with {upperCode}
      </h2>
      <p class="text-gray-500 text-sm mb-6">
        Showing {substances.length} of {totalCount ?? substances.length} substances in our database with this pictogram.
        <a href={`/substances/?pic=${upperCode}`} class="text-[#062A78] underline ml-1">View all →</a>
      </p>

      <ul class="divide-y divide-gray-200 border border-gray-200 rounded-2xl overflow-hidden bg-white shadow-sm">
        {substances.map(s => {
          const name = substanceName(s)
          const pics = s.ghs_pictogram_codes ?? []
          const casEnc = encodeURIComponent(s.cas_number)
          const slug = sdsSlug.get(s.cas_number)
          // ⚠ Ссылка только туда, где страница действительно есть. Отбор по форме CAS
          // обязан совпадать с getStaticPaths в src/pages/substances/[slug].astro:
          // у 156 записей CAS многосоставный («110-45-2[1]35073-27-»), страницы нет.
          // Без этой проверки check:seo ловил 115 битых адресов.
          const detailHref = slug
            ? `/sds/${slug}/`
            : casShapeOk(s.cas_number)
              ? substanceHref(substanceNameFull(s), s.cas_number)
              : null
          const inner = (
            <>
              <div class="min-w-0">
                <span class="font-semibold text-[#062A78] block truncate" title={substanceNameFull(s)}>{name}</span>
                {/* ⚠⚠ ЧЕРЕЗ ПРОВЕРКУ ФОРМЫ. Здесь печаталась склейка форм Annex VI
                    («110-45-2[1]35073-27-») у 156 записей: отбор по форме стоял
                    только на ссылке, а подпись бралась из колонки как есть. */}
                {casForDisplay(s.cas_number) && (
                  <span class="text-xs text-gray-500">CAS {casForDisplay(s.cas_number)}</span>
                )}
              </div>
              <div class="flex items-center gap-2 shrink-0">
                {s.signal_word && (
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${s.signal_word === 'Danger' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-700'}`}>
                    {s.signal_word}
                  </span>
                )}
                <span class="text-xs text-gray-400 hidden sm:block">{pics.slice(0,4).join(' ')}</span>
                <span class="text-[#062A78] text-xs font-medium">
                  {slug ? 'SDS →' : detailHref ? 'Details →' : 'No single CAS'}
                </span>
              </div>
            </>
          )
          // ⚠⚠ У <li> НЕТ key, И ЭТО НАМЕРЕННО. Это .astro, а не React: `key`
          // здесь не служебный атрибут, а обычный HTML — он печатался в разметку
          // как key="110-45-2[1]35073-27-" и протаскивал склейку Annex VI на
          // девять страниц пиктограмм мимо всех проверок формы. Нашла его
          // проверка identifiers-in-dist; глазами он невидим — атрибут.
          return (
            <li class="flex items-stretch gap-0">
              {detailHref ? (
                <a
                  href={detailHref}
                  class="flex flex-1 min-w-0 items-center justify-between px-5 py-3.5 hover:bg-slate-50 transition-colors gap-4"
                >
                  {inner}
                </a>
              ) : (
                <span
                  class="flex flex-1 min-w-0 items-center justify-between px-5 py-3.5 gap-4"
                  title="Multi-component Annex VI entry — no single CAS, so no substance page"
                >
                  {inner}
                </span>
              )}
              <a
                href={`/ghs-label-maker/?cas=${casEnc}`}
                class="shrink-0 px-4 py-3.5 border-l border-gray-200 text-xs font-semibold text-[#062A78] hover:bg-blue-50 transition-colors flex items-center"
              >
                Label
              </a>
            </li>
          )
        })}
      </ul>
    </div>

    <!-- Cross-link to ghssymbols -->
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 flex items-start gap-4">
      <div class="flex-1">
        <p class="font-semibold text-gray-900">Need full toxicological data?</p>
        <p class="text-gray-600 text-sm mt-1">GHS Symbols provides detailed hazard classification, H/P statements, ATE values and storage compatibility for all substances.</p>
      </div>
      <a
        href={`https://ghssymbols.com/`}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-4 py-2 bg-[#062A78] text-white text-sm font-semibold rounded-lg hover:bg-[#051f5c] transition-colors"
      >
        GHS Symbols →
      </a>
    </div>

  </div>

  <!-- CTA -->
  <section class="bg-[#062A78] text-white py-14 px-4 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold">Ready to build a GHS-compliant label?</h2>
    <p class="mt-3 text-blue-100 text-lg">Auto-filled with {upperCode} — {meta.name} hazard data</p>
    <a
      href="/ghs-label-maker/"
      class="inline-block mt-8 px-8 py-3 rounded-lg bg-white text-[#062A78] font-bold hover:bg-blue-50 transition-colors"
    >
      Open Label Maker →
    </a>
    <a href="/tools/" class="mt-4 inline-block text-blue-200 text-sm hover:text-white transition-colors">See all free GHS tools →</a>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ghsJsonLd)} />

</Layout>
