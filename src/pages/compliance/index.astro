---
/**
 * Хаб раздела /compliance/.
 *
 * ⚠⚠ SESSION 60: ПЕРЕСТРОЕН СО СТАРОГО СТИЛЯ НА ДИЗАЙН-СИСТЕМУ v2 вместе со
 * всем разделом. Разбор — в шапке `pages/compliance/[pillar]/index.astro`.
 *
 * ⚠⚠⚠ СЛОВАРЬ СТОЛПОВ ОТСЮДА УЕХАЛ в `src/lib/complianceHub.ts`. Он стоял
 * здесь и в странице столпа ДВУМЯ КОПИЯМИ — с прямым признанием этого в
 * комментарии соседнего файла. Правка описания в одной копии молча оставляла
 * вторую как была.
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { PILLARS, PILLAR_BY_SLUG, pillarAccentStyle } from '../../lib/complianceHub';
// ⚠⚠ Акцент ссылок «на остальной сайт» приходит ИЗ КАРТЫ РАЗДЕЛОВ, а не
// подбирается на глаз: /substances/ обязан быть бирюзовым и здесь, и везде.
import { withAccent, accentBadge } from '../../lib/sectionAccent';

export const prerender = true;

const allArticles = await getCollection('compliance', ({ data }) => !data.draft && data.type !== 'pillar');
const sortedArticles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

/**
 * Якорная статья — просто самая свежая.
 *
 * ⚠⚠ ПОЛЯ `featured` В СХЕМЕ КОЛЛЕКЦИИ НЕТ (`src/content.config.ts`), и это
 * не упущение перестройки: его не было и раньше. Прежний код спрашивал
 * `a.data.featured`, всегда получал `undefined` и молча падал на запасной
 * ветке — то есть «избранная статья» уже была самой свежей, просто окольным
 * путём. Правило названо прямо, чтобы никто не искал редакторский флажок,
 * которого не существует.
 *
 * ⭐ Понадобится настоящий выбор редактора — заводить полем в схеме, а не
 * догадкой в разметке.
 */
const featuredArticle = sortedArticles[0];
const recentArticles = sortedArticles
  .filter((a) => a.id !== featuredArticle?.id)
  .slice(0, 6);

// Сколько всего материалов в каждом столпе — вместе с обзорной статьёй столпа.
const allContent = await getCollection('compliance', ({ data }) => !data.draft);
const pillarCounts: Record<string, number> = {};
for (const item of allContent) {
  pillarCounts[item.data.pillar] = (pillarCounts[item.data.pillar] ?? 0) + 1;
}

/**
 * ⚠ EHS ПОДАЁТСЯ ОТДЕЛЬНО, А НЕ СЕДЬМОЙ ПЛИТКОЙ В СЕТКЕ, и так было и до
 * перестройки. Шесть столпов — это регламенты; EHS — то, что делают с ними на
 * площадке. Смешать их в один ряд значит сказать, что EHS — такой же регламент,
 * какого не существует.
 */
const regulatoryPillars = PILLARS.filter((p) => p.slug !== 'ehs');
const ehs = PILLAR_BY_SLUG.get('ehs')!;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const SITE = 'https://ghspictograms.com';
const canonical = `${SITE}/compliance/`;
const pageTitle = 'Compliance Hub';
const pageDescription =
  'Chemical safety regulations explained: UN GHS, OSHA HCS, EU CLP, REACH, SVHC and SDS authoring, with citations, timelines and regional comparisons.';

/** Куда уходят те, кому нужен не разбор нормы, а быстрый ответ. */
const QUICK_LINKS = [
  { href: '/substances/', title: 'Substance database', desc: 'Harmonised CLP classification for 3 650 substances, by name or CAS.' },
  { href: '/un/', title: 'UN number reference', desc: 'ADR and 49 CFR entries side by side, with placards and special provisions.' },
  { href: '/pictogram-selector/', title: 'Pictogram selector', desc: 'Pick hazard classes, get the pictograms four jurisdictions require.' },
  { href: '/ghs-label-maker/', title: 'Label maker', desc: 'Build a print-ready GHS label against CLP, OSHA, WHMIS or GB CLP rules.' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Compliance Hub', item: canonical },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  {/* ── ГЕРОЙ ───────────────────────────────────────────────────────────────
      Тон героя — сиреневый: по карте разделов весь /compliance/ это `reg`,
      и хаб раздела — единственное место, где цвет раздела уместен целиком.
      У страниц столпов тон свой, потому что там различаются столпы. */}
  <section class="hub-hero" style="--hub-tint:#2e1065">
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <span aria-current="page">Compliance</span>
      </nav>
      <p class="hub-hero-eyebrow">Regulations, explained</p>
      <h1>Compliance Hub</h1>
      <p class="hub-hero-sub">
        Chemical safety regulations, explained. Deep-dive articles on UN GHS, OSHA HCS, EU CLP,
        REACH and SDS authoring — with citations, timelines and regional comparisons.
      </p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{allArticles.length} articles</span>
        <span class="hub-hero-chip">{regulatoryPillars.length} regulatory pillars</span>
        <span class="hub-hero-chip">Updated continuously</span>
      </div>
    </div>
  </section>

  {/* ── СТОЛПЫ ────────────────────────────────────────────────────────────── */}
  <section class="hub-sec-white">
    <div class="hub-wrap">
      <p class="hub-eyebrow">Frameworks</p>
      <h2 class="hub-h2">Regulatory pillars</h2>
      <p class="hub-sub">
        Each pillar covers one framework end to end. Open a pillar for its full article library.
      </p>
      <div class="hub-cards">
        {regulatoryPillars.map((p) => {
          const n = pillarCounts[p.slug] ?? 0;
          return (
            <a class="hub-card" href={`/compliance/${p.slug}/`} style={pillarAccentStyle(p)}>
              <span class="tag">{p.label}</span>
              <h3>{p.fullName}</h3>
              <p class="copy">{p.short}</p>
              <span class="cta">{n} {n === 1 ? 'article' : 'articles'} →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ── EHS: ПРИКЛАДНОЙ СЛОЙ ──────────────────────────────────────────────── */}
  <section class="hub-sec-a">
    <div class="hub-wrap">
      <p class="hub-eyebrow">Applied</p>
      <h2 class="hub-h2">On top of the regulations</h2>
      <p class="hub-sub">
        What people actually do with them on site — grounded in your safety data sheets, hazard
        classification and chemical inventory.
      </p>
      <div class="hub-cards">
        <a class="hub-card" href="/compliance/ehs/" style={pillarAccentStyle(ehs)}>
          <span class="tag">{ehs.label}</span>
          <h3>{ehs.fullName}</h3>
          <p class="copy">{ehs.description}</p>
          <span class="cta">Incident reporting · risk assessment · audit →</span>
        </a>
      </div>
    </div>
  </section>

  {/* ── С ЧЕГО НАЧАТЬ ─────────────────────────────────────────────────────── */}
  {featuredArticle && (
    <section class="hub-sec-white">
      <div class="hub-wrap">
        <p class="hub-eyebrow">Start here</p>
        <h2 class="hub-h2">{featuredArticle.data.title}</h2>
        <p class="hub-sub">{featuredArticle.data.description}</p>
        <p style="margin-top:22px">
          <a
            class="tool-cta"
            href={`/compliance/${featuredArticle.data.pillar}/${featuredArticle.data.slug}/`}
          >
            Read the anchor article →
          </a>
        </p>
        <p class="hub-fine">
          {PILLAR_BY_SLUG.get(featuredArticle.data.pillar)?.label ?? featuredArticle.data.pillar}
          {' · '}
          <time datetime={featuredArticle.data.pubDate.toISOString()}>
            {formatDate(featuredArticle.data.pubDate)}
          </time>
        </p>
      </div>
    </section>
  )}

  {/* ── СВЕЖЕЕ ────────────────────────────────────────────────────────────── */}
  {recentArticles.length > 0 && (
    <section class="hub-sec-b">
      <div class="hub-wrap">
        <p class="hub-eyebrow">Latest</p>
        <h2 class="hub-h2">Recently published</h2>
        <div class="hub-mini-cards">
          {recentArticles.map((article) => {
            const p = PILLAR_BY_SLUG.get(article.data.pillar);
            return (
              <a
                class="hub-mini-card"
                href={`/compliance/${article.data.pillar}/${article.data.slug}/`}
                style={p ? pillarAccentStyle(p) : undefined}
              >
                <span class="code">{p?.label ?? article.data.pillar}</span>
                <h4>{article.data.title}</h4>
                <p class="copy">{article.data.description}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* ── БЫСТРЫЙ ОТВЕТ ВМЕСТО РАЗБОРА ──────────────────────────────────────── */}
  <section class="hub-sec-deep">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">Need a quick answer instead?</p>
      <h2 class="hub-h2">Look it up rather than read about it</h2>
      <p class="hub-sub">
        These are lookups, not articles: they answer one question about one substance and get out
        of the way.
      </p>
      <div class="hub-mini-cards">
        {QUICK_LINKS.map((l) => (
          <a class={withAccent('hub-mini-card', l.href)} href={l.href}>
            {accentBadge(l.href) && <span class="sect">{accentBadge(l.href)}</span>}
            <h4>{l.title}</h4>
            <p class="copy">{l.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
