---
/**
 * Страница столпа раздела /compliance/ — например `/compliance/clp/`.
 *
 * ⚠⚠ SESSION 60: ПЕРЕСТРОЕНА СО СТАРОГО СТИЛЯ НА ДИЗАЙН-СИСТЕМУ v2.
 * До этого весь раздел был единственным местом сайта, где не было НИ ОДНОГО
 * класса из `hub.css`: герой собирался градиентом `bg-gradient-to-br
 * from-slate-900 via-rose-900`, карточки — утилитами, а проза статьи несла
 * полтораста строк `<style is:global>` с литеральными цветами. Разбор — в
 * `claude/design-system.md`, §8: два языка оформления на одном сайте и есть
 * та каша, из-за которой раздел выглядел «просто белыми карточками».
 *
 * ⚠⚠⚠ ОПИСАНИЯ СТОЛПОВ БОЛЬШЕ НЕ ЖИВУТ ЗДЕСЬ. Словарь `pillarMeta` стоял
 * ДВАЖДЫ — тут и в `pages/compliance/index.astro`, — и прямо над ним было
 * написано «Duplicated from compliance/index.astro». Теперь он один, в
 * `src/lib/complianceHub.ts`.
 */
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import SharePage from '../../../components/SharePage.astro';
import { PILLARS, PILLAR_BY_SLUG, pillarAccentStyle, pillarHeroStyle } from '../../../lib/complianceHub';

export const prerender = true;

export async function getStaticPaths() {
  // ⚠ Пути берутся ИЗ ТОГО ЖЕ списка, что рисует карточки на хабе. Пока их было
  // два, «столп есть на хабе, но страницы нет» ловилось только глазами.
  return PILLARS.map((p) => ({ params: { pillar: p.slug } }));
}

const { pillar } = Astro.params;
const pillarSlug = pillar as string;
const meta = PILLAR_BY_SLUG.get(pillarSlug)!;

const allArticles = await getCollection(
  'compliance',
  ({ data }) => data.pillar === pillarSlug && !data.draft && data.type !== 'pillar',
);
const articles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pillarArticle = (
  await getCollection('compliance', ({ data }) => data.pillar === pillarSlug && data.type === 'pillar' && !data.draft)
)[0];

const PillarContent = pillarArticle ? (await render(pillarArticle)).Content : null;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

/**
 * Вид статьи словом.
 *
 * ⚠⚠ ЦВЕТА У ЭТИХ МЕТОК БОЛЬШЕ НЕТ, И ЭТО НАМЕРЕННО. В старом стиле каждый вид
 * нёс свою заливку (`bg-amber-100`, `bg-rose-100`, `bg-emerald-100` …) — семь
 * оттенков, не значащих ничего: цвет на сайте раздаётся по НАЗНАЧЕНИЮ ссылки,
 * а все семь ведут в одну и ту же статью одного и того же столпа. Метка
 * набрана моноширинным в верхнем регистре, как все служебные метки сайта,
 * и говорит ровно то, что говорила, — словом.
 */
function articleTypeLabel(type: string): string {
  const map: Record<string, string> = {
    listicle: 'Reference',
    'event-driven': 'Update',
    evergreen: 'Evergreen',
    'deep-dive': 'Deep dive',
    comparison: 'Comparison',
    'how-to': 'How-to',
    cluster: 'Article',
  };
  return map[type] ?? type;
}

const otherPillars = PILLARS.filter((p) => p.slug !== pillarSlug);

const pageTitle = pillarArticle?.data.title ?? `${meta.label} — Compliance Hub`;
const pageDescription = pillarArticle?.data.description ?? meta.short;

const SITE = 'https://ghspictograms.com';
const pillarPageUrl = `${SITE}/compliance/${pillarSlug}/`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Compliance Hub', item: `${SITE}/compliance/` },
    { '@type': 'ListItem', position: 2, name: meta.label, item: pillarPageUrl },
  ],
};

const articleSchema = pillarArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: pillarArticle.data.title,
      description: pillarArticle.data.description,
      datePublished: pillarArticle.data.pubDate.toISOString(),
      dateModified: (pillarArticle.data.updatedDate ?? pillarArticle.data.pubDate).toISOString(),
      author: { '@type': 'Organization', name: 'GHS Pictograms', url: SITE },
      publisher: {
        '@type': 'Organization',
        name: 'GHS Pictograms',
        url: SITE,
        logo: { '@type': 'ImageObject', url: `${SITE}/favicon.svg` },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': pillarPageUrl },
    }
  : null;

const totalArticles = articles.length + (pillarArticle ? 1 : 0);
---

<Layout title={pageTitle} description={pageDescription} canonical={pillarPageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  </Fragment>

  {/* ── ГЕРОЙ ───────────────────────────────────────────────────────────────
      ⚠ В герое меняется ТОЛЬКО `--hub-tint`: остальное (градиент, три слоя,
      углы) описано в `hub.css`. Прежний код собирал герой заново на каждой
      странице столпа — отсюда и брались семь разных «почти одинаковых, но
      чуть-чуть других» шапок. */}
  <section class="hub-hero" style={pillarHeroStyle(meta)}>
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/compliance/">Compliance</a><span class="sep">/</span>
        <span aria-current="page">{meta.label}</span>
      </nav>
      <p class="hub-hero-eyebrow">
        {pillarSlug === 'ehs' ? 'Applied pillar' : 'Regulatory pillar'} · {meta.fullName}
      </p>
      <h1>{pillarArticle?.data.title ?? meta.label}</h1>
      <p class="hub-hero-sub">{pillarArticle?.data.description ?? meta.description}</p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{totalArticles} {totalArticles === 1 ? 'article' : 'articles'}</span>
        {pillarArticle?.data.updatedDate && (
          <span class="hub-hero-chip">Updated {formatDate(pillarArticle.data.updatedDate)}</span>
        )}
      </div>
    </div>
  </section>

  {/* ── СТАТЬИ СТОЛПА ─────────────────────────────────────────────────────── */}
  <section class="hub-sec-white">
    <div class="hub-wrap">
      <div class="hub-share"><SharePage url={pillarPageUrl} title={pageTitle} /></div>

      {totalArticles > 0 ? (
        <>
          <p class="hub-eyebrow">In this pillar</p>
          <h2 class="hub-h2">All articles</h2>
          <p class="hub-sub">Sorted by publication date — most recent first.</p>

          <div class="hub-cards">
            {pillarArticle && (
              <a class="hub-card" href="#pillar-content" style={pillarAccentStyle(meta)}>
                <span class="tag">Pillar overview</span>
                <h3>About {meta.label}</h3>
                <p class="copy">
                  {meta.fullName} in full — scope, core requirements, regulatory history, GHS
                  alignment, deadlines, labels, SDS structure and enforcement.
                </p>
                <span class="cta">Read on this page ↓</span>
              </a>
            )}
            {articles.map((article) => (
              <a
                class="hub-card"
                href={`/compliance/${article.data.pillar}/${article.data.slug}/`}
                style={pillarAccentStyle(meta)}
              >
                <span class="tag">{articleTypeLabel(article.data.type)}</span>
                <h3>{article.data.title}</h3>
                <p class="copy">{article.data.description}</p>
                <span class="cta">Read article →</span>
              </a>
            ))}
          </div>
        </>
      ) : (
        /* ⚠ Пустое состояние — та же пунктирная карточка, что у инструментов.
           Тупика здесь быть не должно: человек пришёл за столпом, а статей
           ещё нет, и единственное честное действие — увести его к соседям. */
        <div class="tool-blank">
          <p class="t">Articles coming soon</p>
          <p class="s">
            Deep-dive content for the {meta.label} pillar is being written. The other pillars
            below are already there.
          </p>
        </div>
      )}
    </div>
  </section>

  {/* ── СВОИ СТРАНИЦЫ СТОЛПА ──────────────────────────────────────────────
      ⚠ Отдельной секцией, а не строкой в списке статей: это не статья из
      коллекции, а разбор, собранный из данных, и обещать читателю «ещё одну
      статью» было бы неточно. */}
  {meta.extraPages && meta.extraPages.length > 0 && (
    <section class="hub-sec-b">
      <div class="hub-wrap">
        <p class="hub-eyebrow">Also in this pillar</p>
        <h2 class="hub-h2">Reference and analysis</h2>
        <div class="hub-mini-cards">
          {meta.extraPages.map((x) => (
            <a class="hub-mini-card" href={x.href} style={pillarAccentStyle(meta)}>
              <span class="code">{meta.label}</span>
              <h4>{x.title}</h4>
              <p class="copy">{x.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ── ПРОЗА САМОГО СТОЛПА ───────────────────────────────────────────────── */}
  {PillarContent && (
    <section class="hub-sec-a" id="pillar-content">
      <div class="hub-wrap">
        <div class="md-prose hub-prose" style={pillarAccentStyle(meta)}>
          <PillarContent />
        </div>
      </div>
    </section>
  )}

  {/* ── ОСТАЛЬНЫЕ СТОЛПЫ ──────────────────────────────────────────────────── */}
  <section class="hub-sec-deep">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">Elsewhere in this section</p>
      <h2 class="hub-h2">Explore the other pillars</h2>
      <div class="hub-mini-cards">
        {otherPillars.map((p) => (
          <a class="hub-mini-card" href={`/compliance/${p.slug}/`} style={pillarAccentStyle(p)}>
            <span class="code">{p.label}</span>
            <h4>{p.fullName}</h4>
            <p class="copy">{p.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
