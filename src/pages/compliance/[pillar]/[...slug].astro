---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SharePage from '../../../components/SharePage.astro';
import { PILLAR_BY_SLUG, pillarAccentStyle } from '../../../lib/complianceHub';

export const prerender = true;

export async function getStaticPaths() {
  const articles = await getCollection('compliance', ({ data }) => !data.draft && data.type !== 'pillar');
  return articles.map((article) => {
    return {
      params: { 
        pillar: article.data.pillar, 
        slug: article.id 
      },
      props: { article },
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);

/**
 * ⚠⚠ ТРЕТЬЯ КОПИЯ СЛОВАРЯ СТОЛПОВ УБРАНА. Здесь стоял свой список меток — уже
 * разошедшийся с двумя остальными: он знал `global-ghs`,
 * `mixture-classification` и `transport`, которых нет ни в контенте, ни на
 * хабе. Метка и цвет столпа теперь приходят из одного места.
 *
 * ⚠ Запасной вариант остаётся: заведут статью со столпом, которого ещё нет в
 * `PILLARS`, — страница покажет слаг заглавными, а не упадёт.
 */
const pillar = PILLAR_BY_SLUG.get(article.data.pillar);
const pillarLabel = pillar?.label ?? article.data.pillar.toUpperCase();

// BreadcrumbList JSON-LD schema для Google rich results
const SITE = 'https://ghspictograms.com';
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Compliance Hub',
      item: `${SITE}/compliance/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: pillarLabel,
      item: `${SITE}/compliance/${article.data.pillar}/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.data.title,
      item: `${SITE}/compliance/${article.data.pillar}/${article.data.slug}/`,
    },
  ],
};
const articlePageId = `${SITE}/compliance/${article.data.pillar}/${article.data.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: 'GHS Pictograms',
    url: 'https://ghspictograms.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'GHS Pictograms',
    url: 'https://ghspictograms.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://ghspictograms.com/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articlePageId,
  },
};

const articleSchemaJson = JSON.stringify(articleSchema);

// FAQ — single source: frontmatter `faq` feeds both the visible block and FAQPage JSON-LD
const faqItems = article.data.faq ?? [];
const mdLinkToText = (s: string) => s.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const mdLinkToHtml = (s: string) => s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
const faqJsonLd = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: mdLinkToText(item.a) },
  })),
} : null;
---

<Layout title={article.data.title} description={article.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={articleSchemaJson} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>

  {/* ── ГЕРОЙ ───────────────────────────────────────────────────────────────
      Session 60: раздел переведён со старого стиля на дизайн-систему v2.
      Прежде здесь была светло-серая полоса крошек и заголовок утилитами
      Tailwind — язык оформления, которого на остальном сайте больше нет.
      Крошки живут ВНУТРИ героя (`.hub-crumb`), как на всех страницах v2: они
      светлые на тёмном и не занимают отдельной ленты. */}
  <section class="hub-hero" style={pillar ? `--hub-tint:${pillar.tint}` : undefined}>
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>
    <div class="hub-wrap hub-hero-inner hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/compliance/">Compliance</a><span class="sep">/</span>
        <a href={`/compliance/${article.data.pillar}/`}>{pillarLabel}</a><span class="sep">/</span>
        <span aria-current="page">{article.data.title}</span>
      </nav>
      <p class="hub-hero-eyebrow">{pillarLabel}</p>
      <h1>{article.data.title}</h1>
      <p class="hub-hero-sub">{article.data.description}</p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">
          <time datetime={article.data.pubDate.toISOString()}>
            {article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </span>
        {article.data.updatedDate && (
          <span class="hub-hero-chip">
            Updated{' '}
            <time datetime={article.data.updatedDate.toISOString()}>
              {article.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </span>
        )}
        {article.data.author && <span class="hub-hero-chip">{article.data.author}</span>}
      </div>
    </div>
  </section>

  {/* ── ПРОЗА ───────────────────────────────────────────────────────────────
      `md-prose` одевает теги, которые порождает MDX; цвет приходит из акцента
      раздела, а не из самого файла прозы. До session 60 стили статьи стояли
      блоком `<style is:global>` прямо здесь — 150 строк с литеральными
      цветами, которые повторяли то, что уже описано в `md-prose.css`, только
      синим. */}
  <section class="hub-sec-white">
    <div class="hub-wrap">
      <div class="hub-share"><SharePage url={articlePageId} title={article.data.title} /></div>
      <div class="md-prose hub-prose" style={pillar ? pillarAccentStyle(pillar) : undefined}>
        <Content />
      </div>
    </div>
  </section>

  {faqItems.length > 0 && (
    <section class="hub-sec-a" id="faq" aria-labelledby="faq-heading">
      <div class="hub-wrap">
        <p class="hub-eyebrow">Questions</p>
        <h2 class="hub-h2" id="faq-heading">Frequently asked</h2>
        <div class="hub-faq">
          {faqItems.map((item) => (
            <div class="hub-faq-item">
              <p class="q">{item.q}</p>
              <p class="a" set:html={mdLinkToHtml(item.a)} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
