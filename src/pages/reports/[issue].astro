---
// /reports/ai-gap-preview/ — GHS Compliance Market Report, preview issue "The AI Gap" (s114, 2026-10-19).
//
// Agreed with Sergej 2026-10-19: five numbers, one chart by region, a short method box, a sign-up for the full issue;
// light humour in the headline, strict numbers inside; jokes about the market, never about named vendors — this page
// names NO vendor. Only confirmed facts (section G, dimension confirmed_only). Published after the facts are confirmed:
// until REPORT_PREVIEW_PUBLIC is true the page carries noindex and is not in the sitemap.
//
// s115 (2026-10-24): set in Placard, the report's own visual language (src/styles/placard.css; the full system is the
// design-system artifact "Placard Design System", project doc claude/report-design-placard-2026-10-24.md): a header
// strip like a safety data sheet, the key figures on orange ADR plates, a signal word, the AI Gap drawn as two bars
// joined by a step, every vendor as one diamond, a label-framed table with row codes, buyer statements coded like
// P-statements, and a Receipt (base, snapshot, confirmed only) under every figure.
//
// ⚠ Every number comes from report_metrics of ONE frozen snapshot (src/lib/reportData.ts); nothing is typed by hand.
//   No snapshot with section G yet → getStaticPaths returns [] and the page is simply not built.
import Layout from '../../layouts/Layout.astro'
import NewsletterOptIn from '../../components/NewsletterOptIn'
import '../../styles/placard.css'
import {
  REPORT_FULL_ISSUE, REPORT_PREVIEW_PATH, REPORT_PREVIEW_PUBLIC, REPORT_PREVIEW_SLUG, loadAiGapView, longDate,
} from '../../lib/reportData'
import type { Share } from '../../lib/reportData'

export const prerender = true

export async function getStaticPaths() {
  const view = await loadAiGapView()
  return view ? [{ params: { issue: REPORT_PREVIEW_SLUG }, props: { view } }] : []
}

const { view } = Astro.props as { view: NonNullable<Awaited<ReturnType<typeof loadAiGapView>>> }
const v = view
const snapDate = longDate(v.snapshot.snapshot_date)
const snapShort = new Date(v.snapshot.snapshot_date + 'T00:00:00Z').toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
})
const title = 'The AI Gap: GHS Compliance Market Report preview'
const description =
  `${v.cover.talk} SDS and GHS compliance vendors talk about AI; ${v.cover.product.toLowerCase()} show it in the product. ` +
  `Five numbers from ${v.vendors} vendors, every fact a quote with a link.`
const canonical = `https://ghspictograms.com${REPORT_PREVIEW_PATH}`

// Placard number rules: one decimal in tables and text, "1 in N" on a plate only when exact within 2% (oneIn did that),
// percentage points as "pp".
const pct1 = (x: number) => `${x.toFixed(1)}%`
const pp = (x: number) => `${x.toFixed(1)} pp`
const plateTop = (cover: string, s: Share) => (/^1 in \d+$/.test(cover) ? cover : pct1(s.pct))

// GapBar geometry: one scale per figure, from 0 to the next 10% above the largest bar; ticks every 10%.
function scale(...values: number[]) {
  const max = Math.max(10, Math.ceil(Math.max(...values) / 10) * 10)
  return {
    max,
    w: (p: number) => `${Math.max(0.4, (100 * p) / max)}%`,
    left: (p: number) => `${(100 * p) / max}%`,
    tick: `${(100 * 10) / max}%`,
    ticks: Array.from({ length: max / 10 + 1 }, (_, i) => i * 10),
  }
}
const all = scale(v.talk.pct, v.product.pct)
const reg = scale(...v.regions.flatMap((r) => [r.talk.pct, r.product.pct]))
const widest = [...v.regions].sort((a, b) => b.gapPp - a.gapPp)[0]
const regionTitle =
  v.regions.length >= 2 && widest && v.regions.some((r) => r.gapPp < widest.gapPp)
    ? `The gap is widest in ${widest.label}`
    : 'Talk versus product, by region'

// DiamondGrid: every vendor with a known AI status is one diamond, in three exclusive groups.
const talkOnly = v.talk.n - v.product.n
const silent = v.talk.base - v.talk.n
const COLS = 30
const PITCH = 15
const H = 5.5
const groups: [number, string, string][] = [
  [v.product.n, 'd-hi', 'AI in the listed product'],
  [talkOnly, 'd-ink', 'Talks about AI, not in the product'],
  [silent, 'd-none', 'No AI claim found'],
]
const diamonds: { points: string; cls: string; label: string }[] = []
let di = 0
for (const [count, cls, label] of groups) {
  for (let k = 0; k < count; k++, di++) {
    const cx = 8 + (di % COLS) * PITCH
    const cy = 8 + Math.floor(di / COLS) * PITCH
    diamonds.push({ points: `${cx},${cy - H} ${cx + H},${cy} ${cx},${cy + H} ${cx - H},${cy}`, cls, label })
  }
}
const gridH = 16 + (Math.ceil(v.talk.base / COLS) - 1) * PITCH

// SplitBar: who checks the AI, among products with AI in them. The two stances are separate codes; on snapshot 2 no
// product carries both (checked by SQL 2026-10-24). If a later snapshot ever makes them overlap, the bar is not drawn.
const chk = v.checks
const notStated = chk.customer.base - chk.customer.n - chk.vendor.n
const splitOk = notStated >= 0 && chk.customer.base > 0
const splitTitle =
  chk.customer.n > chk.vendor.n ? 'Who checks the AI? More often you than the vendor.' : 'Who checks the AI?'

const anti = v.antiAi
const allSell = anti.sellAi === anti.warnAboutAi && anti.warnAboutAi > 0

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Report',
  name: title,
  description,
  datePublished: v.snapshot.snapshot_date,
  url: canonical,
  publisher: { '@id': 'https://ghspictograms.com/#organization' },
}
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete>
  <Fragment slot="head">
    {!REPORT_PREVIEW_PUBLIC && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="pc">
    <div class="pc-wrap">
      <div class="pc-header">
        <span>GHS Compliance Market Report</span>
        <span>Preview · The AI Gap</span>
        <span>Snapshot {v.snapshot.id} · {snapShort}</span>
        <span>Confirmed facts only</span>
        <span>{v.vendors} vendors{v.countries ? ` · ${v.countries} countries` : ''}</span>
      </div>

      <header class="pc-hero">
        <div>
          <h1 class="pc-title">The AI Gap</h1>
          <p style="margin:1.25rem 0 0"><span class="pc-signal pc-signal--warning">Warning</span></p>
          <p class="pc-verdict">AI is everywhere in the SDS market. Mostly on the homepage.</p>
          <p class="pc-lead">
            {v.talk.n} of {v.talk.base} vendors ({pct1(v.talk.pct)}) talk about AI on their own site. {v.product.n}
            ({pct1(v.product.pct)}) show it in the product we list. The rest are still on the press release. The distance
            between the two is a new quarterly index: the AI Gap.
          </p>
        </div>
        <div class="pc-plates">
          <figure class="pc-plate-fig">
            <div class="pc-plate"><div class="pc-plate-top">{plateTop(v.cover.talk, v.talk)}</div><div class="pc-plate-bot">{v.talk.n} / {v.talk.base}</div></div>
            <figcaption class="pc-plate-cap">talk about AI on their site.</figcaption>
          </figure>
          <figure class="pc-plate-fig">
            <div class="pc-plate"><div class="pc-plate-top">{plateTop(v.cover.product, v.product)}</div><div class="pc-plate-bot">{v.product.n} / {v.product.base}</div></div>
            <figcaption class="pc-plate-cap">show AI in the product we list.</figcaption>
          </figure>
        </div>
        <p class="pc-receipt">
          <span><i class="pc-dia"></i><b>confirmed facts only</b></span>
          <span>n = {v.talk.base} vendors with a known AI status</span>
          <span>snapshot {v.snapshot.id} · {snapShort}</span>
          <span><a href="#method">how we counted</a></span>
        </p>
      </header>

      <div class="pc-section"><span class="pc-section-no">01</span><h2 class="pc-section-t">The gap</h2></div>

      <figure class="pc-figure">
        <div class="pc-figcode">Fig. G-01 · AIG</div>
        <h3>A {pp(v.gapPp)} gap between talk and product</h3>
        <p class="pc-figsub">
          Share of {v.talk.base} vendors. "Talk" counts AI on the listing or anywhere on the vendor's own site; "product"
          counts AI in the product or service we list.
        </p>
        <div class="pc-gap" role="img" aria-label={`Talk about AI ${pct1(v.talk.pct)}, AI in the product ${pct1(v.product.pct)}, AI Gap ${pp(v.gapPp)}`} style={`--tick:${all.tick}`}>
          <div class="pc-row"><span class="pc-row-k">Talk about AI</span><span class="pc-track"><i class="pc-bar pc-bar--ctx" style={`width:${all.w(v.talk.pct)}`}></i></span><span class="pc-row-v"><b>{pct1(v.talk.pct)}</b><small>{v.talk.n} of {v.talk.base}</small></span></div>
          <div class="pc-row"><span class="pc-row-k"></span><span class="pc-track pc-track--step"><i class="pc-step" style={`left:${all.left(v.product.pct)};width:${all.left(v.talk.pct - v.product.pct)}`}></i></span><span class="pc-row-v pc-code">AIG {pp(v.gapPp)}</span></div>
          <div class="pc-row"><span class="pc-row-k">AI in the product</span><span class="pc-track"><i class="pc-bar pc-bar--hi" style={`width:${all.w(v.product.pct)}`}></i></span><span class="pc-row-v"><b>{pct1(v.product.pct)}</b><small>{v.product.n} of {v.product.base}</small></span></div>
          <div class="pc-axis" aria-hidden="true"><span></span><span class="pc-axis-track">{all.ticks.map((t) => <span style={`left:${(100 * t) / all.max}%`}>{t}%</span>)}</span><span></span></div>
        </div>
        <p class="pc-receipt"><span><i class="pc-dia"></i><b>confirmed facts only</b></span><span>n = {v.talk.base} vendors</span><span>snapshot {v.snapshot.id} · {snapShort}</span></p>
      </figure>

      <figure class="pc-figure">
        <div class="pc-figcode">Fig. G-02 · AIG</div>
        <h3>{v.talk.base} vendors, one diamond each</h3>
        <p class="pc-figsub">
          {v.product.n} have AI in the listed product. {talkOnly} more talk about AI only elsewhere on their site. {silent}
          make no AI claim we could find.
        </p>
        <div class="pc-grid">
          <svg viewBox={`0 0 456 ${gridH}`} role="img" aria-label={`${v.talk.base} diamonds: ${v.product.n} AI in the product, ${talkOnly} AI talk only, ${silent} no AI claim`}>
            {diamonds.map((d) => <polygon class={d.cls} points={d.points}><title>{d.label}</title></polygon>)}
          </svg>
        </div>
        <div class="pc-legend">
          <span><i class="pc-sw pc-sw--dia pc-hi"></i>AI in the listed product · {v.product.n}</span>
          <span><i class="pc-sw pc-sw--dia pc-ink"></i>Talks about AI, not in the product · {talkOnly}</span>
          <span><i class="pc-sw pc-sw--dia" style="border:1px solid var(--pc-context)"></i>No AI claim found · {silent}</span>
        </div>
        <p class="pc-receipt"><span><i class="pc-dia"></i><b>confirmed facts only</b></span><span>n = {v.talk.base} vendors</span><span>snapshot {v.snapshot.id} · {snapShort}</span></p>
      </figure>

      {v.regions.length > 0 && (
        <figure class="pc-figure">
          <div class="pc-figcode">Fig. G-03 · AIG</div>
          <h3>{regionTitle}</h3>
          <p class="pc-figsub">Share of vendors that talk about AI and share with AI in the listed product, by the country of the vendor's head office.</p>
          {v.regions.map((r) => (
            <div class="pc-gap" role="img" aria-label={`${r.label}: talk ${pct1(r.talk.pct)}, product ${pct1(r.product.pct)}, gap ${pp(r.gapPp)}`} style={`--tick:${reg.tick}`}>
              <p class="pc-gap-name"><span>{r.label}</span><span class="pc-code">AIG {pp(r.gapPp)}</span></p>
              <div class="pc-row"><span class="pc-row-k">Talk about AI</span><span class="pc-track"><i class="pc-bar pc-bar--ctx" style={`width:${reg.w(r.talk.pct)}`}></i></span><span class="pc-row-v"><b>{pct1(r.talk.pct)}</b><small>{r.talk.n} of {r.talk.base}</small></span></div>
              <div class="pc-row"><span class="pc-row-k"></span><span class="pc-track pc-track--step"><i class="pc-step" style={`left:${reg.left(r.product.pct)};width:${reg.left(r.talk.pct - r.product.pct)}`}></i></span><span class="pc-row-v"></span></div>
              <div class="pc-row"><span class="pc-row-k">AI in the product</span><span class="pc-track"><i class="pc-bar pc-bar--hi" style={`width:${reg.w(r.product.pct)}`}></i></span><span class="pc-row-v"><b>{pct1(r.product.pct)}</b><small>{r.product.n} of {r.product.base}</small></span></div>
            </div>
          ))}
          <div class="pc-axis" aria-hidden="true" style="margin-top:0.25rem"><span></span><span class="pc-axis-track">{reg.ticks.map((t) => <span style={`left:${(100 * t) / reg.max}%`}>{t}%</span>)}</span><span></span></div>
          <p class="pc-receipt"><span><i class="pc-dia"></i><b>confirmed facts only</b></span><span>Europe and North America by head-office country</span><span>snapshot {v.snapshot.id} · {snapShort}</span></p>
        </figure>
      )}

      <div class="pc-section"><span class="pc-section-no">02</span><h2 class="pc-section-t">Who checks the AI</h2></div>

      {splitOk ? (
        <figure class="pc-figure">
          <div class="pc-figcode">Fig. G-04</div>
          <h3>{splitTitle}</h3>
          <p class="pc-figsub">
            {chk.customer.base} products with AI in them: who reviews the AI output, in the vendor's own words. Read the terms
            before you rely on the output.
          </p>
          <div role="img" aria-label={`Customer checks ${chk.customer.n}, vendor experts check ${chk.vendor.n}, not stated ${notStated}, of ${chk.customer.base}`}>
            <div class="pc-split-bar" aria-hidden="true">
              <i class="pc-s1" style={`flex:${chk.customer.n}`} title={`Customer checks: ${chk.customer.n}`}></i>
              <i class="pc-s2" style={`flex:${chk.vendor.n}`} title={`Vendor experts check: ${chk.vendor.n}`}></i>
              <i class="pc-ctx" style={`flex:${notStated}`} title={`Not stated: ${notStated}`}></i>
            </div>
            <div class="pc-split-nums" aria-hidden="true">
              <span style={`flex:${chk.customer.n}`}>{chk.customer.n}</span>
              <span style={`flex:${chk.vendor.n}`}>{chk.vendor.n}</span>
              <span style={`flex:${notStated}`}>{notStated}</span>
            </div>
          </div>
          <div class="pc-legend">
            <span><i class="pc-sw pc-s1"></i>The customer checks · {chk.customer.n} ({pct1(chk.customer.pct)})</span>
            <span><i class="pc-sw pc-s2"></i>Vendor experts check · {chk.vendor.n} ({pct1(chk.vendor.pct)})</span>
            <span><i class="pc-sw pc-ctx"></i>Not stated · {notStated}</span>
          </div>
          <p class="pc-receipt"><span><i class="pc-dia"></i><b>confirmed facts only</b></span><span>base: {chk.customer.base} products with AI in them</span><span>snapshot {v.snapshot.id} · {snapShort}</span></p>
        </figure>
      ) : (
        <p class="pc-note"><span class="pc-signal">Note</span><span>Of {chk.customer.base} vendors with AI in the product, {chk.customer.n} say the customer must check the output; {chk.vendor.n} say their own experts do.</span></p>
      )}

      <div class="pc-note">
        <span class="pc-signal">Note</span>
        <p>
          {anti.humanFirst} vendors sell themselves on not being a machine. {anti.warnAboutAi} of them warn about AI or machine
          translation by name, and {allSell ? `all ${anti.sellAi}` : anti.sellAi} of those sell it themselves.{anti.pure > 0 && ` Vendors that reject AI and sell none: ${anti.pure}.`}
        </p>
      </div>

      <div class="pc-section"><span class="pc-section-no">03</span><h2 class="pc-section-t">The numbers</h2></div>

      <div class="pc-table-wrap" style="margin-top:1.5rem">
        <table class="pc-table">
          <thead><tr><th>Code</th><th>Signal</th><th class="num">Count</th><th class="num">Base</th><th class="num">Share</th></tr></thead>
          <tbody>
            <tr><td class="code">AIG</td><td>AI Gap: talk minus product, in percentage points</td><td class="num muted">–</td><td class="num">{v.talk.base}</td><td class="num"><b>{pp(v.gapPp)}</b></td></tr>
            <tr><td class="code">AI-01</td><td>Talk about AI (listing or vendor site)</td><td class="num">{v.talk.n}</td><td class="num">{v.talk.base}</td><td class="num">{pct1(v.talk.pct)}</td></tr>
            <tr><td class="code">AI-02</td><td>AI in the listed product</td><td class="num">{v.product.n}</td><td class="num">{v.product.base}</td><td class="num">{pct1(v.product.pct)}</td></tr>
            <tr><td class="code">AI-03</td><td>Proof rate: vendors that talk about AI and have it in the product</td><td class="num">{v.proof.n}</td><td class="num">{v.proof.base}</td><td class="num">{pct1(v.proof.pct)}</td></tr>
            <tr><td class="code">AI-04</td><td>AI products where the customer checks the output</td><td class="num">{chk.customer.n}</td><td class="num">{chk.customer.base}</td><td class="num">{pct1(chk.customer.pct)}</td></tr>
            <tr><td class="code">AI-05</td><td>AI products where the vendor's experts check the output</td><td class="num">{chk.vendor.n}</td><td class="num">{chk.vendor.base}</td><td class="num">{pct1(chk.vendor.pct)}</td></tr>
            {v.humanFirstShare && (
              <tr><td class="code">AI-06</td><td>Sell themselves on not using AI</td><td class="num">{v.humanFirstShare.n}</td><td class="num">{v.humanFirstShare.base}</td><td class="num">{pct1(v.humanFirstShare.pct)}</td></tr>
            )}
            <tr><td class="code">AI-07</td><td>Mention insurance cover in their terms or pages</td><td class="num">{v.insurance.n}</td><td class="num">{v.insurance.base}</td><td class="num">{pct1(v.insurance.pct)}</td></tr>
          </tbody>
          <caption>Every row counts confirmed facts only: a claim found again on the vendor's own page · snapshot {v.snapshot.id} · {snapDate}</caption>
        </table>
      </div>

      <section class="pc-pstate" aria-label="Buyer statements for the AI chapter">
        <div class="pc-pstate-hd"><span>Buyer statements · AI</span><span>PB-AI</span></div>
        <ol>
          <li><span class="pc-c">PB-AI-01</span><span>Ask which clause says who checks AI output before it reaches your safety data sheet.</span></li>
          <li><span class="pc-c">PB-AI-02</span><span>Ask whether "AI" describes the product you are buying or the company's other work.</span></li>
          <li><span class="pc-c">PB-AI-03</span><span>Ask which model provider is used and whether your documents are used to train it.</span></li>
        </ol>
      </section>

      <div class="pc-section" id="method"><span class="pc-section-no">04</span><h2 class="pc-section-t">How we counted</h2></div>
      <ul class="pc-method">
        <li>We read the websites, terms and licences of {v.vendors} vendors in the <a href="/directory/">GHS Tools &amp; Services Directory</a>. Every fact is a verbatim quote with a link to the vendor's own page.</li>
        <li>Each source page is read again, by a script or, where a site blocks scripts, in a browser; only facts found there again are counted here.</li>
        <li><strong>Talk about AI</strong>: the vendor claims AI for the listed product or anywhere else on its own site. Claims made only by a parent group, and AI sold in an unrelated business line, are not counted.</li>
        <li><strong>AI in product</strong>: the vendor says the product or service we list uses AI (machine learning, language models, neural machine translation). "Smart" or "automatic" without AI words does not count.</li>
        <li>No ratings, no rankings. A place in the directory is never sold. This page names no vendor: findings are aggregates.</li>
      </ul>

      <div class="pc-section"><span class="pc-section-no">05</span><h2 class="pc-section-t">The full report</h2></div>
      <section class="pc-signup" aria-labelledby="pc-full">
        <h3 id="pc-full">The full report, {REPORT_FULL_ISSUE}</h3>
        <p>
          Prices and how to buy, who is liable for a wrong safety data sheet, languages and jurisdictions, security, 24/7
          emergency lines, and the AI chapter with every number broken down. Free, no paywall.
        </p>
        <NewsletterOptIn
          client:visible
          source="market_report_preview"
          list="report"
          consentText="Email me when the GHS Compliance Market Report is out, plus occasional GHS / CLP / OSHA compliance updates. Unsubscribe anytime."
          buttonText="Notify me"
        />
      </section>

      <p class="pc-receipt pc-foot">
        <span>Preview figures from snapshot {v.snapshot.id} of {snapDate}</span>
        <span>The full issue may differ as more facts are confirmed</span>
      </p>
    </div>
  </article>
</Layout>
