---
// /reports/ai-gap-preview/ — GHS Compliance Market Report, preview issue "The AI Gap" (s114, 2026-10-19).
//
// Agreed with Sergej 2026-10-19: five numbers, one chart by region, a short method box, a sign-up for the full issue;
// light humour in the headline, strict numbers inside; jokes about the market, never about named vendors — this page
// names NO vendor. Only confirmed facts (section G, dimension confirmed_only). Published after the facts are confirmed:
// until REPORT_PREVIEW_PUBLIC is true the page carries noindex and is not in the sitemap.
//
// ⚠ Every number comes from report_metrics of ONE frozen snapshot (src/lib/reportData.ts); nothing is typed by hand.
//   No snapshot with section G yet → getStaticPaths returns [] and the page is simply not built.
import Layout from '../../layouts/Layout.astro'
import NewsletterOptIn from '../../components/NewsletterOptIn'
import {
  REPORT_FULL_ISSUE, REPORT_PREVIEW_PATH, REPORT_PREVIEW_PUBLIC, REPORT_PREVIEW_SLUG, fmtPct, fmtPp, loadAiGapView, longDate, monthYear,
} from '../../lib/reportData'

export const prerender = true

export async function getStaticPaths() {
  const view = await loadAiGapView()
  return view ? [{ params: { issue: REPORT_PREVIEW_SLUG }, props: { view } }] : []
}

const { view } = Astro.props as { view: NonNullable<Awaited<ReturnType<typeof loadAiGapView>>> }
const v = view
const snapDate = longDate(v.snapshot.snapshot_date)
const title = 'The AI Gap: GHS Compliance Market Report preview'
const description =
  `${v.cover.talk} SDS and GHS compliance vendors talk about AI; ${v.cover.product.toLowerCase()} show it in the product. ` +
  `Five numbers from ${v.vendors} vendors, every fact a quote with a link.`
const canonical = `https://ghspictograms.com${REPORT_PREVIEW_PATH}`

// Chart scale: one axis for every bar, rounded up to the next 10 % above the largest share drawn.
const maxPct = Math.max(10, ...v.regions.flatMap((r) => [r.talk.pct, r.product.pct]))
const axisMax = Math.ceil(maxPct / 10) * 10
const w = (pct: number) => `${Math.max(0.5, (100 * pct) / axisMax)}%`
const ticks = Array.from({ length: axisMax / 10 + 1 }, (_, i) => i * 10).filter((t) => t % (axisMax > 50 ? 20 : 10) === 0)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Report',
  name: title,
  description,
  datePublished: v.snapshot.snapshot_date,
  url: canonical,
  publisher: { '@id': 'https://ghspictograms.com/#organization' },
}
---

<Layout title={title} description={description} canonical={canonical} titleIsComplete>
  <Fragment slot="head">
    {!REPORT_PREVIEW_PUBLIC && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="rp">
    <header class="rp-hero">
      <div class="rp-wrap">
        <p class="rp-eyebrow">GHS Compliance Market Report · Preview · {monthYear(v.snapshot.snapshot_date)}</p>
        <h1>The AI Gap</h1>
        <p class="rp-dek">
          {v.cover.talk} SDS and GHS compliance vendors talk about AI. {v.cover.product} show it in the product.
          The rest are still on the press release.
        </p>
        <p class="rp-meta">
          {v.vendors} vendors{v.countries ? ` · ${v.countries} countries` : ''} · snapshot {snapDate} · confirmed facts only
        </p>
      </div>
    </header>

    <div class="rp-wrap rp-body">
      <section aria-labelledby="rp-numbers">
        <h2 id="rp-numbers">Five numbers</h2>
        <div class="rp-grid">
          <div class="rp-card rp-card-lead">
            <p class="rp-big">{fmtPp(v.gapPp)}</p>
            <p class="rp-name">The AI Gap</p>
            <p>
              {fmtPct(v.talk.pct)} of vendors talk about AI ({v.talk.n} of {v.talk.base}); {fmtPct(v.product.pct)} show it in the product
              we list ({v.product.n}). The difference, in percentage points, is a new quarterly index.
            </p>
          </div>
          <div class="rp-card">
            <p class="rp-big">{fmtPct(v.proof.pct)}</p>
            <p class="rp-name">Proof rate</p>
            <p>Of the {v.proof.base} vendors that talk about AI, {v.proof.n} show it in the product itself.</p>
          </div>
          <div class="rp-card">
            <p class="rp-big">{v.checks.customer.n} vs {v.checks.vendor.n}</p>
            <p class="rp-name">Who checks the AI?</p>
            <p>
              Of {v.checks.customer.base} vendors with AI in the product, {v.checks.customer.n} say the customer must check the
              output. {v.checks.vendor.n} say their own experts do. Read the terms: it is usually you.
            </p>
          </div>
          <div class="rp-card">
            <p class="rp-big">{v.antiAi.sellAi} of {v.antiAi.warnAboutAi}</p>
            <p class="rp-name">The anti-AI camp</p>
            <p>
              {v.antiAi.humanFirst} vendors sell themselves on not being a machine. {v.antiAi.warnAboutAi} of them warn about AI or
              machine translation by name, and {v.antiAi.sellAi} of those sell it themselves. Vendors that reject AI and sell
              none: {v.antiAi.pure}.
            </p>
          </div>
          <div class="rp-card">
            <p class="rp-big">{v.insurance.n} of {v.insurance.base}</p>
            <p class="rp-name">Insurance</p>
            <p>Vendors that mention insurance cover anywhere in their terms or pages. A wrong SDS is the supplier's problem.</p>
          </div>
        </div>
      </section>

      {v.regions.length > 0 && (
        <section aria-labelledby="rp-regions">
          <h2 id="rp-regions">Talk versus product, by region</h2>
          <p class="rp-lead">Share of vendors that talk about AI, and share that show it in the listed product. Gap in percentage points.</p>
          <div class="rp-chart" role="img" aria-label={v.regions.map((r) => `${r.label}: talk ${fmtPct(r.talk.pct)}, product ${fmtPct(r.product.pct)}, gap ${fmtPp(r.gapPp)}`).join('; ')}>
            {v.regions.map((r) => (
              <div class="rp-region">
                <div class="rp-region-head">
                  <span class="rp-region-name">{r.label}</span>
                  <span class="rp-region-gap">gap {fmtPp(r.gapPp)}</span>
                </div>
                <div class="rp-row">
                  <span class="rp-row-k">Talk about AI</span>
                  <span class="rp-track"><i class="rp-bar rp-bar-talk" style={`width:${w(r.talk.pct)}`}></i></span>
                  <span class="rp-row-v">{fmtPct(r.talk.pct)} <small>({r.talk.n}/{r.talk.base})</small></span>
                </div>
                <div class="rp-row">
                  <span class="rp-row-k">AI in product</span>
                  <span class="rp-track"><i class="rp-bar rp-bar-product" style={`width:${w(r.product.pct)}`}></i></span>
                  <span class="rp-row-v">{fmtPct(r.product.pct)} <small>({r.product.n}/{r.product.base})</small></span>
                </div>
              </div>
            ))}
            <div class="rp-axis" aria-hidden="true">
              <span class="rp-row-k"></span>
              <span class="rp-axis-track">
                {ticks.map((t) => <span style={`left:${(100 * t) / axisMax}%`}>{t}%</span>)}
              </span>
              <span class="rp-row-v"></span>
            </div>
          </div>
        </section>
      )}

      <section aria-labelledby="rp-method" class="rp-method">
        <h2 id="rp-method">How we counted</h2>
        <ul>
          <li>We read the websites, terms and licences of {v.vendors} vendors in the <a href="/directory/">GHS Tools &amp; Services Directory</a>. Every fact is a verbatim quote with a link to the vendor's own page.</li>
          <li>A script re-reads each source page; only facts found there again are counted here.</li>
          <li><strong>Talk about AI</strong>: the vendor claims AI for the listed product or anywhere else on its own site. Claims made only by a parent group, and AI sold in an unrelated business line, are not counted.</li>
          <li><strong>AI in product</strong>: the vendor says the product or service we list uses AI (machine learning, language models, neural machine translation). "Smart" or "automatic" without AI words does not count.</li>
          <li>No ratings, no rankings. A place in the directory is never sold. This page names no vendor: findings are aggregates.</li>
        </ul>
      </section>

      <section aria-labelledby="rp-full" class="rp-signup">
        <h2 id="rp-full">The full report, {REPORT_FULL_ISSUE}</h2>
        <p>
          Prices and how to buy, who is liable for a wrong safety data sheet, languages and jurisdictions, security, 24/7
          emergency lines, and the AI chapter with every number broken down. Free, no paywall.
        </p>
        <NewsletterOptIn
          client:visible
          source="market_report_preview"
          list="report"
          consentText="Email me when the GHS Compliance Market Report is out, plus occasional GHS / CLP / OSHA compliance updates. Unsubscribe anytime."
          buttonText="Notify me"
        />
      </section>

      <p class="rp-foot">
        Preview figures from the snapshot of {snapDate}. The full issue may differ as more facts are confirmed.
      </p>
    </div>
  </article>
</Layout>

<style>
  .rp { --rp-navy: var(--navy, #062a78); --rp-orange: #f97316; --rp-teal: var(--teal-600, #0d9488); --rp-ink: var(--ink, #0f1729); --rp-ink-2: var(--ink-2, #475569); --rp-line: var(--line, #e2e8f0); --rp-bg: var(--bg-a, #eef2f9); color: var(--rp-ink); }
  .rp-wrap { max-width: 60rem; margin: 0 auto; padding-left: 1rem; padding-right: 1rem; }
  .rp-hero { background: var(--rp-navy); color: #fff; padding-block: 3rem 2.5rem; }
  .rp-eyebrow { font-family: var(--font-mono, ui-monospace, Menlo, monospace); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-dark-3, #a8c1ea); margin: 0; }
  .rp-hero h1 { font-size: clamp(2.25rem, 7vw, 3.75rem); line-height: 1.05; font-weight: 800; margin: 0.5rem 0 0; text-wrap: balance; }
  .rp-dek { font-size: clamp(1.125rem, 2.6vw, 1.375rem); line-height: 1.45; max-width: 44rem; margin: 1rem 0 0; color: var(--ink-dark-1, #dbe6fb); }
  .rp-meta { font-family: var(--font-mono, ui-monospace, Menlo, monospace); font-size: 0.8125rem; color: var(--ink-dark-3, #a8c1ea); margin: 1.25rem 0 0; }
  .rp-body { display: flex; flex-direction: column; gap: 3rem; padding-block: 2.5rem 4rem; }
  .rp-body h2 { font-size: 1.5rem; font-weight: 700; margin: 0 0 1rem; color: var(--rp-navy); text-wrap: balance; }
  .rp-lead { color: var(--rp-ink-2); margin: -0.5rem 0 1rem; }
  .rp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .rp-card { border: 1px solid var(--rp-line); border-radius: 0.75rem; padding: 1.25rem; background: #fff; display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
  .rp-card p { margin: 0; color: var(--rp-ink-2); line-height: 1.5; font-size: 0.9375rem; }
  .rp-card-lead { border-color: var(--rp-orange); box-shadow: inset 0 0 0 1px var(--rp-orange); }
  @media (min-width: 52rem) { .rp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .rp-card-lead { grid-column: span 2; } }
  .rp-card .rp-big { font-family: var(--font-mono, ui-monospace, Menlo, monospace); font-variant-numeric: tabular-nums; font-size: 2rem; font-weight: 600; color: var(--rp-ink); line-height: 1.1; }
  .rp-card-lead .rp-big { color: var(--rp-orange); }
  .rp-card .rp-name { font-weight: 700; color: var(--rp-navy); font-size: 1rem; }
  .rp-chart { display: flex; flex-direction: column; gap: 1.5rem; }
  .rp-region-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.5rem; }
  .rp-region-name { font-weight: 700; }
  .rp-region-gap { font-family: var(--font-mono, ui-monospace, Menlo, monospace); color: var(--rp-orange); font-size: 0.875rem; }
  .rp-row, .rp-axis { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) 6.5rem; gap: 0.75rem; align-items: center; margin-top: 0.375rem; }
  .rp-row-k { font-size: 0.875rem; color: var(--rp-ink-2); }
  .rp-row-v { font-family: var(--font-mono, ui-monospace, Menlo, monospace); font-variant-numeric: tabular-nums; font-size: 0.875rem; text-align: right; }
  .rp-row-v small { color: var(--rp-ink-2); }
  .rp-track { height: 0.875rem; background: var(--rp-bg); border-radius: 0.25rem; overflow: hidden; }
  .rp-bar { display: block; height: 100%; }
  .rp-bar-talk { background: var(--rp-navy); }
  .rp-bar-product { background: var(--rp-orange); }
  .rp-axis { margin-top: -0.75rem; }
  .rp-axis-track { position: relative; height: 1rem; border-top: 1px solid var(--rp-line); }
  .rp-axis-track span { position: absolute; top: 0.125rem; transform: translateX(-50%); font-family: var(--font-mono, ui-monospace, Menlo, monospace); font-size: 0.6875rem; color: var(--rp-ink-2); }
  .rp-method ul { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; color: var(--rp-ink-2); line-height: 1.55; }
  .rp-method a { color: var(--rp-navy); text-decoration: underline; }
  .rp-signup { background: var(--rp-bg); border-radius: 0.75rem; padding: 1.5rem; }
  .rp-signup p { margin: 0; color: var(--rp-ink-2); line-height: 1.55; max-width: 42rem; }
  .rp-foot { font-size: 0.8125rem; color: var(--rp-ink-2); margin: 0; }
  @media (max-width: 30rem) {
    .rp-row, .rp-axis { grid-template-columns: 5.75rem minmax(0, 1fr) 5.5rem; gap: 0.5rem; }
    .rp-row-v small { display: none; }
  }
</style>
