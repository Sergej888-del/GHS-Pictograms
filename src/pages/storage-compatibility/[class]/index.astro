---
// Storage-class category page — /storage-compatibility/<slug>/
// One page per storage class (getStaticPaths over STORAGE_CLASSES). Data-driven:
//   * hero + count            (get_class_substances total)
//   * compatibility-at-a-glance: never / keep separate / compatible cards,
//     each row -> the other class's page (interlink graph)
//   * substances in this class: ALL baked into HTML, first 50 shown + the rest
//     behind a "Show all N" toggle; each -> the tool's ?substance= deep-link
//   * optional editorial prose + FAQ from the `storage-classes` content collection
//   * CollectionPage + ItemList (+ FAQPage when prose has faq) JSON-LD
// Prose is OPTIONAL (P4). Without an entry the page renders data-only; such
// pages should not be linked/sitemapped until prose lands (publication control
// handled outside this file — see P2 notes).
// rev2 (session 14, Фаза 3): rebuilt on the v2 hub vocabulary (src/styles/hub.css),
// sharing its components with the hub — same data cards, badges, mini-tables.
// Hero colour untouched (HERO_BG, §0.2); only the frame changed.
import Layout from '../../../layouts/Layout.astro'
import SdsManagerCard from '../../../components/SdsManagerCard.astro'
import { STORAGE_CLASSES, shortForCode, urlForCode, familyStyleForCode, HERO_BG } from '../../../lib/storageClasses'
import { supabase } from '../../../lib/supabase'
import { getCollection, render } from 'astro:content'

const SITE = 'https://ghspictograms.com'
const TOOL = '/tools/chemical-storage-compatibility/'

export async function getStaticPaths() {
  // Top-level module imports (STORAGE_CLASSES, supabase) ARE visible here; only
  // `---` consts are not. High p_limit => bake the full class list into the HTML.
  const pages = await Promise.all(
    STORAGE_CLASSES.map(async (cls) => {
      const [subsRes, compatRes] = await Promise.all([
        supabase.rpc('get_class_substances', { p_sc_code: cls.code, p_limit: 5000 }),
        supabase.rpc('get_class_compatibility', { p_sc_code: cls.code }),
      ])
      const subs = subsRes.data ?? { sc_code: cls.code, total: 0, items: [] }
      const compat = compatRes.data?.compat ?? []
      return { params: { class: cls.slug }, props: { cls, subs, compat } }
    }),
  )
  return pages
}

interface SubItem { cas: string; name: string; signal_word: string | null }
interface CompatItem { class: string; name: string; status: 'prohibited' | 'separate' | 'compatible' }

const { cls, subs, compat } = Astro.props as {
  cls: { code: string; slug: string; short: string }
  subs: { sc_code: string; total: number; items: SubItem[] }
  compat: CompatItem[]
}

// Optional editorial prose. Collection NAME is the config key `storageClasses`;
// content FILES live in src/content/storage-classes/ (filename === class slug).
const entries = await getCollection('storageClasses').catch(() => [])
const entry = entries.find((e) => e.id === cls.slug && !e.data.draft) ?? null
const Content = entry ? (await render(entry)).Content : null

const never = compat.filter((c) => c.status === 'prohibited')
const separate = compat.filter((c) => c.status === 'separate')
const compatible = compat.filter((c) => c.status === 'compatible')
const others = compat.length // the 12 other storage classes

const total = subs.total ?? 0
const items = subs.items ?? []
const COLLAPSE_AT = 50 // first 50 shown; the rest collapsed behind a toggle

// SEO — prose frontmatter wins; sensible data-driven fallback otherwise.
const title = entry?.data.title ?? `${cls.short} — storage, segregation & compatibility`
const description =
  entry?.data.description ??
  `What ${cls.short.toLowerCase()} can and can't be stored with — segregation by GHS hazard class, chemical reactivity, and ADR transport. ${total} substances in our database.`
const canonical = `${SITE}/storage-compatibility/${cls.slug}/`

// Structured data.
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${cls.short} — substances`,
    numberOfItems: total,
    itemListElement: items.slice(0, 100).map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: `${SITE}${TOOL}?substance=${encodeURIComponent(s.cas)}`,
    })),
  },
]
if (entry?.data.faq?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: entry.data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })
}

const fam = familyStyleForCode(cls.code)
const lower = cls.short.toLowerCase()

// The three verdict cards — same component as the hub deck.
const deck = [
  {
    badge: 'Never store',
    note: 'hard stop',
    title: 'Never store with',
    n: never.length,
    acc: '#e11d48',
    ink: '#9f1239',
    line: '#fecdd3',
    soft: '#fff1f2',
    copy: `Direct reaction with ${lower} — ignition, pressure build-up or a toxic gas release.`,
    head: 'Separate cabinet, bund or room',
    empty: `No storage class is prohibited outright with ${lower}.`,
    items: never,
  },
  {
    badge: 'Keep separate',
    note: 'distance control',
    title: 'Keep separate from',
    n: separate.length,
    acc: '#d97706',
    ink: '#92400e',
    line: '#fde68a',
    soft: '#fffbeb',
    copy: 'No direct reaction, but a spill or fire involving either class makes the other markedly worse.',
    head: 'Distance, bund or separate tray',
    empty: `No storage class needs distance separation from ${lower}.`,
    items: separate,
  },
  {
    badge: 'Compatible',
    note: 'verify per substance',
    title: 'Generally compatible with',
    n: compatible.length,
    acc: '#0d9488',
    ink: '#0f766e',
    line: '#99f6e4',
    soft: '#f0fdfa',
    copy:
      'No class-level restriction. The individual substance still governs — check SDS sections 7 and 10.',
    head: 'Shared storage normally acceptable',
    empty: `No storage class shares a store with ${lower} without conditions.`,
    items: compatible,
  },
]

// Section numbers depend on which optional sections exist on this page.
let sn = 0
const pad = () => String(++sn).padStart(2, '0')
const nSeg = pad()
const nProse = Content ? pad() : null
const nSubs = pad()
const nFaq = entry?.data.faq?.length ? pad() : null
---

<Layout title={title} description={description} canonical={canonical}>
  <!-- Data-only pages (no prose entry) stay out of the index until P4 prose lands -->
  {!entry && <meta name="robots" content="noindex,follow" slot="head" />}

  <!-- HERO — v2 frame, original storage colour (HERO_BG) kept via inline style -->
  <section class="hub-hero" style={`background:${HERO_BG};`}>
    <div class="dots-a" aria-hidden="true"></div>
    <div class="dots-b" aria-hidden="true"></div>
    <div class="sheen" aria-hidden="true"></div>

    <div class="hub-wrap hub-hero-left">
      <nav class="hub-crumb" aria-label="Breadcrumb">
        <a href="/storage-compatibility/">Storage compatibility</a><span class="sep">/</span>{cls.short}
      </nav>
      <p class="hub-hero-eyebrow">{fam.label} · storage class</p>
      <h1>{title}</h1>
      <p class="hub-hero-sub">
        {entry?.data.intro ??
          `Storage segregation, incompatibilities, and the ${total} substances in this class in our database.`}
      </p>
      <div class="hub-hero-chips">
        <span class="hub-hero-chip">{total} {total === 1 ? 'substance' : 'substances'}</span>
        <span class="hub-hero-chip"><i class="d rose"></i>{never.length} never store</span>
        <span class="hub-hero-chip"><i class="d amber"></i>{separate.length} keep separate</span>
        <span class="hub-hero-chip"><i class="d teal"></i>{compatible.length} compatible</span>
      </div>
      <a href={TOOL} class="hub-hero-cta">Check a specific substance →</a>
    </div>
  </section>

  <!-- SEGREGATION — the three verdicts against the other classes -->
  <section class="hub-sec-deep">
    <div class="hub-wrap">
      <p class="hub-eyebrow">{nSeg} · Segregation</p>
      <h2 class="hub-h2">What {lower} can be stored with</h2>
      <p class="hub-sub">
        Class-level segregation against the {others} other storage classes. Open any class for its own guidance
        and substance list.
      </p>

      <div class="hub-deck">
        {deck.map((d) => (
          <div
            class={d.n > 0 ? 'hub-deck-card' : 'hub-deck-card muted'}
            style={d.n > 0 ? `--c-acc:${d.acc};--c-ink:${d.ink};--c-line:${d.line};--c-soft:${d.soft}` : undefined}
          >
            <div class="hub-deck-badges">
              <span class="hub-deck-badge">{d.badge}</span>
              <span class="hub-deck-note">{d.note}</span>
            </div>
            <h3>{d.title}</h3>
            <div class="hub-deck-stat">
              <span class="num">{d.n}</span>
              <span class="of">of the {others} other classes</span>
            </div>
            <div class="hub-deck-bar"><span style={`width:${Math.round((d.n / Math.max(others, 1)) * 100)}%`}></span></div>
            {d.n > 0 && <p class="copy">{d.copy}</p>}
            {d.n > 0 ? (
              <div class="hub-pairs">
                <div class="hub-pairs-head"><span>{d.head}</span><span>{d.n}</span></div>
                {d.items.map((c) => (
                  <a href={urlForCode(c.class)} class="hub-pair">
                    <span class="a">{shortForCode(c.class)}</span>
                    <span class="v arrow" aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="hub-deck-empty">{d.empty}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EDITORIAL PROSE (optional, P4) -->
  {Content && (
    <section class="hub-sec-white">
      <div class="hub-wrap">
        <p class="hub-eyebrow">{nProse} · Guidance</p>
        <div class="md-prose hub-prose">
          <Content />
        </div>
      </div>
    </section>
  )}

  <!-- SUBSTANCES IN THIS CLASS -->
  <section class="hub-sec-b">
    <div class="hub-wrap">
      <p class="hub-eyebrow navy">{nSubs} · Substances</p>
      <h2 class="hub-h2">{cls.short} in our database</h2>
      <p class="hub-sub">
        {total === 0
          ? 'No substances are currently classified into this class.'
          : 'Every substance classified into this class. Open one to get its own verdict against any other chemical in the matrix.'}
      </p>

      {items.length > 0 && (
        <p class="hub-meta">
          {total} {total === 1 ? 'substance' : 'substances'}
          {total > COLLAPSE_AT ? ` · first ${COLLAPSE_AT} shown` : ''}
        </p>
      )}

      {items.length > 0 && (
        <ul id="ss-list" class="hub-index wide ss-collapsed" style="margin-top:22px">
          {items.map((s, i) => (
            <li class={i >= COLLAPSE_AT ? 'ss-extra' : undefined}>
              <a href={`${TOOL}?substance=${encodeURIComponent(s.cas)}`} class="hub-index-card">
                <span class="txt">
                  <span class="name">{s.name}</span>
                  <span class="cas">CAS {s.cas}</span>
                </span>
                {s.signal_word && (
                  <span class={`sig ${s.signal_word === 'Danger' ? 'danger' : 'warning'}`}>{s.signal_word}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}

      {total > COLLAPSE_AT && (
        <button id="ss-toggle" type="button" data-all={`Show all ${total} substances ↓`} class="hub-toggle">
          Show all {total} substances ↓
        </button>
      )}
    </div>
  </section>

  <!-- FAQ (optional, P4) + closing bridge -->
  <section class="hub-sec-white">
    <div class="hub-wrap">
      {entry?.data.faq && entry.data.faq.length > 0 && (
        <>
          <p class="hub-eyebrow">{nFaq} · FAQ</p>
          <h2 class="hub-h2">Frequently asked questions</h2>
          <div class="hub-faq">
            {entry.data.faq.map((f) => (
              <div class="hub-faq-item">
                <p class="q">{f.q}</p>
                <p class="a">{f.a}</p>
              </div>
            ))}
          </div>
        </>
      )}

      <div class="hub-close-panel" style="margin-top:36px">
        <div class="dots" aria-hidden="true"></div>
        <h2>Need the verdict for one specific substance?</h2>
        <p>
          Search it in the <a href={TOOL}>storage compatibility matrix</a> — 3,600+ substances by CAS number,
          with reaction-gas prediction and ADR transport data. Substance reference pages live in the
          <a href="/sds/">SDS library</a>.
        </p>
      </div>

      <SdsManagerCard
        service="management"
        body={`Class-level segregation is only as current as the sheets behind it: what actually decides where ${lower} go is SDS sections 7 and 10 for each product on the shelf, and those change whenever a supplier reissues. For keeping that library central, version-controlled and reachable by QR code at the store, the solution we recommend is SDS Manager. It also offers SDS authoring and a broader EHS suite.`}
        href="https://sdsmanager.com/us/sds-management?fpr=ghs3&fp_sid=stclass"
      />

      <p class="hub-fine">
        Reference aid only — class-level segregation is a starting point, not a substitute for a substance's Safety
        Data Sheet or professional judgment. Always verify storage against SDS sections 7 and 10 and local regulations.
      </p>
    </div>
  </section>

  {jsonLd.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}

  <style is:global>
    #ss-list.ss-collapsed .ss-extra { display: none !important; }
  </style>
  <script is:inline>
    (function () {
      var b = document.getElementById('ss-toggle')
      var ul = document.getElementById('ss-list')
      if (!b || !ul) return
      b.addEventListener('click', function () {
        var collapsed = ul.classList.toggle('ss-collapsed')
        b.textContent = collapsed ? b.getAttribute('data-all') : 'Show fewer ↑'
      })
    })()
  </script>
</Layout>
