      .hp-sds-table {
        margin-top: 36px;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow-x: auto;
      }
      .hp-sds-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1.6fr 1.4fr 1fr;
        gap: 16px;
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        align-items: center;
        min-width: 720px;
      }
      .hp-sds-grid.head {
        padding: 14px 20px;
        background: #f1f5f9;
        border-bottom: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-2);
      }
      .hp-sds-grid:last-child {
        border-bottom: 0;
      }
      .hp-sds-grid .name {
        font-size: 14.5px;
        font-weight: 600;
        color: var(--ink);
      }
      .hp-sds-grid .cas,
      .hp-sds-grid .adr {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--ink-2);
      }
      .hp-sds-grid .cls {
        font-size: 13.5px;
        color: var(--ink-2);
      }
      .hp-sds-grid .verdict {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        color: #9f1239;
      }
      .hp-sds-cards {
        margin-top: 20px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px;
      }
      .hp-sds-card {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px;
      }
      .hp-sds-card .s {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--teal-600);
      }
      .hp-sds-card .s.muted {
        color: var(--ink-3);
      }
      .hp-sds-card p.d {
        margin-top: 6px;
        font-size: 14px;
        color: var(--ink-2);
      }

      /* ── Compliance ── */
      .hp-compliance {
        padding: clamp(56px, 8vw, 104px) 0;
        background: var(--navy);
        position: relative;
        overflow: hidden;
      }
      .hp-compliance .dots {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
        background-size: 26px 26px;
        mask-image: linear-gradient(200deg, #000 0%, transparent 60%);
        -webkit-mask-image: linear-gradient(200deg, #000 0%, transparent 60%);
      }
      .hp-compliance .wrap {
        position: relative;
      }
      .hp-pillars {
        margin-top: 36px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 14px;
      }
      .hp-pillar {
        display: block;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 0 0 12px 12px;
        padding: 20px;
        transition: all 400ms ease-out;
        border-top: 2px solid transparent;
      }
      .hp-pillar:hover {
        background: rgba(255, 255, 255, 0.12);
        transform: translateY(-4px);
      }
      .hp-pillar .n {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--ink-dark-4);
      }
      .hp-pillar h3 {
        margin: 8px 0 6px;
        font-size: 18px;
        font-weight: 600;
        color: #ffffff;
      }
      .hp-pillar p.c {
        font-size: 14px;
        line-height: 1.55;
        color: var(--ink-dark-2);
      }

      /* ── Roles ── */
      .hp-roles {
        background: #f1f5f9;
        border-top: 1px solid var(--line-r);
        padding: clamp(40px, 5vw, 64px) 0;
      }
      .hp-roles .t {
        margin-bottom: 24px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .hp-roles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 24px;
      }
      .hp-role .who {
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
      }
      .hp-role .c {
        margin-top: 6px;
        font-size: 14px;
        line-height: 1.55;
        color: var(--ink-2);
      }

      /* ── Pictogram reference ── */
      .hp-pictos {
        padding: clamp(56px, 8vw, 104px) 0;
        background: linear-gradient(180deg, #ffffff 0%, var(--bg-a) 100%);
      }
      .hp-pictos-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
      }
      .btn-outline {
        border: 1px solid var(--line-2);
        color: #1e3a8a !important;
        font-size: 15px;
        font-weight: 600;
        padding: 13px 20px;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 2px 6px rgba(15, 23, 41, 0.08);
        transition: all 300ms ease-out;
        white-space: nowrap;
        display: inline-block;
      }
      .btn-outline:hover {
        border-color: #1e3a8a;
        background: #f8fafc;
        color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 14px 26px rgba(15, 23, 41, 0.14);
      }
      .hp-picto-grid {
        margin-top: 36px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }
      @media (min-width: 1024px) {
        .hp-picto-grid {
          grid-template-columns: repeat(9, minmax(0, 1fr));
        }
      }
      .hp-picto-tile {
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        transition: all 400ms ease-out;
        background: #ffffff;
      }
      .hp-picto-tile:hover {
        border-color: var(--line-2);
        transform: translateY(-4px);
      }
      .hp-picto-tile svg {
        width: 100%;
        max-width: 84px;
        height: auto;
        display: block;
      }
      .hp-picto-tile .code {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        color: #1e3a8a;
      }
      .hp-picto-tile .nm {
        font-size: 13px;
        color: var(--ink-2);
        text-align: center;
      }

    </style>
  </head>

  <body class="hp">
    {/* ⚠ animateMark стоит ТОЛЬКО здесь. Сборка знака — приветствие на главной;
        в шапке страницы вещества, куда человек пришёл из поиска за конкретным
        числом, то же движение читается как помеха. Разбор — SiteHeader.astro. */}
    <SiteHeader sdsCount={sdsLabel} animateMark={true} />

    <section class="hp-hero">
      <div class="dots-a" aria-hidden="true"></div>
      <div class="dots-b" aria-hidden="true"></div>
      <div class="sheen" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      {
        ghs02?.svg_content && (
          <div class="float-picto" aria-hidden="true">
            <Fragment set:html={ghs02.svg_content} />
          </div>
        )
      }

      <div class="wrap hp-hero-inner">
        <p class="hp-hero-eyebrow">Chemical safety reference · EU CLP + US OSHA</p>
        <h1>Chemical safety reference data — and the free tools that use it.</h1>
        <p class="hp-hero-sub">
          {sdsLabel} substance safety reports with computed storage-compatibility verdicts, GHS/CLP
          classification tools and the full pictogram library. Cited sources, no registration.
        </p>
        {/* ⚠ Первой кнопкой — конструктор этикеток: это единственный инструмент
            сайта, ради которого приходят «сделать», а не «посмотреть». Матрица
            хранения уходит на вторую позицию, SDS — в призрачную.
            ⚠ Три кнопки здесь предел; четвёртую не добавлять. */}
        <div class="hp-hero-ctas">
          <a href="/ghs-label-maker/" class="btn-orange">Build a GHS label →</a>
          <a href="/tools/chemical-storage-compatibility/" class="btn-ghost">Check storage compatibility</a>
          <a href="/sds/" class="btn-ghost">Browse {sdsLabel} SDS reports</a>
        </div>
      </div>

      <div class="hp-statband">
        <div class="wrap hp-statband-grid">
          <div><p class="hp-stat-num">14</p><p class="hp-stat-label">Free tools</p></div>
          <div><p class="hp-stat-num teal">{sdsLabel}</p><p class="hp-stat-label">SDS substance reports</p></div>
          <div><p class="hp-stat-num">4,178</p><p class="hp-stat-label">Substances, CLP Annex VI</p></div>
          <div><p class="hp-stat-num">9</p><p class="hp-stat-label">Pictograms, free SVG</p></div>
          <div><p class="hp-stat-num">4</p><p class="hp-stat-label">Label rulebooks</p></div>
        </div>
      </div>
    </section>

    <div class="hp-provenance">
      <div class="wrap hp-provenance-row">
        <span class="tag">Provenance</span>
        <p>Reference data from EU CLP Annex VI and published regulations — verify against your supplier's SDS before use.</p>
      </div>
    </div>

    <section class="hp-tools" id="tools">
      <div class="wrap">
        <p class="hp-eyebrow">01 · Tools</p>
        <h2 class="hp-h2">Working tools, not calculators that dodge the answer.</h2>
        <p class="hp-sub">
          14 free tools. Two of them do work no other public tool does — a per-substance storage
          verdict and full acute-toxicity classification of mixtures.
        </p>

        <div class="hp-flagships">
          {/* ── ФЛАГМАН · GHS LABEL MAKER ───────────────────────────────────
              ⚠⚠ Карточка занимает ВЕСЬ РЯД (`grid-column: 1 / -1`), а не встаёт
              третьей колонкой. Сетка здесь `auto-fit, minmax(320px, 1fr)`:
              третья обычная карточка сжала бы две существующие до 320 px и
              разрушила бы и виджет вердиктов, и таблицу ATE.
              ⚠ Этикетка внутри — настоящая, считается на сборке движком
              инструмента; разбор в шапке файла. */}
          <div class="hp-card-label">
            <div class="hp-label-copy">
              <div class="hp-badge-row">
                <span class="hp-badge orange">Flagship tool</span>
                <span class="hp-badge-note">Vector PDF · no signup</span>
              </div>
              <h3 class="hp-card-title">GHS Label Maker</h3>
              <p class="hp-card-copy">
                Pick a substance and the pictograms, signal word and hazard statements come from the
                harmonised CLP Annex VI list. Enter the container volume and the label is sized to the
                rule that actually applies where you sell — or to the pack of blank labels you already
                own. The PDF is vector at true physical size, so 4 × 2 in prints 4 × 2 in.
              </p>
              <div class="hp-label-jur">
                {JURISDICTION_BRANCHES.map((b) => (
                  <a href={`/ghs-label-maker/${b.slug}/`} class="hp-label-chip">
                    <strong>{b.badge}</strong>
                    <span>{b.cardTitle}</span>
                  </a>
                ))}
              </div>
              <div class="hp-label-links">
                <a href="/ghs-label-maker/" class="hp-card-link">Build a label →</a>
                <a href="/ghs-label-maker/templates/" class="hp-label-alt">Avery &amp; A4 size templates →</a>
              </div>
            </div>
            <div class="hp-label-art">
              <figure>
                <div class="hp-label-paper" set:html={demoLabelSvg} />
                <figcaption>
                  Acetone · CLP Annex VI 606-001-00-8 · OSHA HazCom layout on 4 × 2 in stock.
                  Drawn by the same engine the tool uses.
                </figcaption>
              </figure>
            </div>
          </div>

          {/* ── ЛЕВАЯ КОЛОНКА РЯДА ──────────────────────────────────────────
              Матрица хранения и под ней полоса девяти калькуляторов по
              пиктограммам. Полоса раньше стояла отдельной секцией НИЖЕ вместе с
              рядом из трёх карточек инструментов. Ряд карточек убран (он
              повторял плитки «Also free»), а полоса переехала сюда — и ровно
              она уравновешивает колонки: 720 px слева против 696 px справа. */}
          <div class="hp-flag-col">
            <div class="hp-card-storage">
              <div class="hp-badge-row">
                <span class="hp-badge">Signature tool</span>
                <span class="hp-badge-note">Computed verdicts</span>
              </div>
              <h3 class="hp-card-title">Chemical Storage Compatibility Matrix</h3>
              <p class="hp-card-copy">
                Pick a substance and read the verdict per hazard group: never store together, keep
                separate, or compatible — with the reaction risk named.
              </p>

              <div class="hp-chips" id="sw-chips">
                {
                  storageDemo.map((s, i) => (
                    <button type="button" class={i === 0 ? 'hp-chip active' : 'hp-chip'} data-sub={s.key}>
                      {s.label}
                    </button>
                  ))
                }
              </div>

              {
                storageDemo.map((s, i) => (
                  <div
                    class="hp-verdict-table"
                    id={`sw-${s.key}`}
                    style={i === 0 ? undefined : 'display:none'}
                  >
                    {s.rows.map((r) => (
                      <div class="hp-verdict-row">
                        <p>{r.group}</p>
                        <span
                          class="hp-verdict-pill"
                          style={`background:${verdictStyle[r.v].bg};color:${verdictStyle[r.v].ink}`}
                        >
                          {verdictStyle[r.v].label}
                        </span>
                      </div>
                    ))}
                  </div>
                ))
              }
              <p class="hp-card-footnote">
                Extract from the live matrix — verdicts computed from CLP Annex VI and CAMEO
                reactivity data.
              </p>
              <a href="/tools/chemical-storage-compatibility/" class="hp-card-link">Open the matrix →</a>
            </div>

            <div class="hp-calcs">
              <div class="hp-calcs-head">
                <p class="t">9 per-pictogram calculators</p>
                <p class="d">One per hazard class — enter your data, get the category and label elements.</p>
              </div>
              <div class="hp-calcs-strip">
                {
                  pictogramsRows.map((p) => (
                    <a href={`/ghs/${p.code.toLowerCase()}/`} class="hp-calc-pill">
                      <Fragment set:html={p.svg_content} />
                      {p.code}
                      <span class="sub">{pictoTag[p.code] ?? ''}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="hp-flag-col">
            <div class="hp-card-ate">
              <span class="hp-badge-note" style="color:#0d9488">Classification</span>
              <h3 class="hp-card-title" style="margin-top:10px; font-size:21px">ATE Mixture Calculator</h3>
              <p class="hp-card-copy" style="margin-bottom:16px">
                Acute toxicity estimate for a formulation across oral, dermal and inhalation routes
                under GHS/CLP — with category, H-statements, pictogram and a printable report.
              </p>
              {/* ⚠ Обёртка БЕЗ `flex: 1 1 auto` и без прижатия к низу. Пока
                  карточка тянулась до высоты соседней (`height: 100%`), этот
                  блок забирал всю лишнюю высоту и отодвигал таблицу вниз —
                  отсюда и провал между текстом и таблицей, на который показал
                  Сергей. Высоту колонки теперь добирает блок «Also free». */}
              <div>
                <div class="hp-ate-table">
                  <div class="hp-ate-head"><span>Route</span><span>ATE mix</span><span>Category</span></div>
                  {
                    ateDemo.map((r) => (
                      <div class="hp-ate-row">
                        <p class="route">{r.route}</p>
                        <p class="val">{r.ate}</p>
                        <span class="hp-ate-cat">{r.cat}</span>
                      </div>
                    ))
                  }
                </div>
                <p class="hp-card-footnote">
                  Worked example: methanol 40 % w/w in water — CLP additivity formula, converted
                  point estimates from H301 · H311 · H331. Result: Danger, GHS06.
                </p>
              </div>
              <a href="/tools/ate-mixture-calculator/?mix=67-56-1:40&form=vapour" class="hp-card-link navy">Open the calculator →</a>
            </div>

            {/* ── ALSO FREE ────────────────────────────────────────────────────
                ⚠⚠ ЭТО ВОЗВРАЩЁННЫЙ БЛОК ЭТАЛОНА, А НЕ НОВАЯ ВЫДУМКА. В макете
                Claude Design он стоит ровно здесь — под карточкой ATE, в правой
                колонке ряда флагманов, — и заполняет её до низа. При переносе
                макета в код блок потерялся, колонка осталась короче соседней, и
                разница вылезла пустотой внутри карточки ATE.

                ⚠⚠ GHS LABEL MAKER СЮДА НЕ СТАВИТСЯ. В эталоне он здесь плиткой,
                но у нас он с session 45 — широкий флагман над этим же рядом.
                Поставить его ещё и плиткой значило бы показать один инструмент на
                одном экране дважды. Решение Сергея: флагман остаётся, «Also free»
                возвращается без него.

                ⚠ Плитки печатаются из `otherTools` — того же массива, который
                раньше рисовал ряд карточек ниже. Ряд убран: три карточки и четыре
                плитки об одном и том же на одном экране — это дубль, а не
                перелинковка. Массив остался ОДИН, второго списка нет. */}
            <div class="hp-also">
              <p class="t">Also free</p>
              <div class="hp-also-grid">
                {
                  otherTools.map((t) => (
                    <a href={t.href} class="hp-also-tile">
                      {t.title}
                      <span class="sub">{t.tag}</span>
                    </a>
                  ))
                }
              </div>
              <a href="/tools/" class="all">All 14 tools →</a>
            </div>
          </div>
        </div>
      </div>
    </section>


    <section class="hp-sds" id="sds">
      <div class="wrap">
        <div class="hp-sds-head">
          <div style="max-width:720px">
            <p class="hp-eyebrow">02 · SDS Library</p>
            <h2 class="hp-h2">{sdsLabel} substance reports, each with a storage verdict you won't find in a PDF.</h2>
            <p class="hp-sub">
              Harmonised CLP Annex VI classification with cited sources, EU supplementary hazards,
              ADR transport data — and an honest hand-off to the supplier's official SDS.
            </p>
          </div>
          <a href="/sds/" class="btn-teal">Browse the library →</a>
        </div>

        <div class="hp-sds-table">
          <div class="hp-sds-grid head">
            <span>Substance</span><span>CAS</span><span>Classification</span><span>Storage verdict</span><span>ADR</span>
          </div>
          {
            sdsRows.map((r) => (
              <div class="hp-sds-grid">
                <a href={r.href} class="name">{r.name}</a>
                <span class="cas">{r.cas}</span>
                <span class="cls">{r.cls}</span>
                <span class="verdict">{r.verdict}</span>
                <span class="adr">{r.adr}</span>
              </div>
            ))
          }
        </div>

        <div class="hp-sds-cards">
          <div class="hp-sds-card"><p class="s">§ 02 · Hazards</p><p class="d">Classification and label elements, per source article.</p></div>
          <div class="hp-sds-card"><p class="s">§ 07 · Storage verdict</p><p class="d">Computed segregation, not copied boilerplate.</p></div>
          <div class="hp-sds-card"><p class="s">§ 14 · Transport</p><p class="d">UN number, class, packing group, ADR plates.</p></div>
          <div class="hp-sds-card"><p class="s muted">§ 16 · Limits</p><p class="d">What we don't cover, and where to get it.</p></div>
        </div>
      </div>
    </section>

    <!-- Reference data — added session 19 with the P-statements hub. Deliberately
         un-numbered: the 01/02/03 eyebrows belong to Tools / SDS / Compliance,
         and .hp-others above sets the precedent for a section without a number. -->
    <section class="hp-others" id="reference">
      <div class="wrap">
        <div class="hp-others-head">
          <h3>Reference tables — the data every calculation on this site rests on</h3>
          <a href="/h-statements/" class="hp-link-mono">All H-codes &rarr;</a>
        </div>
        <div class="hp-others-grid">
          {
            referenceCards.map((r) => (
              <a href={r.href} class="hp-tool-card" style={`border-top:3px solid ${r.accent}`}>
                <p class="tag" style={`color:${r.accent}`}>{r.tag}</p>
                <h4>{r.title}</h4>
                <p class="copy">{r.copy}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="hp-compliance" id="compliance">
      <div class="dots" aria-hidden="true"></div>
      <div class="wrap">
        <p class="hp-eyebrow on-dark">03 · Compliance Hub</p>
        <h2 class="hp-h2 on-dark">Seven regulatory pillars, written for the person who has to sign off.</h2>
        <p class="hp-sub on-dark">
          In-depth guides on the frameworks that decide your label, your SDS and your storage plan —
          EU and US, kept current.
        </p>

        <div class="hp-pillars">
          {
            pillars.map((p) => (
              <a href={p.href} class="hp-pillar" style={`border-top-color:${p.accent}`}>
                <p class="n">Pillar {p.n}</p>
                <h3>{p.title}</h3>
                <p class="c">{p.copy}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="hp-roles">
      <div class="wrap">
        <p class="t">Who uses this</p>
        <div class="hp-roles-grid">
          {
            roles.map((r) => (
              <div class="hp-role">
                <p class="who">{r.who}</p>
                <p class="c">{r.copy}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="hp-pictos" id="pictograms">
      <div class="wrap">
        <div class="hp-pictos-head">
          <div style="max-width:720px">
            <p class="hp-eyebrow navy">04 · Pictogram reference</p>
            <h2 class="hp-h2">GHS01–GHS09, free SVGs, and the substance behind each one.</h2>
            <p class="hp-sub">
              The original library, still here: every pictogram with its hazard classes, print notes
              and a free SVG download — cross-linked to 4,178 classified substances.
            </p>
          </div>
          <a href="/substances/" class="btn-outline">Search 4,178 substances →</a>
        </div>

        <div class="hp-picto-grid">
          {
            pictogramsRows.map((p) => (
              <a href={`/ghs/${p.code.toLowerCase()}/`} class="hp-picto-tile">
                <Fragment set:html={p.svg_content} />
                <span class="code">{p.code}</span>
                <span class="nm">{p.name_en}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <NewsletterCtaBand />

    <SiteFooter />

    <script is:inline>
      (function () {
        // ── Storage widget: chip switching (static, pre-rendered tables) ──
        var chips = document.querySelectorAll('#sw-chips .hp-chip')
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) {
              c.classList.remove('active')
            })
            chip.classList.add('active')
            var key = chip.getAttribute('data-sub')
            document.querySelectorAll('.hp-verdict-table').forEach(function (t) {
              t.style.display = t.id === 'sw-' + key ? '' : 'none'
            })
          })
        })
      })()
    </script>
  </body>
</html>
