        border-radius: 4px;
      }
      .hp-card-footnote {
        margin-top: 12px;
        font-size: 12px;
        color: var(--ink-3);
      }
      .hp-card-link {
        display: inline-block;
        margin-top: 18px;
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--teal-700);
      }
      .hp-card-link.navy {
        color: #1e3a8a;
      }
      .hp-card-ate {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: #ffffff;
        padding: 26px;
        box-shadow: 0 2px 6px rgba(15, 23, 41, 0.05);
        transition: all 400ms ease-out;
        /* ⚠⚠ `height: 100%` ОТСЮДА УБРАН. Карточка тянулась до высоты матрицы
           слева, а лишнюю высоту забирал внутренний блок с `justify-content:
           flex-end` — отсюда и провал между текстом и таблицей ATE. Теперь
           высоту колонки добирает блок «Also free» под карточкой. */
      }
      .hp-card-ate:hover {
        transform: translateY(-4px);
        border-color: var(--teal-600);
        box-shadow: 0 18px 34px rgba(15, 23, 41, 0.12);
      }
      .hp-ate-table {
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
      }
      .hp-ate-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 14px;
        background: #f1f5f9;
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-2);
      }
      .hp-ate-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-bottom: 1px solid #f1f5f9;
      }
      .hp-ate-row:last-child {
        border-bottom: 0;
      }
      .hp-ate-row .route {
        font-size: 14px;
        color: var(--ink);
      }
      .hp-ate-row .val {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--ink-2);
      }
      .hp-ate-cat {
        flex: 0 0 auto;
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 5px 8px;
        border-radius: 4px;
        background: #fff1f2;
        color: #9f1239;
      }

      /* ── Other tools band ── */
      .hp-others {
        background: linear-gradient(180deg, #f1f5f9 0%, var(--bg-b) 100%);
        padding: 0 0 clamp(48px, 6vw, 88px);
      }
