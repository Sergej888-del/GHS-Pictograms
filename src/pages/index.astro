---
export const prerender = true
// ghspictograms.com — главная v2 (Claude Design mockup 2026-07-28, data-first hero).
// Дизайн-система: navy #062A78 / teal #0d9488 / orange CTA. Space Grotesk + Inter.
// Данные виджетов выверены по get_storage_verdict + ate.ts (session 11).
import '../styles/global.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import { Fragment } from 'astro/jsx-runtime'
import { supabase } from '../lib/supabase'
import NewsletterCtaBand from '../components/NewsletterCtaBand.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { layoutLabel, renderSvg } from '../lib/labelEngine'
import { JURISDICTION_BRANCHES } from '../lib/labelMakerHub'

/**
 * pictograms_signals: id, code, name_en, svg_content, svg_url
 * (полей pictogram_id / name в таблице нет — см. supabase/schema.sql)
 */
const { data: pictogramsRaw, error: pictogramsError } = await supabase
  .from('pictograms_signals')
  .select('id, code, name_en, svg_url, svg_content')
  .order('code', { ascending: true })
  .limit(9)

if (pictogramsError) {
  console.error('[index] pictograms_signals:', pictogramsError.message)
}

const pictogramsRows = pictogramsRaw ?? []
const ghs02 = pictogramsRows.find((p) => p.code === 'GHS02')

// ── Флагман «GHS Label Maker»: этикетка на карточке НАСТОЯЩАЯ ───────────────
//
// ⚠⚠ SVG НЕ НАРИСОВАН РУКАМИ И НЕ ЛЕЖИТ КАРТИНКОЙ В `public/`. Он считается
// здесь, на сборке, ТЕМ ЖЕ ДВИЖКОМ (`layoutLabel` + `renderSvg`), которым
// инструмент рисует этикетку человеку. Нарисованная руками копия макета устарела
// бы молча: движок бы поменялся, а картинка на главной осталась бы прежней — и
// главная страница сайта обещала бы то, чего инструмент уже не делает.
//
// ⚠ Обе функции чистые: считают в миллиметрах и отдают строку. Ни DOM, ни
// браузерных API — поэтому они выполняются на сборке, а не в остров.
//
// ⚠ Вещество взято из базы, а не выдумано: ацетон, CLP Annex VI 606-001-00-8,
// Danger, GHS02 + GHS07. Реквизиты поставщика — заведомо примерные, с номером из
// зарезервированного для примеров диапазона 555-01xx.
const DEMO_H_CODES = ['H225', 'H319', 'H336']
const DEMO_P_CODES = ['P210', 'P233', 'P280', 'P403']

const [{ data: demoHRows }, { data: demoPRows }] = await Promise.all([
  supabase.from('h_statements').select('code, text_plain').in('code', DEMO_H_CODES),
  supabase.from('p_statements').select('code, text_plain').in('code', DEMO_P_CODES),
])

const demoHText = new Map((demoHRows ?? []).map((r) => [r.code, r.text_plain as string]))
const demoPText = new Map((demoPRows ?? []).map((r) => [r.code, r.text_plain as string]))

const demoLabelSvg = renderSvg(
  layoutLabel(
    {
      productName: 'Acetone',
      casNumber: '67-64-1',
      ecNumber: '200-662-2',
      signalWord: 'Danger',
      pictograms: pictogramsRows
        .filter((p) => p.code === 'GHS02' || p.code === 'GHS07')
        .map((p) => ({ code: p.code, svg: p.svg_content ?? '' })),
      hStatements: DEMO_H_CODES
        .map((c) => ({ code: c, text: demoHText.get(c) ?? '' }))
        .filter((s) => s.text),
      pStatements: DEMO_P_CODES
        .map((c) => ({ code: c, text: demoPText.get(c) ?? '' }))
        .filter((s) => s.text),
      pFormat: 'codes',
      supplier: {
        name: 'Your company name',
        address: '1 Example Street, Springfield IL 62704',
        phone: '+1 555 0100',
      },
    },
    // 4 × 2 in — самый ходовой формат наклейки (Avery 60505/5163 и ещё четыре
    // артикула той же геометрии). Ярус CLP считается от литража тары.
    { jurisdiction: 'osha', purpose: 'supplier', widthMm: 101.6, heightMm: 50.8, containerLitres: 1, containerMl: 1000 },
  ),
)

// SDS library — live page count from the registry (falls back to '109').
const { count: sdsCountRaw } = await supabase
  .from('sds_pages')
  .select('slug', { count: 'exact', head: true })
  .eq('status', 'live')
const sdsLabel = sdsCountRaw ? String(sdsCountRaw) : '109'

// ── Storage widget: real verdicts (get_storage_verdict, verified 2026-07-28).
// Labels = shortForCode() wording from src/lib/storageClasses.ts.
type VerdictKey = 'never' | 'separate' | 'ok'
const storageDemo: { key: string; label: string; rows: { group: string; v: VerdictKey }[] }[] = [
  {
    key: 'acetone',
    label: 'Acetone',
    rows: [
      { group: 'Oxidizers', v: 'never' },
      { group: 'Oxidizing acids', v: 'never' },
      { group: 'Bases', v: 'separate' },
      { group: 'Flammable solids', v: 'ok' },
    ],
  },
  {
    key: 'sulfuric',
    label: 'Sulfuric acid',
    rows: [
      { group: 'Flammable liquids', v: 'never' },
      { group: 'Bases', v: 'never' },
      { group: 'Acute toxics', v: 'separate' },
      { group: 'Oxidizers', v: 'ok' },
    ],
  },
  {
    key: 'peroxide',
    label: 'Hydrogen peroxide',
    rows: [
      { group: 'Flammable liquids', v: 'never' },
      { group: 'Organic acids', v: 'never' },
      { group: 'Bases', v: 'separate' },
      { group: 'Oxidizing acids', v: 'ok' },
    ],
  },
]
const verdictStyle: Record<VerdictKey, { label: string; bg: string; ink: string }> = {
  never: { label: 'Never store', bg: '#fff1f2', ink: '#9f1239' },
  separate: { label: 'Keep separate', bg: '#fffbeb', ink: '#92400e' },
  ok: { label: 'Compatible', bg: '#f0fdfa', ink: '#0f766e' },
}

// ── ATE demo: computed through src/lib/ate.ts (methanol 40 % w/w in water;
// converted point estimates from H301/H311/H331; verified 2026-07-28).
const ateDemo = [
  { route: 'Oral', ate: '250 mg/kg', cat: 'Acute Tox. 3' },
  { route: 'Dermal', ate: '750 mg/kg', cat: 'Acute Tox. 3' },
  { route: 'Inhalation, vapour', ate: '7.5 mg/l', cat: 'Acute Tox. 3' },
]

// ── SDS teaser table: classifications + ADR verified against the DB 2026-07-28.
const sdsRows = [
  {
    href: '/sds/acetone/',
    name: 'Acetone',
    cas: '67-64-1',
    cls: 'Flam. Liq. 2 · Eye Irrit. 2 · STOT SE 3',
    verdict: 'Never with oxidizers',
    adr: 'UN1090 · 3 · II',
  },
  {
    href: '/sds/sulfuric-acid/',
    name: 'Sulfuric acid',
    cas: '7664-93-9',
    cls: 'Skin Corr. 1A',
    verdict: 'Never with bases',
    adr: 'UN1830 · 8 · II',
  },
  {
    href: '/sds/hydrogen-peroxide/',
    name: 'Hydrogen peroxide',
    cas: '7722-84-1',
    cls: 'Ox. Liq. 1 · Acute Tox. 4 · Skin Corr. 1A',
    verdict: 'Never with flammables',
    adr: 'UN2014 · 5.1 · II',
  },
]

// ── The other tools (real routes).
//
// ⚠⚠ ЭТО ПЛИТКИ БЛОКА «ALSO FREE» в правой колонке ряда флагманов. До session 46
// тот же массив рисовал ряд крупных карточек ОТДЕЛЬНОЙ секцией ниже; ряд убран,
// потому что после возвращения «Also free» одни и те же три инструмента стояли
// на одном экране дважды. Массив остался ОДИН — второго списка нет нигде.
//
// ⚠⚠ GHS LABEL MAKER ОТСЮДА УБРАН НАМЕРЕННО (session 45). Он стал флагманом
// выше, и оставить его ещё и здесь значило бы показать один инструмент на
// главной дважды.
// ⚠ Заголовок «All 14 tools →» не трогать: четырнадцать — это счёт по
// `/tools/`, а не по этому массиву.
const otherTools = [
  {
    href: '/pictogram-selector/',
    accent: '#2563eb',
    tag: 'Labelling',
    title: 'Pictogram Selector',
    copy: 'Hazard classes in, correct pictograms out — with CLP Article 26 precedence applied.',
  },
  {
    href: '/un/',
    accent: '#7c3aed',
    tag: 'Transport',
    title: 'UN Number Reference',
    copy: 'ADR 2025 and 49 CFR entries for a UN number side by side, with the label elements of its substances.',
  },
  {
    href: '/pictograms/',
    accent: '#0d9488',
    tag: 'Reference',
    title: 'Substance Database',
    copy: '4,178 CLP Annex VI entries, searchable by name or CAS number.',
  },
]

// ── Reference tables (session 19, H-statements added session 21). H first:
// в Bing кластер H даёт примерно 207 кликов за квартал против трёх у P, и это
// единственный справочник с историей ревизий по каждому коду.
const referenceCards = [
  // ⚠ session 30: хаб классов идёт первым — это верхний этаж иерархии
  // (класс → категория → пиктограмма / H-код / P-коды), от которого зависят
  // остальные три справочника ниже.
  {
    href: '/hazard-classes/',
    accent: '#062a78',
    tag: 'Classification',
    title: 'Hazard classes and categories',
    copy: 'All 33 GHS hazard classes and every CLP category in one table — with the pictogram, signal word, H-code and P-codes each category triggers.',
  },
  {
    href: '/h-statements/',
    accent: '#1e3a8a',
    tag: 'Reference',
    title: 'Hazard statements',
    copy: '108 H-codes and EUH codes with the verbatim regulation wording, the nine-edition UN GHS history of each one, and whether it is still current under EU CLP, OSHA HazCom or UN GHS.',
  },
  {
    href: '/p-statements/',
    accent: '#0d9488',
    tag: 'Reference',
    title: 'Precautionary statements',
    copy: '117 P-codes with the verbatim regulation wording, all 27 combined codes, and whether each one is still current under EU CLP, OSHA HazCom or UN GHS.',
  },
  {
    href: '/pictograms/',
    accent: '#1d4ed8',
    tag: 'Reference',
    title: 'Substance database',
    copy: '4,178 harmonised CLP Annex VI entries, searchable by name or CAS number, with classification and label elements.',
  },
  {
    href: '/storage-compatibility/',
    accent: '#0ea5e9',
    tag: 'Reference',
    title: 'Storage classes',
    copy: '13 segregation classes and the pair-by-pair verdicts behind the compatibility matrix — never together, keep separate, or safe.',
  },
]

// Short hazard tag per pictogram for the calculator pill strip.
const pictoTag: Record<string, string> = {
  GHS01: 'Explosive',
  GHS02: 'Flammable',
  GHS03: 'Oxidizing',
  GHS04: 'Gas',
  GHS05: 'Corrosive',
  GHS06: 'Toxic',
  GHS07: 'Irritant',
  GHS08: 'Health',
  GHS09: 'Environment',
}

// ── Compliance pillars (real routes, order as designed).
const pillars = [
  { href: '/compliance/un-ghs/', accent: '#f97316', n: '01', title: 'UN GHS', copy: 'The purple book, revision by revision, and what each one changed.' },
  { href: '/compliance/osha-hcs/', accent: '#d97706', n: '02', title: 'OSHA HCS', copy: 'US workplace labelling, the 2024 alignment and the deadlines.' },
  { href: '/compliance/clp/', accent: '#2563eb', n: '03', title: 'EU CLP', copy: 'Annex VI entries, Article 26 precedence, supplementary EUH hazards.' },
  { href: '/compliance/sds/', accent: '#0d9488', n: '04', title: 'SDS authoring', copy: 'All 16 sections, what belongs where, common rejection reasons.' },
  { href: '/compliance/ehs/', accent: '#7c3aed', n: '05', title: 'EHS practice', copy: 'Storage classes, segregation plans, workplace exposure records.' },
  { href: '/compliance/reach/', accent: '#e11d48', n: '06', title: 'REACH', copy: 'Registration duties, tonnage bands, downstream user obligations.' },
  { href: '/compliance/svhc/', accent: '#93b4e8', n: '07', title: 'SVHC', copy: 'Candidate list changes, authorisation, communication duties.' },
]

const roles = [
  { who: 'EHS managers', copy: 'Segregation plans and storage-class decisions for the chemical store.' },
  { who: 'Lab managers', copy: 'Fast per-substance checks before a delivery goes on the shelf.' },
  { who: 'Chemists & formulators', copy: 'Mixture classification and the label that follows from it.' },
  { who: 'Transport compliance', copy: 'Workplace GHS against ADR/DOT placards, side by side.' },
]
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleAnalytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GHS Pictograms — Label Maker & Hazard Symbol Library</title>
    <meta
      name="description"
      content="Professional GHS pictogram library and label builder for 4,178 classified substances. CLP Annex VI data, CLP/GHS compliant tools."
    />
    <link rel="canonical" href="https://ghspictograms.com/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    {/*
      ⚠⚠ Главная — СТАНДАЛОН, она не проходит через Layout.astro, и ссылок на
      значки здесь не было ВООБЩЕ. Браузер молча брал /favicon.ico из корня, а
      там полтора года лежал дефолтный значок Astro. То есть самая посещаемая
      страница сайта показывала во вкладке чужой логотип.
      ⚠ Этот блок обязан совпадать с таким же в Layout.astro и в subscribed.astro —
      третья копия, и все три стережёт проверка brand-icons в check:dist.
    */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#062a78" />

    <meta property="og:title" content="GHS Pictograms — Label Maker & Library" />
    <meta
      property="og:description"
      content="Pictogram library and label maker for 4,178 substances. CLP Annex VI."
    />
    <meta property="og:url" content="https://ghspictograms.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://ghspictograms.com/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="GHS Pictograms" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="GHS Pictograms — Label Maker & Library" />
    <meta
      name="twitter:description"
      content="Pictogram library and label maker for 4,178 substances. CLP Annex VI."
    />
    <meta name="twitter:image" content="https://ghspictograms.com/og-default.png" />

    <style is:global>
      /* ── Design tokens (mockup 2026-07-28). Ladders, not single colours. ── */
      :root {
        --font-heading: 'Space Grotesk', system-ui, sans-serif;
        --font-body: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: ui-monospace, Menlo, monospace;
        /* navy family */
        --navy: #062a78;
        --navy-panel: #051f5c;
        --hero-1: #274cb0;
        --hero-2: #1e3a8a;
        --hero-3: #172554;
        --hero-4: #101c40;
        /* light-blue ink ladder on dark (4 steps — keep distinct) */
        --ink-dark-1: #dbe6fb;
        --ink-dark-2: #cddcf5;
        --ink-dark-3: #a8c1ea;
        --ink-dark-4: #93b4e8;
        /* teal ladder */
        --teal-50: #f0fdfa;
        --teal-200: #99f6e4;
        --teal-300: #5eead4;
        --teal-500: #14b8a6;
        --teal-600: #0d9488;
        --teal-700: #0f766e;
        /* slate ink on light */
        --ink: #0f1729;
        --ink-2: #475569;
        --ink-3: #64748b;
        --line: #e2e8f0;
        --line-2: #cbd5e1;
        /* navy-tinted section backgrounds (5 close steps — do not collapse) */
        --bg-a: #eef2f9;
        --bg-b: #e8eef7;
        --bg-c: #dfe7f3;
        --line-b: #cfdaea;
        --line-r: #dbe3ee;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        background: #ffffff;
        font-family: var(--font-body);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
      }
      .hp * {
        box-sizing: border-box;
      }
      .hp p {
        margin: 0;
      }
      .hp h1,
      .hp h2,
      .hp h3,
      .hp h4 {
        margin: 0;
        font-family: var(--font-heading);
        letter-spacing: -0.02em;
      }
      .wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding-left: 24px;
        padding-right: 24px;
      }
      .mono {
        font-family: var(--font-mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 600;
      }
      @keyframes drift {
        0%,
        100% {
          transform: translateY(-10px);
        }
        50% {
          transform: translateY(10px);
        }
      }
      @keyframes dotDrift {
        0%,
        100% {
          transform: translate3d(0, 0, 0);
        }
        50% {
          transform: translate3d(7px, -7px, 0);
        }
      }
      @keyframes dotDriftB {
        0%,
        100% {
          transform: translate3d(0, 0, 0);
        }
        50% {
          transform: translate3d(-9px, 6px, 0);
        }
      }
      @keyframes dotPulse {
        0%,
        100% {
          opacity: 0.55;
        }
        42% {
          opacity: 1;
        }
      }
      @keyframes sheen {
        0%,
        100% {
          opacity: 0.12;
          transform: translateX(-6%);
        }
        50% {
          opacity: 0.4;
          transform: translateX(6%);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .hp * {
          animation: none !important;
        }
      }

      /* ── Hero ── */
      .hp-hero {
        position: relative;
        background: radial-gradient(120% 130% at 12% 0%, var(--hero-1) 0%, var(--hero-2) 38%, var(--hero-3) 72%, var(--hero-4) 100%);
        overflow: hidden;
      }
      .hp-hero .dots-a {
        position: absolute;
        inset: -20px;
        background-image: radial-gradient(rgba(255, 255, 255, 0.34) 1.4px, transparent 1.4px);
        background-size: 22px 22px;
        animation: dotDrift 16s ease-in-out infinite, dotPulse 9s ease-in-out infinite;
        mask-image: linear-gradient(160deg, #000 0%, transparent 78%);
        -webkit-mask-image: linear-gradient(160deg, #000 0%, transparent 78%);
      }
      .hp-hero .dots-b {
        position: absolute;
        inset: -20px;
        background-image: radial-gradient(rgba(94, 234, 212, 0.5) 1.6px, transparent 1.6px);
        background-size: 66px 66px;
        background-position: 12px 8px;
        animation: dotDriftB 23s ease-in-out infinite, dotPulse 13s ease-in-out infinite;
        mask-image: radial-gradient(90% 90% at 70% 20%, #000 0%, transparent 75%);
        -webkit-mask-image: radial-gradient(90% 90% at 70% 20%, #000 0%, transparent 75%);
      }
      .hp-hero .sheen {
        position: absolute;
        inset: 0;
        background: linear-gradient(112deg, transparent 32%, rgba(94, 234, 212, 0.22) 50%, transparent 68%);
        animation: sheen 14s ease-in-out infinite;
      }
      .hp-hero .glow {
        position: absolute;
        left: -140px;
        bottom: -180px;
        width: 520px;
        height: 520px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(13, 148, 136, 0.45) 0%, transparent 70%);
      }
      .hp-hero .float-picto {
        position: absolute;
        right: -40px;
        bottom: -60px;
        width: 320px;
        opacity: 0.13;
        animation: drift 15s ease-in-out infinite;
      }
      .hp-hero .float-picto svg {
        width: 100%;
        height: auto;
        display: block;
      }
      .hp-hero-inner {
        position: relative;
        padding-top: clamp(48px, 7vw, 96px);
        padding-bottom: clamp(40px, 6vw, 80px);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .hp-hero-eyebrow {
        margin-bottom: 20px;
        font-family: var(--font-mono);
        font-size: 11.5px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--teal-300);
      }
      .hp-hero h1 {
        max-width: 880px;
        font-weight: 700;
        font-size: clamp(40px, 7vw, 84px);
        line-height: 1.02;
        letter-spacing: -0.035em;
        color: #ffffff;
        text-wrap: pretty;
      }
      .hp-hero-sub {
        margin: 22px auto 0;
        max-width: 640px;
        font-size: clamp(16px, 1.3vw, 18px);
        line-height: 1.6;
        color: var(--ink-dark-2);
        text-wrap: pretty;
      }
      .hp-hero-ctas {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 32px;
      }
      .btn-orange {
        background: linear-gradient(180deg, #fb923c 0%, #f97316 100%);
        color: #ffffff !important;
        font-size: 15px;
        font-weight: 600;
        padding: 14px 22px;
        border-radius: 8px;
        box-shadow: 0 12px 26px rgba(249, 115, 22, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.28);
        transition: all 300ms ease-out;
        white-space: nowrap;
        display: inline-block;
      }
      .btn-orange:hover {
        background: linear-gradient(180deg, #fb923c 0%, #ea580c 100%);
        transform: translateY(-2px);
        box-shadow: 0 18px 34px rgba(249, 115, 22, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.32);
      }
      .btn-ghost {
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: #ffffff !important;
        font-size: 15px;
        font-weight: 600;
        padding: 14px 22px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
        box-shadow: 0 10px 24px rgba(3, 14, 44, 0.35);
        transition: all 300ms ease-out;
        white-space: nowrap;
        display: inline-block;
      }
      .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.14);
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(3, 14, 44, 0.45);
      }
      .hp-statband {
        position: relative;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(5, 31, 92, 0.6);
      }
      .hp-statband-grid {
        padding-top: 22px;
        padding-bottom: 22px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
      }
      .hp-stat-num {
        font-family: var(--font-heading);
        font-size: 26px;
        font-weight: 700;
        color: #ffffff;
      }
      .hp-stat-num.teal {
