    <script is:inline>
      (function () {
        // ── Header dropdowns + mobile menu ──
        var toolsBtn = document.getElementById('nav-tools-btn')
        var dataBtn = document.getElementById('nav-data-btn')
        var toolsPanel = document.getElementById('nav-tools-panel')
        var dataPanel = document.getElementById('nav-data-panel')
        var mobileBtn = document.getElementById('nav-mobile-btn')
        var mobilePanel = document.getElementById('nav-mobile-panel')

        function closePanels() {
          toolsPanel.classList.remove('open')
          dataPanel.classList.remove('open')
          toolsBtn.setAttribute('aria-expanded', 'false')
          dataBtn.setAttribute('aria-expanded', 'false')
        }
        function toggle(btn, panel, otherBtn) {
          var isOpen = panel.classList.contains('open')
          closePanels()
          if (!isOpen) {
            panel.classList.add('open')
            btn.setAttribute('aria-expanded', 'true')
          }
        }
        toolsBtn.addEventListener('click', function (e) {
          e.stopPropagation()
          toggle(toolsBtn, toolsPanel, dataBtn)
        })
        dataBtn.addEventListener('click', function (e) {
          e.stopPropagation()
          toggle(dataBtn, dataPanel, toolsBtn)
        })
        document.addEventListener('click', function (e) {
          if (!toolsPanel.contains(e.target) && !dataPanel.contains(e.target)) closePanels()
        })
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closePanels()
        })
        mobileBtn.addEventListener('click', function () {
          var open = mobilePanel.classList.toggle('open')
          mobileBtn.setAttribute('aria-expanded', open ? 'true' : 'false')
        })

        // ── Storage widget: chip switching (static, pre-rendered tables) ──
        var chips = document.querySelectorAll('#sw-chips .hp-chip')
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) {
              c.classList.remove('active')
            })
            chip.classList.add('active')
            var key = chip.getAttribute('data-sub')
            document.querySelectorAll('.hp-verdict-table').forEach(function (t) {
              t.style.display = t.id === 'sw-' + key ? '' : 'none'
            })
          })
        })
      })()
    </script>
