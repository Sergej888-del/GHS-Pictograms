      }
      .hp-provenance p {
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--ink-2);
      }

      /* ── Sections ── */
      .hp-eyebrow {
        margin-bottom: 12px;
        font-family: var(--font-mono);
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--teal-600);
      }
      .hp-eyebrow.navy {
        color: #1e3a8a;
      }
      .hp-eyebrow.on-dark {
        color: var(--teal-300);
      }
      .hp-h2 {
        max-width: 720px;
        font-weight: 700;
        font-size: clamp(26px, 3.4vw, 38px);
        line-height: 1.12;
        letter-spacing: -0.03em;
        color: var(--ink);
      }
      .hp-h2.on-dark {
        color: #ffffff;
      }
      .hp-sub {
        margin-top: 14px;
        max-width: 660px;
        font-size: 16.5px;
        line-height: 1.6;
        color: var(--ink-2);
      }
      .hp-sub.on-dark {
        color: var(--ink-dark-2);
      }

      .hp-tools {
        padding: clamp(56px, 8vw, 104px) 0;
        background: linear-gradient(180deg, var(--bg-a) 0%, #f8fafc 55%, #f1f5f9 100%);
      }
      /* ⚠⚠ ДВЕ КОЛОНКИ ЯВНО, А НЕ `auto-fit`. Раньше здесь стояло
         `repeat(auto-fit, minmax(320px, 1fr))`. При ширине содержимого 1 152 px
         (`.wrap` — 1 200 минус поля) в ряд помещаются ТРИ колонки по 320 px, а
         карточек в ряду две: матрица и ATE. Третья колонка оставалась пустой —
         это и есть «внизу пустое место», на которое показал Сергей. Само число
         колонок при этом менялось от ширины окна, поэтому на одних экранах дыра
         была, а на других нет.
         Эталон Claude Design в этом месте — две колонки: слева матрица, справа
         столбец «ATE + Also free». Держим так же и не возвращаемся к `auto-fit`:
         ряд из двух карточек должен быть рядом из двух карточек. */
      .hp-flagships {
        margin-top: 40px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        /* ⚠ `start`, а не растягивание по высоте: обе колонки должны быть
           РОВНО такой высоты, какая у них есть. Именно растягивание и рождало
           пустоту — карточка ATE тянулась до высоты матрицы, а лишнюю высоту
           забирал внутренний блок с `justify-content: flex-end`. Замер после
           правки: 720 px слева и 696 px справа, разница не читается. */
        align-items: start;
      }
      @media (max-width: 900px) {
        .hp-flagships {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      /* Правая колонка ряда: карточка ATE и под ней блок «Also free».
         ⚠ Именно ЭТОТ блок был потерян при переносе макета в код. Без него
         колонка растягивалась по высоте соседней матрицы, а растягивалась она
         за счёт пустоты внутри карточки ATE — между текстом и таблицей. */
      .hp-flag-col {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .hp-also {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: #f8fafc;
        padding: 26px;
      }
      .hp-also .t {
        margin: 0 0 16px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .hp-also-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 10px;
      }
      .hp-also-tile {
        display: block;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #ffffff;
        padding: 12px 14px;
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        transition: all 300ms ease-out;
      }
      .hp-also-tile:hover {
        border-color: #1e3a8a;
        color: #1e3a8a;
      }
      .hp-also-tile .sub {
        display: block;
        margin-top: 3px;
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      /* ⚠ `margin-top: auto` прижимает ссылку к низу карточки — это и есть то,
         чем блок заполняет колонку до конца. */
      .hp-also .all {
        display: inline-block;
        margin-top: auto;
        padding-top: 16px;
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #1e3a8a;
      }
      /* ── Флагман · GHS Label Maker ──────────────────────────────────────
         ⚠⚠ `grid-column: 1 / -1` — карточка занимает ВЕСЬ ряд. Разбор в
         разметке: третья обычная колонка сжала бы соседние до 320 px. */
      .hp-card-label {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 30px;
        align-items: center;
        border: 1px solid #cbd5e1;
        border-radius: 18px;
        background: linear-gradient(135deg, #0f2557 0%, #14336f 46%, #1e3a8a 100%);
        padding: 30px 32px;
        transition: all 400ms ease-out;
      }
      .hp-card-label:hover {
        transform: translateY(-4px);
        border-color: #f97316;
      }
      .hp-card-label .hp-card-title { color: #ffffff; }
      .hp-card-label .hp-card-copy { color: #c8d6f2; margin-bottom: 18px; }
      .hp-badge.orange { background: #f97316; }
      .hp-card-label .hp-badge-note { color: #93b0e8; }
      .hp-label-jur {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 9px;
      }
      .hp-label-chip {
        display: block;
        padding: 10px 12px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.06);
        text-decoration: none;
        transition: all 250ms ease-out;
      }
      .hp-label-chip:hover {
        background: rgba(255, 255, 255, 0.13);
        border-color: #f97316;
      }
      .hp-label-chip strong {
        display: block;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: #93b0e8;
      }
      .hp-label-chip span {
        display: block;
        margin-top: 3px;
        font-size: 13.5px;
        font-weight: 600;
        color: #ffffff;
      }
      .hp-label-links {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 20px;
      }
      .hp-card-label .hp-card-link { color: #ffb277; }
      .hp-label-alt {
        margin-top: 18px;
        font-size: 13.5px;
        color: #c8d6f2;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      /* ⚠ Белая «бумага» под этикеткой обязательна: сама этикетка рисуется
         чёрным по прозрачному, и на тёмной карточке текст исчез бы целиком. */
      .hp-label-paper {
        background: #ffffff;
        border-radius: 8px;
        padding: 12px;
        box-shadow: 0 18px 40px rgba(3, 12, 34, 0.45);
      }
      /* ⚠ Блок стилей на этой странице объявлен `is:global`, поэтому селектор
         обычный. `:global(...)` здесь был бы невалидным CSS и правило молча
         отвалилось бы — а вместе с ним и масштабирование этикетки: SVG выходит
         из движка шириной «101.6mm» и без этого правила вылез бы за карточку.

         ⚠⚠ ПРЯМОЙ ПОТОМОК (`>`), А НЕ ЛЮБОЙ ВЛОЖЕННЫЙ. Пиктограммы внутри
         этикетки — тоже элементы `<svg>`, вложенные в неё, и им движок уже
         проставил width/height в миллиметрах. Правило без `>` перебило бы их на
         `width:100%`, и два ромба размером с всю этикетку легли бы поверх
         текста. Проверено рендером: именно так это и выглядит. */
      .hp-label-paper > svg {
        display: block;
        width: 100%;
        height: auto;
      }
      .hp-label-art figcaption {
        margin-top: 12px;
        font-family: var(--font-mono);
        font-size: 10.5px;
        line-height: 1.5;
        color: #93b0e8;
      }
      .hp-label-art figure { margin: 0; }
      @media (max-width: 900px) {
        .hp-card-label {
          grid-template-columns: minmax(0, 1fr);
          gap: 22px;
          padding: 24px 22px;
        }
      }

      .hp-card-storage {
        border: 1px solid var(--teal-200);
        border-radius: 16px;
        background: linear-gradient(180deg, var(--teal-50) 0%, #ffffff 60%);
        padding: 26px;
        transition: all 400ms ease-out;
      }
      .hp-card-storage:hover {
        transform: translateY(-4px);
        border-color: var(--teal-600);
      }
      .hp-badge-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
      }
      .hp-badge {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: var(--teal-600);
        color: #ffffff;
        padding: 4px 8px;
