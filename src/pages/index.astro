      .hp-stat-label {
        margin-top: 2px;
        font-size: 13px;
        color: var(--ink-dark-3);
      }

      /* ── Provenance strip ── */
      .hp-provenance {
        background: #f1f5f9;
        border-bottom: 1px solid var(--line);
      }
      .hp-provenance-row {
        padding-top: 14px;
        padding-bottom: 14px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
      }
      .hp-provenance .tag {
        font-family: var(--font-mono);
