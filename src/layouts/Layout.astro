---
// Базовый layout для всех страниц ghspictograms.com — design system v2 (session 11).
// Каркас (хедер/футер) вынесен в SiteHeader/SiteFooter — те же компоненты использует
// standalone-главная (src/pages/index.astro). Эко-баннер ghssymbols/ghslabels удалён
// (решение Сергея, session 11). Blog и FAQ живут в футере.
import '../styles/global.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import NewsletterCtaBand from '../components/NewsletterCtaBand.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

interface Props {
  title: string
  description?: string
  canonical?: string
  /** Если true, в <title> используется только `title` без суффикса «| GHS Pictograms» */
  titleIsComplete?: boolean
  /** Абсолютный URL превью для Open Graph / Twitter (по умолчанию og-default.png) */
  image?: string
}

const {
  title,
  description = 'GHS pictograms, label builder and visual chemical safety tools for design, logistics and compliance.',
  canonical,
  titleIsComplete = false,
  image,
} = Astro.props

const pageTitle = titleIsComplete ? title : `${title} | GHS Pictograms`
const ogImage = image ?? 'https://ghspictograms.com/og-default.png'

const siteUrl = 'https://ghspictograms.com'
const base = Astro.site ?? siteUrl

/** Совпадает с финальным URL Cloudflare (trailing slash) — иначе Ahrefs: «canonical → redirect». */
function ensureTrailingSlashUrl(href: string): string {
  const u = new URL(href)
  if (u.pathname !== '/' && !u.pathname.endsWith('/')) {
    u.pathname += '/'
  }
  return u.href
}

const rawPath = Astro.url.pathname
const pathWithSlash = rawPath.endsWith('/') ? rawPath : rawPath + '/'
const canonicalURL = canonical
  ? ensureTrailingSlashUrl(canonical)
  : new URL(pathWithSlash, base).href

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <GoogleAnalytics />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    {/* Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    {/*
      Значки (session 37). ⚠⚠ До этой правки здесь стояла ОДНА строка про
      favicon.svg, а public/favicon.ico оставался дефолтным логотипом Astro —
      чёрный квадрат с ракетой. Именно он показывался во вкладке браузера, в
      закладках и на панели задач. Проверку держит группа Brand в check:dist.

      ⚠ Порядок важен: браузер берёт ПЕРВЫЙ формат, который понимает. SVG первым,
      он масштабируется. .ico запасной, и в нём ТРИ кадра (16, 32, 48), где кадр
      16 нарисован по пиксельной сетке, а не сжат из 32: при сжатии полосы знака
      попадают на половину пикселя и замыливаются антиалиасингом.
    */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    {/* ⚠ apple-touch-icon обязан быть НЕПРОЗРАЧНЫМ во весь квадрат: iOS кладёт
         своё скругление поверх и подставляет под прозрачность чёрный. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#062a78" />

    {/*
      Open Graph. ⚠⚠ og-default.png до session 37 был ПРОЗРАЧНЫМ ПИКСЕЛЕМ 1 × 1
      на 70 байт: каждое превью ссылки в Slack, LinkedIn, Telegram и Facebook
      выходило пустым. Размер обязателен 1200 × 630, иначе часть площадок
      обрежет или откажется показывать.
    */}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="GHS Pictograms" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <div style="background:#f1f5f9;border-bottom:1px solid #e2e8f0;">
      <div style="max-width:1200px;margin:0 auto;padding:8px 24px;display:flex;flex-wrap:wrap;align-items:center;gap:10px;">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:10.5px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#0d9488;">Provenance</span>
        <p style="margin:0;font-size:13px;line-height:1.5;color:#475569;">
          Reference data from EU CLP Annex VI and published regulations — verify against your supplier's SDS before use.
        </p>
      </div>
    </div>

    <SiteHeader />

    <main>
      <slot />
    </main>

    <NewsletterCtaBand />
    <SiteFooter />
  </body>
</html>
