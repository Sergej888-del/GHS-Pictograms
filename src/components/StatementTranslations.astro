---
// src/components/StatementTranslations.astro
//
// Секция «фраза на 24 языках ЕС» на страницах H- и P-кодов.
//
// ⚠⚠ ЭТО НЕ ПЕРЕВОД, А ЦИТАТА. Каждая строка — официальная формулировка из
// языковой версии консолидированного CLP, и в этом весь смысл: на этикетке,
// уходящей в Германию, обязан стоять текст немецкой редакции регламента, а не
// хороший перевод английского. Поэтому здесь нет ни одной строки, которую
// сочинили бы мы, и поэтому же у кодов без официального текста стоит
// ОБЪЯСНЕНИЕ, а не пустое место (см. `src/lib/statementTranslations.ts`).
//
// ⚠ Атрибут `lang` на ячейке с текстом — не украшение: без него экранный
// диктор читает немецкую фразу английской фонетикой, а поисковик не понимает,
// что на странице делает чужой язык. WCAG 2.2, 3.1.2 «Language of Parts».
import { orderedTranslations, type MissingReason, type TranslationRow } from '../lib/statementTranslations';
import { EURLEX_ATTRIBUTION } from '../lib/labelLanguages';

interface Props {
  code: string;
  /** Строки `statement_translations` для этого кода. Пусто — покажем причину. */
  rows: TranslationRow[];
  /** Почему их нет. Обязателен, когда `rows` пуст. */
  reason?: MissingReason;
  /** `III` · `IV` · `II` — для подписи источника. */
  annex: string;
  /** Номер секции на странице: `02` и т. п. */
  sectionNo: string;
}

const { code, rows, reason, annex, sectionNo } = Astro.props;
const lines = orderedTranslations(rows);
// ⚠ Ссылка на источник берётся из данных, а не набирается: у разных импортов
// разные редакции CELEX, и подпись обязана называть ту, что реально в базе.
const sourceRef = rows.find((r) => r.source_ref)?.source_ref ?? null;
---

<section class="hub-sec-white">
  <div class="hub-wrap">
    <p class="hub-eyebrow">{sectionNo} · Languages</p>
    <h2 class="hub-h2">{code} in the 24 official EU languages</h2>

    {lines.length > 0 ? (
      <>
        <p class="hub-sub">
          A label put on the market in an EU country must carry the wording of that country's own
          language version of CLP — not a translation of the English one. These {lines.length} lines are
          quoted from the consolidated regulation, Annex {annex}, and are the text to print.
        </p>

        <div class="hub-table-wrap">
          <table class="hub-table stx">
            <thead>
              <tr><th>Language</th><th>Official wording of {code}</th></tr>
            </thead>
            <tbody>
              {lines.map((l) => (
                <tr>
                  <td class="c-code">
                    <span class="cmb">{l.language.code}</span>
                    <span class="stx-name">{l.language.native}</span>
                    <span class="stx-en">{l.language.name}</span>
                  </td>
                  <td class="c-txt" lang={l.language.code.toLowerCase()}>{l.text}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="hub-fine">
          {sourceRef ? <>Source: {sourceRef}, Annex {annex}. </> : <>Source: consolidated CLP, Annex {annex}. </>}
          {EURLEX_ATTRIBUTION}
          {' '}Irish is one of the 24 official languages and its H and P texts are printed inside the
          multilingual Annex tables, but no consolidated CLP has ever been published in Irish — which is
          why an Irish-primary label cannot be built here.
        </p>
      </>
    ) : (
      <>
        {/* ⚠⚠ Секция не исчезает. Отсутствие текста — это ответ, и чаще всего
            ответ не про нас, а про регламент. */}
        <p class="hub-sub">{reason?.headline}</p>
        <div class="hub-panel">
          <div class="hub-panel-row">
            <span class="hub-panel-label">{reason?.ours ? 'Our gap' : 'Why'}</span>
            <p class="juris-note" style="margin:0;flex:1 1 320px">{reason?.body}</p>
          </div>
        </div>
      </>
    )}
  </div>
</section>
