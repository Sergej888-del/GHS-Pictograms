---
// DirectoryCard — одна запись каталога (№148, s92). Одна разметка для страницы категории и
// страницы записи: на категории подробности свёрнуты в нативный <details> (текст остаётся в HTML —
// урок s81: всё, что за состоянием React, краулер не видит), на странице записи — раскрыты.
//
// ⚠ ПРАВИЛА §18.2, которые держит эта разметка:
//   • ни звёзд, ни оценок, ни «best for» — только факты, у каждой строки ссылка «source»;
//   • <img> — только логотип от владельца при tier ≥ claimed и скриншот при featured (правило 2, s96;
//     сторож dir-images): у listed-записи картинок нет вовсе;
//   • цены и цитаты — только `printable()` (подтверждённые check-directory); цитата об ответственности —
//     к тому же только из юридического документа (`source_kind`, s93), и под ней написано, из какого;
//   • партнёрство раскрыто бейджем и строкой, партнёрская ссылка — sponsored nofollow noopener,
//     и рядом ссылка на /affiliate-disclosure/ (сторож affiliate-marking требует её на странице);
//   • внешняя ссылка listed-записи — nofollow (владелец не подтверждён); claimed — обычная ссылка
//     (бесплатный стимул заявить запись); featured — sponsored (оплачено — так требует Google).
//
// ⭐ s96 — ГРАНИЦА БЕСПЛАТНОГО И ПЛАТНОГО (tiers-doc s95 §2, `ownerProfileShown`): claimed бесплатно получает
//   «Verified by owner · дата», логотип, своё описание ≤ 60 слов, ссылки Pricing/Terms как источники; только
//   featured — скриншот, кнопку «Contact vendor» (placement `contact`, rel sponsored). Уровень берётся из
//   `effectiveTier`: истёкший featured печатается как claimed сам, без правки базы.
// ⭐ s96 — в дополнительной категории (`also_in`, подтверждённое основание) та же карточка печатается со
//   строкой «Also listed under <основная>»; страница записи одна, под основной категорией.
import {
  type CardModel, AFFILIATE_NOTE, ALSO_IN_NOTE, CLAIMED_NOTE, LISTED_NOTE, LOGO_BASE, SCREENSHOT_BASE, OWNER_FACT_NOTE,
  JURISDICTION_SHORT, SOURCE_KIND_LABEL, TAG_LABEL, categoryBySlug, categoryHref, countryName, effectiveTier, entryHref,
  first, formatDate, jurisdictionsOf, outboundLink, ownerProfileShown, ownerStated,
} from '../lib/directoryModel'

interface Props {
  card: CardModel
  variant: 'compact' | 'full'
  /** Копия в блоке Sponsored: свой id и пометка, чтобы не дублировать якорь редакционной карточки. */
  sponsored?: boolean
  /** Слуг категории, на странице которой карточка стоит; если это не основная категория записи — пометка. */
  inCategory?: string
}
const { card, variant, sponsored = false, inCategory } = Astro.props
const e = card.entry
const f = card.facts
const closed = e.state === 'closed'
const tier = effectiveTier(e)
const shown = ownerProfileShown(tier)
const primary = inCategory && inCategory !== e.category ? categoryBySlug(e.category) : undefined
const logo = shown.logo && e.logo_path ? `${LOGO_BASE}${e.logo_path}` : null
const ownerDesc = shown.description && e.owner_description ? e.owner_description : null
const ownerLinks = shown.links ? ([['Pricing', e.pricing_url], ['Terms', e.terms_url]] as const).filter(([, u]) => !!u) : []
const screenshot = shown.screenshot && e.screenshot_path ? `${SCREENSHOT_BASE}${e.screenshot_path}` : null
const contact = shown.contact && e.contact_url ? e.contact_url : null
const ownerConfirmed = tier !== 'listed' ? formatDate(e.owner_confirmed_on ?? e.claimed_on) : ''
const country = countryName(e.hq_country)
const juris = jurisdictionsOf(card)
const lang = first(card, 'language')
const deployment = first(card, 'deployment')
const pricingModel = first(card, 'pricing_model')
const pricingStatement = first(card, 'pricing_statement')
const trial = first(card, 'free_trial')
const api = first(card, 'api')
const ufi = first(card, 'ufi_pcn')
const iso17100 = first(card, 'iso17100')
const claim = first(card, 'jurisdiction_claim')
const features = f.feature ?? []
const certs = f.certification ?? []
const integrations = f.integration ?? []
const platforms = f.platform ?? []
const notes = (f.pricing_note ?? []).filter((n) => n.confirmed === true)

// ⚠ Решение Сергея s92 (05.10): ссылка на вендора — nofollow у всех, заявленных тоже («пока оставляем
// nofollow»). Стимул заявить — «Verified by owner» и место наверху раздела, не вес ссылки.
// Сторож dir-entry-pages требует nofollow у каждой ссылки «Vendor website». Логика — outboundLink().
// ⭐ s93: кнопка на вендора стоит в ШАПКЕ карточки, не мелкой ссылкой в подвале — каталогу нужны клики
// (решение Сергея), и клик по вендору — цифра для письма «we sent you N visitors». `data-dir-place`
// говорит GA4, где был клик: card (список категории) или entry (страница записи).
const out = outboundLink(e)
const place = variant === 'full' ? 'entry' : 'card'
const src = 'nofollow noopener'
const verified = formatDate(e.last_verified)
const respLabel: Record<string, string> = {
  customer_responsible: 'Customer responsibility',
  compliance_guarantee: 'Compliance and accuracy',
  liability_cap: 'Liability',
  insurance: 'Insurance',
  data_disclaimer: 'Data disclaimer',
}
// Цитата, оборванная посреди фразы, получает «…» — иначе читатель примет обрыв за конец условия.
// ⚠ Логика здесь, а не в разметке: вложенный шаблон с обратными кавычками внутри map() Astro
// компилирует неверно (s92 — страница отдавала 500).
function quoteText(q: string | null): string {
  const t = (q ?? '').trim()
  return /[.!?;:)\u201d"']$/.test(t) ? t : t + '\u2026'
}
// ⚠ Пометка о юрисдикциях — не всегда дословная цитата вендора (часто перечень стран со страницы),
// поэтому без кавычек. «(no count stated)» — наша служебная оговорка, читателю она не нужна.
const claimText = claim ? claim.value.replace(/^named:\s*/i, 'Countries named: ') : null
const langText = lang ? lang.value.replace(/\s*\(no count stated\)/i, '') : null
const closedBadge = e.closed_on ? 'Closed ' + formatDate(e.closed_on) : 'Closed'
const jurisData = juris.map((j) => (JURISDICTION_SHORT[j] ?? j).toLowerCase().replace(/\s+/g, '-')).join(' ')
const searchBlob = [e.title, e.vendor, country, e.description, ...juris, ...features.map((x) => x.value)]
  .filter(Boolean)
  .join(' | ')
  .toLowerCase()
const hasDetails =
  card.prices.length > 0 || card.pricesPending || features.length > 0 || card.responsibility.length > 0 ||
  card.termsUrl || certs.length > 0 || integrations.length > 0 || platforms.length > 0
---

<article
  class={`dir-card${closed ? ' is-closed' : ''}${tier !== 'listed' ? ' is-claimed' : ''}${tier === 'featured' ? ' is-featured' : ''}`}
  id={`${sponsored ? 's' : 'e'}-${e.slug}`}
  data-dir-entry={sponsored ? undefined : e.id}
  data-dir-sponsored-card={sponsored ? e.id : undefined}
  data-dir-title={e.title}
  data-dir-tier={tier}
  data-dir-also-in={primary ? e.category : undefined}
  data-juris={jurisData}
  data-country={e.hq_country ?? ''}
  data-search={searchBlob}
>
  <header class="dir-card-head">
    <div class="dir-card-name">
      {logo && (
        <span class="dir-logo">
          <img src={logo} alt={`${e.title} logo`} width="48" height="48" loading="lazy" decoding="async" data-dir-logo={e.slug} />
        </span>
      )}
      <div>
        <h3>
          {variant === 'compact' ? <a href={entryHref(e)}>{e.title}</a> : e.title}
        </h3>
        <p class="dir-vendor">
          {e.vendor && <span>{e.vendor}</span>}
          {country && (
            <span class="dir-country">
              {country}
              {e.hq_country_source && (
                <a class="dir-src" href={e.hq_country_source} rel={src} target="_blank" title="Where we read the company address">source</a>
              )}
            </span>
          )}
          {ownerLinks.length > 0 && (
            <span class="dir-owner-links" data-dir-owner-links>
              {ownerLinks.map(([label, u]) => <a href={u!} rel={src} target="_blank" title={`${label} page, as given by the owner`}>{label}</a>)}
            </span>
          )}
        </p>
      </div>
    </div>
    <div class="dir-badges">
      {closed && <span class="dir-badge closed">{closedBadge}</span>}
      {tier !== 'listed' && <span class="dir-badge claimed" data-dir-claimed={e.owner_confirmed_on ?? e.claimed_on ?? ''}>Verified by owner · {ownerConfirmed}</span>}
      {e.affiliate && <span class="dir-badge aff" data-dir-affiliate={e.affiliate}>Affiliate partner</span>}
      {e.tags.map((t) => TAG_LABEL[t] && <span class="dir-badge tag">{TAG_LABEL[t]}</span>)}
      {contact && (
        <a class="dir-out dir-out-btn ghost" href={contact} rel="sponsored nofollow noopener" target="_blank" data-dir-out={e.slug} data-dir-cat={e.category} data-dir-tier={tier} data-dir-place="contact" data-dir-contact>Contact vendor ↗</a>
      )}
      {out && (
        <a class="dir-out dir-out-btn" href={out.href} rel={out.rel} target="_blank" data-dir-out={e.slug} data-dir-cat={e.category} data-dir-tier={tier} data-dir-place={place}>Vendor website ↗</a>
      )}
    </div>
  </header>

  {primary && (
    <p class="dir-also" data-dir-also-note>
      {ALSO_IN_NOTE} <a href={categoryHref(primary.slug)}>{primary.short}</a> — its main section; this card is the same listing.
    </p>
  )}

  <p class="dir-desc">
    {e.description}
    {e.description_source && (
      <a class="dir-src" href={e.description_source} rel={src} target="_blank" title="Where this description comes from">source</a>
    )}
  </p>

  {ownerDesc && (
    <p class="dir-owner-desc" data-dir-owner-desc>
      <span class="dir-owner-lbl">In the vendor’s words</span>
      {ownerDesc}
    </p>
  )}

  {screenshot && (
    <figure class="dir-shot" data-dir-screenshot>
      <img src={screenshot} alt={`${e.title} — product screenshot supplied by the vendor`} width="1200" height="675" loading="lazy" decoding="async" />
      <figcaption>Screenshot supplied by the vendor.</figcaption>
    </figure>
  )}

  {closed && (
    <dl class="dir-facts">
      {e.closed_on && (
        <div><dt>Closed</dt><dd>{formatDate(e.closed_on)}{e.closed_source && <a class="dir-src" href={e.closed_source} rel={src} target="_blank">source</a>}</dd></div>
      )}
      {e.successor && <div><dt>Where it went</dt><dd>{e.successor}</dd></div>}
      {e.url && <div><dt>Old address</dt><dd class="dir-mono">{e.url.replace(/^https?:\/\//, '')}</dd></div>}
    </dl>
  )}

  {!closed && (
    <dl class="dir-facts">
      <div>
        <dt>Covers</dt>
        <dd>
          {juris.length ? juris.join(' · ') : <span class="dir-none">not stated by the vendor</span>}
          {juris.length > 0 && f.jurisdiction?.[0] && <a class="dir-src" href={f.jurisdiction[0].source_url} rel={src} target="_blank">source</a>}
          {claimText && <span class="dir-claim">{claimText}</span>}
        </dd>
      </div>
      <div>
        <dt>Languages</dt>
        <dd>
          {lang ? langText : <span class="dir-none">not stated</span>}
          {lang && <a class="dir-src" href={lang.source_url} rel={src} target="_blank">source</a>}
        </dd>
      </div>
      <div>
        <dt>Pricing</dt>
        <dd>
          {pricingModel ? pricingModel.value : <span class="dir-none">not stated</span>}
          {card.fromPrice && <span class="dir-from"> · from {card.fromPrice}</span>}
          {pricingModel && <a class="dir-src" href={pricingModel.source_url} rel={src} target="_blank">source</a>}
        </dd>
      </div>
      {deployment && (
        <div><dt>Delivered as</dt><dd>{deployment.value}<a class="dir-src" href={deployment.source_url} rel={src} target="_blank">source</a></dd></div>
      )}
      {(trial || api || ufi || iso17100) && (
        <div>
          <dt>Also</dt>
          <dd class="dir-flags">
            {trial && <span>Free trial or free account<a class="dir-src" href={trial.source_url} rel={src} target="_blank">source</a></span>}
            {api && <span>API<a class="dir-src" href={api.source_url} rel={src} target="_blank">source</a></span>}
            {ufi && <span>UFI / poison centre notification<a class="dir-src" href={ufi.source_url} rel={src} target="_blank">source</a></span>}
            {iso17100 && <span>ISO 17100 certified<a class="dir-src" href={iso17100.source_url} rel={src} target="_blank">source</a></span>}
          </dd>
        </div>
      )}
    </dl>
  )}

  {!closed && hasDetails && (
    <details class="dir-more" open={variant === 'full'}>
      <summary>Prices, features and terms</summary>

      <section class="dir-block">
        <h4>Prices</h4>
        {card.prices.length > 0 && (
          <ul class="dir-prices">
            {card.prices.map((p) => (
              <li data-fact="price" data-fid={p.id} data-dir-owner-fact={ownerStated(p) ? '' : undefined}>
                {p.label && <span class="tier">{p.label}</span>}
                <span class="amt">{p.value}</span>
                {p.detail && <span class="inc">{p.detail}</span>}
                {ownerStated(p) && <span class="dir-stated">{OWNER_FACT_NOTE}</span>}
              </li>
            ))}
          </ul>
        )}
        {notes.map((n) => <p class="dir-fine" data-fact="pricing_note" data-fid={n.id}>{n.value}</p>)}
        {card.prices.length > 0 && (
          <p class="dir-fine">
            As published by the vendor, checked {formatDate(card.prices[0].confirmed_on ?? card.prices[0].checked_on)}.
            Prices change — the vendor’s page is the reference:
            <a href={card.prices[0].source_url} rel={src} target="_blank">pricing page</a>.
          </p>
        )}
        {card.pricesPartial && (
          <p class="dir-fine" data-dir-pending="price-partial">
            The vendor publishes more tiers than shown here; we print only the figures our re-check found on its page.
          </p>
        )}
        {card.pricesPending && (
          <p class="dir-fine" data-dir-pending="price">
            The vendor publishes prices on its own site. We print a price only after re-reading it on that page; until
            then, see the <a href={(f.price ?? [])[0]?.source_url} rel={src} target="_blank">vendor’s pricing page</a>.
          </p>
        )}
        {card.prices.length === 0 && !card.pricesPending && pricingStatement && (
          <p class="dir-fine">
            Price on request — the vendor publishes no prices on its site (checked {formatDate(pricingStatement.checked_on)}).
            <a class="dir-src" href={pricingStatement.source_url} rel={src} target="_blank">source</a>
          </p>
        )}
      </section>

      {features.length > 0 && (
        <section class="dir-block">
          <h4>What it does, according to the vendor</h4>
          <ul class="dir-features">
            {features.map((x) => (
              <li data-dir-owner-fact={ownerStated(x) ? '' : undefined} data-dir-basis={x.basis_for ?? undefined}>
                {x.value}<a class="dir-src" href={x.source_url} rel={src} target="_blank">source</a>
                {ownerStated(x) && <span class="dir-stated">{OWNER_FACT_NOTE}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {(certs.length > 0 || integrations.length > 0 || platforms.length > 0) && (
        <section class="dir-block">
          <dl class="dir-facts tight">
            {certs.length > 0 && (
              <div><dt>Certifications</dt><dd>{certs.map((c) => <span class="dir-chip">{c.value}<a class="dir-src" href={c.source_url} rel={src} target="_blank">source</a></span>)}</dd></div>
            )}
            {integrations.length > 0 && (
              <div><dt>Integrations</dt><dd>{integrations.map((c) => c.value).join(' · ')}<a class="dir-src" href={integrations[0].source_url} rel={src} target="_blank">source</a></dd></div>
            )}
            {platforms.length > 0 && (
              <div><dt>Platforms</dt><dd>{platforms.map((c) => c.value).join(' · ')}<a class="dir-src" href={platforms[0].source_url} rel={src} target="_blank">source</a></dd></div>
            )}
          </dl>
        </section>
      )}

      {(card.responsibility.length > 0 || card.termsUrl) && (
        <section class="dir-block dir-resp">
          <h4>What the vendor says it is responsible for</h4>
          {card.responsibility.map((r) => (
            <figure data-fact="responsibility" data-fid={r.id} data-src-kind={r.source_kind ?? ''}>
              <figcaption>{respLabel[r.label ?? ''] ?? r.value}</figcaption>
              <blockquote>“{quoteText(r.quote)}”</blockquote>
              <p class="dir-resp-src">
                <a class="dir-src" href={r.source_url} rel={src} target="_blank">source</a>
                <span class="dir-resp-kind">{r.source_kind ? SOURCE_KIND_LABEL[r.source_kind] : ''}</span>
              </p>
            </figure>
          ))}
          {card.responsibility.length === 0 && card.termsUrl && (
            <p class="dir-fine" data-dir-pending="responsibility">
              We quote a vendor’s terms only after re-reading the exact words on its page; until then, read them at the
              source: <a href={card.termsUrl} rel={src} target="_blank">vendor terms</a>.
            </p>
          )}
          <p class="dir-fine">
            Quoted only from the vendor’s own legal documents — terms, licence, legal notice or a published policy — never
            from its blog, help pages or marketing.
          </p>
        </section>
      )}
    </details>
  )}

  {e.affiliate && (
    <p class="dir-aff-note">
      {AFFILIATE_NOTE[e.affiliate]} It does not change where this card appears.
      <a href="/affiliate-disclosure/">Affiliate disclosure</a>
    </p>
  )}

  <footer class="dir-card-foot">
    <span class="dir-status">
      {tier === 'listed' ? LISTED_NOTE : CLAIMED_NOTE}
      {tier !== 'listed' && ownerConfirmed && ` Owner confirmed on ${ownerConfirmed}.`}
      {' '}Last verified {verified}.
    </span>
    <span class="dir-links">
      {variant === 'compact' && <a href={entryHref(e)}>Details · claim or correct</a>}
      {variant === 'full' && e.state === 'live' && <a href="#claim">{tier === 'listed' ? 'Claim or correct this listing' : 'Report a correction'}</a>}
    </span>
  </footer>
</article>
