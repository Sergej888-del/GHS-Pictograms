---
// DirectoryListing — таблица сравнения, фильтры, блок Sponsored и карточки (№148, s96).
//
// Одна разметка для страницы категории (/directory/<category>/) и страницы подраздела услуг
// (/directory/authoring-services-consultants/<sub>/): вынесена из [category]/index.astro в s96, когда появились
// подразделы — вторая копия таблицы и скрипта фильтров разошлась бы молча.
//
// ⚠ Порядок карточек и строк — тот, в котором пришли `cards` (orderEntries у вызывающей страницы). Таблица и
//   карточки идут в ОДНОМ порядке; сторож dir-order проверяет его по data-dir-row / data-dir-entry.
// ⚠ Фраза о порядке (ORDER_NOTE) печатается здесь дословно — сторож dir-order ищет её на каждой странице списка.
// ⚠ Фильтры — на клиенте, только прячут строки; без JS видно всё. Панель — DirectoryFilters, скрипт — directoryFilterClient (s108).
// ⚠ `inCategory` — слуг категории страницы: карточка записи из другой основной категории (`also_in`) получает
//   пометку «Also listed under …» (DirectoryCard).
import DirectoryCard from './DirectoryCard.astro'
import DirectoryFilters from './DirectoryFilters.astro'
import {
  type CardModel, JURISDICTION_ORDER, JURISDICTION_SHORT, ORDER_NOTE, countryName, effectiveTier, first, hqTokensOf, jurisdictionsOf,
  languageShort, opsTokensOf, outboundLink, formatDate, serviceFilterOptions, serviceSearchWords, serviceTokensOf
} from '../lib/directoryModel'
import { geoFilterOptions, geoProblems, geoSearchWords } from '../lib/directoryGeo'

export interface ListingGroup {
  id: string
  title: string
  /** Чем группа отличается — под заголовком (подразделы услуг). */
  rule?: string
  /** Своя страница группы, если есть. */
  href?: string
  cards: CardModel[]
}

interface Props {
  /** Все карточки страницы в редакционном порядке (таблица). */
  cards: CardModel[]
  sponsoredCards: CardModel[]
  /** Карточки по группам (у обычной категории — одна группа без заголовка). */
  groups: ListingGroup[]
  isClosed: boolean
  inCategory: string
  /** Нумерация секций страницы: «01 · Compare» / «02 · Every listing». */
  compareNo?: string
  listNo?: string
}
const { cards, sponsoredCards, groups, isClosed, inCategory, compareNo = '01', listNo = '02' } = Astro.props
const n = cards.length
const juris = (c: CardModel) => jurisdictionsOf(c).map((j) => (JURISDICTION_SHORT[j] ?? j).toLowerCase().replace(/\s+/g, '-')).join(' ')
// s108 (A1): фильтры «Based in» (страна → субрегион → континент) и «Operates in» (подтверждённые рынки вендора).
// Опции строятся из того, что есть на этой странице; число в скобках — сколько строк останется при выборе.
// ⚠ Неизвестный код страны роняет сборку: иначе запись молча выпала бы из фильтра (таблица — directoryGeo.GEO).
const geoBad = geoProblems(cards.map((c) => c.entry.hq_country), (cards.flatMap((c) => c.facts.market ?? [])).map((f) => f.detail))
if (geoBad.length) throw new Error(`directory: ${geoBad.join('; ')}`)
const hqOf = cards.map((c) => hqTokensOf(c.entry))
const opsOf = cards.map((c) => opsTokensOf(c))
// Опции — directoryGeo.geoFilterOptions; «Operates in»: вендор с `ww` («worldwide») остаётся при выборе любой страны.
const hqOpts = geoFilterOptions(hqOf, false)
const opsOpts = geoFilterOptions(opsOf, true)
const opsStated = opsOf.filter((t) => t.length > 0).length
// s109 (A2.2): «Service» and «Regime» come from confirmed service_scope facts; no field when nobody on the page states a service.
const svcOf = cards.map((c) => serviceTokensOf(c))
const svcOpts = serviceFilterOptions(svcOf)
const svcStated = svcOf.filter((t) => t.length > 0).length
const jurisPresent = JURISDICTION_ORDER.filter((j) => cards.some((c) => jurisdictionsOf(c).includes(j)))
---

{!isClosed && (
  <section class="hub-sec-a">
    <div class="hub-wrap">
      <p class="hub-eyebrow">{compareNo} · Compare</p>
      <h2 class="hub-h2">{n} listings side by side</h2>
      <p class="hub-sub">
        <span data-dir-order-note>{ORDER_NOTE}</span> Each column comes from the vendor’s own pages; click a name for
        the full card with the source of every line, or go straight to the vendor’s site from the last column.
      </p>

      <DirectoryFilters total={n} hq={hqOpts} ops={opsOpts} opsStated={opsStated} jurisdictions={jurisPresent} services={svcOpts.services} regimes={svcOpts.regimes} svcStated={svcStated} />
      <p class="hub-fine dir-all-link">
        Looking for a vendor in a country across every section?
        <a href="/directory/all/" data-dir-all-link>Filter all listings by country →</a>
      </p>

      <div class="dir-table-wrap">
        <table class="dir-table" data-dir-table>
          <thead>
            <tr>
              <th>Name</th><th>Based in</th><th>Covers</th><th>Languages</th><th>Pricing</th><th>Delivered as</th><th>Trial</th><th>API</th><th>Website</th>
            </tr>
          </thead>
          <tbody>
            {cards.map((c) => {
              const e = c.entry
              const jl = jurisdictionsOf(c)
              const model = first(c, 'pricing_model')
              const dep = first(c, 'deployment')
              const out = outboundLink(e)
              const alsoIn = e.category !== inCategory
              return (
                <tr
                  class={effectiveTier(e) !== 'listed' ? 'is-verified' : undefined}
                  data-dir-row={e.id}
                  data-dir-title={e.title}
                  data-dir-tier={effectiveTier(e)}
                  data-juris={juris(c)}
                  data-country={e.hq_country ?? ''}
                  data-geo={hqOf[cards.indexOf(c)].join(' ')}
                  data-ops={opsOf[cards.indexOf(c)].join(' ')}
                  data-svc={svcOf[cards.indexOf(c)].join(' ')}
                  data-search={[e.title, e.vendor, countryName(e.hq_country), ...geoSearchWords(e.hq_country), e.description, ...serviceSearchWords(c)].filter(Boolean).join(' | ').toLowerCase()}
                >
                  <td class="c-name">
                    <a href={`#e-${e.slug}`}>{e.title}</a>
                    {effectiveTier(e) !== 'listed' && (
                      <span class="dir-verified-mini" data-dir-verified-mini={e.slug} title={`Verified by owner · ${formatDate(e.owner_confirmed_on ?? e.claimed_on)}`}><svg class="dir-check" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="8" fill="#ffffff" /><path d="M4.4 8.4l2.3 2.3 4.9-5.1" fill="none" stroke="#d97706" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" /></svg>Verified</span>
                    )}
                    {e.vendor && <span class="v">{e.vendor}</span>}
                    {alsoIn && <span class="v dir-also-mini">also listed under its main section</span>}
                  </td>
                  <td>{countryName(e.hq_country) ?? <span class="no">—</span>}</td>
                  <td>{jl.length ? jl.map((j) => <span class="jur">{JURISDICTION_SHORT[j] ?? j}</span>) : <span class="no">—</span>}</td>
                  <td>{languageShort(first(c, 'language')?.value) ?? <span class="no">—</span>}</td>
                  <td>
                    {model ? model.value : <span class="no">—</span>}
                    {c.fromPrice && <><br /><span>from {c.fromPrice}</span></>}
                  </td>
                  <td>{dep ? dep.value : <span class="no">—</span>}</td>
                  <td>{first(c, 'free_trial') ? <span class="yes">Yes</span> : <span class="no">—</span>}</td>
                  <td>{first(c, 'api') ? <span class="yes">Yes</span> : <span class="no">—</span>}</td>
                  <td>
                    {out ? (
                      <a class="dir-out-mini" href={out.href} rel={out.rel} target="_blank" data-dir-out={e.slug} data-dir-cat={e.category} data-dir-tier={effectiveTier(e)} data-dir-place="table" title={`Open the ${e.title} website`}>Visit ↗</a>
                    ) : (
                      <span class="no">—</span>
                    )}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
      <p class="hub-fine">
        “—” means the vendor’s pages did not state it when we checked, not that the product lacks it. Prices appear only
        where the vendor publishes them and our re-check found the same figure on its page.
      </p>
    </div>
  </section>
)}

<section class={isClosed ? 'hub-sec-a' : 'hub-sec-b'}>
  <div class="hub-wrap">
    <p class="hub-eyebrow navy">{isClosed ? `${compareNo} · Closed and moved` : `${listNo} · Every listing`}</p>
    <h2 class="hub-h2">{isClosed ? 'Where they went' : 'Facts, prices and terms'}</h2>
    {isClosed && (
      <p class="hub-sub">
        Library guides and old safety manuals still link to these addresses. Each card gives the closure date when an
        official notice states one, and where the content went.
      </p>
    )}

    {sponsoredCards.length > 0 && (
      <div class="dir-sponsored" data-dir-sponsored>
        <p class="lbl">Sponsored</p>
        <div class="dir-list">
          {sponsoredCards.map((c) => <DirectoryCard card={c} variant="compact" sponsored inCategory={inCategory} />)}
        </div>
      </div>
    )}

    {groups.map((g) => (
      <div data-dir-group={g.id}>
        {g.title && (
          <div class="dir-group-head">
            <h3 class="hub-h2" id={g.id}>
              {g.href ? <a href={g.href}>{g.title}</a> : g.title} <span class="dir-cat-n">{g.cards.length}</span>
            </h3>
            {g.rule && <p class="dir-group-rule">{g.rule}{g.href && <> · <a href={g.href}>Open this section →</a></>}</p>}
          </div>
        )}
        <div class="dir-list" data-dir-list>
          {g.cards.map((c) => <DirectoryCard card={c} variant="compact" inCategory={inCategory} />)}
        </div>
      </div>
    ))}
    <p id="dir-empty" class="hub-note hub-hide">Nothing matches these filters. Clear one of them to see more.</p>
  </div>
</section>

<script>
  // Фильтры — общий скрипт каталога (src/lib/directoryFilterClient.ts). Без JS видно всё.
  import { initDirectoryFilters } from '../lib/directoryFilterClient'
  initDirectoryFilters()
</script>
