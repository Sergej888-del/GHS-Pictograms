---
// SdsManagerCard.astro
// Reusable affiliate recommendation card for SDS Manager (sdsmanager.com).
// Place at: src/components/SdsManagerCard.astro
// Usage in MDX:
//   import SdsManagerCard from '../../../components/SdsManagerCard.astro'
//   <SdsManagerCard service="management" href="https://sdsmanager.com/us/sds-management?fpr=ghs3&fp_sid=gpmgmt" />
//   <SdsManagerCard service="ehs" href="https://ehs.sdsmanager.com/?fpr=ghs3&fp_sid=ehsrisk" />
//   // Optional per-placement override of the copy (title/body/cta) without adding a new service variant:
//   <SdsManagerCard service="ehs" body="..." href="https://ehs.sdsmanager.com/?fpr=ghs3&fp_sid=ehsrisk" />
//   // coupons={false} suppresses the discount-code block (it is off by default on service="ehs").
//
// Tracking coupons (session 28): GHS5 and GHS10 are volume-tiered and product-specific.
// They are printed WITH their scope on purpose — a bare "10% off" would be untrue for
// the small-library reader, who is most of the audience.
//
// Marking is mandatory and wired here ONCE: dagger + rel="sponsored nofollow noopener"
// + target="_blank" + an inline, plain-language disclosure linking to /affiliate-disclosure/.
// Scoped styles are written to out-specify global .article-content rules.
interface Props {
  service?: 'general' | 'authoring' | 'management' | 'ehs';
  href: string;
  title?: string;
  body?: string;
  cta?: string;
  /** Show the two tracking coupons. Default: everywhere EXCEPT the EHS suite —
   *  the partner granted the codes for SDS Manager Premium/Pro and ExactSDS
   *  Standard annual plans only, so advertising them next to the EHS suite
   *  would promise a discount that does not exist. */
  coupons?: boolean;
}
const {
  service = 'general',
  href,
  title: titleProp,
  body: bodyProp,
  cta: ctaProp,
  coupons: couponsProp,
} = Astro.props;
const COPY: Record<'general' | 'authoring' | 'management' | 'ehs', { title?: string; body: string; cta: string }> = {
  general: {
    body:
      'For ongoing SDS authoring and management \u2014 a central online library, version control, automatic regulatory updates, and team access \u2014 the solution we recommend is SDS Manager. It also offers a broader EHS suite.',
    cta: 'Explore SDS Manager',
  },
  authoring: {
    body:
      'For creating compliant Safety Data Sheets \u2014 AI-assisted authoring, hazard classification, version control, and 39+ languages \u2014 the solution we recommend is SDS Manager (ExactSDS). It also offers SDS management and a broader EHS suite.',
    cta: 'Explore SDS authoring',
  },
  management: {
    body:
      'For managing a compliant SDS library \u2014 central online access, version control, automatic supplier updates, and QR-code access for your team \u2014 the solution we recommend is SDS Manager. It also offers SDS authoring and a broader EHS suite.',
    cta: 'Explore SDS management',
  },
  ehs: {
    title: 'SDS Manager EHS',
    body:
      'For turning your SDS and chemical inventory into documented risk assessments \u2014 substance-, task-, and process-based, with controls and exposure data tracked per chemical \u2014 the solution we recommend is SDS Manager\u2019s EHS suite. It also covers incident reporting and audit & inspection.',
    cta: 'Start a 30-day free trial',
  },
};
const base = COPY[service] ?? COPY.general;
const title = titleProp ?? base.title;
const body = bodyProp ?? base.body;
const cta = ctaProp ?? base.cta;
const showCoupons = couponsProp ?? service !== 'ehs';
// Tracking coupons issued to us by SDS Manager. They are volume-tiered, and the
// tiers differ between the two products — printing a bare "10% off" would be
// false for most readers, so each code carries its exact scope.
const COUPONS = [
  {
    code: 'GHS5',
    off: '5% off annual plans',
    scope: 'SDS Manager Premium/Pro 200–400 SDSs · ExactSDS Standard 50–70 SDSs',
  },
  {
    code: 'GHS10',
    off: '10% off annual plans',
    scope: 'SDS Manager Premium/Pro 500+ SDSs · ExactSDS Standard 100+ SDSs',
  },
];
---
<aside class="smc" aria-label="Recommended solution">
  <div class="smc__accent" aria-hidden="true"></div>
  <div class="smc__inner">
    <p class="smc__eyebrow">Recommended solution</p>
    <h3 class="smc__title">{title ?? 'SDS Manager'}</h3>
    <p class="smc__body">{body}</p>
    <a class="smc__cta" href={href} target="_blank" rel="sponsored nofollow noopener">
      {cta} <span aria-hidden="true">&dagger;</span>
    </a>
    {showCoupons && (
      <div class="smc__coupons">
        <p class="smc__coupons-label">Reader discount codes</p>
        <ul class="smc__coupons-list">
          {COUPONS.map((c) => (
            <li>
              <code class="smc__code">{c.code}</code>
              <span class="smc__coupon-off">{c.off}</span>
              <span class="smc__coupon-scope">{c.scope}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
    <p class="smc__disclosure">
      <span aria-hidden="true">&dagger;</span> SDS Manager is a partner solution. We may earn a
      commission if you subscribe through our link{showCoupons ? ' or with one of the codes above' : ''},
      at no extra cost to you. See our
      <a href="/affiliate-disclosure/">affiliate disclosure</a>.
    </p>
  </div>
</aside>
<style>
  .smc {
    display: flex;
    margin: 2rem 0;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }
  .smc__accent {
    width: 6px;
    flex-shrink: 0;
    background: #059669; /* SDS pillar emerald */
  }
  .smc__inner {
    padding: 1.25rem 1.5rem;
  }
  .smc__eyebrow {
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #047857; /* emerald-700 */
  }
  .smc__title {
    margin: 0.25rem 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    color: #062a78; /* brand navy */
  }
  .smc__body {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #374151; /* gray-700 */
  }
  .smc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 1rem;
    padding: 0.55rem 1rem;
    border-radius: 0.5rem;
    background: #f97316; /* brand orange CTA */
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .smc__cta:hover {
    background: #ea6a0a;
    color: #ffffff;
  }
  .smc__cta:focus-visible {
    outline: 2px solid #062a78;
    outline-offset: 2px;
  }
  .smc__coupons {
    margin-top: 1rem;
    padding: 0.75rem 0.875rem;
    border: 1px dashed #a7f3d0; /* emerald-200 */
    border-radius: 0.5rem;
    background: #f0fdf4; /* emerald-50 */
  }
  .smc__coupons-label {
    margin: 0 0 0.5rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #047857; /* emerald-700 */
  }
  .smc__coupons-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .smc__coupons-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 0.5rem;
    margin: 0;
  }
  .smc__code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #064e3b; /* emerald-900 */
    background: #ffffff;
    border: 1px solid #6ee7b7; /* emerald-300 */
    border-radius: 0.25rem;
    padding: 0.125rem 0.4375rem;
  }
  .smc__coupon-off {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #065f46; /* emerald-800 */
  }
  .smc__coupon-scope {
    flex-basis: 100%;
    font-size: 0.75rem;
    line-height: 1.45;
    color: #6b7280; /* gray-500 */
  }
  .smc__disclosure {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: #6b7280; /* gray-500 */
  }
  .smc__disclosure a {
    color: #6b7280;
    text-decoration: underline;
  }
  .smc__disclosure a:hover {
    color: #374151;
  }
  @media (prefers-reduced-motion: reduce) {
    .smc__cta {
      transition: none;
    }
  }
</style>
