---
// Google Analytics 4 + Consent Mode v2 + cookie consent banner.
// Single source of truth — included in Layout.astro AND in standalone pages.
//
// Behaviour:
//   - analytics_storage defaults to 'denied' BEFORE GA4 loads (Consent Mode v2),
//     so no analytics cookies are set until the visitor accepts.
//   - A previously stored choice is honoured immediately on load.
//   - A bottom banner (injected on DOMContentLoaded) lets the visitor Accept/Decline.
//   - window.openCookieSettings() re-opens the banner (used by the footer link).
// Keep the scripts `is:inline` so Astro does not bundle/transform them.
---
{/* GA4 + Consent Mode v2 */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  // Default: deny analytics until the visitor consents (must run before GA4 loads).
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied'
  });

  // Honour a stored choice immediately so returning visitors are tracked from the first hit.
  try {
    if (localStorage.getItem('ga-consent') === 'granted') {
      gtag('consent', 'update', { analytics_storage: 'granted' });
    }
  } catch (e) {}

  // s99: a browser driven by automation (headless Chrome, Puppeteer, Playwright, Selenium) reports
  // navigator.webdriver === true; a person's Chrome / Edge / Safari / Firefox never does.
  // Such a visit is counted nowhere: GA4 is switched off by Google's own opt-out flag (it must be
  // set before gtag('config')), Umami drops every send in ghsUmamiBeforeSend (data-before-send on
  // its tag), and the directory listener below sends no beacon to our click counter.
  // The scripts still load, so a lab test (Lighthouse) measures the same page a person gets.
  // Why: Umami 08-09.10.2026 - ~400 "Singapore" and ~150 "China" visitors a day, 100 % direct,
  // 1-second single-page visits; a WAF rule by country is ruled out (lesson s68, CLAUDE.md s15).
  window.ghsAutomated = false;
  try { window.ghsAutomated = navigator.webdriver === true; } catch (e) {}
  if (window.ghsAutomated) window['ga-disable-G-7T76LL8ZF3'] = true;
  window.ghsUmamiBeforeSend = function (type, payload) { return window.ghsAutomated ? null : payload; };
</script>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7T76LL8ZF3"></script>
{/* Umami Cloud (s92): cookieless statistics, no consent banner needed - counts the visitors GA4 does not see
    after they decline. data-domains: only ghspictograms.com is counted (not *.pages.dev previews, not localhost).
    data-exclude-search: page reports by path; query strings (tool deep links, label-maker state) are not sent.
    data-before-send (s99): ghsUmamiBeforeSend above returns null for an automated browser - nothing is sent.
    Free Hobby plan: 100K events / month, one website, 6 months retention. */}
<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="825a9f36-85a7-416f-b44d-b5a0937db4b8" data-domains="ghspictograms.com" data-exclude-search="true" data-before-send="ghsUmamiBeforeSend"></script>
<script is:inline>
  gtag('js', new Date());
  gtag('config', 'G-7T76LL8ZF3');

  // ---- Партнёрские клики → GA4 `affiliate_click` (session 89, №144) ------------
  // Один делегированный слушатель на ВСЕ ссылки с fpr=ghs3 — и в статических
  // карточках SdsManagerCard (~4 400 страниц), и в React-островах. До s89 событие
  // слали только четыре острова, и GA4 показывал «2» при ~110 кликах в FirstPromoter.
  // placement = fp_sid ссылки (тот же ключ, что в отчёте FirstPromoter), page = путь.
  // Источник правды по партнёрке — по-прежнему FirstPromoter; это вторая линейка.
  // Фаза capture: сработает и там, где островной обработчик остановит всплытие.
  document.addEventListener('click', function (e) {
    var t = e.target;
    var a = t && t.closest ? t.closest('a[href*="fpr=ghs3"]') : null;
    if (!a) return;
    var sid = 'unknown';
    try { sid = new URL(a.href).searchParams.get('fp_sid') || 'unknown'; } catch (err) {}
    gtag('event', 'affiliate_click', {
      partner: 'sds_manager',
      placement: sid,
      page: location.pathname,
      link_url: a.href.split('?')[0]
    });
    // Same click to Umami (cookieless - counted even when GA4 consent was declined).
    if (window.umami && typeof window.umami.track === 'function') {
      window.umami.track('affiliate_click', { partner: 'sds_manager', placement: sid, page: location.pathname });
    }
  }, true);

  // ---- Directory: clicks to a vendor's website -> GA4 `directory_outbound` (s92, No.148)
  // One delegated listener for every "Vendor website" link on /directory/ (category cards and
  // entry pages). vendor = listing slug, the number a vendor can be shown: "we sent you N visitors".
  // An SDS Manager link fires affiliate_click as well - two rulers, FirstPromoter stays the truth.
  // s99: the same click also goes to our own counter (POST /api/directory-click -> Supabase
  // directory_clicks) - THAT is the number we show a vendor; GA4/Umami are second rulers.
  // Middle-click (auxclick, button 1) opens a tab too, so it counts as well.
  function dirOut(e) {
    if (e.type === 'auxclick' && e.button !== 1) return;
    var t = e.target;
    var a = t && t.closest ? t.closest('a[data-dir-out]') : null;
    if (!a) return;
    var ev = {
      vendor: a.getAttribute('data-dir-out') || 'unknown',
      category: a.getAttribute('data-dir-cat') || 'unknown',
      tier: a.getAttribute('data-dir-tier') || 'unknown',
      placement: a.getAttribute('data-dir-place') || 'card',
      page: location.pathname,
      link_url: a.href.split('?')[0]
    };
    gtag('event', 'directory_outbound', ev);
    if (window.umami && typeof window.umami.track === 'function') {
      window.umami.track('directory_outbound', ev);
    }
    // Own counter: only real clicks by a person (isTrusted, not an automated browser), nothing
    // stored on the device - the server builds a daily key from the request (functions/api/directory-click.ts).
    if (!e.isTrusted || window.ghsAutomated || location.pathname.indexOf('/directory/') !== 0) return;
    try {
      var host = '';
      try { host = new URL(a.href).hostname; } catch (err) {}
      var body = JSON.stringify({ cat: ev.category, slug: ev.vendor, place: ev.placement, page: location.pathname, host: host });
      var sent = navigator.sendBeacon ? navigator.sendBeacon('/api/directory-click', body) : false;
      if (!sent && window.fetch) {
        fetch('/api/directory-click', { method: 'POST', body: body, keepalive: true, headers: { 'Content-Type': 'text/plain' } }).catch(function () {});
      }
    } catch (err) {}
  }
  document.addEventListener('click', dirOut, true);
  document.addEventListener('auxclick', dirOut, true);

  // ---- Cookie consent banner -------------------------------------------------
  (function () {
    var KEY = 'ga-consent';

    function grant() {
      try { localStorage.setItem(KEY, 'granted'); } catch (e) {}
      gtag('consent', 'update', { analytics_storage: 'granted' });
    }
    function deny() {
      try { localStorage.setItem(KEY, 'denied'); } catch (e) {}
      gtag('consent', 'update', { analytics_storage: 'denied' });
    }
    function removeBanner() {
      var b = document.getElementById('cookie-consent-banner');
      if (b && b.parentNode) b.parentNode.removeChild(b);
    }

    function buildBanner() {
      if (document.getElementById('cookie-consent-banner')) return;

      var bar = document.createElement('div');
      bar.id = 'cookie-consent-banner';
      bar.setAttribute('role', 'dialog');
      bar.setAttribute('aria-label', 'Cookie consent');
      bar.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:9999;background:#062A78;color:#fff;padding:14px 16px;font-family:Inter,system-ui,sans-serif;font-size:14px;line-height:1.5;box-shadow:0 -2px 12px rgba(0,0,0,.25);';

      var inner = document.createElement('div');
      inner.style.cssText = 'max-width:1100px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;justify-content:space-between;';

      var text = document.createElement('p');
      text.style.cssText = 'margin:0;flex:1 1 320px;';
      text.innerHTML = 'We use cookies for analytics (Google Analytics) to understand site usage. Analytics cookies are set only with your consent. See our <a href="/privacy/" style="color:#bfdbfe;text-decoration:underline;">Privacy Policy</a>.';

      var btns = document.createElement('div');
      btns.style.cssText = 'display:flex;gap:10px;flex:0 0 auto;';

      var decline = document.createElement('button');
      decline.type = 'button';
      decline.textContent = 'Decline';
      decline.style.cssText = 'cursor:pointer;padding:8px 16px;border-radius:6px;border:1px solid rgba(255,255,255,.6);background:transparent;color:#fff;font:inherit;font-weight:600;';
      decline.onclick = function () { deny(); removeBanner(); };

      var accept = document.createElement('button');
      accept.type = 'button';
      accept.textContent = 'Accept';
      accept.style.cssText = 'cursor:pointer;padding:8px 16px;border-radius:6px;border:1px solid #fff;background:#fff;color:#062A78;font:inherit;font-weight:600;';
      accept.onclick = function () { grant(); removeBanner(); };

      btns.appendChild(decline);
      btns.appendChild(accept);
      inner.appendChild(text);
      inner.appendChild(btns);
      bar.appendChild(inner);
      document.body.appendChild(bar);
    }

    function maybeShow() {
      var choice = null;
      try { choice = localStorage.getItem(KEY); } catch (e) {}
      if (!choice) buildBanner();
    }

    // Footer "Cookie settings" link re-opens the banner.
    window.openCookieSettings = function () {
      try { localStorage.removeItem(KEY); } catch (e) {}
      removeBanner();
      buildBanner();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', maybeShow);
    } else {
      maybeShow();
    }
  })();
</script>
